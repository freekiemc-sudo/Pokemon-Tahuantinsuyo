# [FIX5] Funciones auxiliares globales (restauradas)
# =============================================================

def mos_activas(gimnasios):
    """Devuelve el set de MOs activas segun las medallas obtenidas."""
    try:
        medallas = getattr(gimnasios, "medallas_obtenidas", [])
    except Exception:
        medallas = []
    m = set(medallas) if not isinstance(medallas, set) else medallas
    activas = set()
    if "Medalla Cantera" in m:
        activas.add("Escalada Andina")
    if "Medalla Marea" in m:
        activas.add("Navegacion Fluvial")
    if "Medalla Mistico" in m:
        activas.add("Vaguada")
    if "Medalla Liana" in m:
        activas.add("Corte / Tala")
    return activas


def evento_supay_activo(mapa_id):
    """Devuelve el evento Supay activo en ese mapa, o None."""
    try:
        from data.eventos_supay import EVENTOS_SUPAY
        return EVENTOS_SUPAY.get(mapa_id)
    except Exception:
        return None


def marcar_evento_completado(ciudad):
    """Marca un evento Supay como completado."""
    try:
        from data.eventos_supay import EVENTOS_SUPAY
        ev = EVENTOS_SUPAY.get(ciudad)
        if ev:
            ev.completado = True
    except Exception:
        pass


def gimnasio_bloqueado(id_gimnasio):
    """Devuelve (bloqueado, motivo) segun progreso del juego."""
    return (False, "")


def puede_avanzar_a(id_destino, gimnasios):
    """Gating de progresion: devuelve (puede, motivo)."""
    try:
        n = gimnasios.cantidad_medallas()
    except Exception:
        n = 0
    # Mapa -> medallas requeridas
    requisitos = {
        "ruta_5":          4,
        "ciudad_imperial": 3,
        "puno":            4,
        "ruta_6":          5,
        "huaraz":          5,
        "ruta_7":          6,
        "puerto_selva":    6,
        "ruta_8":          7,
        "ciudad_capital":  7,
    }
    req = requisitos.get(id_destino, 0)
    if n < req:
        return (False, f"Necesitas {req} medallas para ir a {id_destino.replace('_',' ').title()}")
    return (True, "")


def proximo_objetivo(gimnasios, liga=None):
    """Texto del proximo objetivo."""
    try:
        n = gimnasios.cantidad_medallas()
    except Exception:
        n = 0
    if n >= 8:
        if liga and getattr(liga, "es_campeon", False):
            return "Disfruta el post-game"
        return "Desafia la Liga Pokemon"
    return f"Consigue la medalla #{n+1}"


def _tipo_sprite_npc(npc):
    """Mapea rol de NPC a tipo de sprite."""
    try:
        rol = (npc.get("rol") or "").lower()
        nombre = (npc.get("nombre") or "").lower()
    except Exception:
        return "civil"
    mapa = {
        "anciana": "anciano", "anciano": "anciano", "sabio": "anciano",
        "pescador": "pescador", "barquero": "pescador",
        "nino": "nino", "nina": "nina",
        "comerciante": "vendedor", "vendedor": "vendedor",
        "tendero": "tendero", "empresario": "empresario",
        "religioso": "sacerdote", "sacerdote": "sacerdote",
        "oficial": "guardia", "guardia": "guardia",
        "guardaparques": "guardia",
        "aventurero": "explorador", "explorador": "explorador",
        "artesana": "dama", "dama": "dama", "abogada": "dama",
        "arriero": "campesino", "campesino": "campesino", "pastor": "campesino",
        "artista": "danzante", "danzante": "danzante",
        "medica": "chamana", "chamana": "chamana", "shaman": "chamana",
        "extranjero": "montanista", "montanista": "montanista",
        "taxista": "civil", "civil": "civil", "fanatica": "nina",
        "cientifico": "cientifico", "astronomo": "cientifico",
        "ejecutivo": "empresario", "veterano": "guerrero",
    }
    if "profesor" in nombre or "kuntur" in nombre:
        return "profesor"
    if "enfermera" in nombre or "tambo" in nombre:
        return "enfermera"
    if "supay" in nombre or "recluta" in nombre:
        return "supay"
    return mapa.get(rol, "civil")


