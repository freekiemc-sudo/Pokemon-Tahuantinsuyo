    def _verificar_aprendizaje_movimiento(self, pokemon):
        """Encola los movimientos que el Pokémon quiere aprender al subir de nivel."""
        datos = POKEDEX_COMPLETA.get(pokemon.nombre, {})
        for entry in datos.get("aprendizajes_por_nivel", []):
            if entry.get("nivel") != pokemon.nivel:
                continue
            mov_data = entry["movimiento"]
            if any(m.nombre == mov_data["nombre"] for m in pokemon.movimientos):
                continue
            self._aprendizajes_pendientes.append((pokemon, mov_data))

    def _procesar_siguiente_aprendizaje(self):
        if not self._aprendizajes_pendientes:
            return False
        poke, mov_data = self._aprendizajes_pendientes.pop(0)
        self._iniciar_aprendizaje(poke, mov_data)
        return True

    def _iniciar_aprendizaje(self, pokemon, mov_data):
        from sistemas.batalla import Movimiento
        self._aprendizaje_poke = pokemon
        self._aprendizaje_mov = Movimiento(mov_data)
        self._aprendizaje_mov_data = mov_data

        if len(pokemon.movimientos) < 4:
            # Aprender directo
            pokemon.movimientos.append(self._aprendizaje_mov)
            self.mensajes = [f"¡{pokemon.nombre} aprendió {mov_data['nombre']}!"]
            self.timer_mensajes = 2.5
            # Limpiar
            self._aprendizaje_poke = None
            self._aprendizaje_mov = None
            self._aprendizaje_mov_data = None
            # Procesar el siguiente
            if self._aprendizajes_pendientes:
                self._procesar_siguiente_aprendizaje()
        else:
            # Preguntar al jugador
            self._aprender_mov_fase = "pregunta"
            self._aprender_mov_idx = 0
            self.estado = "aprender_movimiento"

    def _manejar_input_aprender_mov(self, key):
        if self._aprender_mov_fase == "pregunta":
            if key in (pygame.K_y, pygame.K_RETURN, pygame.K_x, pygame.K_z):
                self._aprender_mov_fase = "elegir"
                self._aprender_mov_idx = 0
                self._txt_cache = None
            elif key in (pygame.K_n, pygame.K_ESCAPE):
                self.mensajes = [f"{self._aprendizaje_poke.nombre} no aprendió "
                                 f"{self._aprendizaje_mov_data['nombre']}."]
                self.timer_mensajes = 2.5
                self._aprendizaje_poke = None
                self._aprendizaje_mov = None
                self._aprendizaje_mov_data = None
                self.estado = "exploracion"
                if self._aprendizajes_pendientes:
                    self._procesar_siguiente_aprendizaje()

        elif self._aprender_mov_fase == "elegir":
            movs = self._aprendizaje_poke.movimientos
            if key == pygame.K_UP:
                self._aprender_mov_idx = (self._aprender_mov_idx - 1) % len(movs)
            elif key == pygame.K_DOWN:
                self._aprender_mov_idx = (self._aprender_mov_idx + 1) % len(movs)
            elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                olvidado = movs[self._aprender_mov_idx]
                movs[self._aprender_mov_idx] = self._aprendizaje_mov
                self.mensajes = [
                    f"¡{self._aprendizaje_poke.nombre} olvidó {olvidado.nombre}!",
                    f"¡Y aprendió {self._aprendizaje_mov_data['nombre']}!",
                ]
                self.timer_mensajes = 3.0
                self._aprendizaje_poke = None
                self._aprendizaje_mov = None
                self._aprendizaje_mov_data = None
                self.estado = "exploracion"
                if self._aprendizajes_pendientes:
                    self._procesar_siguiente_aprendizaje()
            elif key == pygame.K_ESCAPE:
                self.mensajes = [f"{self._aprendizaje_poke.nombre} no aprendió "
                                 f"{self._aprendizaje_mov_data['nombre']}."]
                self.timer_mensajes = 2.5
                self._aprendizaje_poke = None
                self._aprendizaje_mov = None
                self._aprendizaje_mov_data = None
                self.estado = "exploracion"
                if self._aprendizajes_pendientes:
                    self._procesar_siguiente_aprendizaje()

    def _dibujar_aprender_movimiento(self):
        """Sistema de aprendizaje mejorado con preview visual."""
        overlay = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
        overlay.fill((10, 5, 20, 200))
        pantalla.blit(overlay, (0, 0))

        bx, by, bw, bh = 30, 60, ANCHO - 60, ALTO - 120
        # Marco con doble borde dorado
        pygame.draw.rect(pantalla, (0, 0, 0, 100), (bx + 3, by + 3, bw, bh))
        pygame.draw.rect(pantalla, (140, 90, 30), (bx - 2, by - 2, bw + 4, bh + 4))
        pygame.draw.rect(pantalla, (240, 200, 60), (bx - 2, by - 2, bw + 4, bh + 4), 2)
        pygame.draw.rect(pantalla, (40, 25, 55), (bx, by, bw, bh))
        pygame.draw.rect(pantalla, (255, 240, 180), (bx + 4, by + 4, bw - 8, bh - 8), 1)

        poke = self._aprendizaje_poke
        mov = self._aprendizaje_mov_data
        if poke is None or mov is None:
            return

        # Colores por tipo
        col_tipo = {
            "Fuego": (255, 140, 40), "Agua": (80, 170, 240),
            "Planta": (80, 200, 90), "Electrico": (255, 230, 60),
            "Eléctrico": (255, 230, 60), "Hielo": (150, 230, 245),
            "Lucha": (220, 80, 60), "Siniestro": (120, 80, 150),
            "Fantasma": (160, 100, 200), "Veneno": (180, 90, 200),
            "Tierra": (200, 150, 90), "Roca": (170, 140, 100),
            "Acero": (180, 190, 210), "Psiquico": (240, 100, 200),
            "Psíquico": (240, 100, 200), "Bicho": (170, 200, 80),
            "Volador": (170, 200, 240), "Dragon": (100, 110, 240),
            "Dragón": (100, 110, 240), "Hada": (250, 180, 220),
            "Sonido": (150, 220, 220), "Normal": (220, 220, 220),
        }
        col_mov = col_tipo.get(mov.get("tipo", "Normal"), (220, 220, 220))

        if self._aprender_mov_fase == "pregunta":
            # Icono de interrogacion pulsante
            pulso = 1 + 0.1 * math.sin(self.anim_menu * 4)

            # Retrato del Pokemon como preview
            try:
                sp = SPRITES.get(poke.nombre)
                if sp:
                    tam = int(96 * pulso)
                    big = pygame.transform.scale(sp, (tam, tam))
                    pantalla.blit(big, (bx + 30 - (tam - 96) // 2,
                                        by + 60 - (tam - 96) // 2))
            except Exception:
                pass

            t1 = fuente_grande.render(
                f"!{poke.nombre} quiere aprender!", True, (255, 240, 180))
            t2 = fuente_media.render(
                f"{mov['nombre']}", True, col_mov)
            t3 = fuente_peque.render(
                f"[{mov.get('tipo','?')}]  Poder: {mov.get('potencia', 0)}  "
                f"Precision: {mov.get('precision', 100)}  PP: {mov.get('pp', 20)}",
                True, (240, 240, 220))
            t4 = fuente_media.render(
                f"Pero {poke.nombre} ya conoce 4 movimientos.", True, (220, 220, 240))
            t5 = fuente_media.render(
                "Quieres olvidar uno para aprender este?", True, (255, 240, 100))

            pantalla.blit(t1, (ANCHO//2 - t1.get_width()//2 + 30, by + 30))
            # Caja del movimiento nuevo
            mov_bx = bx + 160
            mov_by = by + 80
            mov_bw = bw - 190
            pygame.draw.rect(pantalla, (30, 20, 40), (mov_bx, mov_by, mov_bw, 80))
            pygame.draw.rect(pantalla, col_mov, (mov_bx, mov_by, mov_bw, 80), 3)
            pantalla.blit(t2, (mov_bx + 20, mov_by + 8))
            pantalla.blit(t3, (mov_bx + 20, mov_by + 34))

            # Descripcion si existe
            desc = mov.get("descripcion", "")
            if desc:
                y_d = mov_by + 54
                for ln in self._wrap_texto(desc, fuente_peque, mov_bw - 30)[:2]:
                    dt = fuente_peque.render(ln, True, (200, 220, 240))
                    pantalla.blit(dt, (mov_bx + 20, y_d))
                    y_d += 14

            pantalla.blit(t4, (ANCHO//2 - t4.get_width()//2 + 30, by + 190))
            pantalla.blit(t5, (ANCHO//2 - t5.get_width()//2 + 30, by + 220))

            # Botones
            pygame.draw.rect(pantalla, (60, 140, 60), (bx + 60, by + bh - 70, 200, 40))
            pygame.draw.rect(pantalla, (255, 240, 180), (bx + 60, by + bh - 70, 200, 40), 2)
            by1 = fuente_media.render("[Y] Aprender", True, (255, 255, 255))
            pantalla.blit(by1, (bx + 60 + 100 - by1.get_width()//2, by + bh - 60))

            pygame.draw.rect(pantalla, (150, 50, 50), (bx + bw - 260, by + bh - 70, 200, 40))
            pygame.draw.rect(pantalla, (255, 240, 180), (bx + bw - 260, by + bh - 70, 200, 40), 2)
            bn = fuente_media.render("[N] Rechazar", True, (255, 255, 255))
            pantalla.blit(bn, (bx + bw - 260 + 100 - bn.get_width()//2, by + bh - 60))

        elif self._aprender_mov_fase == "elegir":
            t = fuente_media.render(
                f"Que movimiento debe olvidar {poke.nombre}?", True, (255, 240, 180))
            pantalla.blit(t, (ANCHO//2 - t.get_width()//2, by + 12))

            # Lista de movimientos actuales
            y = by + 50
            for i, m in enumerate(poke.movimientos):
                sel = (i == self._aprender_mov_idx)
                col = (255, 240, 120) if sel else (220, 220, 240)
                rect_col = (80, 60, 110) if sel else (35, 25, 45)
                pygame.draw.rect(pantalla, rect_col, (bx + 30, y, bw - 60, 44))
                if sel:
                    pygame.draw.rect(pantalla, (240, 200, 60), (bx + 30, y, bw - 60, 44), 3)
                else:
                    pygame.draw.rect(pantalla, (90, 70, 110), (bx + 30, y, bw - 60, 44), 1)
                # Cuadro de tipo del movimiento
                m_tipo = getattr(m, "tipo", "Normal")
                m_col = col_tipo.get(m_tipo, (200, 200, 200))
                pygame.draw.rect(pantalla, m_col, (bx + 40, y + 8, 60, 28))
                pygame.draw.rect(pantalla, (20, 15, 25), (bx + 40, y + 8, 60, 28), 1)
                et = fuente_peque.render(m_tipo[:8], True, (30, 20, 30))
                pantalla.blit(et, (bx + 70 - et.get_width()//2, y + 15))

                txt = fuente_media.render(
                    f"{m.nombre}", True, col)
                pantalla.blit(txt, (bx + 115, y + 4))
                stats_m = fuente_peque.render(
                    f"POT {getattr(m,'potencia',0)}  PREC {getattr(m,'precision',100)}  "
                    f"PP {m.pp}/{m.pp_max}",
                    True, (200, 200, 220))
                pantalla.blit(stats_m, (bx + 115, y + 24))

                if sel:
                    fx = bx + 15 + int(3 * math.sin(self.anim_menu * 8))
                    pygame.draw.polygon(pantalla, (240, 200, 60), [
                        (fx, y + 22), (fx + 10, y + 14), (fx + 10, y + 30)
                    ])
                y += 52

            # Movimiento nuevo
            pygame.draw.rect(pantalla, (40, 60, 40), (bx + 30, by + bh - 78, bw - 60, 40))
            pygame.draw.rect(pantalla, col_mov, (bx + 30, by + bh - 78, bw - 60, 40), 3)
            tn = fuente_media.render(
                f"NUEVO: {mov['nombre']}  [{mov.get('tipo','?')}]  "
                f"POT {mov.get('potencia', 0)}", True, (255, 250, 180))
            pantalla.blit(tn, (bx + 50, by + bh - 68))

            tip = fuente_peque.render(
                "[^/v] Elegir   [X] Olvidar y aprender   [ESC] Cancelar",
                True, (240, 220, 180))
            pantalla.blit(tip, (ANCHO//2 - tip.get_width()//2, by + bh - 26))
    def _iniciar_evento_huaca(self):
        """Secuencia: Mateo avisa → llegas a la huaca → Recluta Alfa → victoria."""
        self.dialogo_actual = [
            "¡Oye, [Nombre]! La situación es seria.",
            "Esos sujetos del Team Supay se acaban de meter a la fuerza",
            "en la Huaca del Sol con herramientas pesadas.",
            "Intentan desenterrar una reliquia que protege los campos.",
            "¡Vamos para allá antes de que arruinen todo!",
        ]
        self.dialogo_hablante = "Mateo"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "evento_huaca"

    def _dibujar_elegir_nombre(self):
        # Fondo degradado Hoenn azul-mar
        for i in range(ALTO):
            r = int(40 + 60 * i / ALTO)
            g = int(90 + 80 * i / ALTO)
            b = int(150 + 90 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))
        # Estrellitas
        for i in range(28):
            px = (i * 151 + int(self.anim_menu * 25)) % ANCHO
            py = (i * 67) % 130
            pygame.draw.rect(pantalla, (240, 240, 250), (px, py, 2, 2))
        # Retrato de Kuntur a la izquierda
        try:
            from sistemas.retratos import Retratos
            ret = Retratos.obtener("Prof. Kuntur", 140, self.anim_menu)
            pygame.draw.rect(pantalla, (26, 20, 42), (30, 130, 152, 152))
            pygame.draw.rect(pantalla, DORADO_LIGA, (30, 130, 152, 152), 3)
            pygame.draw.rect(pantalla, (16, 12, 28), (36, 136, 140, 140))
            pantalla.blit(ret, (36, 136))
        except Exception:
            pass

        t = fuente_grande.render("¿Cómo te llamas?", True, BLANCO)
        pantalla.blit(t, (210, 140))

        # Cuadro de texto estilo Hoenn
        bx, by, bw, bh = 210, 178, 380, 44
        pygame.draw.rect(pantalla, (250, 250, 240), (bx, by, bw, bh))
        pygame.draw.rect(pantalla, (26, 20, 42), (bx, by, bw, bh), 3)
        pygame.draw.rect(pantalla, DORADO_LIGA, (bx+3, by+3, bw-6, bh-6), 1)

        nombre_mostrado = self.nombre_input or ""
        tn = fuente_grande.render(nombre_mostrado, True, (26, 20, 42))
        pantalla.blit(tn, (bx + 14, by + 10))

        # Cursor parpadeante
        blink = int(self.anim_menu * 3) % 2
        if blink:
            cx = bx + 14 + tn.get_width() + 2
            pygame.draw.rect(pantalla, (26, 20, 42), (cx, by + 10, 3, 26))

        # Contador de letras
        info = fuente_peque.render(f"{len(self.nombre_input)}/10  (mín. 2)",
                                    True, (100, 90, 110))
        pantalla.blit(info, (bx, by + bh + 6))

        # Ayuda
        ayuda = fuente_peque.render(
            "Escribe con el teclado. [ENTER] Confirmar  [BACKSPACE] Borrar",
            True, (240, 240, 210))
        pantalla.blit(ayuda, (ANCHO//2 - ayuda.get_width()//2, ALTO - 30))
    def _dibujar_evento_huaca(self):
        """Pelea de presentación contra el Recluta Alfa del Team Supay."""
        if not self.equipo.pokemons:
            self.mensajes = ["¡No tienes Pokémon contigo!"]
            self.timer_mensajes = 1.8
            self.estado = "exploracion"
            return

        # Sólo arrancamos la batalla la primera vez que se dibuja el estado.
        if getattr(self, "_huaca_batalla_iniciada", False):
            # Si ya hay batalla, delega al dibujante normal
            if self.batalla_actual is not None:
                self._dibujar_batalla()
                return
            # Si terminó y el resultado fue victoria, completar evento
            if getattr(self, "_huaca_resultado", None) == "victoria":
                self.historia.completar_evento("evento_huaca")
                # Marcar el evento del Team Supay de Moche como completado
                self.historia.completar_evento("supay_moche")
                try:
                    marcar_evento_completado("ciudad_moche")
                except Exception:
                    pass
                self.inventario.dinero += 400
                self.dialogo_actual = [
                    "¡Imposible! ¿Cómo un novato nos va a derrotar?",
                    "¡Retirémonos! Esto no se queda así.",
                    "---",
                    "El cuidador de la huaca se libera y te agradece.",
                    "Te entrega el Quipu que los vándalos habían robado.",
                    "Mateo: ¡Excelente trabajo, causa!",
                    "Ahora ve al Gimnasio: Don Fermín te está esperando.",
                ]
                self.dialogo_hablante = "Recluta Alfa"
                self.dialogo_idx = 0
                self.estado = "dialogo"
                self.siguiente_estado_tras_dialogo = "exploracion"
                self._huaca_batalla_iniciada = False
                self._huaca_resultado = None
                return
            return

        # Primera vez: arrancar batalla contra el Recluta Alfa
        try:
            datos1 = POKEDEX_COMPLETA.get("Surito", {})
            datos2 = POKEDEX_COMPLETA.get("Cuy", {})
            rival = PokemonBatalla(datos1, 6) if datos1 else None
            rival2 = PokemonBatalla(datos2, 7) if datos2 else None
            if rival is None:
                self.estado = "exploracion"
                return
            self.batalla_actual = Batalla(self.equipo.pokemons, rival)
            self.batalla_actual.es_gimnasio = True
            self.batalla_actual.es_rival = True
            self.batalla_actual.rival_equipo = [rival, rival2] if rival2 else [rival]
            self.batalla_actual.rival_poke_idx = 0
            self.batalla_actual.sub_estado = "menu_principal"
            self._huaca_batalla_iniciada = True
            self._huaca_resultado = None
            self.menu_batalla_idx = 0
            self.mensajes = ["¡Recluta Alfa del Team Supay te reta!"]
            self.timer_mensajes = 1.6
            self._iniciar_transicion_batalla()
            self.musica.fondo("batalla_supay")
        except Exception:
            import traceback
            traceback.print_exc()
            self.historia.completar_evento("evento_huaca")
            self.estado = "exploracion"

    def _procesar_movimiento(self, dx, dy, direccion):
        # ----- GATING DE PROGRESIÓN -----
        nx = self.mapa_actual.destino_x + dx
        ny = self.mapa_actual.destino_y + dy
        trans_pre = self.mapa_actual.transiciones.get((nx, ny))
        if trans_pre:
            id_dest = trans_pre[0]
            ok, motivo = puede_avanzar_a(id_dest, self.gimnasios)
            if not ok:
                self.mensajes = ["¡Camino bloqueado!", motivo]
                self.timer_mensajes = 3.0
                # No movemos al jugador
                self.mapa_actual.direccion = direccion
                return

        # B4: guardar posicion actual del jugador en la cola del seguidor
        try:
            if self.equipo.pokemons:
                jx_old = self.mapa_actual.destino_x
                jy_old = self.mapa_actual.destino_y
                self._seguidor_cola.insert(0, (jx_old, jy_old, self.mapa_actual.direccion))
                # Solo guardar ultimas 3 posiciones
                self._seguidor_cola = self._seguidor_cola[:3]
        except Exception:
            pass

        exito, trans = self.mapa_actual.iniciar_movimiento(
            dx, dy, direccion, mo_activas=self.mos_desbloqueadas
        )
        if not exito:
            # Revertir la cola si no se movio
            try:
                if self._seguidor_cola:
                    self._seguidor_cola.pop(0)
            except Exception:
                pass
            return

        if trans:
            id_dest = trans[0]
            # F: verificar si debe activarse el episodio
            try:
                self._verificar_episodio_amaru()
            except Exception:
                pass
            def _cambiar_mapa(_id=id_dest):
                self.mapa_actual = MapaVisual(_id)
                try:
                    self._seguidor_cola = []
                except Exception:
                    pass
                try:
                    ev2 = evento_supay_activo(_id)
                    if ev2 and not self.historia.evento_completado(ev2.id) and not getattr(ev2, "completado", False):
                        self._iniciar_evento_supay(ev2)
                except Exception:
                    pass
            self._iniciar_fade(_cambiar_mapa)
            return

            # Disparar evento Team Supay si aplica
            ev = evento_supay_activo(id_dest)
            if ev and not self.historia.evento_completado(ev.id) and not getattr(ev, "completado", False):
                px = self.mapa_actual.destino_x
                py = self.mapa_actual.destino_y
                self._iniciar_evento_supay(ev)
                self.mapa_actual.destino_x = px
                self.mapa_actual.destino_y = py
                self.mapa_actual.pos_x = float(px)
                self.mapa_actual.pos_y = float(py)
                self.mensajes = [f"Llegaste a {id_dest.replace('_',' ').title()}"]
                self.timer_mensajes = 2.0
                if (
                    id_dest == "ciudad_moche"
                    and not self.historia.evento_completado("evento_huaca")
                    and not getattr(self, "_huaca_batalla_iniciada", False)
                ):
                    self._iniciar_evento_huaca()
                return

        try:
            self._stats_partida["pasos"] += 1
        except Exception:
            pass

        # E8: verificar leyenda cercana
        try:
            if self._intentar_invocar_leyenda():
                return
        except Exception:
            pass

        if self.mapa_actual.esta_en_hierba_alta():
            self.pasos_en_hierba += 1
            # ADICTIVIDAD: 3% de encontrar item al caminar en hierba
            if random.random() < 0.03:
                try:
                    from sistemas.inventario import (CURACIONES, POKEBALLS,
                                                      EVOLUCION, REVIVIRES)
                    opciones = []
                    for cat in (CURACIONES, POKEBALLS, EVOLUCION, REVIVIRES):
                        opciones.extend(cat.values())
                    if opciones:
                        obj = random.choice(opciones)
                        self.inventario.agregar(obj, 1)
                        self.mensajes = [f"!Encontraste {obj.nombre}!"]
                        self.timer_mensajes = 2.0
                        try:
                            from sistemas.sonidos import Sonidos as SonAvz
                            SonAvz.captura_exitosa()
                        except Exception:
                            pass
                except Exception:
                    pass
            if self.pasos_en_hierba >= self.PASOS_PARA_ENCUENTRO:
                self.pasos_en_hierba = 0
                if random.random() < 0.75:
                    self._iniciar_batalla_aleatoria()
                            # Trigger automático de entrenadores al pasar al lado
        if not self.mapa_actual.moviendo:
            jx, jy = self.mapa_actual.destino_x, self.mapa_actual.destino_y
            for ent in entrenadores_en(self.mapa_actual.id):
                if getattr(ent, "derrotado", False):
                    continue
                ex, ey = ent.posicion
                if abs(ex - jx) + abs(ey - jy) == 1:
                    # Solo auto-trigger si el jugador lo está mirando
                    d = self.mapa_actual.direccion
                    mira = ((d == "derecha"   and ex == jx + 1 and ey == jy) or
                            (d == "izquierda" and ex == jx - 1 and ey == jy) or
                            (d == "abajo"     and ex == jx and ey == jy + 1) or
                            (d == "arriba"    and ex == jx and ey == jy - 1))
                    if mira:
                        self.entrenador_actual = ent
                        self.dialogo_entrenador = list(ent.dialogo_pre)
                        self.dialogo_entrenador_idx = 0
                        self.estado = "dialogo_entrenador"
                        self.estado_tras_entrenador = "batalla_entrenador"
                        return

    def _iniciar_evento_supay(self, ev):
        """Muestra diálogo y arranca el combate contra el Team Supay."""
        self._evento_supay_activo = ev
        self.dialogo_actual = list(ev.dialogos_intro)
        self.dialogo_hablante = "Recluta Supay"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "batalla_supay"

    def _lanzar_batalla_supay_real(self):
        if not self.equipo.pokemons:
            self.mensajes = ["¡No tienes Pokémon contigo!"]
            self.timer_mensajes = 1.8
            self.estado = "exploracion"
            return
        ev = self._evento_supay_activo
        if not ev:
            self.estado = "exploracion"
            return
        eq = ev.crear_equipo()
        if not eq:
            self.estado = "exploracion"
            return
        try:
            self._exp_vis = {}
            self._pausa_anim = 0.0
            self._mega_usada_batalla = False
            self._mega_animando = False
            self._mega_anim_t = 0.0
            self._anim_ataque_timer = 0.0
            self._anim_ataque_quien = None
            self._anim_ataque_duracion = 1.1
        except Exception:
            pass
        self.batalla_actual = Batalla(self.equipo.pokemons, eq[0])
        self.batalla_actual.sub_estado = "menu_principal"
        self.batalla_actual.es_gimnasio = True
        self.batalla_actual.rival_equipo = eq
        self.batalla_actual.rival_poke_idx = 0
        self.batalla_actual.es_rival = True
        self.batalla_actual.es_supay = True
        self.menu_batalla_idx = 0
        self.mensajes = [f"¡{ev.titulo}!"]
        self.timer_mensajes = 2.0
        self._iniciar_transicion_batalla()
        self.musica.fondo("batalla_supay")

    def _resolver_victoria_supay(self):
        ev = self._evento_supay_activo
        if not ev:
            return
        self.historia.completar_evento(ev.id)
        marcar_evento_completado(ev.ciudad)
        self.inventario.dinero += ev.recompensa
        self.dialogo_actual = list(ev.dialogos_derrota)
        self.dialogo_hablante = "Recluta Supay"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "exploracion"
        self._evento_supay_activo = None

    # --------- PORTERO DEL GIMNASIO ---------
    def _iniciar_portero(self, portero):
        self._portero_actual = portero
        if portero.puzzle_resuelto:
            # Solo el combate
            self.dialogo_actual = list(portero.dialogo_pre)
            self.dialogo_hablante = portero.nombre
            self.dialogo_idx = 0
            self.estado = "dialogo"
            self.siguiente_estado_tras_dialogo = "batalla_portero"
        else:
            # Primero el acertijo
            self._portero_fase = "pregunta"
            self._portero_idx = 0
            self.estado = "portero_puzzle"

    def _dibujar_portero_puzzle(self):
        overlay = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 180)); pantalla.blit(overlay, (0, 0))
        bx, by, bw, bh = 40, 110, ANCHO - 80, ALTO - 180
        pygame.draw.rect(pantalla, (32, 24, 40), (bx, by, bw, bh))
        pygame.draw.rect(pantalla, DORADO_LIGA, (bx, by, bw, bh), 3)

        p = self._portero_actual
        ac = p.acertijo

        tt = fuente_media.render(f"{p.nombre} te pregunta:", True, CREMA)
        pantalla.blit(tt, (bx + 20, by + 16))

        # Pregunta
        y = by + 50
        for ln in self._wrap_texto(ac["pregunta"], fuente_media, bw - 40):
            t = fuente_media.render(ln, True, AMARILLO_SOL)
            pantalla.blit(t, (bx + 20, y)); y += 26

        # Opciones
        y += 10
        for i, op in enumerate(ac["opciones"]):
            sel = (i == self._portero_idx)
            col = AMARILLO_SOL if sel else BLANCO
            rect_col = (80, 60, 100) if sel else (40, 30, 50)
            pygame.draw.rect(pantalla, rect_col, (bx + 40, y, bw - 80, 32))
            pygame.draw.rect(pantalla, col, (bx + 40, y, bw - 80, 32), 2)
            t = fuente_media.render(op, True, col)
            pantalla.blit(t, (bx + 60, y + 6))
            y += 40

        tt = fuente_peque.render("[↑/↓] Elegir  [X] Confirmar  [ESC] Salir",
                                 True, CREMA)
        pantalla.blit(tt, (ANCHO//2 - tt.get_width()//2, by + bh - 30))

    def _manejar_input_portero_puzzle(self, key):
        p = self._portero_actual
        if not p:
            self.estado = "exploracion"; return
        ac = p.acertijo
        if key == pygame.K_UP:
            self._portero_idx = (self._portero_idx - 1) % len(ac["opciones"])
        elif key == pygame.K_DOWN:
            self._portero_idx = (self._portero_idx + 1) % len(ac["opciones"])
        elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
            elegido = ac["opciones"][self._portero_idx]
            if elegido == ac["respuesta"]:
                p.puzzle_resuelto = True
                # Ahora el combate
                self.dialogo_actual = list(p.dialogo_pre)
                self.dialogo_hablante = p.nombre
                self.dialogo_idx = 0
                self.estado = "dialogo"
                self.siguiente_estado_tras_dialogo = "batalla_portero"
            else:
                self.mensajes = list(p.dialogo_puzzle_fail)
                self.timer_mensajes = 2.5
                self.estado = "exploracion"
                self._portero_actual = None
        elif key == pygame.K_ESCAPE:
            self.estado = "exploracion"
            self._portero_actual = None

    def _lanzar_batalla_portero(self):
        if not self.equipo.pokemons:
            self.mensajes = ["¡No tienes Pokémon contigo!"]
            self.timer_mensajes = 1.8
            self.estado = "exploracion"
            return
        p = self._portero_actual
        if not p:
            self.estado = "exploracion"
            return
        eq = p.crear_equipo()
        if not eq:
            self.estado = "exploracion"
            return
        self.batalla_actual = Batalla(self.equipo.pokemons, eq[0])
        self.batalla_actual.sub_estado = "menu_principal"
        self.batalla_actual.es_gimnasio = True
        self.batalla_actual.rival_equipo = eq
        self.batalla_actual.rival_poke_idx = 0
        self.batalla_actual.es_rival = True
        self.batalla_actual.es_portero = True
        self.menu_batalla_idx = 0
        self.mensajes = [f"¡{p.nombre} te reta!"]
        self.timer_mensajes = 2.0
        self._iniciar_transicion_batalla()
        self.musica.fondo("batalla_entrenador")

    def _check_entrenadores_adyacentes(self):
        """Si el jugador mira a un entrenador al terminar de caminar, lo reta."""
        jx, jy = self.mapa_actual.destino_x, self.mapa_actual.destino_y
        d = self.mapa_actual.direccion
        dx, dy = 0, 0
        if d == "arriba": dy = -1
        elif d == "abajo": dy = 1
        elif d == "izquierda": dx = -1
        elif d == "derecha": dx = 1
        fx, fy = jx + dx, jy + dy
        for ent in entrenadores_en(self.mapa_actual.id):
            if getattr(ent, "derrotado", False):
                continue
            if tuple(ent.posicion) == (fx, fy):
                # E4: verificar si este entrenador es parte de un Tag Team
                tag = obtener_tag_team(self.mapa_actual.id)
                if tag and (ent is tag.ent1 or ent is tag.ent2) and not tag.completado:
                    if ent is tag.ent1 and tag.batalla_idx == 0:
                        self._iniciar_tag_team(tag)
                        return
                    elif ent is tag.ent2 and tag.batalla_idx == 1:
                        self._iniciar_tag_team(tag)
                        return
                # Combate normal
                self.entrenador_actual = ent
                self.dialogo_entrenador = list(ent.dialogo_pre)
                self.dialogo_entrenador_idx = 0
                self.estado = "dialogo_entrenador"
                self.estado_tras_entrenador = "batalla_entrenador"
                return True
        return False
    def _resolver_victoria_portero(self):
        p = self._portero_actual
        if p:
            p.derrotado = True
            self.dialogo_actual = list(p.dialogo_derrota)
            self.dialogo_hablante = p.nombre
            self.dialogo_idx = 0
            self.estado = "dialogo"
            self.siguiente_estado_tras_dialogo = "exploracion"
            self._portero_actual = None

    def _limpiar_npcs_puertas(self):
        """Elimina NPCs que esten bloqueando puertas importantes."""
        try:
            from sistemas.mapa_visual import (PUERTA, GIMNASIO_POS, TAMBO_POS,
                                                TIENDA_POS, MapaVisual, CAMINABLES)
            from data.npcs import NPCS_DEFINIDOS

            # Recolectar posiciones criticas por mapa
            criticas = {}  # {mapa_id: set de (x,y)}
            for d in (GIMNASIO_POS, TAMBO_POS, TIENDA_POS):
                for mapa_id, pos in d.items():
                    if isinstance(pos, tuple) and len(pos) == 2:
                        if mapa_id not in criticas:
                            criticas[mapa_id] = set()
                        # La puerta + 2 tiles alrededor en cada direccion
                        for dx in range(-1, 2):
                            for dy in range(-1, 3):
                                criticas[mapa_id].add((pos[0] + dx, pos[1] + dy))

            npcs_a_borrar = []
            for i, npc in enumerate(NPCS_DEFINIDOS):
                pos = tuple(npc.pos)
                if npc.mapa in criticas and pos in criticas[npc.mapa]:
                    npcs_a_borrar.append(i)

            # Borrar de atras hacia adelante
            for i in sorted(npcs_a_borrar, reverse=True):
                npc = NPCS_DEFINIDOS[i]
                print(f"  [FIX-NPC] Removiendo {npc.nombre} de puerta en {npc.mapa}")
                NPCS_DEFINIDOS.pop(i)

            # Regenerar la lista NPCS publica
            try:
                from data import npcs as npcs_mod
                npcs_mod.NPCS = []
                for npc in npcs_mod.NPCS_DEFINIDOS:
                    npcs_mod.NPCS.append({
                        "nombre": npc.nombre, "mapa": npc.mapa,
                        "pos": npc.pos, "rol": npc.rol,
                        "dialogo": npc.dialogos.get(0, ["Hola."]),
                        "obtener_dialogo": npc.obtener_dialogo,
                    })
            except Exception:
                pass

            print(f"  [FIX-NPC] Total removidos: {len(npcs_a_borrar)}")
        except Exception as e:
            print(f"  [FIX-NPC] Error: {e}")

    def loop(self):
        # Limpiar NPCs en puertas al iniciar
        self._limpiar_npcs_puertas()
        while self.correr:
            dt = reloj.tick(60) / 1000.0
            self._last_dt = dt
            for e in pygame.event.get():
                if e.type == pygame.QUIT:
                    self.correr = False
                elif e.type == pygame.KEYDOWN:
                    self._manejar_input(e.key)

            # Movimiento continuo en exploración
            if self.estado == "exploracion" and not self.mapa_actual.moviendo:
                self._dibujar_exploracion(dt)
                # Auto-trigger: si terminamos un paso y hay trainer al frente
                self._check_entrenadores_adyacentes()
                keys = pygame.key.get_pressed()
                if keys[pygame.K_UP]:
                    self._procesar_movimiento(0, -1, "arriba")
                elif keys[pygame.K_DOWN]:
                    self._procesar_movimiento(0, 1, "abajo")
                elif keys[pygame.K_LEFT]:
                    self._procesar_movimiento(-1, 0, "izquierda")
                elif keys[pygame.K_RIGHT]:
                    self._procesar_movimiento(1, 0, "derecha")

            if self.timer_mensajes > 0: self.timer_mensajes -= dt
            self.anim_menu += dt
            try:
                if self.estado in ("exploracion", "dialogo", "menu_pausa", "interior"):
                    self._tiempo_juego = getattr(self, "_tiempo_juego", 0.0) + dt
            except Exception:
                pass
            self.clima.actualizar(dt)
            try:
                bioma_amb = getattr(self.mapa_actual, "bioma", "valle")
                es_noche_amb = False
                try:
                    es_noche_amb = self.tiempo.es_noche()
                except Exception:
                    pass
                clima_amb = "despejado"
                try:
                    clima_amb = self.tiempo.clima_actual
                except Exception:
                    pass
                self.ambiente.actualizar(
                    dt, bioma=bioma_amb, es_noche=es_noche_amb,
                    clima=clima_amb,
                    activo=(self.estado in ("exploracion", "dialogo", "menu_pausa", "interior")))
            except Exception:
                pass
            try:
                zona = getattr(self.mapa_actual, 'bioma', 'valle')
                self.tiempo.actualizar(dt, zona)
            except Exception:
                pass
            self.efectos.actualizar(dt)
            try:
                if self._mega_anim_t > 0:
                    self._mega_anim_t -= dt
                    if self._mega_anim_t <= 0:
                        self._mega_animando = False
            except Exception:
                pass
            # D6: chequear logros cada 3s
            try:
                self._chequeo_logros_t = getattr(self, "_chequeo_logros_t", 0.0) + dt
                if self._chequeo_logros_t >= 3.0:
                    self._chequeo_logros_t = 0.0
                    nuevos = self.logros.chequear(self)
                    if nuevos and self._logro_popup is None:
                        self._logro_popup = nuevos[0]
                        self._logro_popup_t = 3.5
                        try:
                            from sistemas.sonidos import Sonidos as SonAvz
                            SonAvz.victoria()
                        except Exception:
                            pass
                # Timer del popup
                if self._logro_popup_t > 0:
                    self._logro_popup_t -= dt
                    if self._logro_popup_t <= 0:
                        self._logro_popup = None
            except Exception:
                pass
            try:
                self._actualizar_fade(dt)
            except Exception:
                pass
            self.musica.actualizar(dt)
            self._actualizar_musica()
            # Actualizar MOs según medallas
            self.mos_desbloqueadas = mos_activas(self.gimnasios)

            # Cola de mensajes de batalla: avanza cada 0.7s.
            if self.batalla_msg_queue:
                self.batalla_msg_timer -= dt
                if self.batalla_msg_timer <= 0:
                    msg = self.batalla_msg_queue.pop(0)
                    self.mensajes = [msg]
                    self.batalla_msg_timer = 0.55
                    # A8-2 HOTFIX: animar al rival si su mensaje aparece
                    try:
                        if ("rival usó" in msg or "rival uso" in msg) and self.batalla_actual:
                            if not getattr(self, "_anim_ataque_quien", None):
                                mov_r = None
                                if self.batalla_actual.pokemon_salvaje.movimientos:
                                    mov_r = self.batalla_actual.pokemon_salvaje.movimientos[0]
                                tipo_r = getattr(mov_r, "tipo", "Normal") if mov_r else "Normal"
                                self._iniciar_anim_ataque("rival", tipo_r)
                    except Exception:
                        pass   # ← era 0.7

            # Efecto máquina de escribir para diálogos
            if self.estado == "dialogo" and self.dialogo_actual:
                if self.dialogo_idx < len(self.dialogo_actual):
                    txt = self.dialogo_actual[self.dialogo_idx]
                    if getattr(self, "_txt_cache", None) != txt:
                        self._txt_cache = txt
                        self.dialogo_char_idx = 0
                        self.dialogo_char_timer = 0.0
                    if self.dialogo_char_idx < len(txt):
                        self.dialogo_char_timer += dt
                        av = int(self.dialogo_char_timer * self.VELOCIDAD_TEXTO)
                        if av > 0:
                            self.dialogo_char_idx = min(len(txt), self.dialogo_char_idx + av)
                            self.dialogo_char_timer -= av / self.VELOCIDAD_TEXTO
            pantalla.fill(NEGRO)

            if key in (pygame.K_t, pygame.K_ESCAPE, pygame.K_BACKSPACE):
                self.estado = "exploracion"
                try:
                    Sonidos.reproducir_cancelar()
                except Exception:
                    pass
            return
            # C6: efecto flash verde al curar en Tambo
            try:
                if getattr(self, "_efecto_curado_timer", 0) > 0:
                    self._efecto_curado_timer -= dt
                    if self._efecto_curado_timer > 0:
                        alpha = int(80 * (self._efecto_curado_timer / 2.5))
                        ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
                        ov.fill((80, 240, 120, alpha))
                        pantalla.blit(ov, (0, 0))
            except Exception:
                pass

            try:
                self._dibujar_popup_logro()
            except Exception:
                pass
            try:
                self._dibujar_mega_anim()
            except Exception:
                pass

            try:
                if self.estado == "batalla":
                    self._vignette_batalla()
            except Exception:
                pass

            if self.estado == "menu_principal":
                self._dibujar_menu_principal()
            if self.estado == "menu_principal":
                self._dibujar_menu_principal()
            if self.estado == "menu_principal":
                self._dibujar_menu_principal()
            try:
                self._actualizar_hit_flashes(dt)
                self._dibujar_hit_flashes()
            except Exception:
                pass

            try:
                self._dibujar_crit_flash()
            except Exception:
                pass

            try:
                self._dibujar_banner_ef()
            except Exception:
                pass

            try:
                self._dibujar_mega_cine()
            except Exception:
                pass

            try:
                self._dibujar_aprender_reveal()
            except Exception:
                pass

            if self.estado == "menu_principal":
                self._dibujar_menu_principal()
            elif self.estado == "elegir_modo":
                self._dibujar_elegir_modo()
            elif self.estado == "menu_logros":
                try: self._dibujar_menu_logros_simple()
                except: pass
            elif self.estado == "intro":
                self._dibujar_intro(dt)
            elif self.estado == "creditos":
                self._dibujar_creditos(dt)
            elif self.estado == "vs_intro":
                self._dibujar_vs_intro(dt)
            elif self.estado == "safari":
                self._dibujar_safari()
            elif self.estado == "seleccion_slot":
                self._dibujar_seleccion_slot()
            elif self.estado == "dialogo":
                self._dibujar_dialogo()
            elif self.estado == "dialogo_entrenador":
                self._dibujar_dialogo_entrenador()
            elif self.estado == "seleccion_inicial":
                self._dibujar_seleccion_inicial()
            elif self.estado == "exploracion":
                self._dibujar_exploracion()
            elif self.estado == "menu_pausa":
                self._dibujar_exploracion()
                self._dibujar_menu_pausa()
            elif self.estado == "equipo_menu":
                self._dibujar_equipo_menu()
            elif self.estado == "transicion_batalla":
                self._dibujar_transicion_batalla(dt)
            elif self.estado == "batalla":
                self._dibujar_batalla(dt)
            elif self.estado == "inventario":
                self._dibujar_inventario()
            elif self.estado == "pc":
                self._dibujar_pc()
            elif self.estado == "pokedex":
                self._dibujar_pokedex()
            elif self.estado == "tarjeta":
                try: self._dibujar_trainer_card()
                except: pass
            elif self.estado == "logros":
                self._dibujar_logros()
            elif self.estado == "estadisticas":
                self._dibujar_estadisticas()
            elif self.estado == "chasqui_lista":
                self._dibujar_chasqui_lista()
            elif self.estado == "frente_menu":
                self._dibujar_frente_menu()
            elif self.estado == "danza_elegir":
                self._dibujar_danza_elegir()
            elif self.estado == "danza_resultado":
                self._dibujar_danza_resultado()
            elif self.estado == "base_menu":
                self._dibujar_base_menu()
            elif self.estado == "base_tienda":
                self._dibujar_base_tienda()
            elif self.estado == "base_decorar":
                self._dibujar_base_decorar()
            elif self.estado == "intercambio":
                self._dibujar_intercambio()
            elif self.estado == "admin_login":
                self._dibujar_admin_login()
            elif self.estado == "admin_panel":
                self._dibujar_admin_panel()

            pygame.display.flip()

        # ← el while termina AQUÍ (misma columna que "while", 8 espacios)

    # =====================================================================
    # ESCENA 4 DEL LORE: "El Primer Duelo (¡El Debut de Barrio entre Patas!)"
    # =====================================================================
    def _mostrar_dialogo_mateo(self):
        """Muestra la escena 4 del lore: Mateo reta al jugador (una sola vez)."""
        try:
            from data.rivales import RIVAL_AMISTOSO
        except Exception:
            self.estado = "exploracion"
            return
        self.dialogo_actual = RIVAL_AMISTOSO.dialogo("primer_reto")
        self.dialogo_hablante = "Mateo"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "primer_duelo"
        inicial_jugador = getattr(self, "inicial_jugador", "Alpaka")
        self._rival_actual = RIVAL_AMISTOSO
        self._rival_equipo_pendiente = RIVAL_AMISTOSO.crear_equipo(
            inicial_jugador, nivel_extra=0, extras=[("Cuy", 5)])

    def _lanzar_batalla_primer_duelo(self):
        """Arranca la batalla contra Mateo (después del diálogo)."""
        if not self.equipo.pokemons:
            self.mensajes = ["¡No tienes Pokémon contigo!"]
            self.timer_mensajes = 1.8
            self.estado = "exploracion"
            return
        eq = getattr(self, "_rival_equipo_pendiente", [])
        if not eq:
            self.estado = "exploracion"
            return
        self.batalla_actual = Batalla(self.equipo.pokemons, eq[0])
        self.batalla_actual.sub_estado = "menu_principal"
        self.batalla_actual.es_gimnasio = True
        self.batalla_actual.rival_equipo = eq
        self.batalla_actual.rival_poke_idx = 0
        self.batalla_actual.es_rival = True
        self.menu_batalla_idx = 0
        self.mensajes = [f"¡{self._rival_actual.nombre} te reta!"]
        self.timer_mensajes = 1.6
        self._iniciar_transicion_batalla()
        self.musica.fondo("batalla_entrenador")

    def _dibujar_primer_duelo(self):
        """Mientras está activo, mostramos una pantalla de espera breve
        y luego arrancamos la batalla contra Mateo."""
        # Si ya hay batalla en curso, delega al dibujante normal
        if self.batalla_actual is not None:
            self._dibujar_batalla()
            return

        # Pantalla simple de "aquí viene Mateo"
        pantalla.fill((140, 200, 120))
        pygame.draw.rect(pantalla, (32, 24, 40), (40, 200, ANCHO - 80, 90))
        pygame.draw.rect(pantalla, AMARILLO_SOL, (40, 200, ANCHO - 80, 90), 3)
        t1 = fuente_grande.render("¡Mateo te reta!", True, AMARILLO_SOL)
        t2 = fuente_media.render("Preparando la pichanga...", True, BLANCO)
        pantalla.blit(t1, (ANCHO//2 - t1.get_width()//2, 215))
        pantalla.blit(t2, (ANCHO//2 - t2.get_width()//2, 255))

        # Arrancar la batalla real
        eq = getattr(self, "_rival_equipo_pendiente", [])
        if not eq:
            self.estado = "exploracion"
            return
        self.batalla_actual = Batalla(self.equipo.pokemons, eq[0])
        self.batalla_actual.sub_estado = "menu_principal"
        self.batalla_actual.es_gimnasio = True
        self.batalla_actual.rival_equipo = eq
        self.batalla_actual.rival_poke_idx = 0
        self.batalla_actual.es_rival = True
        self.menu_batalla_idx = 0
        self.mensajes = [f"¡{self._rival_actual.nombre} te reta!"]
        self.timer_mensajes = 1.6
        self._iniciar_transicion_batalla()
        self.musica.fondo("batalla_entrenador")

    def _siguiente_poke_rival(self):
        b = self.batalla_actual
        eq = getattr(b, "rival_equipo", [])
        idx = getattr(b, "rival_poke_idx", 0) + 1
        if idx < len(eq):
            b.rival_poke_idx = idx
            b.pokemon_salvaje = eq[idx]
            b.sub_estado = "menu_principal"
        else:
            b.terminada = True
            b.resultado = "victoria"

    # ---------------------------------------------------------------------
    def _actualizar_musica(self):
        est = self.estado
        if est in ("menu_principal", "seleccion_slot"):
            self.musica.fondo("titulo")
        elif est == "seleccion_inicial":
            self.musica.fondo("caleta")
        elif est == "dialogo":
            self.musica.fondo("caleta")
        elif est == "exploracion":
            usa_noche = False
            try:
                usa_noche = self.tiempo.es_noche()
            except Exception:
                pass
            if usa_noche:
                self.musica.fondo(self._pista_nocturna())
            else:
                self.musica.fondo(self._pista_mapa())
        elif est == "batalla":
            self.musica.fondo(self._pista_batalla())
        elif est == "dialogo_gimnasio":
            self.musica.fondo(self._pista_mapa())
        elif est == "evento_historia":
            self.musica.fondo("batalla_supay")
        elif est == "evolucion":
            self.musica.fondo("evolucion")
        elif est == "liga":
            self.musica.fondo("batalla_liga")
        elif est == "tienda":
            self.musica.fondo("pueblo_sierra")
        elif est == "pc":
            self.musica.fondo("capital")
        elif est == "inventario":
            self.musica.fondo(self._pista_mapa())
        elif est == "pokedex":
            self.musica.fondo("capital")

    def _pista_nocturna(self):
        """Pista segun zona cuando es de noche."""
        try:
            d = getattr(self.mapa_actual, "bioma", "valle")
            if d == "selva":
                return "noche_selva"
            if d in ("sierra", "paramo", "altiplano"):
                return "noche_nieve"
            return "noche"
        except Exception:
            return "noche"

    def _pista_mapa(self):
        d = getattr(self.mapa_actual, "bioma", "valle")
        mid = self.mapa_actual.id
        if mid.startswith("ruta"):
            if d in ("costa",):       return "ruta_costa"
            if d in ("selva",):       return "ruta_selva"
            return "ruta_sierra"
        if mid == "caleta_norte":     return "caleta"
        if d == "costa":              return "pueblo_costa"
        if d == "selva":              return "pueblo_selva"
        if d == "capital":            return "capital"
        return "pueblo_sierra"

    def _pista_batalla(self):
        b = self.batalla_actual
        if b is None:                 return "batalla_salvaje"
        if getattr(b, "gimnasio_id", None): return "batalla_lider"
        if getattr(b, "es_gimnasio", False): return "batalla_entrenador"
        return "batalla_salvaje"
    # ---------------------------------------------------------------------

    def _manejar_input(self, key):
        if key in (pygame.K_F11, pygame.K_F4):
            pygame.display.toggle_fullscreen()
            return

        _block = ("admin_login", "admin_panel", "vs_intro", "creditos",
                  "elegir_nombre", "batalla", "batalla_yacumama",
                  "omega_batalla", "batalla_leyenda", "transicion_batalla")
        if key == pygame.K_a and self.estado not in _block:
            if getattr(self, "equipo", None) is not None and (
                    self.equipo.pokemons or
                    self.historia.evento_completado("evento_prologo") or
                    self.estado == "exploracion"):
                try:
                    self._admin_cargar_lista()
                    self._admin_menu_idx = 0
                    self._admin_poke_idx = 0
                    self._admin_modo = "lista"
                    self._admin_mensaje = "!Admin activado! (ESC para salir)"
                    self._admin_msg_t = 2.5
                    self._admin_volver_a = self.estado if self.estado in (
                        "exploracion", "menu_pausa", "interior") else "exploracion"
                    self.estado = "admin_panel"
                    return
                except Exception as e:
                    print("Error admin: " + str(e))

        if self.estado == "menu_principal":
            if key == pygame.K_UP:
                self.menu_principal_idx = (self.menu_principal_idx - 1) % 4
            elif key == pygame.K_DOWN:
                self.menu_principal_idx = (self.menu_principal_idx + 1) % 4
            elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                if self.menu_principal_idx == 0:
                    self.estado = "elegir_modo"
                    self.modo_idx = 0
                elif self.menu_principal_idx == 1:
                    self.estado = "seleccion_slot"
                    self.slot_idx = 0
                elif self.menu_principal_idx == 2:
                    self.estado = "menu_logros"
                else:
                    self.correr = False
            elif key == pygame.K_l:
                self._admin_pwd = ""
                self.estado = "admin_login"
            return

        if self.estado == "elegir_modo":
            if key == pygame.K_UP:
                self.modo_idx = max(0, self.modo_idx - 1)
            elif key == pygame.K_DOWN:
                self.modo_idx = min(1, self.modo_idx + 1)
            elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                self.nuzlocke_activo = (self.modo_idx == 1)
                self.nuzlocke_capturas_por_mapa = {}
                self.nuzlocke_muertos = []
                self._iniciar_intro()
            elif key == pygame.K_ESCAPE:
                self.estado = "menu_principal"
            return

        if self.estado == "menu_logros":
            if key in (pygame.K_ESCAPE, pygame.K_x, pygame.K_z):
                self.estado = "menu_principal"
            return

        if self.estado == "intro":
            if key in (pygame.K_RETURN, pygame.K_x, pygame.K_z, pygame.K_SPACE, pygame.K_ESCAPE):
                self._nueva_partida()
                self._intro_timer = 0.0
            return

        if self.estado == "creditos":
            if key in (pygame.K_RETURN, pygame.K_x, pygame.K_z, pygame.K_SPACE, pygame.K_ESCAPE):
                self._creditos_activos = False
                self._creditos_t = 0.0
                self.estado = "menu_principal"
                self.menu_principal_idx = 0
            return

        if self.estado == "seleccion_slot":
            if key == pygame.K_UP:
                self.slot_idx = max(0, self.slot_idx - 1)
            elif key == pygame.K_DOWN:
                self.slot_idx = min(2, self.slot_idx + 1)
            elif key in (pygame.K_RETURN, pygame.K_x):
                if existe_guardado(self.slot_idx + 1):
                    if cargar_partida(self, self.slot_idx + 1):
                        self.estado = "exploracion"
                        self.mensajes = ["Partida cargada!"]
                        self.timer_mensajes = 2.0
                else:
                    self.mensajes = ["No hay guardado aqui."]
                    self.timer_mensajes = 1.5
            elif key == pygame.K_ESCAPE:
                self.estado = "menu_principal"
            return

        if self.estado == "admin_login":
            if key == pygame.K_RETURN:
                if self._admin_pwd == self._admin_pwd_correcta:
                    self._admin_cargar_lista()
                    self._admin_poke_idx = 0
                    self._admin_modo = "lista"
                    self._admin_mensaje = "Bienvenido, admin!"
                    self._admin_msg_t = 2.0
                    self.estado = "admin_panel"
                else:
                    self._admin_mensaje = "Contrasena incorrecta."
                    self._admin_msg_t = 2.0
                    self._admin_pwd = ""
            elif key == pygame.K_BACKSPACE:
                self._admin_pwd = self._admin_pwd[:-1]
            elif key == pygame.K_ESCAPE:
                self._admin_pwd = ""
                self.estado = "menu_principal"
            else:
                try:
                    ch = pygame.key.name(key)
                except Exception:
                    ch = ""
                if len(ch) == 1 and ch.isprintable():
                    self._admin_pwd += ch
            return

        if self.estado == "admin_panel":
            if key == pygame.K_ESCAPE:
                va = getattr(self, "_admin_volver_a", "menu_principal")
                self.estado = va if va else "menu_principal"
                self._admin_volver_a = None
            elif self._admin_modo == "lista":
                if key == pygame.K_UP:
                    self._admin_poke_idx = max(0, self._admin_poke_idx - 1)
                elif key == pygame.K_DOWN:
                    n = len(self._admin_poke_lista)
                    if n > 0:
                        self._admin_poke_idx = min(n - 1, self._admin_poke_idx + 1)
                elif key == pygame.K_LEFT:
                    self._admin_nivel = max(1, self._admin_nivel - 1)
                elif key == pygame.K_RIGHT:
                    self._admin_nivel = min(100, self._admin_nivel + 1)
                elif key == pygame.K_MINUS:
                    self._admin_nivel = max(1, self._admin_nivel - 10)
                elif key in (pygame.K_EQUALS, pygame.K_PLUS, pygame.K_KP_PLUS):
                    self._admin_nivel = min(100, self._admin_nivel + 10)
                elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                    self._admin_add_pokemon()
                elif key == pygame.K_h:
                    for p in self.equipo.pokemons:
                        p.ps = p.ps_max
                        p.estado = None
                        p.confundido_turnos = 0
                    self._admin_mensaje = "Equipo curado!"
                    self._admin_msg_t = 2.0
                elif key == pygame.K_c:
                    self.inventario.dinero += 100000
                    self._admin_mensaje = "+100000 soles!"
                    self._admin_msg_t = 2.0
                elif key == pygame.K_v:
                    for p in self.equipo.pokemons:
                        p.nivel = 100
                        if hasattr(p, "_calcular_stats"):
                            p._calcular_stats()
                        elif hasattr(p, "_calc_stats"):
                            p._calc_stats()
                        p.ps = p.ps_max
                    self._admin_mensaje = "Equipo nivel 100!"
                    self._admin_msg_t = 2.0
            return

        if self.estado == "tarjeta":
            if key in (pygame.K_f, pygame.K_ESCAPE, pygame.K_RETURN, pygame.K_x, pygame.K_t):
                self.estado = "menu_pausa"
            return

        if self.estado == "menu_pausa":
            try:
                self._manejar_input_menu_pausa(key)
            except Exception as e:
                print("Error menu_pausa: " + str(e))
            return

        if self.estado == "equipo_menu":
            try:
                self._manejar_input_equipo(key)
            except Exception as e:
                print("Error equipo_menu: " + str(e))
            return

        if self.estado == "transicion_batalla":
            if key in (pygame.K_RETURN, pygame.K_x, pygame.K_z, pygame.K_SPACE):
                self._trans_timer = 999.0
            return

        if self.estado == "vs_intro":
            if key in (pygame.K_RETURN, pygame.K_x, pygame.K_z, pygame.K_SPACE):
                self._vs_intro_timer = 999.0
            return

        if self.estado == "safari":
            if key == pygame.K_z:
                self.safari.cambiar_zona()
                self.timer_mensajes = 1.5
            elif key == pygame.K_ESCAPE:
                self._salir_safari()
            elif key in (pygame.K_UP, pygame.K_DOWN, pygame.K_LEFT, pygame.K_RIGHT):
                self._safari_caminar()
            return

        if self.estado == "dialogo":
            if key in (pygame.K_RETURN, pygame.K_x, pygame.K_z, pygame.K_SPACE):
                txt = ""
                if self.dialogo_actual and self.dialogo_idx < len(self.dialogo_actual):
                    txt = self.dialogo_actual[self.dialogo_idx]
                if self.dialogo_char_idx < len(txt):
                    self.dialogo_char_idx = len(txt)
                    self.dialogo_char_timer = 0.0
                else:
                    self.dialogo_idx += 1
                    self.dialogo_char_idx = 0
                    self.dialogo_char_timer = 0.0
                    self._txt_cache = None
                    if self.dialogo_idx >= len(self.dialogo_actual):
                        sig = self.siguiente_estado_tras_dialogo
                        self.dialogo_actual = None
                        self.dialogo_idx = 0
                        self.dialogo_hablante = None
                        self.siguiente_estado_tras_dialogo = None
                        if sig == "preguntar_nombre":
                            self.dialogo_actual = ["Como te llamas?"]
                            self.dialogo_hablante = "Prof. Kuntur"
                            self.dialogo_idx = 0
                            self.estado = "dialogo"
                            self.siguiente_estado_tras_dialogo = "elegir_nombre"
                        elif sig == "chasqui_batalla":
                            try:
                                self._lanzar_batalla_chasqui()
                            except Exception:
                                self.estado = "exploracion"
                        elif sig == "batalla_supay":
                            self._lanzar_batalla_supay()
                        elif sig == "batalla_portero":
                            self._lanzar_batalla_portero()
                        elif sig == "elegir_nombre":
                            self.nombre_input = ""
                            self.estado = "elegir_nombre"
                        elif sig == "dialogo_mateo":
                            self._mostrar_dialogo_mateo()
                        elif sig == "primer_duelo":
                            self._lanzar_batalla_primer_duelo()
                        elif sig == "escena_supay":
                            self._mostrar_escena_supay()
                        elif sig == "tag_team_batalla":
                            self._iniciar_batalla_tag_team()
                        elif sig == "omega_batalla":
                            self._lanzar_batalla_omega()
                        elif sig == "batalla_yacumama":
                            self._lanzar_batalla_yacumama()
                        elif sig == "batalla_leyenda":
                            self._lanzar_batalla_leyenda()
                        elif sig:
                            self.estado = sig
                        else:
                            self.estado = "exploracion"
            return

        if self.estado == "dialogo_entrenador":
            if key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                self.dialogo_entrenador_idx += 1
                if self.dialogo_entrenador_idx >= len(self.dialogo_entrenador):
                    sig = self.estado_tras_entrenador
                    self.dialogo_entrenador = None
                    if sig == "batalla_entrenador":
                        self._iniciar_batalla_entrenador()
                    else:
                        self.estado = "exploracion"
            return

        if self.estado == "seleccion_inicial":
            if key == pygame.K_LEFT:
                self.inicial_idx = (self.inicial_idx - 1) % 3
            elif key == pygame.K_RIGHT:
                self.inicial_idx = (self.inicial_idx + 1) % 3
            elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                nombre = self.iniciales[self.inicial_idx]
                if not getattr(self, "nombre_jugador", None):
                    self.nombre_jugador = "Freekie"
                datos = POKEDEX_COMPLETA.get(nombre)
                if datos:
                    self.equipo.agregar(PokemonBatalla(datos, 5))
                    self.pokedex.registrar_capturado(nombre)
                self.inicial_jugador = nombre
                self.dialogo_actual = DIALOGOS_PROFESOR.get(
                    "primer_encuentro", ["Buena suerte!"])
                self.dialogo_hablante = "Prof. Kuntur"
                self.dialogo_idx = 0
                self.estado = "dialogo"
                self.siguiente_estado_tras_dialogo = "primer_duelo"
            return

        if self.estado == "elegir_nombre":
            if key == pygame.K_RETURN:
                if 2 <= len(self.nombre_input) <= 10:
                    self.nombre_jugador = self.nombre_input
                    self._txt_cache = None
                    self.estado = "seleccion_inicial"
                    self.inicial_idx = 0
            elif key == pygame.K_BACKSPACE:
                self.nombre_input = self.nombre_input[:-1]
            else:
                try:
                    ch = pygame.key.name(key)
                except Exception:
                    ch = ""
                if len(ch) == 1 and ch.isprintable() and len(self.nombre_input) < 10:
                    if pygame.key.get_mods() & pygame.KMOD_SHIFT:
                        ch = ch.upper()
                    self.nombre_input += ch
            return

        if self.estado == "exploracion":
            if key == pygame.K_f:
                self.estado = "menu_pausa"
                self.menu_pausa_idx = 0
            elif key == pygame.K_i:
                self.estado = "inventario"
                self.inv_idx = 0
            elif key == pygame.K_p:
                self.estado = "pc"
                self.pc_modo = "ver"
                self.pc_idx = 0
            elif key == pygame.K_d:
                self.estado = "pokedex"
                self.pokedex_idx = 0
                self.pokedex_detalle = None
            elif key == pygame.K_t:
                self.estado = "tarjeta"
            elif key == pygame.K_x:
                self._interactuar()
            elif key == pygame.K_h:
                for p in self.equipo.pokemons:
                    p.ps = p.ps_max
                self.mensajes = ["Equipo curado!"]
                self.timer_mensajes = 1.2
            elif key == pygame.K_s:
                if guardar_partida(self, 1):
                    self.mensajes = ["Partida guardada!"]
                    self.timer_mensajes = 1.5
            elif key == pygame.K_l:
                if self.liga.puede_desafiar(self.gimnasios):
                    self._iniciar_liga()
                else:
                    self.mensajes = ["Medallas: " + str(self.gimnasios.cantidad_medallas()) + "/8"]
                    self.timer_mensajes = 2.0
            elif key == pygame.K_m:
                self.musica.alternar()
                self.mensajes = ["Musica " + ("OFF" if self.musica.silenciada else "ON")]
                self.timer_mensajes = 1.0
            elif key == pygame.K_ESCAPE:
                self.estado = "menu_principal"
                self.menu_principal_idx = 0
            return

        if self.estado == "batalla":
            try:
                self._manejar_input_batalla(key)
            except Exception as e:
                print("Error batalla: " + str(e))
            return

        if self.estado == "interior":
            try:
                self._manejar_input_interior(key)
            except Exception:
                pass
            return

        if self.estado == "inventario":
            if key in (pygame.K_i, pygame.K_ESCAPE, pygame.K_f):
                self.estado = "exploracion"
            elif key == pygame.K_UP:
                self.inv_idx = max(0, getattr(self, "inv_idx", 0) - 1)
            elif key == pygame.K_DOWN:
                lista = self.inventario.obtener_lista()
                self.inv_idx = min(max(0, len(lista) - 1),
                                   getattr(self, "inv_idx", 0) + 1)
            elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                lista = self.inventario.obtener_lista()
                idx = getattr(self, "inv_idx", 0)
                if 0 <= idx < len(lista):
                    obj, cant = lista[idx]
                    if getattr(obj, "tipo", "") == "curacion" and self.equipo.pokemons:
                        p = self.equipo.pokemons[0]
                        p.ps = p.ps_max
                        self.inventario.remover(obj.nombre, 1)
                        self.mensajes = [p.nombre + " curado"]
                        self.timer_mensajes = 1.5
            return

        if self.estado == "pc":
            try:
                self._manejar_input_pc(key)
            except Exception:
                pass
            return
        if self.estado == "tienda":
            try:
                self._manejar_input_tienda(key)
            except Exception:
                pass
            return
        if self.estado == "liga":
            try:
                self._manejar_input_liga(key)
            except Exception:
                pass
            return
        if self.estado == "pokedex":
            try:
                self._manejar_input_pokedex(key)
            except Exception:
                pass
            return

        if self.estado == "dialogo_gimnasio":
            if key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                if self.gimnasio_actual and not getattr(self.gimnasio_actual.lider, "derrotado", False):
                    self._iniciar_batalla_gimnasio()
                else:
                    self.estado = "exploracion"
            elif key == pygame.K_ESCAPE:
                self.estado = "exploracion"
            return

        if self.estado == "evolucion":
            if key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                self._confirmar_evolucion()
            elif key == pygame.K_n:
                self.estado = "exploracion"
                self.pokemon_evolucionar = None
                self.evolucion_resultado = None
            return

        if self.estado == "evento_historia":
            if key in (pygame.K_RETURN, pygame.K_x, pygame.K_z, pygame.K_SPACE):
                self.dialogo_idx += 1
                if self.evento_actual and self.dialogo_idx >= len(self.evento_actual.dialogos):
                    self.historia.completar_evento(self.evento_actual.id)
                    self.evento_actual = None
                    self.estado = "exploracion"
            return

        if self.estado == "logros":
            if key in (pygame.K_f, pygame.K_ESCAPE, pygame.K_RETURN, pygame.K_x):
                self.estado = "menu_pausa"
            return
        if self.estado == "estadisticas":
            if key in (pygame.K_f, pygame.K_ESCAPE, pygame.K_RETURN, pygame.K_x):
                self.estado = "menu_pausa"
            return

        if self.estado == "chasqui_lista":
            if key == pygame.K_UP:
                self.chasqui_idx = max(0, self.chasqui_idx - 1)
            elif key == pygame.K_DOWN:
                n = len(self.chasqui_lista)
                if n > 0:
                    self.chasqui_idx = min(n - 1, self.chasqui_idx + 1)
            elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                self._iniciar_chasqui_batalla()
            elif key in (pygame.K_ESCAPE, pygame.K_f):
                self.estado = "menu_pausa"
            return

        if self.estado == "frente_menu":
            if key == pygame.K_UP:
                self.frente_menu_idx = max(0, self.frente_menu_idx - 1)
            elif key == pygame.K_DOWN:
                self.frente_menu_idx = min(2, self.frente_menu_idx + 1)
            elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                torres = ["condor", "serpiente", "sol"]
                self._iniciar_frente_torre(torres[self.frente_menu_idx])
            elif key in (pygame.K_ESCAPE, pygame.K_f):
                self.estado = "menu_pausa"
            return

        if self.estado == "danza_elegir":
            n = len(self.equipo.pokemons)
            if key == pygame.K_UP and n > 0:
                self.danza_pokemon_idx = (self.danza_pokemon_idx - 1) % n
            elif key == pygame.K_DOWN and n > 0:
                self.danza_pokemon_idx = (self.danza_pokemon_idx + 1) % n
            elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                self._iniciar_danza()
            elif key in (pygame.K_ESCAPE, pygame.K_f):
                self.estado = "menu_pausa"
            return
        if self.estado == "danza_resultado":
            if key in (pygame.K_RETURN, pygame.K_x, pygame.K_z, pygame.K_ESCAPE):
                self.danza_resultado = None
                self.estado = "menu_pausa"
            return

        if self.estado == "base_menu":
            if key == pygame.K_ESCAPE:
                self.estado = "exploracion"
                self.bases.base_actual = None
            return

        if self.estado == "tag_team_batalla":
            self._iniciar_batalla_tag_team()
            return
        if self.estado == "omega_batalla":
            self._lanzar_batalla_omega()
            return
        if self.estado == "batalla_yacumama":
            self._lanzar_batalla_yacumama()
            return
        if self.estado == "batalla_leyenda":
            self._lanzar_batalla_leyenda()
            return

        if key == pygame.K_ESCAPE:
            self.estado = "exploracion"

    def _manejar_input_batalla(self, key):
        if not self.batalla_actual:
            return

        # Si hay cola de mensajes, esperar a que termine (excepto terminada)
        if self.batalla_msg_queue and not self.batalla_actual.terminada:
            return

        if self.batalla_actual.terminada:
            if self.batalla_msg_queue:
                return
            # Primero, aprendizajes pendientes
            if self._aprendizajes_pendientes:
                self._procesar_siguiente_aprendizaje()
                return
            if key in (pygame.K_RETURN, pygame.K_x, pygame.K_z, pygame.K_SPACE):
                self._finalizar_batalla()
            return

        # E8: tecla M para Mega Evolucion
        if key == pygame.K_m:
            self._intentar_mega_evolucion()
            return

        if self.batalla_actual.sub_estado == "menu_principal":
            if key == pygame.K_UP:
                self.menu_batalla_idx = (self.menu_batalla_idx - 1) % 5
            elif key == pygame.K_DOWN:
                self.menu_batalla_idx = (self.menu_batalla_idx + 1) % 5
            elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                if self.menu_batalla_idx == 0:
                    self.batalla_actual.sub_estado = "menu_movimientos"
                    self.menu_mov_idx = 0
                elif self.menu_batalla_idx == 1:
                    self.batalla_actual.sub_estado = "menu_cambiar"
                    self.menu_cambiar_idx = 0
                elif self.menu_batalla_idx == 2:
                    self.batalla_actual.sub_estado = "menu_objetos"
                    self.menu_objetos_idx = 0
                elif self.menu_batalla_idx == 3:
                    self._intentar_captura()
                elif self.menu_batalla_idx == 4:
                    exito, msg = self.batalla_actual.intentar_huir()
                    self.mensajes = [msg]
                    self.timer_mensajes = 1.5
                    if exito:
                        self.batalla_actual = None
                        self.batalla_msg_queue = []
                        self.estado = "exploracion"

        elif self.batalla_actual.sub_estado == "menu_cambiar":
            eq = self.equipo.pokemons
            if not eq:
                self.batalla_actual.sub_estado = "menu_principal"
                return
            if key == pygame.K_UP:
                self.menu_cambiar_idx = (self.menu_cambiar_idx - 1) % len(eq)
            elif key == pygame.K_DOWN:
                self.menu_cambiar_idx = (self.menu_cambiar_idx + 1) % len(eq)
            elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                nuevo = eq[self.menu_cambiar_idx]
                if not nuevo.esta_vivo():
                    self.mensajes = ["¡Ese Pokémon está debilitado!"]
                    self.timer_mensajes = 1.2
                elif nuevo is self.batalla_actual.pokemon_activo_jugador:
                    self.mensajes = ["Ya está en combate."]
                    self.timer_mensajes = 1.2
                else:
                    self.batalla_actual.pokemon_activo_jugador = nuevo
                    self.mensajes = [f"¡Adelante, {nuevo.nombre}!"]
                    self.timer_mensajes = 1.2
                    if self.batalla_actual.pokemon_salvaje.esta_vivo():
                        msgs_rival = self.batalla_actual._ejecutar_ataque_rival()
                        self.batalla_msg_queue = list(msgs_rival)
                        self.batalla_msg_timer = 0.4
                    self.batalla_actual.sub_estado = "menu_principal"
                    self.menu_batalla_idx = 0
            elif key == pygame.K_ESCAPE:
                self.batalla_actual.sub_estado = "menu_principal"

        elif self.batalla_actual.sub_estado == "menu_objetos":
            pociones = [n for n in self.inventario.objetos
                        if self.inventario.objetos[n]["objeto"].tipo == "curacion"]
            if not pociones:
                self.mensajes = ["¡No tienes objetos!"]
                self.timer_mensajes = 1.2
                self.batalla_actual.sub_estado = "menu_principal"
                return
            if key == pygame.K_UP:
                self.menu_objetos_idx = (self.menu_objetos_idx - 1) % len(pociones)
            elif key == pygame.K_DOWN:
                self.menu_objetos_idx = (self.menu_objetos_idx + 1) % len(pociones)
            elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
                nombre_obj = pociones[self.menu_objetos_idx]
                p = self.batalla_actual.pokemon_activo_jugador
                curas = {"Pocion": 20, "Superpocion": 50,
                         "Hiperpocion": 200, "Maxipocion": 9999,
                         "Agua de Florida": 50, "Supermiel Andina": 9999}
                cantidad = curas.get(nombre_obj, 20)
                p.curar(cantidad)
                self.inventario.remover(nombre_obj, 1)
                self.mensajes = [f"¡{p.nombre} recuperó PS!"]
                self.timer_mensajes = 1.2
                self.batalla_actual.sub_estado = "menu_principal"
            elif key == pygame.K_ESCAPE:
                self.batalla_actual.sub_estado = "menu_principal"

        elif self.batalla_actual.sub_estado == "menu_movimientos":
            try:
                self._dibujar_caja_movimientos(jugador)
            except Exception:
                pass
    def _manejar_input_pc(self, key):
        if self.pc_modo == "ver":
            if key == pygame.K_UP:   self.pc_caja_actual = max(0, self.pc_caja_actual - 1)
            elif key == pygame.K_DOWN: self.pc_caja_actual = min(29, self.pc_caja_actual + 1)
            elif key in (pygame.K_RETURN, pygame.K_x):
                self.pc_modo = "retirar"; self.pc_idx = 0
            elif key == pygame.K_g:
                if len(self.equipo.pokemons) > 1:
                    self.pc_modo = "guardar"; self.pc_idx = 0
            elif key in (pygame.K_ESCAPE, pygame.K_p): self.estado = "exploracion"
        elif self.pc_modo == "retirar":
            caja = self.pc.obtener_lista_caja(self.pc_caja_actual)
            if caja:
                if   key == pygame.K_UP:   self.pc_idx = max(0, self.pc_idx - 1)
                elif key == pygame.K_DOWN: self.pc_idx = min(len(caja)-1, self.pc_idx + 1)
                elif key in (pygame.K_RETURN, pygame.K_x):
                    if len(self.equipo.pokemons) < 6:
                        p = self.pc.obtener_pokemon(self.pc_caja_actual, self.pc_idx)
                        if p: self.equipo.agregar(p)
                elif key == pygame.K_ESCAPE: self.pc_modo = "ver"
            else:
                if key == pygame.K_ESCAPE: self.pc_modo = "ver"
        elif self.pc_modo == "guardar":
            if   key == pygame.K_UP:   self.pc_idx = max(0, self.pc_idx - 1)
            elif key == pygame.K_DOWN: self.pc_idx = min(len(self.equipo.pokemons)-1, self.pc_idx + 1)
            elif key in (pygame.K_RETURN, pygame.K_x):
                if len(self.equipo.pokemons) > 1:
                    p = self.equipo.remover(self.pc_idx)
                    if p and not self.pc.guardar_pokemon(p):
                        self.equipo.agregar(p)
            elif key == pygame.K_ESCAPE: self.pc_modo = "ver"

    def _manejar_input_tienda(self, key):
        if not self.tienda_actual: return
        prods = self.tienda_actual.obtener_lista_compra()
        if   key == pygame.K_UP:   self.tienda_idx = max(0, self.tienda_idx - 1)
        elif key == pygame.K_DOWN: self.tienda_idx = min(len(prods)-1, self.tienda_idx + 1)
        elif key in (pygame.K_RETURN, pygame.K_x):
            nombre, obj, precio = prods[self.tienda_idx]
            if self.inventario.dinero >= precio:
                self.inventario.dinero -= precio
                self.inventario.agregar(obj, 1)
                self.mensajes = [f"Compraste {nombre}"]; self.timer_mensajes = 1.5
            else:
                self.mensajes = ["¡Sin Soles!"]; self.timer_mensajes = 1.5
        elif key == pygame.K_ESCAPE:
            self.estado = "exploracion"; self.tienda_actual = None

    def _manejar_input_liga(self, key):
        if not self.liga_oponente_actual: return
        if self.batalla_actual and not self.batalla_actual.terminada:
            self._manejar_input_batalla(key)

    def _lista_pokedex_filtrada(self):
        lista = self.pokedex.obtener_lista_completa()
        f = getattr(self, "pokedex_filtro", "todos")
        if f == "capturados":
            lista = [p for p in lista if p["estado"] == "✓"]
        elif f == "vistos":
            lista = [p for p in lista if p["estado"] in ("✓", "○")]
        elif f == "pendientes":
            lista = [p for p in lista if p["estado"] == "—"]
        orden = getattr(self, "pokedex_orden", "id")
        if orden == "nombre":
            lista = sorted(lista, key=lambda x: x["nombre"])
        else:
            lista = sorted(lista, key=lambda x: x["id"])
        return lista

    def _manejar_input_pokedex(self, key):
        if self.pokedex_detalle:
            if key in (pygame.K_ESCAPE, pygame.K_d): self.pokedex_detalle = None
            elif key == pygame.K_LEFT:
                lista = self._lista_pokedex_filtrada()
                if lista:
                    i = next((j for j,p in enumerate(lista) if p["id"] == self.pokedex_detalle["id"]), 0)
                    self.pokedex_detalle = lista[max(0, i-1)]
            elif key == pygame.K_RIGHT:
                lista = self._lista_pokedex_filtrada()
                if lista:
                    i = next((j for j,p in enumerate(lista) if p["id"] == self.pokedex_detalle["id"]), 0)
                    self.pokedex_detalle = lista[min(len(lista)-1, i+1)]
        else:
            lista = self._lista_pokedex_filtrada()
            if   key == pygame.K_UP:   self.pokedex_idx = max(0, self.pokedex_idx - 1)
            elif key == pygame.K_DOWN: self.pokedex_idx = min(max(0, len(lista)-1), self.pokedex_idx + 1)
            elif key == pygame.K_TAB:
                f = getattr(self, "pokedex_filtro", "todos")
                ciclo = ["todos", "capturados", "vistos", "pendientes"]
                self.pokedex_filtro = ciclo[(ciclo.index(f) + 1) % len(ciclo)]
                self.pokedex_idx = 0
            elif key == pygame.K_o:
                self.pokedex_orden = "nombre" if self.pokedex_orden == "id" else "id"
                self.pokedex_idx = 0
            elif key in (pygame.K_RETURN, pygame.K_x):
                if lista: self.pokedex_detalle = lista[self.pokedex_idx]
            elif key in (pygame.K_ESCAPE, pygame.K_d): self.estado = "exploracion"

    # ---------------------------------------------------------------------
    def _tile_frente(self):
        d = self.mapa_actual.direccion
        x, y = self.mapa_actual.destino_x, self.mapa_actual.destino_y
        if d == "arriba":    y -= 1
        elif d == "abajo":   y += 1
        elif d == "izquierda": x -= 1
        elif d == "derecha": x += 1
        return (x, y)

    # =====================================================================
    # SISTEMA DE CUEVAS
    # =====================================================================
    def _entrar_cueva(self, mapa_origen):
        """Entra a una cueva asociada al mapa actual."""
        from sistemas.cuevas import generar_cueva, CUEVAS

        # Mapeo de mapa → cueva
        mapa_a_cueva = {
            "ruta_2": "cueva_ruta2",
            "ruta_3": "cueva_ruta3",
            "ruta_4": "cueva_ruta4",
            "ruta_5": "cueva_ruta5",
            "ruta_7": "cueva_ruta7",
        }
        id_cueva = mapa_a_cueva.get(mapa_origen)
        if not id_cueva:
            self.mensajes = ["Esta entrada está sellada."]
            self.timer_mensajes = 1.5
            return

        cueva = generar_cueva(id_cueva)
        if not cueva:
            self.mensajes = ["La cueva está bloqueada."]
            self.timer_mensajes = 1.5
            return

        self._cueva_actual = cueva
        self._piso_cueva = 0
        self._pos_origen_cueva = (mapa_origen, self.mapa_actual.destino_x,
                                   self.mapa_actual.destino_y)

        # Crea un "mapa virtual" con los tiles del piso 0
        self._cargar_piso_cueva(0)
        self.mensajes = [f"Entraste a {cueva['nombre']}"]
        self.timer_mensajes = 2.5

    def _cargar_piso_cueva(self, idx_piso):
        """Carga el piso idx_piso de la cueva actual."""
        if self._cueva_actual is None:
            return
        piso = self._cueva_actual["pisos"][idx_piso]
        # Reemplaza el mapa visual por uno de cueva
        from sistemas.mapa_visual import MapaVisual
        mv = MapaVisual.__new__(MapaVisual)  # sin __init__ normal
        mv.id = f"cueva_{self._cueva_actual['id']}_p{idx_piso}"
        mv.bioma = self._cueva_actual["bioma"]
        mv.tiles = [row[:] for row in piso["tiles"]]
        mv.alto = piso["h"]
        mv.ancho = piso["w"]
        mv.transiciones = {}
        mv.pos_x, mv.pos_y = 3.0, 3.0
        mv.destino_x, mv.destino_y = 3, 3
        mv.moviendo = False
        # Buscar un tile caminable cercano al centro
        try:
            encontrado = False
            for y in range(mv.alto):
                for x in range(mv.ancho):
                    if mv.tiles[y][x] in (31,):  # CUEVA_PISO
                        mv.pos_x, mv.pos_y = float(x), float(y)
                        mv.destino_x, mv.destino_y = x, y
                        encontrado = True
                        break
                if encontrado:
                    break
        except Exception:
            pass
        mv.direccion = "abajo"
        mv.anim_pasos = 0.0
        mv.anim_agua = 0.0
        mv.anim_global = 0.0
        mv.salto_pendiente = None
        mv.zonas_hierba = set()
        mv._var = [[(x*7+y*13)%5 for x in range(mv.ancho)] for y in range(mv.alto)]
        mv._escala_jugador = {}
        # Encuentra un tile caminable para colocar al jugador
        for y in range(mv.alto):
            for x in range(mv.ancho):
                if mv.tiles[y][x] in (31,):  # CUEVA_PISO
                    mv.pos_x, mv.pos_y = float(x), float(y)
                    mv.destino_x, mv.destino_y = x, y
                    break
            else:
                continue
            break

        self.mapa_actual = mv
        self._piso_cueva = idx_piso

    def _cambiar_piso_cueva(self, tx, ty):
        """Sube o baja de piso según la escalera pisada."""
        if self._cueva_actual is None:
            return
        piso_actual = self._cueva_actual["pisos"][self._piso_cueva]

        # ¿Es la escalera para bajar?
        if piso_actual.get("escalera_abajo") == (tx, ty):
            if self._piso_cueva + 1 < self._cueva_actual["num_pisos"]:
                self._cargar_piso_cueva(self._piso_cueva + 1)
                self.mensajes = [f"Bajaste al piso {self._piso_cueva + 1}"]
                self.timer_mensajes = 1.5
            return

        # ¿Es la escalera para subir?
        if piso_actual.get("escalera_arriba") == (tx, ty):
            if self._piso_cueva > 0:
                self._cargar_piso_cueva(self._piso_cueva - 1)
                self.mensajes = [f"Subiste al piso {self._piso_cueva + 1}"]
                self.timer_mensajes = 1.5
            else:
                # Estamos en el piso 0 → salimos de la cueva
                self._salir_cueva()
            return

    def _salir_cueva(self):
        """Sale de la cueva y vuelve al mapa de origen."""
        from sistemas.mapa_visual import MapaVisual
        if self._pos_origen_cueva:
            mapa_origen, px, py = self._pos_origen_cueva
            self.mapa_actual = MapaVisual(mapa_origen)
            self.mapa_actual.destino_x = px
            self.mapa_actual.destino_y = py
            self.mapa_actual.pos_x = float(px)
            self.mapa_actual.pos_y = float(py)
        self._cueva_actual = None
        self._piso_cueva = 0
        self._pos_origen_cueva = None
        self.mensajes = ["Saliste de la cueva."]
        self.timer_mensajes = 1.5
    def _interactuar(self):
        pj = self._tile_frente()
        # ============================================================
        # FIX: Primero verificar si hay una PUERTA o estructura importante
        # Si la hay, actuar sobre ella IGNORANDO NPCs
        # ============================================================
        try:
            from sistemas.mapa_visual import (PUERTA, SIGN, SIGN_INFO, GIMNASIO_POS,
                                                TAMBO_POS, TIENDA_POS, MapaVisual)
            if 0 <= pj[0] < self.mapa_actual.ancho and 0 <= pj[1] < self.mapa_actual.alto:
                tile_frente = self.mapa_actual.tiles[pj[1]][pj[0]]
                # Si es una puerta, intentar entrar SIN consultar NPCs
                if tile_frente == PUERTA:
                    # Verificar si hay un gimnasio/tambo/tienda en esta posicion
                    mapa_actual = self.mapa_actual.id
                    es_importante = False
                    # Gimnasio?
                    for id_g, gim in GIMNASIOS.items():
                        if gim.posicion_mapa and gim.posicion_mapa[0] == mapa_actual:
                            if (gim.posicion_mapa[1], gim.posicion_mapa[2]) == pj:
                                es_importante = True
                                break
                    # Tambo?
                    if not es_importante and TAMBO_POS.get(mapa_actual) == pj:
                        es_importante = True
                    # Tienda?
                    if not es_importante and TIENDA_POS.get(mapa_actual) == pj:
                        es_importante = True

                    if es_importante:
                        # Ignorar NPCs y actuar sobre la puerta directamente
                        # (replicar la logica de puertas de mas abajo)
                        pass  # Se maneja mas abajo
        except Exception:
            pass

        # ¿Tile especial al frente? MT, objeto, arbusto, roca...
        tipo, tx, ty = self.mapa_actual.tile_enfrente()

        # MT en el suelo
        if tipo is not None and hasattr(self.mapa_actual, "tiles"):
            try:
                from sistemas.mapa_visual import (TELEPORT, MT_SUELO,
                                                   OBJ_BRILLANTE,
                                                   ARBUSTO_CORTABLE,
                                                   ROCA_ROMPIBLE,
                                                   MO_REQUERIDA)
                if tipo == TELEPORT:
                    # Escalera dentro de cueva o entrada
                    if self._cueva_actual is not None:
                        # Estamos DENTRO de una cueva → cambiar de piso
                        self._cambiar_piso_cueva(tx, ty)
                    else:
                        # Estamos AFUERA → entrar a una cueva
                        self._entrar_cueva(self.mapa_actual.id)
                    return
                if tipo == MT_SUELO:
                    # Recoger una MT aleatoria del pool regional
                    import random as _r
                    mts_pool = [
                        ("MT01", "Erupción de Rocoto"),
                        ("MT02", "Danza de Tijeras"),
                        ("MT03", "Silbido de Huaco"),
                        ("MT04", "Eco del Amaru"),
                        ("MT05", "Mordisco Glaciar"),
                    ]
                    mt_id, mt_nombre = _r.choice(mts_pool)
                    self.mapa_actual.tiles[ty][tx] = 0  # → PASTO
                    self.mensajes = [f"¡Encontraste {mt_id} - {mt_nombre}!"]
                    self.timer_mensajes = 3.0
                    return
                if tipo == OBJ_BRILLANTE:
                    import random as _r
                    item = _r.choice(["Pocion", "Superpocion", "Freekie Ball",
                                       "Super Ball", "Ultra Ball"])
                    self.mapa_actual.tiles[ty][tx] = 0
                    try:
                        from sistemas.inventario import (CURACIONES, POKEBALLS)
                        cat = {}; cat.update(CURACIONES); cat.update(POKEBALLS)
                        if item in cat:
                            self.inventario.agregar(cat[item], 1)
                    except Exception: pass
                    self.mensajes = [f"¡Encontraste {item}!"]
                    self.timer_mensajes = 2.5
                    return
                if tipo == ARBUSTO_CORTABLE:
                    if "Corte / Tala" in self.mos_desbloqueadas:
                        self.mapa_actual.romper_tile(tx, ty)
                        self.mensajes = ["¡Cortaste el arbusto!"]
                        self.timer_mensajes = 1.5
                    else:
                        self.mensajes = ["Un arbusto espinoso bloquea el paso.",
                                          "Necesitas la MO Corte / Tala."]
                        self.timer_mensajes = 2.5
                    return
                if tipo == ROCA_ROMPIBLE:
                    if "Golpe Roca" in self.mos_desbloqueadas:
                        self.mapa_actual.romper_tile(tx, ty)
                        self.mensajes = ["¡Rompes la roca!"]
                        self.timer_mensajes = 1.5
                    else:
                        self.mensajes = ["Una roca pequeña bloquea el paso.",
                                          "Necesitas la MO Golpe Roca."]
                        self.timer_mensajes = 2.5
                    return
            except Exception:
                pass
                       # 1) Entrenadores (casilla adyacente en la dirección que mira el jugador)
        d = self.mapa_actual.direccion
        jx, jy = self.mapa_actual.destino_x, self.mapa_actual.destino_y
        dx, dy = 0, 0
        if d == "arriba": dy = -1
        elif d == "abajo": dy = 1
        elif d == "izquierda": dx = -1
        elif d == "derecha": dx = 1
        fx, fy = jx + dx, jy + dy
        for ent in entrenadores_en(self.mapa_actual.id):
            if getattr(ent, "derrotado", False):
                continue
            if tuple(ent.posicion) == (fx, fy):
                self.entrenador_actual = ent
                self.dialogo_entrenador = list(ent.dialogo_pre)
                self.dialogo_entrenador_idx = 0
                self.estado = "dialogo_entrenador"
                self.estado_tras_entrenador = "batalla_entrenador"
                return

        # 2) NPCs ambientales (con dialogo dinamico segun medallas)
        try:
            medallas = self.gimnasios.cantidad_medallas()
        except Exception:
            medallas = 0
        # E6: verificar si hay un intercambio en esta posicion
        intc = obtener_intercambio(self.mapa_actual.id, pj)
        if intc and not intc.completado:
            self._iniciar_intercambio(intc)
            return

        for npc in globals().get("NPCS", []):
            if npc.get("mapa") == self.mapa_actual.id and tuple(npc["pos"]) == pj:
                try:
                    if "obtener_dialogo" in npc and callable(npc["obtener_dialogo"]):
                        dialogos = npc["obtener_dialogo"](medallas)
                    else:
                        dialogos = npc.get("dialogo", ["..."])
                except Exception:
                    dialogos = npc.get("dialogo", ["..."])
                self.dialogo_actual = list(dialogos)
                self.dialogo_hablante = npc.get("nombre", "")
                self.dialogo_idx = 0
                self._txt_cache = None
                self.estado = "dialogo"
                self.siguiente_estado_tras_dialogo = "exploracion"
                return

        # 3) Gimnasios
        for id_g, gim in GIMNASIOS.items():
            if gim.posicion_mapa:
                idm, gx, gy = gim.posicion_mapa
                if idm == self.mapa_actual.id and (gx, gy) == pj:
                    # ¿Bloqueado por evento o portero?
                    bloqueado, motivo = gimnasio_bloqueado(id_g)
                    if bloqueado:
                        ev = evento_supay_activo(self.mapa_actual.id)
                        if ev and not ev.completado:
                            self._iniciar_evento_supay(ev)
                            return
                        portero = obtener_portero(id_g)
                        if portero and not portero.derrotado:
                            self._iniciar_portero(portero)
                            return
                        self.mensajes = [motivo]
                        self.timer_mensajes = 2.5
                        return
                    # Todo OK, entra al gimnasio
                    self.gimnasio_actual = gim
                    self.estado = "dialogo_gimnasio"
                    return

                # 4) Comprobamos el tile de enfrente
        try:
            from sistemas.mapa_visual import PUERTA, SIGN, SIGN_INFO
        except Exception:
            PUERTA = SIGN = SIGN_INFO = -1

        if 0 <= pj[0] < self.mapa_actual.ancho and 0 <= pj[1] < self.mapa_actual.alto:
            tip = self.mapa_actual.tiles[pj[1]][pj[0]]

            # 4a) Letreros
            if tip in (SIGN, SIGN_INFO):
                self._leer_letrero(pj)
                return

            # 4b) Puertas
            if tip == PUERTA:
                casa = interior_de(self.mapa_actual.id, pj)
                tipo = (casa or {}).get("tipo", "casa")

                # Tambo → cura al equipo
                if tipo == "tambo":
                    for p in self.equipo.pokemons:
                        p.ps = p.ps_max
                        p.estado = None
                        p.confundido_turnos = 0
                    self._efecto_curado_timer = 2.5  # C6: flash verde
                    self.dialogo_actual = [
                        "¡Bienvenido al Tambostop!",
                        "¡Tus Pokémon están como nuevos!",
                        "¡Vuelve pronto, causa!",
                    ]
                    self.dialogo_hablante = "Enfermera Tambostop"
                    self.dialogo_idx = 0
                    self.estado = "dialogo"
                    self.siguiente_estado_tras_dialogo = "exploracion"
                    return

                # Tienda
                if tipo == "tienda":
                    try:
                        from sistemas.tienda import obtener_tienda
                        self.tienda_actual = obtener_tienda(self.mapa_actual.id)
                        if self.tienda_actual:
                            self.tienda_idx = 0
                            self.estado = "tienda"
                            return
                    except Exception:
                        pass
                    self.mensajes = ["La tienda está cerrada..."]
                    self.timer_mensajes = 1.5
                    return

                # Gimnasio (por si la puerta es la del gym)
                if tipo == "gimnasio":
                    for id_g, gim in GIMNASIOS.items():
                        if gim.posicion_mapa and gim.posicion_mapa[0] == self.mapa_actual.id:
                            self.gimnasio_actual = gim
                            self.estado = "dialogo_gimnasio"
                            return

                # Casa normal → entrar al interior
                self._entrar_a_casa(casa or {
                    "tipo": "casa", "npc": "Vecino",
                    "dialogo": ["¡Hola, entrenador!", "¡Buena suerte!"],
                    "ancho": 12, "alto": 8,
                })
                return
                
        # 5) PC en Caleta Norte
        if self.mapa_actual.id == "caleta_norte" and pj == (3, 7):
            self.estado = "pc"; self.pc_modo = "ver"; self.pc_idx = 0

        self.mensajes = ["No hay nada interesante aquí..."]
        self.timer_mensajes = 1.2

    # =====================================================================
    #  INTERIORES DE CASAS
    # =====================================================================

    def _entrar_a_casa(self, casa):
        self.interior_actual = casa
        self.interior_mapa_origen = self.mapa_actual.id
        self.interior_pos_origen = (self.mapa_actual.destino_x, self.mapa_actual.destino_y)
        self.interior_npc_idx = 0
        # ¿Es Tambostop? → curar equipo al entrar
        if casa.get("tipo") == "tambo":
            for p in self.equipo.pokemons:
                p.ps = p.ps_max
            self.mensajes = ["¡Tu equipo está curado!"]
            self.timer_mensajes = 2.0
        self.estado = "interior"

    def _salir_de_casa(self):
        self.estado = "exploracion"
        self.interior_actual = None

    def _manejar_input_interior(self, key):
        if not self.interior_actual:
            self.estado = "exploracion"; return
        if key in (pygame.K_ESCAPE, pygame.K_x, pygame.K_z, pygame.K_RETURN):
            if self.interior_npc_idx == 0:
                # Hablar con el NPC
                self.interior_npc_idx = 1
            else:
                # Salir
                self._salir_de_casa()
        elif key == pygame.K_DOWN and self.interior_npc_idx >= 1:
            self._salir_de_casa()

    def _dibujar_interior(self):
        if not self.interior_actual:
            pantalla.fill(NEGRO); return
        c = self.interior_actual
        aw, ah = c.get("ancho", 12), c.get("alto", 8)
        T = TILE_SIZE
        # Fondo: suelo de madera/alfombra
        pantalla.fill((30, 22, 20))
        # Sala principal (centrada)
        sala_w = aw * T
        sala_h = ah * T
        sala_x = (ANCHO - sala_w) // 2
        sala_y = (ALTO - sala_h) // 2 + 10

        # Suelo
        for ty in range(ah):
            for tx in range(aw):
                col = (196, 148, 96) if (tx + ty) % 2 == 0 else (176, 128, 84)
                pygame.draw.rect(pantalla, col,
                    (sala_x + tx*T, sala_y + ty*T, T, T))
                pygame.draw.rect(pantalla, (140, 96, 60),
                    (sala_x + tx*T, sala_y + ty*T, T, T), 1)

        # Pared superior con ventana
        for tx in range(aw):
            pygame.draw.rect(pantalla, (110, 74, 46),
                (sala_x + tx*T, sala_y - T, T, T))
            pygame.draw.rect(pantalla, (60, 42, 28),
                (sala_x + tx*T, sala_y - T, T, T), 1)
        # Ventana
        vx = sala_x + (aw // 2 - 1) * T
        pygame.draw.rect(pantalla, (110, 180, 230), (vx, sala_y - T + 3, 2*T - 6, T - 6))
        pygame.draw.rect(pantalla, (60, 42, 28), (vx, sala_y - T + 3, 2*T - 6, T - 6), 2)
        pygame.draw.line(pantalla, (60, 42, 28),
                         (vx + T - 3, sala_y - T + 3), (vx + T - 3, sala_y - 3), 2)

        # Puerta de salida (abajo)
        px = sala_x + (aw // 2) * T
        pygame.draw.rect(pantalla, (96, 64, 40),
            (px, sala_y + ah*T - T, T, T))
        pygame.draw.rect(pantalla, (40, 24, 16),
            (px, sala_y + ah*T - T, T, T), 2)

        # Alfombra
        pygame.draw.ellipse(pantalla, (140, 60, 60),
            (sala_x + aw*T//2 - 30, sala_y + ah*T//2 - 12, 60, 30))
        pygame.draw.ellipse(pantalla, (200, 100, 100),
            (sala_x + aw*T//2 - 24, sala_y + ah*T//2 - 8, 48, 22))

        # NPC dibujado en el centro
        nx = sala_x + aw*T//2
        ny = sala_y + ah*T//2 + 20
        pygame.draw.ellipse(pantalla, (0, 0, 0, 90), (nx - 8, ny + 12, 16, 5))
        pygame.draw.rect(pantalla, (220, 80, 80), (nx - 8, ny, 16, 14))     # ropa
        pygame.draw.rect(pantalla, (240, 200, 160), (nx - 6, ny - 8, 12, 10))# cara
        pygame.draw.rect(pantalla, (60, 40, 30), (nx - 6, ny - 12, 12, 4))   # pelo

        # Nombre del NPC
        nombre = c.get("npc", "Vecino")
        tn = fuente_media.render(nombre, True, (255, 240, 200))
        pygame.draw.rect(pantalla, (32, 24, 40),
            (nx - tn.get_width()//2 - 6, ny - 32, tn.get_width() + 12, 20))
        pygame.draw.rect(pantalla, DORADO_LIGA,
            (nx - tn.get_width()//2 - 6, ny - 32, tn.get_width() + 12, 20), 1)
        pantalla.blit(tn, (nx - tn.get_width()//2, ny - 30))

        # Diálogo (si ya interactuaste)
        if self.interior_npc_idx >= 1:
            dlg = c.get("dialogo", ["..."])
            ancho_bx = ANCHO - 60
            pygame.draw.rect(pantalla, (32, 24, 40), (30, ALTO - 130, ancho_bx, 100))
            pygame.draw.rect(pantalla, (240, 240, 210), (33, ALTO - 127, ancho_bx - 6, 94), 2)
            y = ALTO - 116
            for linea in dlg[:3]:
                t = fuente_media.render(linea, True, BLANCO)
                pantalla.blit(t, (44, y)); y += 24
            tip = fuente_peque.render("[X] / [ESC] Salir de la casa", True, AMARILLO_SOL)
            pantalla.blit(tip, (ANCHO//2 - tip.get_width()//2, ALTO - 22))
        else:
            tip = fuente_peque.render(
                f"[X] Hablar con {nombre}    [ESC] Salir",
                True, AMARILLO_SOL)
            pantalla.blit(tip, (ANCHO//2 - tip.get_width()//2, ALTO - 22))

        # Etiqueta del mapa arriba
        pygame.draw.rect(pantalla, (32, 24, 40), (0, 0, ANCHO, 24))
        tt = fuente_peque.render("Casa — " + self.interior_mapa_origen.replace('_',' ').title(),
                                 True, BLANCO)
        pantalla.blit(tt, (8, 4))
    def _usar_pocion(self):
        if self.inventario.tiene_objeto("Pocion"):
            p = self.batalla_actual.pokemon_activo_jugador
            if p.ps < p.ps_max:
                p.curar(20); self.inventario.remover("Pocion", 1)
                self.mensajes = [f"¡{p.nombre} recuperó 20 PS!"]
            else:
                self.mensajes = [f"¡{p.nombre} ya tiene todos sus PS!"]
        else:
            self.mensajes = ["¡No tienes Pociones!"]
        self.timer_mensajes = 1.5

    def _intentar_captura(self):
        b = self.batalla_actual
        if b is None:
            return
        # D7: verificar Nuzlocke
        if getattr(self, "nuzlocke_activo", False):
            puede, motivo = self._puede_capturar_nuzlocke(self.mapa_actual.id)
            if not puede:
                self.batalla_msg_queue = [motivo]
                self.batalla_msg_timer = 0.6
                b.sub_estado = "menu_principal"
                self.menu_batalla_idx = 0
                return
        # D7: verificar Nuzlocke
        if getattr(self, "nuzlocke_activo", False):
            puede, motivo = self._puede_capturar_nuzlocke(self.mapa_actual.id)
            if not puede:
                self.batalla_msg_queue = [motivo]
                self.batalla_msg_timer = 0.6
                b.sub_estado = "menu_principal"
                self.menu_batalla_idx = 0
                return
        if getattr(b, "es_gimnasio", False):
            self.batalla_msg_queue = ["¡No puedes capturar Pokémon de entrenadores!"]
            self.batalla_msg_timer = 0.6
            b.sub_estado = "menu_principal"
            self.menu_batalla_idx = 0
            return
        balls = [x for x in ("Apu Ball", "Ultra Ball", "Super Ball",
                             "Chasqui Ball", "Selva Ball", "Freekie Ball")
                 if self.inventario.tiene_objeto(x)]
        if not balls:
            self.batalla_msg_queue = ["¡No tienes Pokébolas!"]
            self.batalla_msg_timer = 0.6
            b.sub_estado = "menu_principal"
            self.menu_batalla_idx = 0
            return

        ball = balls[0]
        self.inventario.remover(ball, 1)
        res = intentar_capturar(b.pokemon_salvaje, ball, None)

        # Cola de mensajes → se muestran uno a uno en el HUD de batalla
        cola = [f"¡Lanzaste {ball}!"] + list(res.get("mensajes", []))
        self.batalla_msg_queue = cola
        self.batalla_msg_timer = 0.55

        if res.get("exito"):
            b.terminada = True
            b.resultado = "captura"
            b.pokemon_capturado = b.pokemon_salvaje
            self.pokedex.registrar_capturado(b.pokemon_salvaje.nombre)
            # E8: registrar leyenda capturada
            if getattr(b, "es_legendario", False):
                try:
                    self.legendarios_post.registrar_captura(b.pokemon_salvaje.nombre)
                except Exception:
                    pass
            try:
                self._marcar_captura_nuzlocke(self.mapa_actual.id)
            except Exception:
                pass
            try:
                self._marcar_captura_nuzlocke(self.mapa_actual.id)
            except Exception:
                pass
        else:
            # El rival ataca después de fallar
            self.batalla_msg_queue.append(
                f"¡{b.pokemon_salvaje.nombre} contraataca!")
            msgs = b._ejecutar_ataque_rival()
            self.batalla_msg_queue.extend(msgs)

        b.sub_estado = "menu_principal"
        self.menu_batalla_idx = 0

    def _puede_capturar_nuzlocke(self, mapa_id):
        """Devuelve (True, '') si puede capturar. Si no, (False, motivo)."""
        if not getattr(self, "nuzlocke_activo", False):
            return True, ""
        if mapa_id in self.nuzlocke_capturas_por_mapa:
            return False, f"Ya capturaste en {mapa_id.replace('_',' ').title()}. Nuzlocke."
        return True, ""

    def _marcar_captura_nuzlocke(self, mapa_id):
        if getattr(self, "nuzlocke_activo", False):
            self.nuzlocke_capturas_por_mapa[mapa_id] = True

    def _puede_capturar_nuzlocke(self, mapa_id):
        """Devuelve (True, '') si puede capturar. Si no, (False, motivo)."""
        if not getattr(self, "nuzlocke_activo", False):
            return True, ""
        if mapa_id in self.nuzlocke_capturas_por_mapa:
            return False, f"Ya capturaste en {mapa_id.replace('_',' ').title()}. Nuzlocke."
        return True, ""

    def _marcar_captura_nuzlocke(self, mapa_id):
        if getattr(self, "nuzlocke_activo", False):
            self.nuzlocke_capturas_por_mapa[mapa_id] = True

    def _iniciar_batalla_aleatoria(self):
        # ¿Estamos en una cueva?
        if self._cueva_actual is not None:
            piso = self._cueva_actual["pisos"][self._piso_cueva]
            nombres = [n for n, _ in self._cueva_actual["pokemon"]]
            pesos = [p for _, p in self._cueva_actual["pokemon"]]
            nombre = random.choices(nombres, weights=pesos, k=1)[0]
            nivel = random.randint(piso["nivel_min"], piso["nivel_max"])
        else:
            ciudades = ("caleta_norte", "ciudad_moche", "puerto_ancon",
                        "andahuaylas", "ciudad_imperial", "puno", "huaraz",
                        "puerto_selva", "ciudad_capital")
            if self.mapa_actual.id in ciudades:
                return
            if not self.equipo.pokemons:
                return
            if all(not p.esta_vivo() for p in self.equipo.pokemons):
                self._curar_tras_derrota()
                return
            try:
                if self.tiempo.es_noche():
                    from data.rutas import salvaje_para_nocturno
                    nombre, nivel = salvaje_para_nocturno(self.mapa_actual.id)
                else:
                    nombre, nivel = salvaje_para(self.mapa_actual.id)
            except Exception:
                nombre, nivel = salvaje_para(self.mapa_actual.id)

        datos = POKEDEX_COMPLETA.get(nombre, {
            "nombre": nombre, "tipos": ["Normal"],
            "stats_base": {"ps": 45, "atq": 40, "def": 40,
                           "atq_esp": 40, "def_esp": 40, "vel": 40}
        })
        self.batalla_actual = Batalla(self.equipo.pokemons, PokemonBatalla(datos, nivel))
        try:
            self.batalla_actual.clima = self.tiempo.clima_actual
            self.batalla_actual.turnos_clima = 5
        except Exception:
            pass
        self.batalla_actual.sub_estado = "menu_principal"
        self.batalla_actual.es_gimnasio = False
        self.batalla_actual.es_rival = False
        self.menu_batalla_idx = 0
        self.mensajes = [f"¡Un {nombre} salvaje apareció!"]
        self.timer_mensajes = 2.0
        self._iniciar_transicion_batalla()
        self.pokedex.registrar_visto(nombre)

    def _iniciar_batalla_gimnasio_real(self):
        """Batalla real contra el líder (llamada despues del VS)."""
        if not self.equipo.pokemons:
            self.mensajes = ["Necesitas Pokemon!"]
            self.timer_mensajes = 1.5
            self.estado = "exploracion"
            return
        if not self.gimnasio_actual:
            self.estado = "exploracion"
            return
        try:
            eq = self.gimnasio_actual.lider.crear_equipo()
        except Exception:
            eq = []
        if not eq:
            self.estado = "exploracion"
            return
        self.batalla_actual = Batalla(self.equipo.pokemons, eq[0])
        self.batalla_actual.sub_estado = "menu_principal"
        self.batalla_actual.es_gimnasio = True
        self.batalla_actual.es_rival = False
        self.batalla_actual.gimnasio_id = self.gimnasio_actual.id
        self.batalla_actual.rival_equipo = eq
        self.batalla_actual.rival_poke_idx = 0
        self.menu_batalla_idx = 0
        self.mensajes = [f"!{self.gimnasio_actual.lider.nombre} te reta!"]
        self.timer_mensajes = 2.0
        # Reset
        try:
            self._exp_vis = {}
            self._pausa_anim = 0.0
            self._mega_usada_batalla = False
        except Exception:
            pass
        self.estado = "batalla"
        self.musica.fondo("batalla_lider")

    def _iniciar_batalla_gimnasio(self):
        """Batalla contra el líder de un gimnasio (con VS Intro)."""
        if not self.gimnasio_actual:
            return
        lider = self.gimnasio_actual.lider
        # VS intro antes del combate
        self._iniciar_vs_intro(
            lider.nombre,
            f"Lider de {self.gimnasio_actual.nombre}",
            self._iniciar_batalla_gimnasio_real
        )
        if not self.equipo.pokemons:
            self.mensajes = ["¡No tienes Pokémon contigo!"]
            self.timer_mensajes = 1.8
            self.estado = "exploracion"
            return
        if not self.gimnasio_actual:
            self.estado = "exploracion"
            return
        if not self.equipo.pokemons:
            self.mensajes = ["¡No tienes Pokémon!"]
            self.timer_mensajes = 1.5
            self.estado = "exploracion"
            return
        eq = []
        if hasattr(self.gimnasio_actual.lider, 'crear_equipo'):
            eq = self.gimnasio_actual.lider.crear_equipo()
        if not eq:
            self.estado = "exploracion"
            return
        self.batalla_actual = Batalla(self.equipo.pokemons, eq[0])
        self.batalla_actual.sub_estado = "menu_principal"
        self.batalla_actual.es_gimnasio = True
        self.batalla_actual.es_rival = False
        self.batalla_actual.gimnasio_id = self.gimnasio_actual.id
        self.batalla_actual.rival_equipo = eq
        self.batalla_actual.rival_poke_idx = 0
        self.menu_batalla_idx = 0
        self.mensajes = [f"¡{self.gimnasio_actual.lider.nombre} te reta!"]
        self.timer_mensajes = 2.0
        self._iniciar_transicion_batalla()
        self.musica.fondo("batalla_lider")

    def _iniciar_batalla_entrenador(self):
        """Batalla contra un entrenador de ruta."""
        if not self.equipo.pokemons:
            self.mensajes = ["¡No tienes Pokémon contigo!"]
            self.timer_mensajes = 1.8
            self.estado = "exploracion"
            return
        if not self.entrenador_actual:
            self.estado = "exploracion"
            return
        eq = self.entrenador_actual.crear_equipo()
        if not eq:
            self.estado = "exploracion"
            return
        self.batalla_actual = Batalla(self.equipo.pokemons, eq[0])
        self.batalla_actual.es_gimnasio = True
        self.batalla_actual.sub_estado = "menu_principal"
        self.batalla_actual.rival_equipo = eq
        self.batalla_actual.rival_poke_idx = 0
        self.menu_batalla_idx = 0
        self.mensajes = [f"¡{self.entrenador_actual.nombre} te reta!"]
        self.timer_mensajes = 2.0
        self._iniciar_transicion_batalla()
        self.musica.fondo("batalla_entrenador")
    def _iniciar_liga(self):
        self._siguiente_oponente_liga()
    def _siguiente_oponente_liga(self):
        # D2: si ya ganamos al Campeon, lanzar creditos
        if getattr(self.liga, "es_campeon", False) and not getattr(self, "_creditos_vistos", False):
            try:
                self._creditos_vistos = True
            except Exception:
                pass
            self._iniciar_creditos()
            return
        res = self.liga.siguiente_oponente()
        if not res: return
        tipo, idx, op = res
        self.liga_oponente_actual = op
        self.liga_equipo_oponente = op.crear_equipo() if hasattr(op, 'crear_equipo') else []
        self.liga_poke_idx = 0
        if self.liga_equipo_oponente:
            self.batalla_actual = Batalla(self.equipo.pokemons, self.liga_equipo_oponente[0])
            self.batalla_actual.sub_estado = "menu_principal"
            self.batalla_actual.es_gimnasio = True
            self.menu_batalla_idx = 0
            self.mensajes = [f"¡{op.nombre} te reta!"]; self.timer_mensajes = 2.0
            self.estado = "liga"
    def _siguiente_poke_oponente(self):
        self.liga_poke_idx += 1
        if self.liga_poke_idx < len(self.liga_equipo_oponente):
            self.batalla_actual = Batalla(self.equipo.pokemons,
                                          self.liga_equipo_oponente[self.liga_poke_idx])
            self.batalla_actual.sub_estado = "menu_principal"
            self.batalla_actual.es_gimnasio = True
        else:
            self.batalla_actual.terminada = True
            self.batalla_actual.resultado = "victoria"

    def _finalizar_batalla(self):
        if self.batalla_actual is None:
            return

        # --- Duelo con rival guionado (Mateo / Inca-Roca) ---
        if (getattr(self.batalla_actual, "es_rival", False)
                and getattr(self, "_rival_actual", None) is not None
                and not getattr(self, "_huaca_batalla_iniciada", False)
                and not getattr(self.batalla_actual, "es_supay", False)
                and not getattr(self.batalla_actual, "es_portero", False)):
            if self.batalla_actual.resultado == "victoria":
                rival = self._rival_actual
                self.dialogo_actual = rival.dialogo("derrota_1")
                self.dialogo_hablante = rival.nombre
                self.dialogo_idx = 0
                self.estado = "dialogo"
                self.siguiente_estado_tras_dialogo = "escena_supay"
                self.inventario.dinero += 500
                self.musica.jingle("victoria")
                self.batalla_actual = None
                self._rival_actual = None
                return

        # --- Evento huaca ---
        if getattr(self, "_huaca_batalla_iniciada", False):
            if self.batalla_actual.resultado == "derrota":
                self._huaca_batalla_iniciada = False
                self._huaca_resultado = None
                self._curar_tras_derrota()
                return
            self._huaca_resultado = self.batalla_actual.resultado
            self.batalla_actual = None
            self.estado = "evento_huaca"
            return

        # E4: Si es Tag Team, manejar antes de finalizar
        if getattr(self.batalla_actual, "es_tag_team", False):
            gano = (self.batalla_actual.resultado == "victoria")
            self.batalla_actual = None
            self._terminar_batalla_tag_team(gano)
            return

        if self.batalla_actual.resultado == "victoria":
            self.musica.jingle("victoria")
            try:
                self._stats_partida["batallas_ganadas"] += 1
            except Exception:
                pass   # único jingle

            # Detección de victorias especiales
            if getattr(self.batalla_actual, "es_supay", False):
                self.batalla_actual = None
                self._resolver_victoria_supay()
                return
            if getattr(self.batalla_actual, "es_portero", False):
                self.batalla_actual = None
                self._resolver_victoria_portero()
                return

            # ADICTIVIDAD: XP extra por combo activo
            combo_mult = 1 + min(1.0, self._combo_racha * 0.1)
            exp = int((50 + self.batalla_actual.pokemon_salvaje.nivel * 8) * combo_mult)
            poke_act = self.batalla_actual.pokemon_activo_jugador
            nivel_antes = poke_act.nivel
            resultado_exp = poke_act.ganar_exp(exp)

            # Cola de mensajes: EXP → nivel → aprendizaje
            self.batalla_msg_queue = [
                f"¡{poke_act.nombre} ganó {exp} puntos de EXP!",
            ]
            self.batalla_msg_timer = 0.4

            if resultado_exp and resultado_exp.get("subidas"):
                nuevo_nivel = resultado_exp["subidas"][-1]
                self.batalla_msg_queue.append(
                    f"¡{poke_act.nombre} subió al nivel {nuevo_nivel}!")
                # Aprendizaje de movimientos (se procesa cuando termine la cola)
                self._verificar_aprendizaje_movimiento(poke_act)

            # Dinero de entrenador
            if self.entrenador_actual:
                self.entrenador_actual.derrotado = True
                self.inventario.dinero += self.entrenador_actual.recompensa
                self.batalla_msg_queue.append(
                    f"¡Ganaste S/{self.entrenador_actual.recompensa}!")

            if getattr(self.batalla_actual, 'es_gimnasio', False) and getattr(self.batalla_actual, 'gimnasio_id', None):
                # E1: Si es un rematch Chasqui, subir nivel del entrenador
                if getattr(self.batalla_actual, "es_chasqui", False) and hasattr(self, "_chasqui_ent"):
                    try:
                        self._chasqui_ent.registrar_rematch()
                    except Exception:
                        pass
                med = self.gimnasios.registrar_victoria(self.batalla_actual.gimnasio_id)
                if med:
                    self.batalla_msg_queue.append(f"¡Obtuviste la {med}!")
                    try:
                        from sistemas.sonidos import Sonidos as SonAvz
                        SonAvz.medalla()
                    except Exception:
                        pass
                    try:
                        from sistemas.sonidos import Sonidos as SonAvz
                        SonAvz.medalla()
                    except Exception:
                        pass
                    try:
                        from sistemas.guardado import guardar_partida
                        if guardar_partida(self, 1):
                            self.batalla_msg_queue.append("(Partida guardada auto)")
                    except Exception:
                        pass

            self._verificar_evolucion()
        elif self.batalla_actual.resultado == "derrota":
            self.musica.jingle("derrota")
            # Reset combo
            try:
                self._combo_racha = 0
            except Exception:
                pass
            # Reset combo
            try:
                self._combo_racha = 0
            except Exception:
                pass
            try:
                self._stats_partida["batallas_perdidas"] += 1
            except Exception:
                pass
            self._curar_tras_derrota()
            return
        elif self.batalla_actual.resultado == "captura":
            p = self.batalla_actual.pokemon_capturado
            self.pokedex.registrar_capturado(p.nombre)
            try:
                self._stats_partida["capturas"] += 1
            except Exception:
                pass
            if len(self.equipo.pokemons) < 6:
                self.equipo.agregar(p)
            else:
                self.pc.guardar_pokemon(p)
            self.batalla_msg_queue = [f"¡{p.nombre} fue añadido al equipo!"]

        # E2: Si la batalla fue en el Frente, pasar al siguiente piso
        if self.batalla_actual and getattr(self.batalla_actual, "es_frente", False):
            if self.batalla_actual.resultado == "victoria":
                self.batalla_actual = None
                self._siguiente_piso_frente()
                return
            else:
                # Perder en Frente = fin de la racha
                self.batalla_actual = None
                self.frente_piso = 1
                self.frente_racha = 0
                self._terminar_frente()
                return
        # F: manejar fin de batalla Yacumama
        if self.batalla_actual and getattr(self.batalla_actual, "es_yacumama", False):
            resultado = self.batalla_actual.resultado
            self.batalla_actual = None
            self._terminar_yacumama(resultado == "victoria")
            return

        # E8: manejar fin de batalla Omega
        if self.batalla_actual and getattr(self.batalla_actual, "es_omega", False):
            resultado = self.batalla_actual.resultado
            self.batalla_actual = None
            self._avanzar_fase_omega()
            return

        # E8: revertir megas al terminar batalla
        try:
            for p in self.equipo.pokemons:
                revertir_mega(p)
        except Exception:
            pass
        self.timer_mensajes = 2.0
        self.estado = "exploracion"
        self.batalla_actual = None
        try:
            self._ps_vis = {}
        except Exception:
            pass
        # FIX_MUSICA_POST_GYM
        try:
            self.musica.actual = None
        except Exception:
            pass

    def _mostrar_escena_supay(self):
        """Escena 5 del lore: el Team Supay roba reliquias y el Prof. Kuntur avisa."""
        # Sacudir la pantalla brevemente con un flash rojo/negro
        for _ in range(3):
            pantalla.fill((180, 40, 40))
            pygame.display.flip()
            pygame.time.wait(60)
            pantalla.fill((0, 0, 0))
            pygame.display.flip()
            pygame.time.wait(60)

        self.dialogo_actual = [
            "¡Oye, [Nombre]! ¿Viste a esos payasos con capucha?",
            "Se han metido a robar a la huaca de frente, sin roche.",
            "¡Esos son los vagos del Team Supay de los que habla la gente mayor!",
            "---",
            "¡Muchachos, cuidado!",
            "Esos sujetos están alterando la energía de toda la zona.",
            "[Nombre], mano, agarra bien tu Pokébola.",
            "Tu viaje por la región ya empezó de la peor forma...",
            "¡Sigue a esos sinvergüenzas hacia la Ruta 1 antes de que hagan más daño!",
        ]
        self.dialogo_hablante = "Mateo / Prof. Kuntur"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "exploracion"

        # Desbloquear la salida de la Caleta hacia la Ruta 1
        self.historia.completar_evento("evento_prologo")

    def _verificar_evolucion(self):
        ev = verificar_evoluciones_equipo(self.equipo.pokemons)
        if ev:
            self.pokemon_evolucionar = ev[0]["pokemon"]
            self.evolucion_resultado = ev[0]["evoluciona_a"]
            self.estado = "evolucion"

    def _confirmar_evolucion(self):
        if self.pokemon_evolucionar:
            i = self.equipo.pokemons.index(self.pokemon_evolucionar)
            nuevo = evolucionar(self.pokemon_evolucionar)
            self.equipo.pokemons[i] = nuevo
            self.pokedex.registrar_capturado(nuevo.nombre)
        self.estado = "exploracion"
        self.pokemon_evolucionar = None
        self.evolucion_resultado = None
        self._evo_timer = 0.0

    def _curar_tras_derrota(self):
        """Al perder todos los Pokemon, curar y volver al Tambostop."""
        # Curar todo el equipo
        for p in self.equipo.pokemons:
            try:
                p.ps = p.ps_max
                p.estado = None
                p.confundido_turnos = 0
                p.flinch = False
                p._turnos_recarga = 0
                p.contador_toxico = 0
                if hasattr(p, "reiniciar_stages"):
                    p.reiniciar_stages()
            except Exception:
                pass

        # Volver al Tambostop de Caleta Norte
        try:
            from sistemas.mapa_visual import MapaVisual
            self.mapa_actual = MapaVisual("caleta_norte")
            self.mapa_actual.pos_x = 5.0
            self.mapa_actual.pos_y = 15.0
            self.mapa_actual.destino_x = 5
            self.mapa_actual.destino_y = 15
            self.mapa_actual.direccion = "abajo"
            self.mapa_actual.moviendo = False
        except Exception:
            pass

        # Dialogo de enfermera
        self.dialogo_actual = [
            "¡Oh! ¡Tus Pokémon estan agotados!",
            "No te preocupes, aqui en el Tambostop los curamos.",
            "Te desmayaste y te trajeron de vuelta a la Caleta Norte.",
            "¡Ten mas cuidado la proxima vez, causa!",
        ]
        self.dialogo_hablante = "Enfermera Tambostop"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "exploracion"
        self.batalla_actual = None
        self._huaca_batalla_iniciada = False
        self._huaca_resultado = None
        self._rival_actual = None
        self._evento_supay_activo = None
        self._portero_actual = None

    def _intentar_invocar_leyenda(self):
        """E8: verifica si hay una leyenda disponible en la posicion actual."""
        try:
            jx = self.mapa_actual.destino_x
            jy = self.mapa_actual.destino_y
        except Exception:
            return False
        mapa_id = self.mapa_actual.id
        # Menores
        for nombre, leyenda in LEYENDAS_MENORES.items():
            if leyenda["mapa"] != mapa_id:
                continue
            lx, ly = leyenda["pos"]
            if abs(jx - lx) + abs(jy - ly) <= 1:
                if self.legendarios_post.puede_invocar(nombre, self):
                    self._invocar_leyenda(nombre, leyenda)
                    return True
        # Mayor
        for nombre, leyenda in LEYENDA_MAYOR.items():
            if leyenda["mapa"] != mapa_id:
                continue
            lx, ly = leyenda["pos"]
            if abs(jx - lx) + abs(jy - ly) <= 1:
                if self.legendarios_post.puede_invocar(nombre, self):
                    self._invocar_leyenda(nombre, leyenda)
                    return True
        return False

    def _invocar_leyenda(self, nombre, leyenda):
        """E8: inicia el encuentro con un legendario."""
        self._leyenda_activa = (nombre, leyenda)
        self.dialogo_actual = list(leyenda["dialogos"])
        self.dialogo_hablante = nombre
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "batalla_leyenda"

    def _lanzar_batalla_leyenda(self):
        """E8: inicia la batalla contra el legendario."""
        if not self._leyenda_activa:
            self.estado = "exploracion"
            return
        nombre, leyenda = self._leyenda_activa
        try:
            from data.pokedex import POKEDEX_COMPLETA
            datos = POKEDEX_COMPLETA.get(nombre)
            if not datos:
                self.estado = "exploracion"
                return
            poke = PokemonBatalla(datos, leyenda["nivel"])
            # Bonus para legendarios
            poke.ps_max = int(poke.ps_max * 1.5)
            poke.ps = poke.ps_max
            self.batalla_actual = Batalla(self.equipo.pokemons, poke)
            self.batalla_actual.sub_estado = "menu_principal"
            self.batalla_actual.es_gimnasio = False
            self.batalla_actual.es_legendario = True
            self.batalla_actual.es_rival = False
            self.menu_batalla_idx = 0
            self.mensajes = [f"!{nombre} aparece!"]
            self.timer_mensajes = 2.0
            self.estado = "batalla"
            self.musica.fondo("batalla_legendario")
        except Exception as e:
            print(f"Error batalla leyenda: {e}")
            self.estado = "exploracion"

    def _dibujar_aviso_leyenda(self):
        """E8: dibuja aviso si hay una leyenda disponible cerca."""
        try:
            jx = self.mapa_actual.destino_x
            jy = self.mapa_actual.destino_y
            mapa_id = self.mapa_actual.id
        except Exception:
            return
        for nombre, leyenda in list(LEYENDAS_MENORES.items()) + list(LEYENDA_MAYOR.items()):
            if leyenda["mapa"] != mapa_id:
                continue
            lx, ly = leyenda["pos"]
            if abs(jx - lx) + abs(jy - ly) <= 4:
                if self.legendarios_post.puede_invocar(nombre, self):
                    t = fuente_peque.render(
                        f"!{nombre} esta cerca!",
                        True, (255, 220, 100))
                    pygame.draw.rect(pantalla, (60, 40, 20),
                                     (ANCHO - t.get_width() - 20, 80,
                                      t.get_width() + 12, 20))
                    pygame.draw.rect(pantalla, (255, 220, 100),
                                     (ANCHO - t.get_width() - 20, 80,
                                      t.get_width() + 12, 20), 2)
                    pantalla.blit(t, (ANCHO - t.get_width() - 14, 82))
                    break

    def _iniciar_omega_inca(self):
        """E8: inicia el combate final contra Omega-Inca."""
        puede, motivo = self.omega_inca.puede_desafiar(self)
        if not puede:
            self.mensajes = [motivo]
            self.timer_mensajes = 3.0
            return
        self.omega_inca.activo = True
        self.omega_inca.fase_actual = 1
        # Dialogo inicial
        fase = FASES_OMEGA[1]
        self.dialogo_actual = list(fase["dialogo"])
        self.dialogo_hablante = "Omega-Inca"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "omega_batalla"

    def _lanzar_batalla_omega(self):
        """E8: lanza la batalla de la fase actual."""
        fase = FASES_OMEGA.get(self.omega_inca.fase_actual)
        if not fase:
            self._terminar_omega()
            return
        try:
            from data.pokedex import POKEDEX_COMPLETA
            datos = POKEDEX_COMPLETA.get("Omega-Inca")
            if not datos:
                self.estado = "exploracion"
                return
            poke = PokemonBatalla(datos, fase["nivel"])
            # Multiplicadores de fase
            poke.ps_max = int(poke.ps_max * fase["hp_mult"])
            poke.ps = poke.ps_max
            # Stats boost
            m = fase["stats_mult"]
            poke.atq_base = int(poke.atq_base * m)
            poke.def_base = int(poke.def_base * m)
            poke.atq_esp_base = int(poke.atq_esp_base * m)
            poke.def_esp_base = int(poke.def_esp_base * m)
            poke.vel_base = int(poke.vel_base * m)
            if hasattr(poke, "_calcular_stats"):
                poke._calcular_stats()
            else:
                poke._calc_stats()
            poke.ps = poke.ps_max
            self.batalla_actual = Batalla(self.equipo.pokemons, poke)
            self.batalla_actual.sub_estado = "menu_principal"
            self.batalla_actual.es_gimnasio = False
            self.batalla_actual.es_omega = True
            self.batalla_actual.es_rival = False
            self.menu_batalla_idx = 0
            self.mensajes = [f"!{fase['nombre']} - Fase {self.omega_inca.fase_actual}/3!"]
            self.timer_mensajes = 2.0
            self.estado = "batalla"
            self.musica.fondo("batalla_liga")
        except Exception as e:
            print(f"Error Omega Inca: {e}")
            self.estado = "exploracion"

    def _avanzar_fase_omega(self):
        """E8: pasa a la siguiente fase o termina."""
        if self.batalla_actual and self.batalla_actual.resultado == "derrota":
            # Perdio: fin
            self.omega_inca.activo = False
            self.omega_inca.fase_actual = 1
            self.dialogo_actual = [
                "Omega-Inca: Tu espiritu se quiebra.",
                "Omega-Inca: Vuelve cuando seas verdaderamente fuerte.",
            ]
            self.dialogo_hablante = "Omega-Inca"
            self.dialogo_idx = 0
            self.estado = "dialogo"
            self.siguiente_estado_tras_dialogo = "exploracion"
            return
        # Victoria: avanzar fase
        self.omega_inca.fase_actual += 1
        if self.omega_inca.fase_actual > 3:
            self._terminar_omega()
            return
        fase = FASES_OMEGA[self.omega_inca.fase_actual]
        # Curar parcialmente al jugador entre fases
        for p in self.equipo.pokemons:
            p.ps = min(p.ps_max, p.ps + int(p.ps_max * 0.3))
        # Dialogo de la nueva fase
        self.dialogo_actual = list(fase["dialogo"])
        self.dialogo_hablante = "Omega-Inca"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "omega_batalla"

    def _terminar_omega(self):
        """E8: victoria final."""
        self.omega_inca.completado = True
        self.omega_inca.activo = False
        # Premio
        self.inventario.dinero += 999999
        # Dar item unico
        try:
            from sistemas.inventario import Objeto
            self.inventario.agregar(Objeto("Corona de Omega", "llave",
                "El mayor tesoro del Tahuantinsuyo.", 0), 1)
        except Exception:
            pass
        # Dialogo final
        self.dialogo_actual = list(DIALOGO_VICTORIA)
        self.dialogo_hablante = "Omega-Inca"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "creditos"

    def _verificar_episodio_amaru(self):
        """F: Verifica si debe dispararse el Episodio Amaru."""
        # Requisito: haber vencido a Omega-Inca
        try:
            if not self.omega_inca.completado:
                return False
        except Exception:
            return False
        # Si ya esta completo, no hacer nada
        if self.episodio_amaru.completado:
            return False
        # Si no esta iniciado, iniciarlo al volver a Caleta Norte
        if not self.episodio_amaru.iniciado:
            try:
                if self.mapa_actual.id == "caleta_norte":
                    self.episodio_amaru.iniciar()
                    self.dialogo_actual = [
                        "!El mundo esta en paz tras vencer a Omega-Inca!",
                        "!Pero algo extrano se siente en el aire...",
                        "!Regresa a tu casa. Tu mama tiene noticias!",
                    ]
                    self.dialogo_hablante = "Sistema"
                    self.dialogo_idx = 0
                    self.estado = "dialogo"
                    self.siguiente_estado_tras_dialogo = "exploracion"
                    return True
            except Exception:
                pass
            return False
        # Fase actual: verificar trigger
        fase = self.episodio_amaru.fase_info()
        if not fase:
            return False
        # Solo disparar si estamos en la ubicacion correcta
        if fase["ubicacion"] != self.mapa_actual.id:
            return False
        return True

    def _disparar_fase_episodio(self, trigger):
        """F: dispara el dialogo de una fase especifica."""
        dlgs = self.episodio_amaru.dialogo_fase(trigger)
        if not dlgs:
            return False
        self.dialogo_actual = list(dlgs)
        self.dialogo_hablante = "Episodio Amaru"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        # Siguiente accion
        if trigger == "yacumama":
            self.siguiente_estado_tras_dialogo = "batalla_yacumama"
        elif trigger == "sabios":
            # Dar Orbe
            try:
                from sistemas.inventario import Objeto
                self.inventario.agregar(Objeto("Orbe del Sol", "llave",
                    "Permite retar infinitamente al Alto Mando.", 0), 1)
                self.episodio_amaru.orbe_obtenido = True
            except Exception:
                pass
            self.episodio_amaru.completado = True
            self.siguiente_estado_tras_dialogo = "exploracion"
        else:
            self.siguiente_estado_tras_dialogo = "exploracion"
        return True

    def _lanzar_batalla_yacumama(self):
        """F: batalla epica contra Yacumama (no captura, purificacion)."""
        try:
            from data.pokedex import POKEDEX_COMPLETA
            datos = POKEDEX_COMPLETA.get("Yacumama")
            if not datos:
                self.estado = "exploracion"
                return
            # Yacumama nivel 80, HP x3
            poke = PokemonBatalla(datos, 80)
            poke.ps_max = int(poke.ps_max * 3)
            poke.ps = poke.ps_max
            poke.atq_esp_base += 40
            poke.def_esp_base += 30
            poke.vel_base += 20
            if hasattr(poke, "_calcular_stats"):
                poke._calcular_stats()
            else:
                poke._calc_stats()
            poke.ps = poke.ps_max
            self.batalla_actual = Batalla(self.equipo.pokemons, poke)
            self.batalla_actual.sub_estado = "menu_principal"
            self.batalla_actual.es_gimnasio = False
            self.batalla_actual.es_yacumama = True
            self.batalla_actual.es_rival = False
            self.menu_batalla_idx = 0
            self.mensajes = ["!YACUMAMA - El Ser Mitico!"]
            self.timer_mensajes = 3.0
            self.estado = "batalla"
            self.musica.fondo("batalla_liga")
        except Exception as e:
            print(f"Error batalla Yacumama: {e}")
            self.estado = "exploracion"

    def _terminar_yacumama(self, gano):
        """F: maneja el fin de la batalla Yacumama."""
        if not gano:
            # Perdio: puede reintentar
            self.dialogo_actual = [
                "!Yacumama es demasiado poderoso!",
                "!Debes entrenar mas y volver!",
            ]
            self.dialogo_hablante = "Yacumama"
            self.dialogo_idx = 0
            self.estado = "dialogo"
            self.siguiente_estado_tras_dialogo = "exploracion"
            return
        # Gano: purificado
        self.episodio_amaru.yacumama_derrotada = True
        self.episodio_amaru.avanzar()  # pasa a fase 7
        # Dialogo final del Yacumama
        self.dialogo_actual = list(DIALOGOS_EPISODIO.get("yacumama_fin", []))
        self.dialogo_hablante = "Yacumama"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "exploracion"

    def _dibujar_hud_episodio(self):
        """F: HUD con la fase actual del Episodio Amaru."""
        if not self.episodio_amaru.iniciado or self.episodio_amaru.completado:
            return
        fase = self.episodio_amaru.fase_info()
        if not fase:
            return
        # Panel arriba a la derecha
        txt1 = fuente_peque.render(
            f"EPISODIO AMARU - Fase {self.episodio_amaru.fase_actual}/{len(FASES_EPISODIO)}",
            True, (255, 220, 100))
        txt2 = fuente_peque.render(fase["objetivo"], True, (240, 240, 220))
        ancho = max(txt1.get_width(), txt2.get_width()) + 20
        x = ANCHO - ancho - 8
        y = 100
        pygame.draw.rect(pantalla, (40, 20, 60), (x, y, ancho, 42))
        pygame.draw.rect(pantalla, (255, 220, 100), (x, y, ancho, 42), 2)
        pantalla.blit(txt1, (x + 10, y + 4))
        pantalla.blit(txt2, (x + 10, y + 22))

    def _iniciar_vs_intro(self, nombre_rival, titulo_rival, callback):
        """VS Intro estilo Emerald: solo para jefes importantes."""
        # Solo mostrar si tiene nombre reconocido
        try:
            from sistemas.retratos import Retratos
            quien = Retratos._resolver(nombre_rival)
            if quien == "Mateo" and "Mateo" not in nombre_rival:
                # No hay retrato conocido, saltar
                callback()
                return
        except Exception:
            callback()
            return
        self._vs_intro_timer = 0.0
        self._vs_intro_datos = {
            "nombre": nombre_rival,
            "titulo": titulo_rival,
        }
        self._vs_intro_siguiente = callback
        self.estado = "vs_intro"

    def _dibujar_vs_intro(self, dt=None):
        """VS screen estilo Pokemon Emerald."""
        if dt is None:
            dt = getattr(self, "_last_dt", 1.0/60.0)
        self._vs_intro_timer += dt
        t = self._vs_intro_timer
        dur = 2.4

        datos = self._vs_intro_datos or {}
        nombre = datos.get("nombre", "?")
        titulo = datos.get("titulo", "Entrenador")

        # Fondo: franjas diagonales
        pantalla.fill((10, 20, 60))
        for i in range(-2, 20):
            x = i * 40
            col_alt = (255, 200, 60) if i % 2 == 0 else (240, 80, 80)
            pygame.draw.polygon(pantalla, col_alt, [
                (x, 0), (x + 20, 0), (x + 60, ALTO), (x + 40, ALTO)
            ])
        # Oscurecer con overlay suave
        ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
        ov.fill((0, 0, 0, 120))
        pantalla.blit(ov, (0, 0))

        # Sprites entrando desde los lados
        # Rival desde la derecha
        fase_r = min(1.0, t / 0.4)
        try:
            from sistemas.retratos import Retratos
            ret_r = Retratos.obtener(nombre, 140, t)
            rx = int(ANCHO - 180 + (1 - fase_r) * 400)
            pygame.draw.rect(pantalla, (20, 15, 30), (rx - 4, 80 - 4, 148, 148))
            pygame.draw.rect(pantalla, (240, 200, 60), (rx - 4, 80 - 4, 148, 148), 4)
            pantalla.blit(ret_r, (rx + 4, 84))
        except Exception:
            pass

        # Jugador desde la izquierda
        fase_j = min(1.0, t / 0.4)
        try:
            from sistemas.retratos import Retratos
            ret_j = Retratos.obtener(getattr(self, "nombre_jugador", "Freekie"), 140, t)
            jx = int(-100 + fase_j * 400)
            pygame.draw.rect(pantalla, (20, 15, 30), (jx - 4, 200 - 4, 148, 148))
            pygame.draw.rect(pantalla, (100, 220, 140), (jx - 4, 200 - 4, 148, 148), 4)
            pantalla.blit(ret_j, (jx + 4, 204))
        except Exception:
            pass

        # VS central con rebote
        if t > 0.6:
            prog = min(1.0, (t - 0.6) / 0.4)
            rebote = 1.0 + 0.5 * math.sin(prog * math.pi) * (1 - prog * 0.6)
            tam_v = int(90 * rebote)
            try:
                fnt_v = pygame.font.SysFont("arial", tam_v, bold=True)
            except Exception:
                fnt_v = fuente_titulo
            txt_b = fnt_v.render("VS", True, (30, 10, 10))
            txt_v = fnt_v.render("VS", True, (255, 230, 80))
            cx = ANCHO // 2 - txt_v.get_width() // 2
            cy = ALTO // 2 - txt_v.get_height() // 2
            pantalla.blit(txt_b, (cx + 4, cy + 4))
            pantalla.blit(txt_v, (cx, cy))

        # Nombres con placas
        if t > 1.0:
            # Placa rival (derecha)
            try:
                txt_n = fuente_grande.render(nombre, True, BLANCO)
                txt_t = fuente_peque.render(titulo, True, (255, 220, 100))
                w = max(txt_n.get_width(), txt_t.get_width()) + 30
                bx = ANCHO - w - 20
                by = 240
                pygame.draw.rect(pantalla, (60, 30, 40), (bx, by, w, 54))
                pygame.draw.rect(pantalla, (240, 200, 60), (bx, by, w, 54), 3)
                pantalla.blit(txt_n, (bx + w // 2 - txt_n.get_width() // 2, by + 4))
                pantalla.blit(txt_t, (bx + w // 2 - txt_t.get_width() // 2, by + 30))
            except Exception:
                pass
            # Placa jugador (izquierda)
            try:
                nombre_j = getattr(self, "nombre_jugador", "Freekie")
                txt_n = fuente_grande.render(nombre_j, True, BLANCO)
                txt_t = fuente_peque.render("Tu", True, (100, 240, 140))
                w = max(txt_n.get_width(), txt_t.get_width()) + 30
                bx = 20
                by = 360
                pygame.draw.rect(pantalla, (30, 60, 40), (bx, by, w, 54))
                pygame.draw.rect(pantalla, (100, 220, 140), (bx, by, w, 54), 3)
                pantalla.blit(txt_n, (bx + w // 2 - txt_n.get_width() // 2, by + 4))
                pantalla.blit(txt_t, (bx + w // 2 - txt_t.get_width() // 2, by + 30))
            except Exception:
                pass

        # Instruccion
        if t < dur - 0.3:
            try:
                hint = fuente_peque.render("[X] Saltar", True, (200, 220, 255))
                pantalla.blit(hint, (ANCHO // 2 - hint.get_width() // 2, ALTO - 20))
            except Exception:
                pass

        # Fin
        if t >= dur:
            cb = self._vs_intro_siguiente
            self._vs_intro_datos = None
            self._vs_intro_siguiente = None
            self._vs_intro_timer = 0.0
            if cb:
                try:
                    cb()
                except Exception as e:
                    print(f"Error callback VS: {e}")
                    self.estado = "exploracion"

    def _iniciar_safari(self):
        """Inicia el Safari de Nasca."""
        if self.inventario.dinero < 500:
            self.mensajes = ["Necesitas 500 soles para el Safari."]
            self.timer_mensajes = 2.0
            return
        self.inventario.dinero -= 500
        self.safari.iniciar()
        self.estado = "safari"
        self.mensajes = ["!Bienvenido al Safari de Nasca!"]
        self.timer_mensajes = 2.0

    def _dibujar_safari(self):
        zona = ZONAS_SAFARI.get(self.safari.zona_actual, {})
        # Fondo desierto
        pantalla.fill((220, 200, 160))
        # Geoglifo decorativo al fondo
        try:
            # Lineas simples representando geoglifos
            pygame.draw.circle(pantalla, (180, 150, 100), (ANCHO//2, 150), 60, 3)
            pygame.draw.circle(pantalla, (180, 150, 100), (ANCHO//2, 150), 40, 2)
            pygame.draw.line(pantalla, (180, 150, 100), (ANCHO//2 - 70, 150), (ANCHO//2 + 70, 150), 2)
        except Exception:
            pass

        # HUD superior
        pygame.draw.rect(pantalla, (32, 24, 40), (0, 0, ANCHO, 40))
        pygame.draw.rect(pantalla, (240, 200, 60), (0, 38, ANCHO, 2))
        t = fuente_grande.render("SAFARI DE NASCA", True, (255, 240, 180))
        pantalla.blit(t, (ANCHO//2 - t.get_width()//2, 6))

        # Info
        info1 = fuente_media.render(
            f"Zona: {zona.get('nombre', '?')}", True, (60, 50, 40))
        info2 = fuente_media.render(
            f"Bolas: {self.safari.bolas_restantes}  Pasos: {self.safari.pasos_restantes}",
            True, (60, 50, 40))
        pantalla.blit(info1, (20, 60))
        pantalla.blit(info2, (20, 88))

        # Descripcion
        desc = zona.get("descripcion", "")
        t_desc = fuente_peque.render(desc, True, (100, 80, 60))
        pantalla.blit(t_desc, (20, 115))

        # Lista de Pokemon de la zona
        pygame.draw.rect(pantalla, (240, 230, 200), (20, 150, ANCHO - 40, 200))
        pygame.draw.rect(pantalla, (150, 120, 60), (20, 150, ANCHO - 40, 200), 2)
        t_pk = fuente_media.render("Pokemon en esta zona:", True, (60, 40, 20))
        pantalla.blit(t_pk, (30, 158))
        y = 185
        for poke, niv_min, niv_max in zona.get("pokemon", [])[:5]:
            t = fuente_peque.render(f"- {poke}  (Nv {niv_min}-{niv_max})",
                                     True, (80, 60, 40))
            pantalla.blit(t, (40, y))
            y += 20

        # Capturas de la sesion
        if self.safari.capturados_sesion:
            t_caps = fuente_peque.render(
                f"Capturados esta sesion: {len(self.safari.capturados_sesion)}",
                True, (80, 120, 60))
            pantalla.blit(t_caps, (30, 320))

        # Ayuda
        tip = fuente_peque.render(
            "[Z] Cambiar zona   [ESC] Salir Safari",
            True, (60, 40, 20))
        pantalla.blit(tip, (ANCHO//2 - tip.get_width()//2, ALTO - 60))

        # Mensaje
        if self.mensajes and self.timer_mensajes > 0:
            msg_bg = pygame.Surface((ANCHO - 60, 40), pygame.SRCALPHA)
            msg_bg.fill((255, 250, 220, 230))
            pantalla.blit(msg_bg, (30, ALTO - 100))
            pygame.draw.rect(pantalla, (150, 120, 60), (30, ALTO - 100, ANCHO - 60, 40), 2)
            tm = fuente_media.render(self.mensajes[0], True, (60, 40, 20))
            pantalla.blit(tm, (ANCHO//2 - tm.get_width()//2, ALTO - 90))

    def _safari_caminar(self):
        """Avanza un paso en el safari."""
        if not self.safari.activo:
            return
        self.safari.dar_pasos(1)
        if self.safari.pasos_restantes <= 0:
            self.mensajes = ["!Se acabaron los pasos!"]
            self.timer_mensajes = 2.0
            self._salir_safari()
            return
        # 15% probabilidad de encuentro
        if random.random() < 0.15:
            poke, nivel = self.safari.pokemon_aleatorio()
            if poke:
                # Batalla Safari
                try:
                    from data.pokedex import POKEDEX_COMPLETA
                    datos = POKEDEX_COMPLETA.get(poke)
                    if datos:
                        pokemon_b = PokemonBatalla(datos, nivel)
                        self.batalla_actual = Batalla(self.equipo.pokemons, pokemon_b)
                        self.batalla_actual.sub_estado = "menu_principal"
                        self.batalla_actual.es_safari = True
                        self.batalla_actual.es_gimnasio = False
                        self.menu_batalla_idx = 0
                        self.mensajes = [f"!{poke} salvaje aparecio!"]
                        self.timer_mensajes = 1.5
                        self.estado = "batalla"
                        return
                except Exception as e:
                    print(f"Error safari batalla: {e}")
        # 5% de encontrar item
        item = self.safari.item_aleatorio()
        if item:
            self.mensajes = [f"!Encontraste {item}!"]
            self.timer_mensajes = 2.0

    def _salir_safari(self):
        """Termina el Safari."""
        capturados = self.safari.terminar()
        self.mensajes = [f"!Saliste del Safari! Capturaste: {len(capturados)}"]
        self.timer_mensajes = 3.0
        self.estado = "exploracion"

    def _recuperar_tras_derrota_lider(self):
        """Si pierdes contra un lider, recuperas niveles al volver."""
        try:
            for p in self.equipo.pokemons:
                # Subir 2 niveles de golpe
                for _ in range(2):
                    if p.nivel < 100:
                        p.nivel += 1
                        p._calcular_stats() if hasattr(p, "_calcular_stats") else p._calc_stats()
                        p.ps = p.ps_max
            self.mensajes = ["Tu equipo gano 2 niveles por la experiencia del combate."]
            self.timer_mensajes = 3.0
        except Exception:
            pass

    def _admin_cargar_lista(self):
        """Carga la lista de Pokemon de la Pokedex."""
        try:
            from data.pokedex import POKEDEX_COMPLETA
            self._admin_poke_lista = sorted(
                POKEDEX_COMPLETA.keys(),
                key=lambda n: POKEDEX_COMPLETA[n].get("id", 999)
            )
        except Exception:
            self._admin_poke_lista = []

    def _admin_add_pokemon(self):
        """Anade el Pokemon seleccionado al equipo al nivel elegido."""
        if not self._admin_poke_lista:
            self._admin_mensaje = "Sin Pokemon disponibles."
            self._admin_msg_t = 2.0
            return
        if len(self.equipo.pokemons) >= 6:
            # Intentar guardar en PC
            try:
                nombre = self._admin_poke_lista[self._admin_poke_idx]
                from data.pokedex import POKEDEX_COMPLETA
                datos = POKEDEX_COMPLETA.get(nombre)
                if datos:
                    nuevo = PokemonBatalla(datos, self._admin_nivel)
                    if self.pc.guardar_pokemon(nuevo):
                        self._admin_mensaje = f"!{nombre} Nv{self._admin_nivel} al PC!"
                        self._admin_msg_t = 2.5
                        self.pokedex.registrar_capturado(nombre)
                        return
            except Exception:
                pass
            self._admin_mensaje = "Equipo y PC llenos."
            self._admin_msg_t = 2.0
            return
        nombre = self._admin_poke_lista[self._admin_poke_idx]
        try:
            from data.pokedex import POKEDEX_COMPLETA
            datos = POKEDEX_COMPLETA.get(nombre)
            if not datos:
                return
            nuevo = PokemonBatalla(datos, self._admin_nivel)
            self.equipo.agregar(nuevo)
            try:
                self.pokedex.registrar_capturado(nombre)
            except Exception:
                pass
            self._admin_mensaje = f"!{nombre} Nv{self._admin_nivel} anadido!"
            self._admin_msg_t = 2.5
            try:
                from sistemas.sonidos import Sonidos as SonAvz
                SonAvz.captura_exitosa() if hasattr(SonAvz, "captura_exitosa") else SonAvz.confirmar()
            except Exception:
                pass
        except Exception as e:
            self._admin_mensaje = f"Error: {e}"
            self._admin_msg_t = 3.0

    def _dibujar_admin_login(self):
        """Pantalla de login de admin."""
        pantalla.fill((10, 5, 20))
        # Textura de fondo
        for i in range(0, ALTO, 20):
            for j in range(0, ANCHO, 20):
                col = (25, 15, 45) if (i+j) % 40 == 0 else (15, 10, 30)
                pygame.draw.rect(pantalla, col, (j, i, 20, 20))

        # Panel central
        px, py, pw, ph = 80, 100, ANCHO - 160, ALTO - 200
        pygame.draw.rect(pantalla, (60, 30, 80), (px - 4, py - 4, pw + 8, ph + 8))
        pygame.draw.rect(pantalla, (240, 200, 60), (px - 4, py - 4, pw + 8, ph + 8), 3)
        pygame.draw.rect(pantalla, (20, 12, 35), (px, py, pw, ph))
        pygame.draw.rect(pantalla, (180, 140, 40), (px + 4, py + 4, pw - 8, ph - 8), 2)

        # Titulo
        titulo = fuente_titulo.render("PANEL DE ADMIN", True, (255, 100, 100))
        pantalla.blit(titulo, (ANCHO // 2 - titulo.get_width() // 2, py + 20))
        sub = fuente_peque.render("Introduce la contrasena de administrador",
                                    True, (200, 200, 220))
        pantalla.blit(sub, (ANCHO // 2 - sub.get_width() // 2, py + 60))

        # Campo de contrasena
        caja_x = px + 40
        caja_y = py + 100
        caja_w = pw - 80
        caja_h = 40
        pygame.draw.rect(pantalla, (15, 8, 25), (caja_x, caja_y, caja_w, caja_h))
        pygame.draw.rect(pantalla, (200, 160, 60), (caja_x, caja_y, caja_w, caja_h), 2)

        # Mostrar asteriscos
        asteriscos = "*" * len(self._admin_pwd)
        txt_pwd = fuente_grande.render(asteriscos, True, (255, 240, 180))
        pantalla.blit(txt_pwd, (caja_x + 15, caja_y + 8))

        # Cursor parpadeante
        if int(self.anim_menu * 2) % 2 == 0:
            cx = caja_x + 15 + txt_pwd.get_width() + 4
            pygame.draw.rect(pantalla, (255, 240, 180), (cx, caja_y + 8, 2, 24))

        # Info intentos
        info = fuente_peque.render(f"Caracteres: {len(self._admin_pwd)}/17",
                                    True, (150, 150, 180))
        pantalla.blit(info, (caja_x, caja_y + caja_h + 8))

        # Mensaje si hay
        if self._admin_msg_t > 0:
            col_msg = (240, 100, 100) if "Error" in self._admin_mensaje or "Incorrecta" in self._admin_mensaje else (100, 240, 120)
            msg = fuente_media.render(self._admin_mensaje, True, col_msg)
            pygame.draw.rect(pantalla, (30, 15, 40), (ANCHO//2 - msg.get_width()//2 - 10, py + 180, msg.get_width() + 20, 30))
            pantalla.blit(msg, (ANCHO // 2 - msg.get_width() // 2, py + 185))

        # Instrucciones
        tip = fuente_peque.render("[ENTER] Confirmar   [ESC] Volver al menu   [BACKSPACE] Borrar",
                                   True, (200, 200, 220))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 40))

    def _dibujar_admin_panel(self):
        """Panel de admin principal - estilo Emerald mejorado."""
        # Fondo con degradado
        for i in range(ALTO):
            r = int(20 + 20 * i / ALTO)
            g = int(10 + 15 * i / ALTO)
            b = int(35 + 25 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Cabecera con marco doble
        pygame.draw.rect(pantalla, (80, 20, 30), (0, 0, ANCHO, 56))
        pygame.draw.rect(pantalla, (255, 220, 100), (0, 52, ANCHO, 4))
        t = fuente_titulo.render("PANEL ADMIN", True, (255, 100, 100))
        ts = fuente_titulo.render("PANEL ADMIN", True, (60, 15, 15))
        pantalla.blit(ts, (ANCHO // 2 - t.get_width() // 2 + 3, 9))
        pantalla.blit(t, (ANCHO // 2 - t.get_width() // 2, 6))

        # Info del equipo en cajas
        try:
            info_txt = f"Equipo: {len(self.equipo.pokemons)}/6"
            t2 = fuente_media.render(info_txt, True, (240, 240, 220))
            pygame.draw.rect(pantalla, (40, 20, 40), (20, 62, t2.get_width() + 16, 22))
            pygame.draw.rect(pantalla, (255, 220, 100), (20, 62, t2.get_width() + 16, 22), 2)
            pantalla.blit(t2, (28, 65))
        except Exception:
            pass

        # Contador del total de Pokemon
        try:
            total_txt = f"Total: {len(self._admin_poke_lista)} Pokemon"
            t3 = fuente_media.render(total_txt, True, (200, 220, 255))
            pygame.draw.rect(pantalla, (30, 25, 50), (ANCHO - t3.get_width() - 36, 62, t3.get_width() + 16, 22))
            pygame.draw.rect(pantalla, (140, 160, 220), (ANCHO - t3.get_width() - 36, 62, t3.get_width() + 16, 22), 2)
            pantalla.blit(t3, (ANCHO - t3.get_width() - 28, 65))
        except Exception:
            pass

        if self._admin_modo == "lista":
            # Panel de lista
            bx, by = 15, 92
            bw, bh = ANCHO - 30, ALTO - 155
            # Fondo con bisel
            pygame.draw.rect(pantalla, (0, 0, 0, 100), (bx + 3, by + 3, bw, bh))
            pygame.draw.rect(pantalla, (180, 140, 40), (bx - 2, by - 2, bw + 4, bh + 4))
            pygame.draw.rect(pantalla, (255, 220, 100), (bx - 2, by - 2, bw + 4, bh + 4), 2)
            pygame.draw.rect(pantalla, (25, 18, 45), (bx, by, bw, bh))
            pygame.draw.rect(pantalla, (140, 110, 40), (bx + 3, by + 3, bw - 6, bh - 6), 1)

            # Visibles: 11 Pokemon
            n_visible = 11
            if self._admin_poke_lista:
                inicio = max(0, min(self._admin_poke_idx - 5,
                                     len(self._admin_poke_lista) - n_visible))
                inicio = max(0, inicio)
                for i in range(n_visible):
                    idx = inicio + i
                    if idx >= len(self._admin_poke_lista):
                        break
                    nombre = self._admin_poke_lista[idx]
                    sel = (idx == self._admin_poke_idx)
                    y = by + 8 + i * 30
                    # Fondo de la fila
                    if sel:
                        pygame.draw.rect(pantalla, (90, 70, 130), (bx + 8, y, bw - 16, 26))
                        pygame.draw.rect(pantalla, (255, 220, 100), (bx + 8, y, bw - 16, 26), 2)
                    else:
                        pygame.draw.rect(pantalla, (38, 30, 60), (bx + 8, y, bw - 16, 26))
                        pygame.draw.rect(pantalla, (70, 55, 95), (bx + 8, y, bw - 16, 26), 1)

                    # Sprite mini
                    sp = SPRITES.get(nombre)
                    if sp:
                        mini = pygame.transform.scale(sp, (24, 24))
                        pantalla.blit(mini, (bx + 14, y + 1))

                    # Numero ID
                    try:
                        from data.pokedex import POKEDEX_COMPLETA
                        num = POKEDEX_COMPLETA[nombre].get("id", idx + 1)
                    except Exception:
                        num = idx + 1
                    num_txt = fuente_peque.render(f"#{num:03d}", True, (180, 200, 240))
                    pantalla.blit(num_txt, (bx + 48, y + 5))

                    # Nombre
                    txt = fuente_media.render(nombre, True,
                                              (255, 240, 140) if sel else (230, 230, 245))
                    pantalla.blit(txt, (bx + 110, y + 2))

                    # Tipos
                    try:
                        from data.pokedex import POKEDEX_COMPLETA
                        tipos = POKEDEX_COMPLETA[nombre].get("tipos", [])
                        tx = bx + 340
                        for tp in tipos[:2]:
                            col_t = {"Planta": (110, 200, 100), "Fuego": (240, 120, 60),
                                     "Agua": (80, 150, 240), "Normal": (180, 180, 160),
                                     "Bicho": (170, 200, 80), "Tierra": (200, 160, 80),
                                     "Hada": (240, 170, 220), "Psiquico": (240, 100, 160),
                                     "Psíquico": (240, 100, 160),
                                     "Siniestro": (90, 70, 90), "Volador": (180, 200, 240),
                                     "Roca": (180, 150, 90), "Acero": (170, 180, 200),
                                     "Lucha": (200, 80, 60), "Veneno": (160, 90, 200),
                                     "Fantasma": (120, 100, 170), "Hielo": (140, 220, 230),
                                     "Dragon": (90, 90, 230), "Dragón": (90, 90, 230),
                                     "Electrico": (240, 210, 60),
                                     "Eléctrico": (240, 210, 60),
                                     "Sonido": (150, 220, 220)}.get(tp, (180, 180, 180))
                            pygame.draw.rect(pantalla, col_t, (tx, y + 5, 62, 18))
                            pygame.draw.rect(pantalla, (20, 15, 25), (tx, y + 5, 62, 18), 1)
                            et = fuente_peque.render(tp[:8], True, (30, 20, 30))
                            pantalla.blit(et, (tx + 31 - et.get_width() // 2, y + 7))
                            tx += 68
                    except Exception:
                        pass

                    # Indicador de seleccion
                    if sel:
                        fx = bx + 10
                        pygame.draw.polygon(pantalla, (255, 220, 100), [
                            (fx, y + 13), (fx + 8, y + 8), (fx + 8, y + 18)
                        ])

            # Panel de nivel
            nivel_y = ALTO - 58
            pygame.draw.rect(pantalla, (60, 30, 60), (15, nivel_y, 240, 40))
            pygame.draw.rect(pantalla, (255, 220, 100), (15, nivel_y, 240, 40), 3)
            pygame.draw.rect(pantalla, (100, 60, 100), (15, nivel_y, 240, 40), 1)
            n_txt = fuente_grande.render(f"NIVEL: {self._admin_nivel}", True, (255, 220, 100))
            pantalla.blit(n_txt, (135 - n_txt.get_width() // 2, nivel_y + 5))

            # Instrucciones
            tip_rect = pygame.Rect(265, nivel_y, ANCHO - 280, 40)
            pygame.draw.rect(pantalla, (25, 15, 45), tip_rect)
            pygame.draw.rect(pantalla, (100, 80, 140), tip_rect, 2)
            tips = [
                "[^/v] Navegar   [<] -1 Nv  [>] +1 Nv  [X] Anadir",
                "[-] -10  [+] +10   [H] Curar  [C] +100k  [B] Balls  [V] Nv100",
            ]
            for i, tp in enumerate(tips):
                tt = fuente_peque.render(tp, True, (220, 220, 240))
                pantalla.blit(tt, (275, nivel_y + 4 + i * 16))

        # Mensaje flotante
        if self._admin_msg_t > 0:
            col_msg = (240, 100, 100) if ("Error" in self._admin_mensaje or
                                          "lleno" in self._admin_mensaje or
                                          "Sin" in self._admin_mensaje) else (100, 240, 120)
            msg = fuente_media.render(self._admin_mensaje, True, col_msg)
            x_msg = ANCHO // 2 - msg.get_width() // 2
            pygame.draw.rect(pantalla, (30, 15, 40), (x_msg - 14, 88, msg.get_width() + 28, 32))
            pygame.draw.rect(pantalla, col_msg, (x_msg - 14, 88, msg.get_width() + 28, 32), 3)
            pantalla.blit(msg, (x_msg, 96))
    def _nueva_partida(self):
        self._trans_timer = 0.0
        try:
            from sistemas.inventario import Objeto
            for nom, (desc, col) in PIEDRAS_MEGA.items():
                o = Objeto(nom, "llave", desc, 0)
                self.inventario.agregar(o, 1)
        except Exception:
            pass
        try:
            self.bases = SistemaBases()
        except Exception:
            pass
        self._tag_team_actual = None
        self._tag_team_fase = 0
        self.danza_resultado = None
        self.danza_resultado = None
        self.frente_activo = False
        self.frente_torre = None
        self.frente_piso = 1
        self.frente_racha = 0
        self.chasqui_lista = []
        try:
            self.nuzlocke_capturas_por_mapa = {}
            self.nuzlocke_muertos = []
        except Exception:
            pass
        try:
            self.nuzlocke_capturas_por_mapa = {}
            self.nuzlocke_muertos = []
        except Exception:
            pass
        try:
            self.logros = SistemaLogros()
            self._logro_popup = None
            self._logro_popup_t = 0.0
        except Exception:
            pass
        self._creditos_vistos = False
        self._creditos_t = 0.0
        self._creditos_vistos = False
        self._creditos_t = 0.0
        try:
            import time as _t
            self._stats_partida = {
                "pasos": 0, "batallas_ganadas": 0, "batallas_perdidas": 0,
                "capturas": 0, "pokemon_vistos": 0, "dinero_gastado": 0,
                "dinero_ganado": 0, "medallas": 0, "inicio_ts": _t.time(),
                "curaciones": 0, "entrenadores_derrotados": 0,
            }
            self._tiempo_juego = 0.0
        except Exception:
            pass
        self._seguidor_cola = []
        self.equipo = Equipo()
        self.inventario = crear_inventario_inicial()
        self.gimnasios = SistemaGimnasios()
        self.historia = SistemaHistoria()
        self.pc = SistemaPC()
        self.liga = SistemaLiga()
        self.pokedex = Pokedex()
        self.mapa_actual = MapaVisual("caleta_norte")
        self.dialogo_actual = DIALOGOS_PROFESOR.get("inicio", ["¡Bienvenido!"])
        self.dialogo_hablante = "Prof. Kuntur"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "preguntar_nombre"

    # =====================================================================
    # DIBUJADO
    # =====================================================================
    def _iniciar_chasqui(self):
        """E1: lista de entrenadores derrotados para rematch."""
        try:
            from data.entrenadores import ENTRENADORES
        except Exception:
            return
        # Solo entrenadores derrotados (filtro simple y sin errores)
        derrotados = [e for e in ENTRENADORES if getattr(e, "derrotado", False)]
        if not derrotados:
            self.mensajes = ["No hay entrenadores registrados."]
            self.timer_mensajes = 1.5
            return
        # Ordenar por nivel del primer Pokemon
        try:
            derrotados.sort(key=lambda e: e.equipo_nombres[0][1] if e.equipo_nombres else 0)
        except Exception:
            pass
        self.chasqui_lista = derrotados
        self.chasqui_idx = 0
        self.estado = "chasqui_lista"

    def _iniciar_chasqui_batalla(self):
        """E1: inicia el combate rematch."""
        if not self.chasqui_lista:
            self.estado = "exploracion"
            return
        ent = self.chasqui_lista[self.chasqui_idx]
        if not self.equipo.pokemons:
            self.mensajes = ["Necesitas un Pokemon!"]
            self.timer_mensajes = 1.5
            self.estado = "exploracion"
            return
        # Crear equipo con nivel de rematch +1
        eq = ent.crear_equipo(rematch_override=ent.rematch_nivel + 1)
        if not eq:
            self.estado = "exploracion"
            return
        self.batalla_actual = Batalla(self.equipo.pokemons, eq[0])
        self.batalla_actual.sub_estado = "menu_principal"
        self.batalla_actual.es_gimnasio = True
        self.batalla_actual.es_rival = True
        self.batalla_actual.rival_equipo = eq
        self.batalla_actual.rival_poke_idx = 0
        self.batalla_actual.es_chasqui = True
        self.menu_batalla_idx = 0
        # Dialogo del rematch
        dlgs = ent.dialogo_rematch()
        self._chasqui_dialogo = dlgs
        self._chasqui_ent = ent
        self.dialogo_actual = dlgs
        self.dialogo_hablante = ent.nombre
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "chasqui_batalla"

    def _iniciar_frente(self):
        """E2: menu principal del Frente de los Apus."""
        # Verificar requisito: ser campeon
        if not getattr(self.liga, "es_campeon", False):
            self.mensajes = ["Debes ser Campeon para entrar al Frente."]
            self.timer_mensajes = 2.0
            return
        self.frente_menu_idx = 0
        self.estado = "frente_menu"

    def _iniciar_frente_torre(self, torre):
        """torre: 'condor' | 'serpiente' | 'sol'"""
        self.frente_torre = torre
        self.frente_piso = 1
        self.frente_racha = 0
        # Configuracion especial por torre
        if torre == "condor":
            # Torre del Condor: 1v1, sin curar entre pisos
            self._frente_cura_entre_pisos = False
            self._frente_max_piso = 20
        elif torre == "serpiente":
            # Palacio de la Serpiente: curacion 50%
            self._frente_cura_entre_pisos = True
            self._frente_max_piso = 15
        elif torre == "sol":
            # Templo del Sol: nivel fijo, 30 pisos
            self._frente_cura_entre_pisos = True
            self._frente_max_piso = 30
        self.estado = "frente_batalla"
        self._generar_batalla_frente()

    def _generar_batalla_frente(self):
        """E2: genera un entrenador aleatorio segun torre y piso."""
        torre = self.frente_torre
        piso = self.frente_piso
        # Nivel escala con el piso (segun torre)
        if torre == "sol":
            nivel = 50  # Nivel fijo (competitivo)
        else:
            nivel = 55 + piso * 2
        # Elegir Pokemon aleatorio
        import random
        try:
            nombres_disponibles = list(POKEDEX_COMPLETA.keys())
        except Exception:
            nombres_disponibles = ["Surito", "Cuy", "Chinchill"]
        # Filtrar legendarios para no hacerlo imposible
        no_legendarios = [n for n in nombres_disponibles if POKEDEX_COMPLETA.get(n, {}).get("id", 999) < 81]
        # Equipo del rival: 3-6 Pokemon
        n_pokes = min(3 + piso // 5, 6)
        equipo_rival = []
        for _ in range(n_pokes):
            nom = random.choice(no_legendarios)
            datos = POKEDEX_COMPLETA.get(nom)
            if datos:
                equipo_rival.append(PokemonBatalla(datos, nivel))
        if not equipo_rival:
            return
        # Nombres tematicos
        titulos = {
            "condor": "Alas del Condor",
            "serpiente": "Colmillos de la Serpiente",
            "sol": "Guardianes del Sol",
        }
        self._frente_rival_nombre = f"Piso {piso}: {titulos.get(torre, 'Retador')}"
        self._frente_equipo = equipo_rival
        # Iniciar batalla
        self.batalla_actual = Batalla(self.equipo.pokemons, equipo_rival[0])
        self.batalla_actual.sub_estado = "menu_principal"
        self.batalla_actual.es_gimnasio = True
        self.batalla_actual.es_frente = True
        self.batalla_actual.rival_equipo = equipo_rival
        self.batalla_actual.rival_poke_idx = 0
        self.menu_batalla_idx = 0
        self.mensajes = [f"!{self._frente_rival_nombre} te reta!"]
        self.timer_mensajes = 2.0
        self.estado = "batalla"

    def _siguiente_piso_frente(self):
        """E2: pasa al siguiente piso (o termina)."""
        self.frente_piso += 1
        self.frente_racha += 1
        if self.frente_piso > self.frente_max_piso:
            # Terminar torre
            self._terminar_frente()
            return
        # Curar segun regla de la torre
        try:
            if getattr(self, "_frente_cura_entre_pisos", True):
                for p in self.equipo.pokemons:
                    p.ps = min(p.ps_max, p.ps + int(p.ps_max * 0.5))
        except Exception:
            pass
        self._generar_batalla_frente()

    def _terminar_frente(self):
        """E2: fin de la torre."""
        torre = self.frente_torre
        recompensas = {
            "condor": 50000,
            "serpiente": 80000,
            "sol": 120000,
        }
        r = recompensas.get(torre, 30000)
        self.inventario.dinero += r
        self.dialogo_actual = [
            f"Has completado la Torre {'del Condor' if torre == 'condor' else 'de la Serpiente' if torre == 'serpiente' else 'del Sol'}!",
            f"Recompensa: S/ {r}",
            "Los Apus te reconocen como un verdadero maestro.",
        ]
        self.dialogo_hablante = "Chasqui"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "frente_menu"
        self.frente_activo = False

    def _dibujar_frente_menu(self):
        # Fondo espiritual andino
        for i in range(ALTO):
            r = int(20 + 40 * i / ALTO)
            g = int(15 + 30 * i / ALTO)
            b = int(40 + 60 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Estrellas
        rnd = random.Random(3)
        for i in range(80):
            px_ = rnd.randint(0, ANCHO)
            py_ = rnd.randint(0, ALTO)
            br = int(150 + 80 * math.sin(self.anim_menu * 2 + i))
            pygame.draw.rect(pantalla, (br, br, 220), (px_, py_, 1, 1))

        # Titulo
        titulo = fuente_titulo.render("FRENTE DE LOS APUS", True, (255, 220, 100))
        pantalla.blit(titulo, (ANCHO // 2 - titulo.get_width() // 2, 30))

        sub = fuente_media.render("Desafios infinitos para el Campeon",
                                   True, (220, 200, 180))
        pantalla.blit(sub, (ANCHO // 2 - sub.get_width() // 2, 72))

        # 3 torres
        torres = [
            ("condor", "TORRE DEL CONDOR", "Combates individuales 1v1", (140, 200, 240)),
            ("serpiente", "PALACIO DE LA SERPIENTE", "Combates dobles (placeholder)", (200, 140, 240)),
            ("sol", "TEMPLO DEL SOL", "Nivel fijo 50 (competitivo)", (255, 200, 100)),
        ]
        for i, (tid, nombre, desc, col) in enumerate(torres):
            y = 120 + i * 100
            x = 60
            w = ANCHO - 120
            h = 80
            sel = (i == self.frente_menu_idx)
            pygame.draw.rect(pantalla, (28, 20, 38), (x, y, w, h))
            pygame.draw.rect(pantalla, col, (x, y, w, h), 4 if sel else 2)
            if sel:
                pygame.draw.rect(pantalla, (255, 240, 180), (x + 4, y + 4, w - 8, h - 8), 1)
            # Icono
            pygame.draw.circle(pantalla, col, (x + 45, y + 40), 22)
            pygame.draw.circle(pantalla, (255, 255, 255), (x + 45, y + 40), 12, 2)
            # Texto
            tn = fuente_grande.render(nombre, True, col)
            pantalla.blit(tn, (x + 90, y + 12))
            td = fuente_peque.render(desc, True, (200, 200, 220))
            pantalla.blit(td, (x + 90, y + 45))
            # Racha
            if tid == self.frente_torre:
                tr = fuente_peque.render(f"Racha actual: {self.frente_racha}", True, (255, 240, 180))
                pantalla.blit(tr, (x + w - 200, y + 55))
            if sel:
                fx = x - 20 + int(3 * math.sin(self.anim_menu * 8))
                pygame.draw.polygon(pantalla, col,
                    [(fx, y + 40), (fx + 12, y + 32), (fx + 12, y + 48)])

        # Info de torre si esta activa
        if self.frente_torre:
            info = fuente_peque.render(
                f"Torre actual: {self.frente_torre}  -  Piso {self.frente_piso}/{self.frente_max_piso}",
                True, (240, 220, 180))
            pantalla.blit(info, (ANCHO // 2 - info.get_width() // 2, ALTO - 60))

        tip = fuente_peque.render("[UP/DN] Elegir  [X] Entrar  [ESC] Volver",
                                   True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 22))

    def _iniciar_danza(self):
        """E3: empieza el festival con el Pokemon seleccionado."""
        if not self.equipo.pokemons:
            self.mensajes = ["Necesitas un Pokemon para el festival."]
            self.timer_mensajes = 1.5
            self.estado = "menu_pausa"
            return
        poke = self.equipo.pokemons[self.danza_pokemon_idx]
        res = simular_festival(poke)
        self.danza_resultado = res
        self.danza_fase = "resultado"
        # Recompensa
        try:
            self.inventario.dinero += res["premio"]
            self.mensajes = [f"Ganaste {res['premio']} soles!"]
            self.timer_mensajes = 2.5
            # Guardar cinta en inventario
            try:
                from sistemas.inventario import OBJETOS_CLAVE, Objeto
                cinta_nom = res["cinta"]
                if cinta_nom not in OBJETOS_CLAVE:
                    OBJETOS_CLAVE[cinta_nom] = Objeto(cinta_nom, "llave",
                        f"Cinta ganada en el Festival ({res['posicion']} lugar)", 0)
                self.inventario.agregar(OBJETOS_CLAVE[cinta_nom], 1)
            except Exception:
                pass
        except Exception:
            pass

    def _dibujar_danza_elegir(self):
        # Fondo
        for i in range(ALTO):
            r = int(40 + 30 * i / ALTO)
            g = int(20 + 20 * i / ALTO)
            b = int(60 + 30 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        titulo = fuente_titulo.render("FESTIVAL DE DANZAS", True, (255, 220, 100))
        pantalla.blit(titulo, (ANCHO // 2 - titulo.get_width() // 2, 24))
        sub = fuente_peque.render("Elige a tu Pokemon participante", True, (220, 200, 180))
        pantalla.blit(sub, (ANCHO // 2 - sub.get_width() // 2, 68))

        # Lista de Pokemon del equipo
        for i, p in enumerate(self.equipo.pokemons[:6]):
            sel = (i == self.danza_pokemon_idx)
            y = 100 + i * 52
            fondo = (100, 60, 130) if sel else (30, 20, 45)
            pygame.draw.rect(pantalla, fondo, (60, y, ANCHO - 120, 46))
            borde = (255, 220, 100) if sel else (100, 80, 120)
            pygame.draw.rect(pantalla, borde, (60, y, ANCHO - 120, 46), 3 if sel else 2)
            # Sprite
            sp = SPRITES.get(p.nombre)
            if sp:
                mini = pygame.transform.scale(sp, (36, 36))
                pantalla.blit(mini, (70, y + 5))
            # Nombre y nivel
            tn = fuente_media.render(f"{p.nombre}  Nv.{p.nivel}", True, BLANCO)
            pantalla.blit(tn, (115, y + 4))
            # Amistad
            am = getattr(p, "amistad", 70)
            am_txt = fuente_peque.render(f"Amistad: {am}/255", True, (220, 220, 240))
            pantalla.blit(am_txt, (115, y + 26))
            # Tipo dominante
            try:
                tipos = p.tipos or []
                if tipos:
                    col_t = {"Planta": (110, 200, 100), "Fuego": (240, 120, 60),
                             "Agua": (80, 150, 240), "Normal": (180, 180, 160)}.get(tipos[0], (200, 200, 200))
                    pygame.draw.rect(pantalla, col_t, (ANCHO - 150, y + 12, 80, 22))
                    et = fuente_peque.render(tipos[0][:8], True, (30, 20, 30))
                    pantalla.blit(et, (ANCHO - 110 - et.get_width() // 2, y + 16))
            except Exception:
                pass

        tip = fuente_peque.render("[UP/DN] Elegir  [X] Participar  [ESC] Salir",
                                   True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 22))

    def _dibujar_danza_resultado(self):
        if not self.danza_resultado:
            self.estado = "menu_pausa"
            return
        res = self.danza_resultado
        # Fondo
        for i in range(ALTO):
            r = int(30 + 20 * i / ALTO)
            g = int(50 + 30 * i / ALTO)
            b = int(80 + 40 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        titulo = fuente_titulo.render("RESULTADO DEL FESTIVAL", True, (255, 220, 100))
        pantalla.blit(titulo, (ANCHO // 2 - titulo.get_width() // 2, 16))

        # Podio del ranking
        y0 = 70
        for i, (pts, nombre) in enumerate(res["ranking"][:5]):
            y = y0 + i * 40
            es_tu = (nombre == "Tu")
            fondo = (100, 80, 30) if es_tu else (35, 30, 50)
            pygame.draw.rect(pantalla, fondo, (60, y, ANCHO - 120, 34))
            borde = (255, 220, 100) if es_tu else (70, 60, 90)
            pygame.draw.rect(pantalla, borde, (60, y, ANCHO - 120, 34), 2)
            # Posicion
            pos_txt = fuente_grande.render(f"{i+1}°", True, (255, 240, 180) if es_tu else (200, 200, 220))
            pantalla.blit(pos_txt, (75, y + 3))
            # Nombre
            nombre_txt = fuente_media.render(nombre, True, BLANCO if es_tu else (200, 200, 220))
            pantalla.blit(nombre_txt, (140, y + 6))
            # Puntos
            pts_txt = fuente_media.render(f"{pts} pts", True, (255, 240, 180) if es_tu else (180, 180, 200))
            pantalla.blit(pts_txt, (ANCHO - 160, y + 6))

        # Detalle fase 1 y fase 2 del jugador
        y_det = 300
        pygame.draw.rect(pantalla, (25, 20, 40), (60, y_det, ANCHO - 120, 60))
        pygame.draw.rect(pantalla, (255, 220, 100), (60, y_det, ANCHO - 120, 60), 2)
        f1 = fuente_peque.render(f"Fase 1 (Movimientos): {res['fase1']} pts", True, (220, 220, 240))
        f2 = fuente_peque.render(f"Fase 2 (Combinaciones): {res['fase2']} pts", True, (220, 220, 240))
        tot = fuente_media.render(f"TOTAL: {res['puntos_jugador']} pts", True, (255, 240, 180))
        pantalla.blit(f1, (80, y_det + 8))
        pantalla.blit(f2, (80, y_det + 26))
        pantalla.blit(tot, (ANCHO - 240, y_det + 16))

        # Premio
        pr = fuente_media.render(f"Posicion #{res['posicion']}  -  Premio: S/ {res['premio']}  -  {res['cinta']}",
                                  True, (255, 220, 100))
        pantalla.blit(pr, (ANCHO // 2 - pr.get_width() // 2, ALTO - 60))

        tip = fuente_peque.render("[X/ESC] Continuar", True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 22))

    def _iniciar_tag_team(self, tag):
        """E4: inicia el combate Tag Team (2 entrenadores seguidos)."""
        if not self.equipo.pokemons:
            self.mensajes = ["Necesitas Pokemon para combatir."]
            self.timer_mensajes = 1.5
            return
        self._tag_team_actual = tag
        self._tag_team_fase = 0
        ent, es_ultimo = tag.siguiente()
        if ent is None:
            self._tag_team_actual = None
            return
        # Dialogo del primer entrenador
        self.dialogo_actual = list(ent.dialogo_pre)
        self.dialogo_hablante = ent.nombre
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "tag_team_batalla"

    def _iniciar_batalla_tag_team(self):
        """E4: lanza la batalla del entrenador actual del Tag Team."""
        tag = self._tag_team_actual
        if tag is None:
            self.estado = "exploracion"
            return
        ent, es_ultimo = tag.siguiente()
        if ent is None:
            self._tag_team_actual = None
            self.estado = "exploracion"
            return
        eq = ent.crear_equipo()
        if not eq:
            self.estado = "exploracion"
            return
        self.batalla_actual = Batalla(self.equipo.pokemons, eq[0])
        self.batalla_actual.sub_estado = "menu_principal"
        self.batalla_actual.es_gimnasio = True
        self.batalla_actual.es_rival = True
        self.batalla_actual.rival_equipo = eq
        self.batalla_actual.rival_poke_idx = 0
        self.batalla_actual.es_tag_team = True
        self.batalla_actual.tag_team_ent = ent
        self.batalla_actual.tag_team_es_ultimo = es_ultimo
        self.menu_batalla_idx = 0
        self.mensajes = [f"!{ent.nombre} te reta!"]
        self.timer_mensajes = 2.0
        self.estado = "batalla"
        self.musica.fondo("batalla_supay")

    def _terminar_batalla_tag_team(self, gano):
        """E4: maneja el fin de una batalla del Tag Team."""
        tag = self._tag_team_actual
        if tag is None:
            return False
        if not gano:
            # Perdio: fin del Tag Team
            self._tag_team_actual = None
            return False
        # Gano esta batalla
        tag.avanzar()
        if tag.completado:
            # Gano las 2 batallas: premio extra
            self.inventario.dinero += tag.premio_extra
            self.dialogo_actual = [
                f"!Has vencido a {tag.titulo}!",
                f"Premio extra: S/ {tag.premio_extra}",
            ]
            self.dialogo_hablante = tag.titulo
            self.dialogo_idx = 0
            self.estado = "dialogo"
            self.siguiente_estado_tras_dialogo = "exploracion"
            self._tag_team_actual = None
            return True
        # Pasa al segundo
        ent2, es_ultimo = tag.siguiente()
        if ent2 is not None:
            self.dialogo_actual = [
                f"!Bien hecho!",
                f"Pero ahora te toca con {ent2.nombre}...",
            ] + list(ent2.dialogo_pre)
            self.dialogo_hablante = ent2.nombre
            self.dialogo_idx = 0
            self.estado = "dialogo"
            self.siguiente_estado_tras_dialogo = "tag_team_batalla"
            return True
        return False

    def _dibujar_base_menu(self):
        """E5: menu de la base secreta actual."""
        # Fondo interior tipo huaca
        for i in range(ALTO):
            r = int(60 + 20 * i / ALTO)
            g = int(40 + 15 * i / ALTO)
            b = int(30 + 10 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Paredes con textura
        for x in range(0, ANCHO, 32):
            for y in range(0, 200, 16):
                col = (140, 100, 70) if (x//32 + y//16) % 2 == 0 else (120, 85, 60)
                pygame.draw.rect(pantalla, col, (x, y, 30, 14))
                pygame.draw.rect(pantalla, (80, 55, 35), (x, y, 30, 14), 1)

        # Suelo
        for y in range(200, ALTO):
            for x in range(0, ANCHO, 32):
                col = (170, 120, 80) if (y//32) % 2 == 0 else (150, 105, 70)
                pygame.draw.rect(pantalla, col, (x, y, 30, 30))
                pygame.draw.rect(pantalla, (100, 70, 45), (x, y, 30, 30), 1)

        # Titulo
        base = self.bases.base_actual
        if base is None:
            self.estado = "exploracion"
            return
        titulo = fuente_grande.render(f"BASE: {base.nombre}", True, (255, 220, 100))
        pantalla.blit(titulo, (ANCHO // 2 - titulo.get_width() // 2, 8))

        # Info
        info = fuente_peque.render(
            f"Decoraciones: {base.contar()}  -  Visitas: {len(base.visitas)}",
            True, (240, 220, 180))
        pantalla.blit(info, (ANCHO // 2 - info.get_width() // 2, 34))

        # Decoraciones colocadas (grid)
        for (oid, ox, oy) in base.decoraciones:
            obj = DECORACIONES.get(oid)
            if not obj:
                continue
            sx = 40 + ox * 40
            sy = 240 + oy * 40
            # Icono como cuadro
            pygame.draw.rect(pantalla, (60, 40, 30), (sx, sy, 36, 36))
            pygame.draw.rect(pantalla, (200, 160, 100), (sx, sy, 36, 36), 2)
            t = fuente_grande.render(obj.icono, True, (255, 220, 140))
            pantalla.blit(t, (sx + 18 - t.get_width() // 2, sy + 18 - t.get_height() // 2))
            # Nombre debajo
            nom = fuente_peque.render(obj.nombre[:8], True, (240, 240, 220))
            pantalla.blit(nom, (sx + 18 - nom.get_width() // 2, sy + 38))

        # Menu inferior
        opciones = ["DECORAR", "QUITAR", "DECORACIONES", "SALIR"]
        y0 = ALTO - 90
        for i, op in enumerate(opciones):
            sel = (i == self.base_menu_idx)
            col = (255, 240, 120) if sel else (220, 220, 230)
            x = 40 + i * 150
            pygame.draw.rect(pantalla, (40, 28, 48), (x, y0, 130, 32))
            pygame.draw.rect(pantalla, (240, 200, 60) if sel else (90, 70, 110), (x, y0, 130, 32), 2)
            t = fuente_media.render(op, True, col)
            pantalla.blit(t, (x + 65 - t.get_width() // 2, y0 + 6))

        # Ayuda
        tip = fuente_peque.render("[IZQ/DER] Elegir  [X] Confirmar  [F/ESC] Salir",
                                   True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 22))

    def _dibujar_base_tienda(self):
        """E5: tienda de decoraciones."""
        for i in range(ALTO):
            r = int(50 + 20 * i / ALTO)
            g = int(30 + 15 * i / ALTO)
            b = int(60 + 20 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        titulo = fuente_grande.render("TIENDA DE DECORACIONES", True, (255, 220, 100))
        pantalla.blit(titulo, (ANCHO // 2 - titulo.get_width() // 2, 12))

        # Dinero
        dinero = fuente_media.render(f"Soles: S/ {self.inventario.dinero}", True, (240, 220, 120))
        pantalla.blit(dinero, (ANCHO - dinero.get_width() - 20, 16))

        # Lista de decoraciones
        decs = list(DECORACIONES.values())
        inicio = max(0, min(self.base_tienda_idx - 5, len(decs) - 12))
        y = 50
        for i in range(12):
            idx = inicio + i
            if idx >= len(decs):
                break
            obj = decs[idx]
            sel = (idx == self.base_tienda_idx)
            fondo = (80, 60, 100) if sel else (30, 20, 40)
            pygame.draw.rect(pantalla, fondo, (20, y, ANCHO - 40, 26))
            borde = (255, 220, 100) if sel else (70, 55, 90)
            pygame.draw.rect(pantalla, borde, (20, y, ANCHO - 40, 26), 2 if sel else 1)
            col = (255, 240, 120) if sel else (220, 220, 230)
            t1 = fuente_peque.render(obj.icono + " " + obj.nombre, True, col)
            pantalla.blit(t1, (30, y + 5))
            t2 = fuente_peque.render(f"S/ {obj.precio}", True, col)
            pantalla.blit(t2, (ANCHO - 130, y + 5))
            y += 30

        tip = fuente_peque.render("[UP/DN] Elegir  [X] Comprar  [ESC] Volver",
                                   True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 22))

    def _dibujar_base_decorar(self):
        """E5: elegir posicion para decorar."""
        for i in range(ALTO):
            r = int(60 + 20 * i / ALTO)
            g = int(40 + 15 * i / ALTO)
            b = int(30 + 10 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        titulo = fuente_grande.render("DECORAR - Elige posicion", True, (255, 220, 100))
        pantalla.blit(titulo, (ANCHO // 2 - titulo.get_width() // 2, 12))

        # Grid 10x5
        base = self.bases.base_actual
        for gy in range(5):
            for gx in range(10):
                sx = 100 + gx * 44
                sy = 100 + gy * 44
                sel = (gx, gy) == self.base_decorar_pos
                # Ocupado?
                ocupado = False
                if base:
                    for (_, ox, oy) in base.decoraciones:
                        if ox == gx and oy == gy:
                            ocupado = True
                            break
                col = (80, 200, 100) if sel else ((200, 80, 80) if ocupado else (150, 120, 90))
                pygame.draw.rect(pantalla, col, (sx, sy, 40, 40))
                pygame.draw.rect(pantalla, (30, 20, 20), (sx, sy, 40, 40), 2)

        # Nombre de la decoracion seleccionada
        try:
            decs = [d for d in DECORACIONES.values()
                    if self.inventario.tiene_objeto(d.id) or True]
            dec_sel = decs[self.base_decorar_idx % len(decs)]
            nombre = fuente_media.render(f"Colocando: {dec_sel.nombre}", True, (255, 240, 180))
            pantalla.blit(nombre, (ANCHO // 2 - nombre.get_width() // 2, ALTO - 70))
        except Exception:
            pass

        tip = fuente_peque.render("[Flechas] Mover  [X] Colocar  [ESC] Volver",
                                   True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 22))

    def _iniciar_intercambio(self, intc):
        """E6: muestra la pantalla de intercambio."""
        self.intercambio_actual = intc
        self.intercambio_sel_idx = 0
        self.estado = "intercambio"

    def _confirmar_intercambio(self):
        """E6: intenta hacer el intercambio."""
        intc = self.intercambio_actual
        if intc is None:
            self.estado = "exploracion"
            return
        # Buscar el Pokemon en el equipo
        encontrado_idx = -1
        for i, p in enumerate(self.equipo.pokemons):
            if p.nombre == intc.pide_nombre and p.nivel >= intc.pide_nivel_min:
                encontrado_idx = i
                break
        if encontrado_idx < 0:
            # Fallo
            self.dialogo_actual = list(intc.dialogo_fail)
            self.dialogo_hablante = intc.npc_nombre
            self.dialogo_idx = 0
            self.estado = "dialogo"
            self.siguiente_estado_tras_dialogo = "exploracion"
            self.intercambio_actual = None
            return
        # Hacer el intercambio
        poke_viejo = self.equipo.pokemons[encontrado_idx]
        self.equipo.pokemons.pop(encontrado_idx)
        # Crear el nuevo
        try:
            from data.pokedex import POKEDEX_COMPLETA
            datos = POKEDEX_COMPLETA.get(intc.da_nombre)
            if datos:
                nuevo = PokemonBatalla(datos, intc.da_nivel)
                # Shiny?
                if intc.da_shiny:
                    try:
                        from sistemas.batalla import aplicar_shiny
                        aplicar_shiny(nuevo, forzar=True)
                    except Exception:
                        nuevo.es_shiny = True
                # Amistad inicial media
                try:
                    nuevo.amistad = 100
                except Exception:
                    pass
                # Marcar en pokedex
                self.pokedex.registrar_capturado(intc.da_nombre)
                self.equipo.agregar(nuevo)
        except Exception as e:
            print(f"Error creando intercambio: {e}")
        intc.completado = True
        self.dialogo_actual = list(intc.dialogo_ok)
        self.dialogo_hablante = intc.npc_nombre
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "exploracion"
        self.intercambio_actual = None

    def _dibujar_intercambio(self):
        intc = self.intercambio_actual
        if intc is None:
            self.estado = "exploracion"
            return
        # Fondo
        for i in range(ALTO):
            r = int(30 + 30 * i / ALTO)
            g = int(20 + 20 * i / ALTO)
            b = int(50 + 30 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Cabecera
        pygame.draw.rect(pantalla, (100, 60, 130), (0, 0, ANCHO, 46))
        pygame.draw.rect(pantalla, (240, 200, 60), (0, 44, ANCHO, 2))
        t = fuente_grande.render("INTERCAMBIO DE POKEMON", True, BLANCO)
        pantalla.blit(t, (ANCHO // 2 - t.get_width() // 2, 12))

        # Panel izquierdo: lo que pide
        pygame.draw.rect(pantalla, (28, 20, 38), (20, 70, 280, ALTO - 140))
        pygame.draw.rect(pantalla, (240, 100, 100), (20, 70, 280, ALTO - 140), 3)
        tit1 = fuente_media.render("EL NPC QUIERE:", True, (240, 120, 120))
        pantalla.blit(tit1, (35, 80))
        # Sprite
        sp = SPRITES.get(intc.pide_nombre)
        if sp:
            mini = pygame.transform.scale(sp, (72, 72))
            pantalla.blit(mini, (124, 110))
        nom = fuente_grande.render(intc.pide_nombre, True, BLANCO)
        pantalla.blit(nom, (160 - nom.get_width() // 2, 190))
        niv = fuente_media.render(f"Nv.{intc.pide_nivel_min}+", True, (220, 200, 180))
        pantalla.blit(niv, (160 - niv.get_width() // 2, 220))

        # Panel derecho: lo que da
        pygame.draw.rect(pantalla, (28, 20, 38), (ANCHO - 300, 70, 280, ALTO - 140))
        pygame.draw.rect(pantalla, (100, 240, 120), (ANCHO - 300, 70, 280, ALTO - 140), 3)
        tit2 = fuente_media.render("TU RECIBES:", True, (120, 240, 120))
        pantalla.blit(tit2, (ANCHO - 285, 80))
        sp2 = SPRITES.get(intc.da_nombre)
        if sp2:
            mini2 = pygame.transform.scale(sp2, (72, 72))
            pantalla.blit(mini2, (ANCHO - 220, 110))
        nom2 = fuente_grande.render(intc.da_nombre, True, BLANCO)
        pantalla.blit(nom2, (ANCHO - 160 - nom2.get_width() // 2, 190))
        niv2 = fuente_media.render(f"Nv.{intc.da_nivel}", True, (220, 200, 180))
        pantalla.blit(niv2, (ANCHO - 160 - niv2.get_width() // 2, 220))
        if intc.da_shiny:
            sh = fuente_peque.render("*** SHINY ***", True, (255, 240, 120))
            pantalla.blit(sh, (ANCHO - 160 - sh.get_width() // 2, 245))

        # Flechas de intercambio en el centro
        cx = ANCHO // 2
        pygame.draw.circle(pantalla, (240, 200, 60), (cx, ALTO // 2), 30)
        pygame.draw.circle(pantalla, (255, 240, 180), (cx, ALTO // 2), 24)
        for i in range(3):
            pygame.draw.polygon(pantalla, (60, 40, 20), [
                (cx - 15, ALTO // 2 - 8 + i * 8),
                (cx - 5, ALTO // 2 - 12 + i * 8),
                (cx - 5, ALTO // 2 - 4 + i * 8),
            ])
            pygame.draw.polygon(pantalla, (60, 40, 20), [
                (cx + 15, ALTO // 2 - 8 + i * 8),
                (cx + 5, ALTO // 2 - 12 + i * 8),
                (cx + 5, ALTO // 2 - 4 + i * 8),
            ])

        # Status
        tiene = False
        for p in self.equipo.pokemons:
            if p.nombre == intc.pide_nombre and p.nivel >= intc.pide_nivel_min:
                tiene = True
                break
        status = "Listo para intercambiar!" if tiene else f"No tienes {intc.pide_nombre} Nv.{intc.pide_nivel_min}+"
        col_status = (100, 240, 100) if tiene else (240, 120, 120)
        st = fuente_media.render(status, True, col_status)
        pantalla.blit(st, (ANCHO // 2 - st.get_width() // 2, ALTO - 90))

        # Ayuda
        tip = fuente_peque.render("[X] Confirmar  [ESC] Cancelar",
                                   True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 22))

    def _iniciar_creditos(self):
        """D2: inicia los creditos finales."""
        self._creditos_t = 0.0
        self._creditos_activos = True
        self.estado = "creditos"

    def _dibujar_chasqui_lista(self):
        # Fondo
        for i in range(ALTO):
            r = int(35 + 20 * i / ALTO)
            g = int(20 + 15 * i / ALTO)
            b = int(60 + 25 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Cabecera
        pygame.draw.rect(pantalla, (100, 60, 130), (0, 0, ANCHO, 46))
        pygame.draw.rect(pantalla, (240, 200, 60), (0, 44, ANCHO, 2))
        t = fuente_grande.render("LLAMADA CHASQUI", True, BLANCO)
        pantalla.blit(t, (ANCHO // 2 - t.get_width() // 2, 12))
        info = fuente_peque.render(
            "Retos a entrenadores ya vencidos (mas fuertes cada vez)",
            True, (240, 220, 180))
        pantalla.blit(info, (ANCHO // 2 - info.get_width() // 2, 50))

        # Lista (panel izquierdo)
        pygame.draw.rect(pantalla, (28, 20, 38), (10, 76, 280, ALTO - 120))
        pygame.draw.rect(pantalla, (240, 200, 60), (10, 76, 280, ALTO - 120), 2)
        if not self.chasqui_lista:
            v = fuente_media.render("(Sin entrenadores)", True, (200, 200, 210))
            pantalla.blit(v, (30, 100))
        else:
            inicio = max(0, min(self.chasqui_idx - 5, len(self.chasqui_lista) - 12))
            for i in range(12):
                idx = inicio + i
                if idx >= len(self.chasqui_lista):
                    break
                ent = self.chasqui_lista[idx]
                sel = (idx == self.chasqui_idx)
                y = 86 + i * 26
                fondo = (72, 50, 88) if sel else (40, 28, 48)
                pygame.draw.rect(pantalla, fondo, (14, y, 272, 24))
                if sel:
                    pygame.draw.rect(pantalla, (240, 200, 60), (14, y, 272, 24), 2)
                nombre = ent.nombre[:18]
                col = (255, 240, 150) if sel else (220, 220, 230)
                tn = fuente_peque.render(nombre, True, col)
                pantalla.blit(tn, (20, y + 5))
                # Badge de rematch
                if ent.rematch_nivel > 0:
                    rb = fuente_peque.render(f"x{ent.rematch_nivel}", True, (240, 120, 120))
                    pantalla.blit(rb, (270 - rb.get_width(), y + 5))

        # Detalle del seleccionado (panel derecho)
        px = 300
        pw = ANCHO - px - 10
        pygame.draw.rect(pantalla, (28, 20, 38), (px, 76, pw, ALTO - 120))
        pygame.draw.rect(pantalla, (240, 200, 60), (px, 76, pw, ALTO - 120), 2)
        if self.chasqui_lista:
            ent = self.chasqui_lista[self.chasqui_idx]
            tn = fuente_grande.render(ent.nombre, True, (255, 220, 100))
            pantalla.blit(tn, (px + 15, 86))
            tt = fuente_media.render(f"{ent.clase}  -  {ent.mapa.replace('_',' ').title()}",
                                     True, (200, 220, 255))
            pantalla.blit(tt, (px + 15, 118))
            # Nivel del rematch
            niv_actual = ent.equipo_nombres[0][1] if ent.equipo_nombres else 0
            niv_nuevo = niv_actual + (ent.rematch_nivel + 1) * 5
            rt = fuente_media.render(
                f"Proximo combate: Nv.{niv_nuevo}",
                True, (255, 180, 100))
            pantalla.blit(rt, (px + 15, 145))
            # Equipo que tendra
            eq_txt = fuente_peque.render("Equipo del rematch:", True, (200, 200, 220))
            pantalla.blit(eq_txt, (px + 15, 175))
            y_eq = 195
            for nom, niv in ent.equipo_nombres[:6]:
                t = fuente_peque.render(f"- {nom}  Nv.{niv + (ent.rematch_nivel + 1) * 5}",
                                        True, (220, 220, 230))
                pantalla.blit(t, (px + 25, y_eq))
                y_eq += 18
            # Recompensa
            recompensa = ent.recompensa * (ent.rematch_nivel + 1)
            rt = fuente_peque.render(f"Recompensa: S/ {recompensa}",
                                     True, (240, 220, 120))
            pantalla.blit(rt, (px + 15, ALTO - 90))

        tip = fuente_peque.render("[UP/DN] Navegar  [X] Retar  [ESC] Volver",
                                   True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 22))

    def _dibujar_creditos(self, dt=None):
        if dt is None:
            dt = getattr(self, "_last_dt", 1.0/60.0)
        self._creditos_t += dt
        t = self._creditos_t
        total = 24.0  # 24 segundos de creditos

        # Fondo cosmico andino
        for i in range(ALTO):
            r = int(10 + 30 * i / ALTO)
            g = int(15 + 20 * i / ALTO)
            b = int(40 + 50 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Estrellas de fondo
        rnd = random.Random(1)
        for i in range(80):
            sx = rnd.randint(0, ANCHO)
            sy = rnd.randint(0, ALTO)
            br = int(150 + 100 * math.sin(t * 2 + i))
            pygame.draw.rect(pantalla, (br, br, 200), (sx, sy, 1, 1))

        # Constelacion del Amaru dibujada
        if t > 2.0:
            alpha = min(1.0, (t - 2.0) / 1.5)
            puntos_const = [
                (80, 100), (120, 80), (180, 90), (240, 70), (300, 85),
                (360, 65), (420, 80), (480, 95), (540, 75), (580, 100),
            ]
            for i, (px_, py_) in enumerate(puntos_const[:-1]):
                nxt = puntos_const[i + 1]
                a = int(255 * alpha)
                # Linea
                for k in range(10):
                    xx = int(px_ + (nxt[0] - px_) * k / 10)
                    yy = int(py_ + (nxt[1] - py_) * k / 10)
                    pygame.draw.circle(pantalla, (200, 220, 255), (xx, yy), 1)
            for px_, py_ in puntos_const:
                pygame.draw.circle(pantalla, (255, 240, 180), (px_, py_), 3)
                pygame.draw.circle(pantalla, (255, 255, 255), (px_, py_), 1)

        # Texto con scroll
        def _txt(texto, tam, color, y, alpha=255):
            try:
                fnt = pygame.font.SysFont("consolas", tam, bold=True)
            except Exception:
                fnt = fuente_media
            ts = fnt.render(texto, True, color)
            ov = pygame.Surface(ts.get_size(), pygame.SRCALPHA)
            ov.blit(ts, (0, 0))
            ov.set_alpha(alpha)
            pantalla.blit(ov, (ANCHO // 2 - ts.get_width() // 2, y))

        # Timeline de los creditos
        if t < 3.0:
            a = min(255, int(t * 200))
            _txt("POKEMON FREEKIE", 26, (255, 220, 100), 260, a)
            _txt("Edicion Tahuantinsuyo", 18, (200, 220, 255), 300, a)
            _txt("Un homenaje a la region del Peru", 14, (180, 180, 200), 330, a)

        elif 3.0 <= t < 6.0:
            a = min(255, int((t - 3.0) * 200))
            _txt("EQUIPO FINAL", 20, (255, 200, 120), 220, a)
            # Fila de Pokemon del equipo
            try:
                for i, p in enumerate(self.equipo.pokemons[:6]):
                    sp = SPRITES.get(p.nombre)
                    if sp:
                        mini = pygame.transform.scale(sp, (56, 56))
                        px_ = 60 + i * 90
                        pantalla.blit(mini, (px_, 270))
                        try:
                            nom_t = fuente_peque.render(p.nombre[:8], True, (255, 240, 180))
                            pantalla.blit(nom_t, (px_ + 28 - nom_t.get_width() // 2, 330))
                            lv_t = fuente_peque.render(f"Nv{p.nivel}", True, (200, 220, 255))
                            pantalla.blit(lv_t, (px_ + 28 - lv_t.get_width() // 2, 348))
                        except Exception:
                            pass
            except Exception:
                pass
            _txt(f"Entrenador: {getattr(self, 'nombre_jugador', 'Freekie')}", 16,
                 (220, 220, 240), 380, a)

        elif 6.0 <= t < 9.0:
            a = min(255, int((t - 6.0) * 200))
            _txt("LOGROS", 20, (255, 200, 120), 200, a)
            st = getattr(self, "_stats_partida", {})
            logros = [
                f"Medallas obtenidas: {self.gimnasios.cantidad_medallas()}/8",
                f"Pokemon capturados: {self.pokedex.total_capturados()}/103",
                f"Batallas ganadas: {st.get('batallas_ganadas', 0)}",
                f"Entrenadores vencidos: {len(self.gimnasios.lideres_derrotados)}",
                f"Pasos recorridos: {st.get('pasos', 0):,}",
                f"Tiempo total: {int(getattr(self, '_tiempo_juego', 0)) // 3600}h "
                f"{(int(getattr(self, '_tiempo_juego', 0)) % 3600) // 60}m",
            ]
            y = 250
            for l in logros:
                _txt(l, 16, (200, 220, 255), y, a)
                y += 28

        elif 9.0 <= t < 13.0:
            a = min(255, int((t - 9.0) * 200))
            _txt("CREDITOS", 20, (255, 200, 120), 200, a)
            creditos = [
                "Diseno y programacion: Freekie",
                "Inspirado en: Pokemon Esmeralda (Game Freak)",
                "Region: Tahuantinsuyo (Peru)",
                "",
                "Pokemon originales: 103",
                "Musica: Chiptune procedural",
                "Graficos: Pixel art procedural",
                "",
                "Agradecimientos especiales:",
                "Los Apus, los Andes, y el Peru entero.",
            ]
            y = 240
            for l in creditos:
                if l:
                    _txt(l, 14, (200, 220, 255), y, a)
                y += 22

        elif 13.0 <= t < 17.0:
            a = min(255, int((t - 13.0) * 200))
            _txt("AGRADECIMIENTOS", 20, (255, 200, 120), 200, a)
            agradecimientos = [
                "A Kuntur, el guardian de los cielos.",
                "A Pachamama, la madre tierra.",
                "A Wira-Titan, el arquitecto.",
                "A Supay-Dread, el guardian de sombras.",
                "Y al Amaru, que vela por el Tahuantinsuyo.",
            ]
            y = 260
            for l in agradecimientos:
                _txt(l, 15, (220, 200, 240), y, a)
                y += 26

        elif 17.0 <= t < 21.0:
            a = min(255, int((t - 17.0) * 200))
            # Silueta del Amaru animada
            ay = 130 + int(10 * math.sin(t * 2))
            pygame.draw.polygon(pantalla, (255, 220, 100), [
                (220, ay+60), (260, ay+30), (320, ay+20), (400, ay+30), (440, ay+60),
                (420, ay+90), (360, ay+100), (280, ay+95), (230, ay+80)])
            _txt("El Amaru te reconoce como Campeon", 18, (255, 240, 180), 260, a)
            _txt("del Tahuantinsuyo.", 18, (255, 240, 180), 285, a)
            _txt("Pero tu viaje no termina aqui...", 16, (200, 220, 255), 320, a)
            _txt("El Post-Game te espera.", 14, (180, 200, 240), 345, a)

        elif 21.0 <= t < 24.0:
            a = min(255, int((t - 21.0) * 200))
            _txt("FIN", 40, (255, 220, 100), 220, a)
            _txt("Gracias por jugar", 20, (220, 220, 240), 290, a)
            _txt("Pokemon Freekie - Edicion Tahuantinsuyo", 14, (180, 200, 240), 330, a)

        # Instruccion
        if t < total - 1:
            try:
                hint = fuente_peque.render("[X] Saltar creditos", True, (140, 140, 170))
                pantalla.blit(hint, (ANCHO // 2 - hint.get_width() // 2, ALTO - 24))
            except Exception:
                pass

        # Fin
        if t >= total:
            self._creditos_activos = False
            self._creditos_t = 0.0
            self.estado = "menu_principal"
            self.menu_principal_idx = 0

    def _dibujar_popup_logro(self):
        """Muestra notificacion de logro desbloqueado."""
        if not self._logro_popup:
            return
        logro = self._logro_popup
        # Animacion: entra desde arriba
        t = 3.5 - self._logro_popup_t
        if t < 0.3:
            prog = t / 0.3
        elif self._logro_popup_t < 0.4:
            prog = self._logro_popup_t / 0.4
        else:
            prog = 1.0
        prog = max(0.0, min(1.0, prog))
        y = int(-70 + 90 * prog)
        ancho = 420
        x = ANCHO // 2 - ancho // 2
        # Fondo con borde dorado
        pygame.draw.rect(pantalla, (32, 24, 40), (x, y, ancho, 60))
        pygame.draw.rect(pantalla, (240, 200, 60), (x, y, ancho, 60), 3)
        pygame.draw.rect(pantalla, (255, 240, 180), (x + 3, y + 3, ancho - 6, 54), 1)
        # Icono de trofeo
        pygame.draw.circle(pantalla, (240, 200, 60), (x + 30, y + 30), 16)
        pygame.draw.circle(pantalla, (255, 240, 180), (x + 30, y + 30), 13)
        pygame.draw.circle(pantalla, (140, 100, 30), (x + 30, y + 30), 8, 2)
        # Texto
        t1 = fuente_peque.render("LOGRO DESBLOQUEADO", True, (240, 200, 60))
        pantalla.blit(t1, (x + 58, y + 8))
        t2 = fuente_media.render(logro.nombre, True, BLANCO)
        pantalla.blit(t2, (x + 58, y + 24))
        t3 = fuente_peque.render(logro.descripcion[:48], True, (200, 200, 220))
        pantalla.blit(t3, (x + 58, y + 42))

    def _dibujar_logros(self):
        """Pantalla completa de logros."""
        # Fondo
        for i in range(ALTO):
            r = int(30 + 20 * i / ALTO)
            g = int(25 + 15 * i / ALTO)
            b = int(50 + 30 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Cabecera
        pygame.draw.rect(pantalla, (60, 40, 90), (0, 0, ANCHO, 44))
        pygame.draw.rect(pantalla, (240, 200, 60), (0, 42, ANCHO, 2))
        t = fuente_grande.render("LOGROS", True, BLANCO)
        pantalla.blit(t, (ANCHO // 2 - t.get_width() // 2, 12))

        # Contador
        info = fuente_peque.render(
            f"{self.logros.cantidad()}/{self.logros.total()} desbloqueados",
            True, (240, 220, 180))
        pantalla.blit(info, (ANCHO // 2 - info.get_width() // 2, 48))

        # Barra de progreso
        try:
            bar_x = ANCHO // 2 - 150
            pygame.draw.rect(pantalla, (30, 25, 40), (bar_x, 64, 300, 8))
            relleno = int(300 * self.logros.progreso())
            pygame.draw.rect(pantalla, (100, 220, 120), (bar_x, 64, relleno, 8))
            pygame.draw.rect(pantalla, (240, 200, 60), (bar_x, 64, 300, 8), 1)
        except Exception:
            pass

        # Lista de logros (3 columnas)
        try:
            from data.logros import LOGROS
            logros_lista = list(LOGROS.values())
        except Exception:
            logros_lista = []

        col_w = ANCHO // 3
        por_col = 8
        for col in range(3):
            for i in range(por_col):
                idx = col * por_col + i
                if idx >= len(logros_lista):
                    break
                l = logros_lista[idx]
                x = col * col_w + 10
                y = 80 + i * 36
                desb = l.id in self.logros.desbloqueados
                # Fondo
                fondo = (60, 45, 30) if desb else (35, 30, 45)
                pygame.draw.rect(pantalla, fondo, (x, y, col_w - 20, 32))
                borde = (240, 200, 60) if desb else (70, 60, 80)
                pygame.draw.rect(pantalla, borde, (x, y, col_w - 20, 32), 2)
                # Icono
                ic_col = (240, 200, 60) if desb else (100, 100, 110)
                pygame.draw.circle(pantalla, ic_col, (x + 16, y + 16), 10)
                if desb:
                    pygame.draw.circle(pantalla, (255, 240, 180), (x + 16, y + 16), 6)
                # Texto
                col_t = (255, 240, 180) if desb else (150, 150, 160)
                nom = fuente_peque.render(l.nombre[:20], True, col_t)
                pantalla.blit(nom, (x + 32, y + 4))
                desc = fuente_peque.render(l.descripcion[:30], True,
                                            (200, 200, 220) if desb else (110, 110, 120))
                pantalla.blit(desc, (x + 32, y + 18))

        # Pie
        tip = fuente_peque.render("[ESC/F] Volver", True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 22))

    def _dibujar_elegir_modo(self):
        """D7: elegir entre Normal y Nuzlocke."""
        pantalla.fill((15, 10, 25))
        for i in range(30):
            px_ = (i * 173) % ANCHO
            py_ = (i * 97) % ALTO
            pygame.draw.rect(pantalla, (200, 200, 220), (px_, py_, 1, 1))

        titulo = fuente_titulo.render("ELIGE TU MODO", True, (240, 200, 60))
        pantalla.blit(titulo, (ANCHO // 2 - titulo.get_width() // 2, 40))

        # Dos botones
        opciones = [
            ("NORMAL", "Modo clasico. Sin restricciones.", (100, 180, 240)),
            ("NUZLOCKE", "Solo puedes capturar 1 Pokemon por zona.", (240, 120, 120)),
        ]
        for i, (nom, desc, col) in enumerate(opciones):
            y = 130 + i * 130
            x = 60
            w = ANCHO - 120
            h = 110
            sel = (i == self.modo_idx)
            pygame.draw.rect(pantalla, (32, 24, 40), (x, y, w, h))
            pygame.draw.rect(pantalla, col, (x, y, w, h), 4 if sel else 2)
            if sel:
                pygame.draw.rect(pantalla, (255, 240, 180), (x + 4, y + 4, w - 8, h - 8), 1)
            t = fuente_titulo.render(nom, True, col)
            pantalla.blit(t, (x + 40, y + 20))
            d = fuente_media.render(desc, True, (220, 220, 240))
            pantalla.blit(d, (x + 40, y + 70))
            if sel:
                fx = x - 20 + int(3 * math.sin(self.anim_menu * 8))
                pygame.draw.polygon(pantalla, col,
                    [(fx, y + 55), (fx + 12, y + 48), (fx + 12, y + 62)])

        tip = fuente_peque.render("[X/Enter] Confirmar    [ESC] Volver", True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 30))

    def _dibujar_menu_logros_simple(self):
        """Menu principal: logros."""
        # Fondo
        for i in range(ALTO):
            r = int(20 + 25 * i / ALTO)
            g = int(20 + 20 * i / ALTO)
            b = int(40 + 30 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Cabecera
        pygame.draw.rect(pantalla, (60, 40, 90), (0, 0, ANCHO, 44))
        pygame.draw.rect(pantalla, (240, 200, 60), (0, 42, ANCHO, 2))
        t = fuente_grande.render("LOGROS DEL JUEGO", True, BLANCO)
        pantalla.blit(t, (ANCHO // 2 - t.get_width() // 2, 12))

        # Info
        try:
            from data.logros import LOGROS
            total = len(LOGROS)
        except Exception:
            total = 30
        info = fuente_peque.render(
            f"{self.logros.cantidad() if hasattr(self, 'logros') else 0}/{total} desbloqueados",
            True, (240, 220, 180))
        pantalla.blit(info, (ANCHO // 2 - info.get_width() // 2, 50))

        # Lista
        try:
            from data.logros import LOGROS
            logros_lista = list(LOGROS.values())
        except Exception:
            logros_lista = []
        y = 80
        for i, l in enumerate(logros_lista[:12]):
            desb = hasattr(self, "logros") and l.id in self.logros.desbloqueados
            fondo = (60, 45, 30) if desb else (35, 30, 45)
            pygame.draw.rect(pantalla, fondo, (20, y, ANCHO - 40, 28))
            borde = (240, 200, 60) if desb else (70, 60, 80)
            pygame.draw.rect(pantalla, borde, (20, y, ANCHO - 40, 28), 2)
            col_t = (255, 240, 180) if desb else (150, 150, 160)
            nom = fuente_peque.render(l.nombre, True, col_t)
            pantalla.blit(nom, (32, y + 6))
            desc = fuente_peque.render(l.descripcion[:50], True,
                                        (200, 200, 220) if desb else (110, 110, 120))
            pantalla.blit(desc, (220, y + 6))
            y += 32

        tip = fuente_peque.render("[ESC] Volver", True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 22))

    def _dibujar_intro(self, dt=None):
        if dt is None:
            dt = getattr(self, "_last_dt", 1.0/60.0)
        self._intro_timer = getattr(self, "_intro_timer", 0.0) + dt
        t = self._intro_timer
        total = 10.0

        # Fondo negro profundo con estrellas
        pantalla.fill((6, 4, 16))
        rnd = random.Random(42)
        for i in range(80):
            sx = rnd.randint(0, ANCHO)
            sy = rnd.randint(0, ALTO)
            br = (int(t * 20 + i) % 30) / 30
            c = (int(180 + 60 * br), int(180 + 60 * br), int(220 + 35 * br))
            pygame.draw.rect(pantalla, c, (sx, sy, 1 + i % 2, 1 + i % 2))

        # Texto centrado con sombra
        def _txt(texto, y, tam, color, alpha=255):
            try:
                fnt = pygame.font.SysFont("consolas", tam, bold=True)
            except Exception:
                fnt = fuente_grande
            txt = fnt.render(texto, True, color)
            sh = fnt.render(texto, True, (0, 0, 0))
            ov = pygame.Surface(txt.get_size(), pygame.SRCALPHA)
            ov.blit(txt, (0, 0))
            ov.set_alpha(alpha)
            ov_sh = pygame.Surface(sh.get_size(), pygame.SRCALPHA)
            ov_sh.blit(sh, (0, 0))
            ov_sh.set_alpha(int(alpha * 0.7))
            pantalla.blit(ov_sh, (ANCHO // 2 - txt.get_width() // 2 + 2, y + 2))
            pantalla.blit(ov, (ANCHO // 2 - txt.get_width() // 2, y))

        # FASES
        if 0.0 <= t < 2.5:
            a = min(255, int(t * 200))
            _txt("Hace eones...", 180, 26, (220, 200, 150), a)
            _txt("el Tahuantinsuyo era un lienzo", 220, 20, (200, 180, 130), a)
            _txt("de energia pura.", 250, 20, (200, 180, 130), a)

        elif 2.5 <= t < 5.0:
            tt = t - 2.5
            a = min(255, int(tt * 200))
            # Circulo pulsante
            br = int(math.sin(t * 4) * 8)
            for i in range(3):
                pygame.draw.circle(pantalla, (255, 220, 80),
                                   (ANCHO // 2, 150), 30 + i * 8 + br, 2)
            pygame.draw.circle(pantalla, (255, 240, 180), (ANCHO // 2, 150), 25 + br)
            pygame.draw.circle(pantalla, (255, 255, 255), (ANCHO // 2, 150), 12)
            _txt("Del nucleo de Omega-Inca", 220, 22, (255, 220, 100), a)
            _txt("brotaron toda la vida y la energia", 250, 20, (255, 220, 100), a)
            _txt("de los Pokemon del Peru.", 280, 20, (255, 220, 100), a)

        elif 5.0 <= t < 7.0:
            tt = t - 5.0
            a = min(255, int(tt * 200))
            # Cruz roja
            cx, cy = ANCHO // 2, 130
            pygame.draw.line(pantalla, (180, 30, 30), (cx - 50, cy - 30), (cx + 50, cy + 30), 8)
            pygame.draw.line(pantalla, (180, 30, 30), (cx + 50, cy - 30), (cx - 50, cy + 30), 8)
            pygame.draw.line(pantalla, (240, 60, 60), (cx - 48, cy - 28), (cx + 48, cy + 28), 3)
            pygame.draw.line(pantalla, (240, 60, 60), (cx + 48, cy - 28), (cx - 48, cy + 28), 3)
            _txt("Pero una sombra se cierne...", 230, 24, (240, 80, 80), a)
            _txt("El Team Supay busca despertar al Amaru", 265, 18, (220, 60, 60), a)
            _txt("y reescribir la geografia de la region.", 290, 18, (220, 60, 60), a)

        elif 7.0 <= t < 10.0:
            tt = t - 7.0
            a = min(255, int(tt * 200))
            _txt("Tu mision...", 160, 26, (255, 240, 180), a)
            _txt("detenerlos y convertirte en", 210, 20, (255, 240, 180), a)
            _txt("el nuevo Campeon del Tahuantinsuyo.", 240, 22, (255, 240, 180), a)
            # Silueta de iniciales
            try:
                for i, nom in enumerate(["Alpaka", "Feligaro", "Bufeito"]):
                    sp = SPRITES.get(nom)
                    if sp:
                        sil = pygame.transform.scale(sp, (72, 72)).copy()
                        sil.fill((255, 255, 255, a), special_flags=pygame.BLEND_RGBA_MULT)
                        px_ = ANCHO // 2 - 110 + i * 80
                        pantalla.blit(sil, (px_, 300))
            except Exception:
                pass

        # Hint
        if t < total - 1:
            try:
                hint = fuente_peque.render("[X] Saltar intro", True, (150, 150, 170))
                pantalla.blit(hint, (ANCHO // 2 - hint.get_width() // 2, ALTO - 30))
            except Exception:
                pass
        else:
            self._nueva_partida()
            self._intro_timer = 0.0
    def _iniciar_intro(self):
        self._intro_timer = 0.0
        self.estado = "intro"

    def _dibujar_menu_principal(self):
        # D3: incrementar timer de animacion
        try:
            self._titulo_t += 1.0 / 60.0
        except Exception:
            self._titulo_t = 0.0
        tt = self._titulo_t

        # Fondo degradado: atardecer andino
        for i in range(ALTO):
            r = max(0, min(255, int(240 - 100 * i / ALTO)))
            g = max(0, min(255, int(140 - 60 * i / ALTO)))
            b = max(0, min(255, int(80 + 100 * i / ALTO)))
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Sol que baja
        sol_y = 130 + int(6 * math.sin(tt * 0.6))
        pygame.draw.circle(pantalla, (255, 220, 120), (ANCHO // 2, sol_y), 44)
        pygame.draw.circle(pantalla, (255, 240, 180), (ANCHO // 2, sol_y), 36)

        # Cordilleras en capas
        pygame.draw.polygon(pantalla, (72, 56, 88),
            [(0, 320), (100, 220), (200, 290), (300, 200), (400, 260),
             (500, 180), (640, 240), (640, 480), (0, 480)])
        pygame.draw.polygon(pantalla, (48, 40, 64),
            [(0, 380), (150, 300), (280, 340), (400, 280), (520, 330),
             (640, 300), (640, 480), (0, 480)])

        # F9b: Condor andino majestuoso
        try:
            self._dibujar_condor_detallado(ANCHO // 2, 190 + int(8 * math.sin(tt * 0.6)), tt, 1.0)
        except Exception as e:
            print(f"Error Condor: {e}")

        # D3: Particulas (hojas + nieve)
        rnd = random.Random(7)
        for i in range(25):
            if i % 2 == 0:
                # Hojas cayendo (izquierda)
                px_ = (i * 173 + int(tt * 40)) % (ANCHO // 2)
                py_ = (i * 97 + int(tt * 60)) % ALTO
                pygame.draw.ellipse(pantalla, (110, 200, 90), (px_, py_, 3, 2))
            else:
                # Nieve cayendo (derecha)
                px_ = ANCHO // 2 + (i * 137 + int(tt * 30)) % (ANCHO // 2)
                py_ = (i * 79 + int(tt * 50)) % ALTO
                pygame.draw.circle(pantalla, (240, 245, 255), (px_, py_), 1)

        # Titulo con sombra
        titulo = "POKEMON FREEKIE"
        for dx, dy in [(-2,-2),(2,-2),(-2,2),(2,2),(-2,0),(2,0),(0,-2),(0,2)]:
            t_sh = fuente_titulo.render(titulo, True, (80, 20, 20))
            pantalla.blit(t_sh, (ANCHO // 2 - t_sh.get_width() // 2 + dx, 60 + dy))
        t_titulo = fuente_titulo.render(titulo, True, (240, 60, 60))
        pantalla.blit(t_titulo, (ANCHO // 2 - t_titulo.get_width() // 2, 60))

        # Subtitulo
        sub = "Edicion Tahuantinsuyo"
        ts = fuente_grande.render(sub, True, (255, 240, 180))
        px_s = ANCHO // 2 - ts.get_width() // 2
        pygame.draw.rect(pantalla, (140, 100, 40), (px_s - 10, 108, ts.get_width() + 20, 30))
        pygame.draw.rect(pantalla, (240, 200, 60), (px_s - 10, 108, ts.get_width() + 20, 30), 2)
        pantalla.blit(ts, (px_s, 112))

        # Opciones (con animacion de pulso)
        ops = ["NUEVA PARTIDA", "CARGAR PARTIDA", "LOGROS", "SALIR"]
        y = 320
        for i, op in enumerate(ops):
            sel = (i == self.menu_principal_idx)
            col = (255, 240, 100) if sel else BLANCO
            t_op = fuente_grande.render(op, True, col)
            w = t_op.get_width() + 40
            x = ANCHO // 2 - w // 2
            pygame.draw.rect(pantalla, (32, 24, 40), (x, y - 4, w, 32))
            pygame.draw.rect(pantalla, (100, 80, 120), (x, y - 4, w, 32), 2)
            if sel:
                pygame.draw.rect(pantalla, (240, 200, 60), (x, y - 4, w, 32), 3)
                fa = int(3 * math.sin(tt * 6))
                pygame.draw.polygon(pantalla, (240, 200, 60),
                    [(x - 20 + fa, y + 12), (x - 8 + fa, y + 6), (x - 8 + fa, y + 18)])
            pantalla.blit(t_op, (ANCHO // 2 - t_op.get_width() // 2, y))
            y += 42

        # Info de partida (D5) si existe guardado
        try:
            from sistemas.guardado import obtener_info_guardado
            info = obtener_info_guardado(1)
            if info:
                txt = fuente_peque.render(
                    f"Ultima partida: {info['nombre']}  Nv.{info['nivel']}  "
                    f"Medallas {info['medallas']}/8",
                    True, (240, 220, 180))
                pygame.draw.rect(pantalla, (30, 20, 40),
                                 (ANCHO // 2 - txt.get_width() // 2 - 8,
                                  ALTO - 34, txt.get_width() + 16, 20))
                pantalla.blit(txt, (ANCHO // 2 - txt.get_width() // 2, ALTO - 30))
        except Exception:
            pass

        # Pie
        tp = fuente_peque.render("Flechas: mover   X/Enter: seleccionar",
                                 True, (240, 240, 200))
        pantalla.blit(tp, (ANCHO // 2 - tp.get_width() // 2, ALTO - 16))
    def _dibujar_seleccion_slot(self):
        # Fondo degradado
        for i in range(ALTO):
            r = int(20 + 40 * i / ALTO)
            g = int(30 + 50 * i / ALTO)
            b = int(70 + 60 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Estrellas
        for i in range(30):
            px_ = (i * 137 + int(self.anim_menu * 20)) % ANCHO
            py_ = (i * 89) % 200
            pygame.draw.rect(pantalla, (240, 240, 200), (px_, py_, 2, 2))

        titulo = fuente_grande.render("SELECCIONAR PARTIDA", True, BLANCO)
        pantalla.blit(titulo, (ANCHO // 2 - titulo.get_width() // 2, 24))

        try:
            from sistemas.guardado import obtener_info_guardado, existe_guardado
        except Exception:
            obtener_info_guardado = None
            def existe_guardado(s): return False

        # 3 slots con preview
        for i in range(3):
            slot = i + 1
            sel = (i == self.slot_idx)
            x = 40
            y = 80 + i * 130
            w = ANCHO - 80
            h = 118
            # Panel
            col_marco = AMARILLO_SOL if sel else (100, 90, 120)
            pygame.draw.rect(pantalla, (28, 20, 38), (x, y, w, h))
            pygame.draw.rect(pantalla, col_marco, (x, y, w, h), 3 if sel else 2)
            if sel:
                pygame.draw.rect(pantalla, (60, 40, 80), (x + 4, y + 4, w - 8, h - 8), 1)

            # Titulo del slot
            tag = fuente_grande.render(f"Slot {slot}", True, col_marco)
            pantalla.blit(tag, (x + 14, y + 8))

            info = None
            try:
                if obtener_info_guardado:
                    info = obtener_info_guardado(slot)
            except Exception:
                info = None

            if info is None:
                # Slot vacio
                vacio = fuente_media.render("— Vacio —", True, (150, 140, 160))
                pantalla.blit(vacio, (x + 14, y + 50))
                sub = fuente_peque.render("(Presiona X para empezar una nueva partida aqui)",
                                          True, (180, 170, 190))
                pantalla.blit(sub, (x + 14, y + 82))
            else:
                # Info del slot
                nom = fuente_media.render(
                    f"Entrenador: {info['nombre']}", True, (255, 240, 180))
                pantalla.blit(nom, (x + 14, y + 38))
                lider = fuente_peque.render(
                    f"Lider: {info['lider']}  Nv.{info['nivel']}",
                    True, (220, 220, 240))
                pantalla.blit(lider, (x + 14, y + 62))
                med = fuente_peque.render(
                    f"Medallas: {info['medallas']}/8   Tiempo: {info['horas']:02d}h {info['minutos']:02d}m",
                    True, (220, 220, 240))
                pantalla.blit(med, (x + 14, y + 80))
                fecha = fuente_peque.render(
                    f"Guardado: {info['fecha']}", True, (200, 200, 220))
                pantalla.blit(fecha, (x + 14, y + 96))

                # Sprites del equipo (mini)
                try:
                    for j, p in enumerate(info.get("equipo", [])[:6]):
                        sp = SPRITES.get(p.get("nombre", ""))
                        if sp:
                            mini = pygame.transform.scale(sp, (28, 28))
                            pantalla.blit(mini, (ANCHO - 220 + j * 32, y + 60))
                except Exception:
                    pass

        tip = fuente_peque.render(
            "[↑/↓] Elegir   [X] Cargar   [ESC] Volver",
            True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 22))
    def _wrap_texto(self, texto, fuente, ancho_max):
        palabras = texto.split()
        lineas, actual = [], ""
        for p in palabras:
            prueba = actual + " " + p if actual else p
            if fuente.size(prueba)[0] < ancho_max:
                actual = prueba
            else:
                if actual:
                    lineas.append(actual)
                actual = p
        if actual:
            lineas.append(actual)
        return lineas

    def _dibujar_dialogo_entrenador(self):
        self._dibujar_exploracion()
        overlay = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 120))
        pantalla.blit(overlay, (0, 0))
        # ... resto igual

        bx, by, bw, bh = 16, 300, ANCHO - 32, 156
        pygame.draw.rect(pantalla, (32, 24, 40), (bx, by, bw, bh))
        pygame.draw.rect(pantalla, (240, 240, 200), (bx + 3, by + 3, bw - 6, bh - 6), 2)

        retrato_ancho = 0
        if self.entrenador_actual:
            try:
                from sistemas.retratos import Retratos
                ret = Retratos.obtener(self.entrenador_actual.nombre, 108, self.anim_menu)
                rx = bx + 10; ry = by + 14
                pygame.draw.rect(pantalla, (60, 30, 40), (rx - 4, ry - 4, 116, 116))
                pygame.draw.rect(pantalla, (200, 160, 60), (rx - 4, ry - 4, 116, 116), 3)
                pygame.draw.rect(pantalla, (24, 18, 32), (rx, ry, 108, 108))
                pantalla.blit(ret, (rx + 4, ry + 4))
                retrato_ancho = 132
            except Exception:
                pass

        if self.entrenador_actual:
            tag = fuente_media.render(self.entrenador_actual.nombre, True, (255, 240, 180))
            tw = tag.get_width() + 20
            pygame.draw.rect(pantalla, (32, 24, 40), (bx + 8, by - 18, tw, 22))
            pygame.draw.rect(pantalla, (240, 200, 60), (bx + 8, by - 18, tw, 22), 2)
            pantalla.blit(tag, (bx + 18, by - 16))

        if self.dialogo_entrenador and self.dialogo_entrenador_idx < len(self.dialogo_entrenador):
            texto = self.dialogo_entrenador[self.dialogo_entrenador_idx]
            nombre_jug = getattr(self, "nombre_jugador", "Freekie")
            texto = texto.replace("[Nombre del Jugador]", nombre_jug)
            texto = texto.replace("[Nombre]", nombre_jug)
            x_texto = bx + 20 + retrato_ancho
            ancho_texto = bw - 40 - retrato_ancho
            y = by + 24
            for linea in self._wrap_texto(texto, fuente_media, ancho_texto):
                pantalla.blit(fuente_media.render(linea, True, BLANCO), (x_texto, y))
                y += 26

    def _dibujar_seleccion_inicial(self):
        # Fondo con degradado cordillerano
        for i in range(ALTO):
            r = int(20 + 40 * i / ALTO)
            g = int(50 + 60 * i / ALTO)
            b = int(110 + 60 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Estrellas chiptune
        for i in range(30):
            px = (i * 137 + int(self.anim_menu * 20)) % ANCHO
            py = (i * 89) % 120
            pygame.draw.rect(pantalla, (240, 240, 200), (px, py, 2, 2))

        t = fuente_grande.render("Elige a tu compañero inicial", True, BLANCO)
        pantalla.blit(t, (ANCHO//2 - t.get_width()//2, 24))

        for i, nombre in enumerate(self.iniciales):
            x = 60 + i * 180
            y = 70
            es_sel = (i == self.inicial_idx)
            col_marco = AMARILLO_SOL if es_sel else GRIS_PIEDRA
            borde = 4 if es_sel else 2

            if es_sel:
                sombra = pygame.Surface((170, 232), pygame.SRCALPHA)
                sombra.fill((0, 0, 0, 100))
                pantalla.blit(sombra, (x - 4 + 3, y - 4 + 3))
            pygame.draw.rect(pantalla, col_marco, (x - 8, y - 8, 160, 232), borde)
            pygame.draw.rect(pantalla, CREMA, (x - 4, y - 4, 152, 224))

            sp = SPRITES.get(nombre)
            if sp:
                sp_big = pygame.transform.scale(sp, (72, 72))
                pantalla.blit(sp_big, (x + 40, y + 6))

            t = fuente_media.render(nombre, True, NEGRO)
            pantalla.blit(t, (x + 76 - t.get_width() // 2, y + 84))

            tipo = POKEDEX_COMPLETA.get(nombre, {}).get("tipos", ["?"])[0]
            col_tipo = {"Planta": (110, 200, 100), "Fuego": (240, 120, 60),
                        "Agua": (80, 150, 240)}.get(tipo, GRIS_PIEDRA)
            pygame.draw.rect(pantalla, col_tipo, (x + 8, y + 108, 60, 20))
            pygame.draw.rect(pantalla, NEGRO, (x + 8, y + 108, 60, 20), 1)
            tt = fuente_peque.render(tipo, True, BLANCO)
            pantalla.blit(tt, (x + 38 - tt.get_width() // 2, y + 110))

            datos = POKEDEX_COMPLETA.get(nombre, {})
            sb = datos.get("stats_base", {})
            stats = [("PS", sb.get("ps", 0), 255),
                     ("ATQ", sb.get("atq", 0), 200),
                     ("DEF", sb.get("def", 0), 200),
                     ("VEL", sb.get("vel", 0), 200)]
            y_st = y + 138
            for etiq, val, maxv in stats:
                lbl = fuente_peque.render(etiq, True, GRIS_PIEDRA)
                pantalla.blit(lbl, (x + 8, y_st))
                pygame.draw.rect(pantalla, (200, 190, 170), (x + 36, y_st + 4, 100, 6))
                ancho = int(100 * min(1.0, val / maxv))
                color_barra = (80, 180, 90) if val >= 80 else \
                              (220, 180, 60) if val >= 50 else (200, 100, 100)
                pygame.draw.rect(pantalla, color_barra, (x + 36, y_st + 4, ancho, 6))
                pygame.draw.rect(pantalla, NEGRO, (x + 36, y_st + 4, 100, 6), 1)
                vlbl = fuente_peque.render(str(val), True, NEGRO)
                pantalla.blit(vlbl, (x + 140, y_st))
                y_st += 16

        nombre_sel = self.iniciales[self.inicial_idx]
        datos_sel = POKEDEX_COMPLETA.get(nombre_sel, {})
        desc = datos_sel.get("descripcion", "Sin descripción disponible.")
        pygame.draw.rect(pantalla, (24, 18, 32), (30, 328, ANCHO - 60, 92))
        pygame.draw.rect(pantalla, DORADO_LIGA, (30, 328, ANCHO - 60, 92), 2)
        tt = fuente_peque.render(
            f"#{datos_sel.get('id', 0):03d}  {nombre_sel}  ·  "
            f"Cat: {datos_sel.get('categoria', '?')}  ·  "
            f"{datos_sel.get('altura', '?')} m / {datos_sel.get('peso', '?')} kg",
            True, DORADO_LIGA)
        pantalla.blit(tt, (44, 334))
        y_d = 354
        for ln in self._wrap_texto(desc, fuente_peque, ANCHO - 100)[:3]:
            t2 = fuente_peque.render(ln, True, (220, 220, 240))
            pantalla.blit(t2, (44, y_d))
            y_d += 18

        inst = fuente_peque.render(
            "[←/→] Navegar    [X/Z/Enter] Confirmar", True, AMARILLO_SOL)
        pantalla.blit(inst, (ANCHO//2 - inst.get_width()//2, ALTO - 22))

    def _leer_letrero(self, pos):
        """Muestra el texto del letrero/buzón según la ubicación."""
        LETREROS = {
            "caleta_norte": {
                (10, 12): ["🏠 Casa de tu familia.",
                          "Mamá siempre te espera con la comida lista."],
                (30, 10): ["🏠 Casa del Abuelo Cahuide.",
                          "Ha pescado aquí desde antes que nacieras."],
                (30, 23): ["🏠 Casa de Doña Peta.",
                          "Los Surito son su debilidad."],
                (3, 7):   ["🔬 Laboratorio del Profesor Kuntur.",
                          "Estudia la biodiversidad del Tahuantinsuyo."],
            },
            "ciudad_moche": {
                (19, 10): ["🏥 Tambostop de Ciudad Moche.",
                          "La enfermera cura a tus Pokémon gratis."],
                (20, 10): ["⚔️ Gimnasio de Ciudad Moche — Don Fermín.",
                          "Especialista en Bicho/Normal. Medalla: Arcilla."],
                (8, 8):   ["🏠 Casa del Agricultor Ñato.",
                          "Dice que un Pokémon de Fuego rompe el gimnasio."],
                (12, 9):  ["🏠 Casa de la Curandera Rosa.",
                          "Escuchó rumores sobre el Team Supay."],
                (28, 8):  ["🏠 Casa del Niño Curioso.",
                          "Sueña con atrapar un Amaru."],
                (30, 22): ["🏠 Casa del Pescador Viejo.",
                          "Habla de una huaca que brilla de noche."],
            },
            "ciudad_imperial": {
                (20, 10): ["⚔️ Gimnasio Imperial — Apu-Capataz.",
                          "Especialista en Roca/Tierra. Medalla: Cantera."],
                (10, 8):  ["🏠 Casa del Sabio del Monolito.",
                          "Te enseña: la piedra se vence con paciencia."],
            },
            "ruta_1": {
                (14, 12): ["🏠 Casa del Arriero Ñoño.",
                          "Aquí paran los entrenadores antes de Moche."],
            },
            "ruta_2": {
                (20, 10): ["🏠 Casa de la Pastorcita Milagros.",
                          "El aire de la sierra fortalece a los Pokémon."],
            },
        }
        dialogo = LETREROS.get(self.mapa_actual.id, {}).get(tuple(pos))
        if not dialogo:
            self.mensajes = ["Un buzón vacío."]
            self.timer_mensajes = 1.2
            return
        self.dialogo_actual = dialogo
        self.dialogo_hablante = "Buzón"
        self.dialogo_idx = 0
        self.estado = "dialogo"
        self.siguiente_estado_tras_dialogo = "exploracion"

    def _jugador_debilitado(self):
        """Devuelve True si TODOS los Pokemon estan debilitados."""
        if not self.equipo.pokemons:
            return False
        return all(not p.esta_vivo() for p in self.equipo.pokemons)

    def _dibujar_sprite_gris(self, sprite, pos):
        """Dibuja un sprite con tinte gris para indicar debilidad."""
        if sprite is None:
            return
        temp = sprite.copy()
        temp.fill((120, 120, 130, 255), special_flags=pygame.BLEND_RGBA_MULT)
        pantalla.blit(temp, pos)

    def _dibujar_exploracion(self, dt=1/60):
        self.mapa_actual.actualizar(dt, velocidad=7.0)

        # Sonido de paso
        if self.mapa_actual.moviendo:
            self._paso_timer = getattr(self, "_paso_timer", 0.0) + dt
            if self._paso_timer > 0.22:
                self._paso_timer = 0.0
                try:
                    from sistemas.sonidos import Sonidos as SonAvz
                    b = getattr(self.mapa_actual, "bioma", "valle")
                    if b == "selva":
                        SonAvz.paso_hierba()
                    elif b in ("sierra", "paramo", "altiplano"):
                        SonAvz.paso_tierra()
                    else:
                        SonAvz.paso_pasto()
                except Exception:
                    pass

        # ---- Cámara ----
        jpx, jpy = self.mapa_actual.tile_en_pixel()
        cam_x = int(jpx - ANCHO//2 + TILE_SIZE//2)
        cam_y = int(jpy - ALTO//2 + TILE_SIZE//2)
        cam_x = max(0, min(cam_x, len(self.mapa_actual.tiles[0]) * TILE_SIZE - ANCHO))
        cam_y = max(0, min(cam_y, len(self.mapa_actual.tiles) * TILE_SIZE - ALTO))

        # ---- Mapa base ----
        self.mapa_actual.dibujar(pantalla, cam_x, cam_y)

        # ---- NPCs ambientales ----
        for npc in globals().get("NPCS", []):
            if npc.get("mapa") != self.mapa_actual.id:
                continue
            nx, ny = npc["pos"]
            # Validacion: solo dibujar si esta en tile caminable
            if 0 <= nx < self.mapa_actual.ancho and 0 <= ny < self.mapa_actual.alto:
                from sistemas.mapa_visual import CAMINABLES as _CAM
                if self.mapa_actual.tiles[ny][nx] not in _CAM:
                    continue  # saltar NPCs mal colocados
            ex = nx * TILE_SIZE - cam_x
            ey = ny * TILE_SIZE - cam_y
            # C6: burbuja de dialogo si esta cerca del jugador
            jx, jy = self.mapa_actual.destino_x, self.mapa_actual.destino_y
            cerca = (abs(nx - jx) + abs(ny - jy)) <= 2
            # E: sprite profesional
            tipo_npc = _tipo_sprite_npc(npc)
            try:
                from sistemas.sprites import SpriteGenerator
                # F3: animacion idle con respiracion + direccion variable
                _t_f3 = self.anim_menu
                # Seed estable basado en posicion para que cada NPC tenga su timing
                seed_f3 = (nx * 13 + ny * 7) % 8
                # Direccion cambia cada 4 segundos segun seed
                ciclo_dir = int(_t_f3 / 4 + seed_f3) % 8
                direcciones_f3 = ["abajo", "abajo", "izquierda", "abajo", "derecha", "abajo", "arriba", "abajo"]
                dir_f3 = direcciones_f3[ciclo_dir]
                # Frame de respiracion (bob)
                bob_f3 = int(math.sin(_t_f3 * 2 + seed_f3 * 0.7) * 1)
                spr_npc = SpriteGenerator.crear_personaje(tipo_npc, dir_f3, 0, 32)
                if spr_npc:
                    # Escalar a tamano de tile (32x48)
                    spr_big = pygame.transform.scale(spr_npc, (24, 36))
                    sprite_x = ex - (24 - TILE_SIZE) // 2
                    sprite_y = ey + TILE_SIZE - 36 + 2 + bob_f3
                    # Sombra
                    pygame.draw.ellipse(pantalla, (0, 0, 0, 90),
                                        (ex + 2, ey + TILE_SIZE - 4, 12, 4))
                    pantalla.blit(spr_big, (sprite_x, sprite_y))
                    # Burbuja encima
                    if cerca:
                        bx = ex + 4
                        by = sprite_y - 10
                        pygame.draw.ellipse(pantalla, (250, 250, 240),
                                            (bx, by, 12, 9))
                        pygame.draw.ellipse(pantalla, (60, 40, 80),
                                            (bx, by, 12, 9), 1)
                        pygame.draw.circle(pantalla, (60, 40, 80), (bx+3, by+4), 1)
                        pygame.draw.circle(pantalla, (60, 40, 80), (bx+5, by+4), 1)
                        pygame.draw.circle(pantalla, (60, 40, 80), (bx+7, by+4), 1)
                    continue
            except Exception:
                pass
            # Fallback al sprite viejo
            if cerca:
                pygame.draw.ellipse(pantalla, (250, 250, 240),
                                    (ex+3, ey-14, 12, 9))
                pygame.draw.ellipse(pantalla, (60, 40, 80),
                                    (ex+3, ey-14, 12, 9), 1)
                pygame.draw.circle(pantalla, (60, 40, 80), (ex+6, ey-10), 1)
                pygame.draw.circle(pantalla, (60, 40, 80), (ex+8, ey-10), 1)
                pygame.draw.circle(pantalla, (60, 40, 80), (ex+10, ey-10), 1)
            pygame.draw.ellipse(pantalla, (0, 0, 0, 80), (ex+3, ey+12, 10, 3))
            pygame.draw.rect(pantalla, (240, 200, 160), (ex+4, ey+4, 8, 9))
            pygame.draw.rect(pantalla, (240, 200, 160), (ex+5, ey+1, 6, 5))
            pygame.draw.rect(pantalla, (60, 40, 25), (ex+4, ey, 8, 3))

        # ---- Entrenadores ----
        for ent in entrenadores_en(self.mapa_actual.id):
            ex = ent.posicion[0] * TILE_SIZE - cam_x
            ey = ent.posicion[1] * TILE_SIZE - cam_y
            if getattr(ent, "derrotado", False):
                # C6: entrenador derrotado se ve gris y con marca
                pygame.draw.ellipse(pantalla, (0, 0, 0, 80), (ex+3, ey+12, 10, 3))
                pygame.draw.rect(pantalla, (110, 110, 120), (ex+4, ey+4, 8, 9))
                pygame.draw.rect(pantalla, (180, 180, 180), (ex+5, ey+1, 6, 5))
                pygame.draw.rect(pantalla, (60, 60, 70), (ex+4, ey, 8, 3))
                # Marca "X" arriba
                pygame.draw.line(pantalla, (80, 200, 80),
                                 (ex+2, ey-8), (ex+12, ey-4), 2)
                pygame.draw.line(pantalla, (80, 200, 80),
                                 (ex+12, ey-8), (ex+2, ey-4), 2)
                continue
            # Sprite profesional segun clase del entrenador
            tipo_ent = "civil"
            clase = (getattr(ent, "clase", "") or "").lower()
            if "pescador" in clase or "marino" in clase:
                tipo_ent = "pescador"
            elif "agricultor" in clase or "pastor" in clase or "arriero" in clase:
                tipo_ent = "campesino"
            elif "danzante" in clase or "musico" in clase:
                tipo_ent = "danzante"
            elif "supay" in clase:
                tipo_ent = "supay"
            elif "montanista" in clase or "esquiador" in clase:
                tipo_ent = "montanista"
            elif "cientifico" in clase or "investigador" in clase:
                tipo_ent = "cientifico"
            elif "anciano" in clase:
                tipo_ent = "anciano"
            elif "explorador" in clase:
                tipo_ent = "explorador"
            elif "guardia" in clase or "seguridad" in clase:
                tipo_ent = "guardia"
            elif "ejecutivo" in clase:
                tipo_ent = "empresario"
            elif "sacerdote" in clase or "chamana" in clase or "curandera" in clase:
                tipo_ent = "sacerdote" if "sacerdote" in clase else "chamana"
            elif "colegial" in clase or "nino" in clase or "nina" in clase:
                tipo_ent = "nino"

            try:
                from sistemas.sprites import SpriteGenerator
                # Si el entrenador fue derrotado, dibujamos en gris
                derrotado_ent = getattr(ent, "derrotado", False)
                spr_ent = SpriteGenerator.crear_personaje(tipo_ent, "abajo", 0, 32)
                if spr_ent:
                    spr_big = pygame.transform.scale(spr_ent, (24, 36))
                    if derrotado_ent:
                        # Tinte gris
                        gris = pygame.Surface(spr_big.get_size(), pygame.SRCALPHA)
                        gris.fill((100, 100, 110, 200))
                        spr_big.blit(gris, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
                    sprite_x = ex - (24 - TILE_SIZE) // 2
                    sprite_y = ey + TILE_SIZE - 36 + 2
                    pygame.draw.ellipse(pantalla, (0, 0, 0, 90),
                                        (ex + 2, ey + TILE_SIZE - 4, 12, 4))
                    pantalla.blit(spr_big, (sprite_x, sprite_y))
                    # Marca de X si derrotado
                    if derrotado_ent:
                        pygame.draw.line(pantalla, (255, 80, 80),
                                         (ex + 2, ey - 6), (ex + 14, ey + 6), 2)
                        pygame.draw.line(pantalla, (255, 80, 80),
                                         (ex + 14, ey - 6), (ex + 2, ey + 6), 2)
                    continue
            except Exception:
                pass
            # Fallback rects
            # Sprite profesional segun clase del entrenador
            tipo_ent = "civil"
            clase = (getattr(ent, "clase", "") or "").lower()
            if "pescador" in clase or "marino" in clase:
                tipo_ent = "pescador"
            elif "agricultor" in clase or "pastor" in clase or "arriero" in clase:
                tipo_ent = "campesino"
            elif "danzante" in clase or "musico" in clase:
                tipo_ent = "danzante"
            elif "supay" in clase:
                tipo_ent = "supay"
            elif "montanista" in clase or "esquiador" in clase:
                tipo_ent = "montanista"
            elif "cientifico" in clase or "investigador" in clase:
                tipo_ent = "cientifico"
            elif "anciano" in clase:
                tipo_ent = "anciano"
            elif "explorador" in clase:
                tipo_ent = "explorador"
            elif "guardia" in clase or "seguridad" in clase:
                tipo_ent = "guardia"
            elif "ejecutivo" in clase:
                tipo_ent = "empresario"
            elif "sacerdote" in clase or "chamana" in clase or "curandera" in clase:
                tipo_ent = "sacerdote" if "sacerdote" in clase else "chamana"
            elif "colegial" in clase or "nino" in clase or "nina" in clase:
                tipo_ent = "nino"

            try:
                from sistemas.sprites import SpriteGenerator
                # Si el entrenador fue derrotado, dibujamos en gris
                derrotado_ent = getattr(ent, "derrotado", False)
                spr_ent = SpriteGenerator.crear_personaje(tipo_ent, "abajo", 0, 32)
                if spr_ent:
                    spr_big = pygame.transform.scale(spr_ent, (24, 36))
                    if derrotado_ent:
                        # Tinte gris
                        gris = pygame.Surface(spr_big.get_size(), pygame.SRCALPHA)
                        gris.fill((100, 100, 110, 200))
                        spr_big.blit(gris, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
                    sprite_x = ex - (24 - TILE_SIZE) // 2
                    sprite_y = ey + TILE_SIZE - 36 + 2
                    pygame.draw.ellipse(pantalla, (0, 0, 0, 90),
                                        (ex + 2, ey + TILE_SIZE - 4, 12, 4))
                    pantalla.blit(spr_big, (sprite_x, sprite_y))
                    # Marca de X si derrotado
                    if derrotado_ent:
                        pygame.draw.line(pantalla, (255, 80, 80),
                                         (ex + 2, ey - 6), (ex + 14, ey + 6), 2)
                        pygame.draw.line(pantalla, (255, 80, 80),
                                         (ex + 14, ey - 6), (ex + 2, ey + 6), 2)
                    continue
            except Exception:
                pass
            # Fallback rects
            pygame.draw.ellipse(pantalla, (0, 0, 0, 80), (ex+3, ey+12, 10, 3))
            pygame.draw.rect(pantalla, (200, 50, 50), (ex+4, ey+4, 8, 9))
            pygame.draw.rect(pantalla, (240, 200, 160), (ex+5, ey+1, 6, 5))
            pygame.draw.rect(pantalla, (32, 24, 40), (ex+4, ey, 8, 3))

        # ---- Gimnasios ----
        for id_g, gim in GIMNASIOS.items():
            if gim.posicion_mapa and gim.posicion_mapa[0] == self.mapa_actual.id:
                _, gx, gy = gim.posicion_mapa
                sx = gx * TILE_SIZE - cam_x
                sy = gy * TILE_SIZE - cam_y
                pygame.draw.rect(pantalla, (240, 200, 60), (sx+1, sy+1, TILE_SIZE-2, TILE_SIZE-2))
                pygame.draw.rect(pantalla, NEGRO, (sx+1, sy+1, TILE_SIZE-2, TILE_SIZE-2), 1)

        # ---- Tambo (rojo) y Tienda (azul) ----
        try:
            from sistemas.mapa_visual import TAMBO_POS, TIENDA_POS
            for pos_dict, color in ((TAMBO_POS, (220, 60, 60)),
                                    (TIENDA_POS, (60, 120, 220))):
                pos = pos_dict.get(self.mapa_actual.id)
                if pos:
                    tx, ty = pos
