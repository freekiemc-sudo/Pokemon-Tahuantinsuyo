def _tipo_sprite_npc(npc):
    """Devuelve el tipo de sprite adecuado para un NPC."""
    rol = (npc.get("rol") or "").lower()
    nombre = (npc.get("nombre") or "").lower()
    if "profesor" in nombre or "kuntur" in nombre:
        return "profesor"
    if "enfermera" in nombre or "tambo" in nombre:
        return "enfermera"
    if "supay" in nombre or "recluta" in nombre:
        return "supay"
    return _mapa_rol_a_tipo.get(rol, "civil")

SPRITES_JUGADOR_ANIM = {}


class EfectosVisuales:
    """Efectos visuales simples (fuego, agua, planta, impacto)."""
    def __init__(self):
        self.efectos = []

    def agregar_efecto(self, tipo, x, y, duracion=1.0):
        self.efectos.append({"tipo": tipo, "x": x, "y": y,
                              "tiempo": duracion, "tiempo_max": duracion})

    def actualizar(self, dt):
        for efecto in self.efectos[:]:
            efecto["tiempo"] -= dt
            if efecto["tiempo"] <= 0:
                self.efectos.remove(efecto)

    def dibujar(self, pantalla):
        for efecto in self.efectos:
            progreso = 1.0 - (efecto["tiempo"] / efecto["tiempo_max"])
            if efecto["tipo"] == "fuego":
                for i in range(5):
                    offset_x = random.randint(-20, 20)
                    offset_y = random.randint(-30, 0)
                    tamano = int(10 * (1 - progreso))
                    color = (255, int(200 * (1 - progreso)), 0)
                    pygame.draw.circle(pantalla, color,
                                       (efecto["x"] + offset_x,
                                        efecto["y"] + offset_y), tamano)
            elif efecto["tipo"] == "agua":
                radio = int(50 * progreso)
                pygame.draw.circle(pantalla, (100, 150, 255),
                                   (efecto["x"], efecto["y"]), radio, 3)
            elif efecto["tipo"] == "planta":
                for i in range(3):
                    offset_x = int(30 * math.sin(progreso * math.pi + i))
                    offset_y = int(-40 * progreso)
                    pygame.draw.ellipse(pantalla, VERDE_SELVA,
                                        (efecto["x"] + offset_x,
                                         efecto["y"] + offset_y, 8, 4))
            elif efecto["tipo"] == "impacto":
                tamano = int(30 * (1 - progreso))
                pygame.draw.polygon(pantalla, AMARILLO_SOL, [
                    (efecto["x"], efecto["y"] - tamano),
                    (efecto["x"] + tamano//2, efecto["y"] - tamano//2),
                    (efecto["x"] + tamano, efecto["y"]),
                    (efecto["x"] + tamano//2, efecto["y"] + tamano//2),
                    (efecto["x"], efecto["y"] + tamano),
                    (efecto["x"] - tamano//2, efecto["y"] + tamano//2),
                    (efecto["x"] - tamano, efecto["y"]),
                    (efecto["x"] - tamano//2, efecto["y"] - tamano//2),
                ])




