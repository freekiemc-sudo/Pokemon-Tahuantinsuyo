# --- batalla ---
try:
    from sistemas.batalla import PokemonBatalla, Batalla, intentar_capturar, Movimiento
except Exception:
    class PokemonBatalla:
        def __init__(self, datos, nivel=5):
            self.nombre = datos.get("nombre", "?")
            self.tipos = datos.get("tipos", ["Normal"])
            self.nivel = nivel
            self.id = datos.get("id", 0)
            self.ps_base = datos.get("stats_base", {}).get("ps", 50)
            self.ps_max = int(((2 * self.ps_base) * nivel / 100) + nivel + 10)
            self.ps = self.ps_max
            self.atq = 10; self.defensa = 10; self.atq_esp = 10
            self.def_esp = 10; self.vel = 10
            self.movimientos = []
            self.estado = None
            self.turnos_estado = 0
            self.exp = 0; self.exp_total = 0
            self.es_shiny = False
            self.color_shiny = None
        def esta_vivo(self): return self.ps > 0
        def recibir_danio(self, c): self.ps = max(0, self.ps - c)
        def curar(self, c): self.ps = min(self.ps_max, self.ps + c)
        def ganar_exp(self, c): return {"subidas": []}
        def exp_para_siguiente_nivel(self): return 100
    class Movimiento:
        def __init__(self, d):
            self.nombre = d.get("nombre", "?")
            self.tipo = d.get("tipo", "Normal")
            self.potencia = d.get("potencia", 40)
            self.precision = d.get("precision", 100)
            self.categoria = d.get("categoria", "Fisico")
            self.pp = d.get("pp", 20)
            self.pp_max = self.pp
    class Batalla:
        def __init__(self, equipo, rival):
            self.equipo_jugador = equipo
            self.pokemon_salvaje = rival
            self.pokemon_activo_jugador = equipo[0] if equipo else rival
            self.turno = 1; self.mensajes = []
            self.terminada = False; self.resultado = None
            self.sub_estado = "menu_principal"
            self.es_gimnasio = False; self.gimnasio_id = None
            self.pokemon_capturado = None
            self.clima = "despejado"; self.turnos_clima = 0
            self._ultimo_turno_critico = False
            self._ultimo_turno_super_efec = False
            self._flash_rival = 0.0; self._flash_jugador = 0.0
            self.rival_equipo = []; self.rival_poke_idx = 0
        def ejecutar_turno(self, mov): return ["Ataque!"]
        def _ejecutar_ataque_rival(self): return ["Rival ataca!"]
        def intentar_huir(self): return True, "Huiste!"
    def intentar_capturar(p, b, e=None):
        return {"exito": True, "intentos": 1, "mensajes": ["Capturado!"]}

