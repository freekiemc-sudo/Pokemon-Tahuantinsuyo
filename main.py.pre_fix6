# --- equipo ---
try:
    from sistemas.equipo import Equipo
except Exception:
    class Equipo:
        def __init__(self): self.pokemons = []
        def agregar(self, p):
            if len(self.pokemons) < 6:
                self.pokemons.append(p); return True
            return False
        def remover(self, i):
            if 0 <= i < len(self.pokemons): return self.pokemons.pop(i)
            return None
        def obtener(self, i):
            if 0 <= i < len(self.pokemons): return self.pokemons[i]
            return None
        def obtener_primero_vivo(self):
            for p in self.pokemons:
                if p.esta_vivo(): return p
            return None
        def todos_debilitados(self):
            if not self.pokemons: return True
            return all(not p.esta_vivo() for p in self.pokemons)

# --- inventario ---
try:
    from sistemas.inventario import (
        Inventario, crear_inventario_inicial, OBJETOS_CLAVE, POKEBALLS,
        CURACIONES, BATALLA as BATALLA_ITEMS, REVIVIRES, EVOLUCION, Objeto
    )
except Exception:
    OBJETOS_CLAVE = {}; POKEBALLS = {}; CURACIONES = {}
    BATALLA_ITEMS = {}; REVIVIRES = {}; EVOLUCION = {}
    class Objeto:
        def __init__(self, n, t="item", d="", p=0):
            self.nombre = n; self.tipo = t
            self.descripcion = d; self.precio = p
    class Inventario:
        def __init__(self):
            self.dinero = 3000; self.objetos = {}
        def tiene_objeto(self, n): return n in self.objetos
        def agregar(self, o, c=1):
            n = o.nombre if hasattr(o, "nombre") else str(o)
            self.objetos[n] = self.objetos.get(n, 0) + c
        def remover(self, n, c=1):
            if n in self.objetos:
                self.objetos[n] -= c
                if self.objetos[n] <= 0: del self.objetos[n]
        def obtener_lista(self): return []
    def crear_inventario_inicial(): return Inventario()

