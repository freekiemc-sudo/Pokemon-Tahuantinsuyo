    # =====================================================================
    # OBJETIVO ACTUAL (HUD de misión)
    # =====================================================================
    def _objetivo_actual(self):
        if not self.equipo.pokemons:
            return "Habla con el Prof. Kuntur y elige tu inicial"
        # Evento Team Supay activo
        ev = evento_supay_activo(self.mapa_actual.id)
        if ev and not ev.completado:
            return f"¡Detén al Team Supay en {self.mapa_actual.id.replace('_',' ').title()}!"
        # Gimnasio bloqueado por portero
        for id_g, gim in GIMNASIOS.items():
            if gim.posicion_mapa and gim.posicion_mapa[0] == self.mapa_actual.id:
                bloqueado, motivo = gimnasio_bloqueado(id_g)
                if bloqueado:
                    portero = obtener_portero(id_g)
                    if portero and not portero.derrotado:
                        return f"Vence a {portero.nombre} en la puerta del gimnasio"
                break
        return _prox_obj(self.gimnasios, self.liga)

    # =====================================================================
    # BATALLA
    # =====================================================================
    def _ps_animado(self, poke):
        if poke is None:
            return {"valor": 0.0, "prev": 0.0}
        key = id(poke)
        ent = self._ps_vis.get(key)
        if ent is None:
            ent = {"valor": float(poke.ps), "prev": float(poke.ps)}
            self._ps_vis[key] = ent
        return ent

    def _actualizar_ps_animados(self, dt=None):
        """A4: anima PS y EXP de forma SECUENCIAL (una barra a la vez)."""
        if not self.batalla_actual:
            return
        if dt is None:
            dt = getattr(self, "_last_dt", 1.0/60.0)
        if dt <= 0:
            dt = 1.0 / 60.0

        # Pausa entre barras (para que se vean secuenciales)
        if not hasattr(self, "_pausa_anim"):
            self._pausa_anim = 0.0
        if self._pausa_anim > 0:
            self._pausa_anim = max(0.0, self._pausa_anim - dt)
            return

        rival = self.batalla_actual.pokemon_salvaje
        jugador = self.batalla_actual.pokemon_activo_jugador
        pokes = [rival, jugador]

        # Inicializar entradas
        for p in pokes:
            if p is not None:
                self._ps_animado(p)
                self._exp_animado(p)

        # Buscar la PRIMERA barra de PS con diferencia
        activa = None
        for p in pokes:
            if p is None:
                continue
            ent = self._ps_vis[id(p)]
            if abs(float(p.ps) - ent["valor"]) >= 0.5:
                activa = p
                break

        if activa is None:
            # Solo animar EXP si ya no hay PS pendiente
            self._actualizar_exp_animados(pokes, dt)
            ids_ok = {id(p) for p in pokes if p is not None}
            for k in list(self._ps_vis.keys()):
                if k not in ids_ok:
                    del self._ps_vis[k]
            for k in list(self._exp_vis.keys()):
                if k not in ids_ok:
                    del self._exp_vis[k]
            return

        # Animar SOLO la barra de PS activa
        ent = self._ps_vis[id(activa)]
        diff = float(activa.ps) - ent["valor"]
        velocidad = 70.0
        paso = velocidad * dt
        if abs(diff) <= paso:
            ent["valor"] = float(activa.ps)
            # Pausa corta antes de la siguiente barra
            self._pausa_anim = 0.35
        else:
            ent["valor"] += paso * (1 if diff > 0 else -1)

        # Limpieza
        ids_ok = {id(p) for p in pokes if p is not None}
        for k in list(self._ps_vis.keys()):
            if k not in ids_ok:
                del self._ps_vis[k]
        for k in list(self._exp_vis.keys()):
            if k not in ids_ok:
                del self._exp_vis[k]

    def _exp_animado(self, poke):
        if poke is None:
            return {"valor": 0.0}
        if not hasattr(self, "_exp_vis"):
            self._exp_vis = {}
        key = id(poke)
        ent = self._exp_vis.get(key)
        if ent is None:
            ent = {"valor": float(getattr(poke, "exp", 0))}
            self._exp_vis[key] = ent
        return ent

    def _actualizar_exp_animados(self, pokes, dt):
        if not hasattr(self, "_exp_vis"):
            self._exp_vis = {}
        velocidad = 120.0
        for p in pokes:
            if p is None:
                continue
            ent = self._exp_animado(p)
            real = float(getattr(p, "exp", 0))
            diff = real - ent["valor"]
            if abs(diff) < 0.5:
                ent["valor"] = real
                continue
            paso = velocidad * dt
            if abs(diff) <= paso:
                ent["valor"] = real
            else:
                ent["valor"] += paso * (1 if diff > 0 else -1)

    def _dibujar_barra_exp(self, poke, x, y, ancho=230, alto=4):
        if poke is None:
            return
        ent = self._exp_animado(poke)
        try:
            nec = poke.exp_para_siguiente_nivel()
        except Exception:
            nec = 100
        if nec <= 0:
            return
        ratio = max(0.0, min(1.0, ent["valor"] / nec))
        pygame.draw.rect(pantalla, (25, 18, 35), (x, y, ancho, alto))
        ancho_fill = int(ancho * ratio)
        if ancho_fill > 0:
            pygame.draw.rect(pantalla, (100, 210, 255), (x, y, ancho_fill, alto))
        pygame.draw.rect(pantalla, NEGRO, (x, y, ancho, alto), 1)

    def _color_barra(self, poke, valor_visual):
        en_mov = abs(valor_visual - poke.ps) > 0.5
        if en_mov:
            if valor_visual > poke.ps:
                return (255, 90, 90)
            return (90, 240, 120)
        r = poke.ps / poke.ps_max if poke.ps_max else 0
        if r > 0.5:
            return VERDE_SELVA
        if r > 0.2:
            return AMARILLO_SOL
        return ROJO_INCA

    def _dibujar_iconos_estado(self, poke, x_panel, y_panel, w_panel, h_panel):
        """Dibuja cajitas con iconos de estado (PAR, QEM, PSN, TOX, DOR, CNG, CNF)."""
        if poke is None:
            return
        estados = []
        e = getattr(poke, "estado", None)
        if e == "paralizado":
            estados.append(("PAR", (245, 220, 60)))
        elif e == "quemado":
            estados.append(("QEM", (245, 120, 40)))
        elif e == "envenenado":
            estados.append(("PSN", (180, 70, 210)))
        elif e == "toxico":
            estados.append(("TOX", (150, 40, 180)))
        elif e == "dormido":
            estados.append(("DOR", (150, 150, 190)))
        elif e == "congelado":
            estados.append(("CNG", (130, 220, 245)))
        if getattr(poke, "confundido_turnos", 0) > 0:
            estados.append(("CNF", (240, 130, 200)))
        if not estados:
            return
        ancho_caja = 32
        alto_caja = 14
        sep = 3
        total = len(estados) * (ancho_caja + sep) - sep
        x_ini = x_panel + w_panel - total - 6
        y_ini = y_panel + h_panel - alto_caja - 4
        for i, (codigo, color) in enumerate(estados):
            bx = x_ini + i * (ancho_caja + sep)
            by = y_ini
            pygame.draw.rect(pantalla, (32, 24, 40), (bx, by, ancho_caja, alto_caja))
            pygame.draw.rect(pantalla, color, (bx, by, ancho_caja, alto_caja), 2)
            txt = fuente_peque.render(codigo, True, color)
            pantalla.blit(txt, (bx + ancho_caja // 2 - txt.get_width() // 2,
                                by + alto_caja // 2 - txt.get_height() // 2))

    def _dibujar_barra_ps(self, poke, x, y, ancho=230, alto=15):
        ent = self._ps_animado(poke)
        valor = max(0.0, min(float(poke.ps_max), ent["valor"]))
        pygame.draw.rect(pantalla, GRIS_PIEDRA, (x, y, ancho, alto))
        ratio = valor / poke.ps_max if poke.ps_max else 0
        col = self._color_barra(poke, valor)
        ancho_fill = int(ancho * ratio)
        if ancho_fill > 0:
            pygame.draw.rect(pantalla, col, (x, y, ancho_fill, alto))
            brillo = tuple(min(255, c + 60) for c in col)
            pygame.draw.line(pantalla, brillo,
                             (x + 1, y + 1),
                             (x + max(1, ancho_fill - 2), y + 1))
        pygame.draw.rect(pantalla, NEGRO, (x, y, ancho, alto), 1)

    def _obtener_silueta(self, sprite):
        """Devuelve una silueta oscura del sprite (cacheada)."""
        if sprite is None:
            return None
        key = id(sprite)
        cache = getattr(self, "_siluetas_cache", None)
        if cache is None:
            self._siluetas_cache = {}
            cache = self._siluetas_cache
        if key not in cache:
            try:
                mascara = pygame.mask.from_surface(sprite)
                silueta = mascara.to_surface(
                    setcolor=(30, 20, 40, 255),
                    unsetcolor=(0, 0, 0, 0))
                cache[key] = silueta
            except Exception:
                cache[key] = None
        return cache.get(key)

    def _dibujar_sprite_batalla(self, sprite, x, y, flash_timer):
        """Dibuja el sprite con sacudida y parpadeo de silueta si flash_timer > 0."""
        if sprite is None:
            return
        ox = 0
        oy = 0
        if flash_timer > 0:
            # Sacudida horizontal + mini salto vertical
            ox = int(math.sin(flash_timer * 42.0) * 8)
            oy = -abs(int(math.sin(flash_timer * 24.0) * 3))
        pos = (x + ox, y + oy)
        # Alternar entre sprite normal y silueta cada ~2 frames
        mostrar_silueta = (flash_timer > 0 and int(flash_timer * 30) % 2 == 0)
        if mostrar_silueta:
            sil = self._obtener_silueta(sprite)
            if sil is not None:
                pantalla.blit(sil, pos)
                return
        pantalla.blit(sprite, pos)

    def _iniciar_transicion_batalla(self):
        """A5: inicia la animacion de entrada a batalla."""
        self._trans_timer = 0.0
        self._trans_duracion = 1.6
        self.estado = "transicion_batalla"

    def _dibujar_transicion_batalla(self, dt=None):
        """A5: sprite rival entra por la derecha, jugador por la izquierda, VS central."""
        if dt is None:
            dt = getattr(self, "_last_dt", 1.0/60.0)
        self._trans_timer = getattr(self, "_trans_timer", 0.0) + dt
        dur = getattr(self, "_trans_duracion", 1.6)
        t_actual = self._trans_timer

        # Fondo con degradado azul
        for i in range(ALTO):
            r = int(20 + 30 * i / ALTO)
            g = int(40 + 50 * i / ALTO)
            b = int(80 + 70 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Franjas diagonales animadas
        offset = int(t_actual * 180) % 60
        for i in range(-2, 15):
            x = i * 60 - offset
            pygame.draw.polygon(pantalla, (35, 60, 110), [
                (x, 0), (x + 25, 0), (x + 60, ALTO), (x + 35, ALTO)
            ])

        b = self.batalla_actual
        if b is None:
            self.estado = "batalla"
            return

        # --- RIVAL (entra de la derecha, con zoom) ---
        fase_r = min(1.0, t_actual / 0.55)
        spr_r = SPRITES.get(b.pokemon_salvaje.nombre)
        if spr_r:
            escala_zoom = 1.0 + 0.8 * (1.0 - fase_r)
            tam_final = int(64 * escala_zoom * (0.4 + 0.6 * fase_r))
            tam_final = max(4, min(180, tam_final))
            try:
                big = pygame.transform.scale(spr_r, (tam_final, tam_final))
            except Exception:
                big = spr_r
            offset_x = int((1.0 - fase_r) * 400)
            rx = ANCHO - 130 - big.get_width() // 2 + offset_x
            ry = 70 + (150 - big.get_height()) // 2
            # Sombra
            pygame.draw.ellipse(pantalla, (0, 0, 0, 90),
                                (rx + big.get_width()//4, ry + big.get_height() - 8,
                                 big.get_width()//2, 8))
            pantalla.blit(big, (rx, ry))

        # --- JUGADOR (entra de la izquierda, con zoom) ---
        if t_actual > 0.30:
            fase_j = min(1.0, (t_actual - 0.30) / 0.55)
            spr_j = SPRITES.get(b.pokemon_activo_jugador.nombre)
            if spr_j:
                escala_zoom = 1.0 + 0.8 * (1.0 - fase_j)
                tam_final = int(64 * escala_zoom * (0.4 + 0.6 * fase_j))
                tam_final = max(4, min(180, tam_final))
                try:
                    big = pygame.transform.scale(spr_j, (tam_final, tam_final))
                except Exception:
                    big = spr_j
                offset_x = int((1.0 - fase_j) * 400)
                jx = 130 - big.get_width() // 2 - offset_x
                jy = 240 + (150 - big.get_height()) // 2
                pygame.draw.ellipse(pantalla, (0, 0, 0, 90),
                                    (jx + big.get_width()//4, jy + big.get_height() - 8,
                                     big.get_width()//2, 8))
                pantalla.blit(big, (jx, jy))

        # --- VS central con rebote ---
        if t_actual > 0.80:
            fase_v = min(1.0, (t_actual - 0.80) / 0.35)
            rebote = 1.0 + 0.7 * math.sin(fase_v * math.pi) * (1 - fase_v * 0.5)
            tam_v = int(72 * rebote)
            tam_v = max(20, tam_v)
            try:
                fnt_v = pygame.font.SysFont("arial", tam_v, bold=True)
            except Exception:
                fnt_v = fuente_titulo
            txt_s = fnt_v.render("VS", True, (0, 0, 0))
            txt_v = fnt_v.render("VS", True, (255, 220, 60))
            txt_b = fnt_v.render("VS", True, (180, 30, 30))
            cx = ANCHO // 2 - txt_v.get_width() // 2
            cy = ALTO // 2 - txt_v.get_height() // 2
            pantalla.blit(txt_b, (cx - 3, cy - 3))
            pantalla.blit(txt_b, (cx + 3, cy + 3))
            pantalla.blit(txt_s, (cx + 4, cy + 4))
            pantalla.blit(txt_v, (cx, cy))

        # --- Nombre del rival (aparece arriba a la derecha) ---
        if t_actual > 0.5:
            try:
                nombre_r = b.pokemon_salvaje.nombre.upper()
                tn = fuente_grande.render(nombre_r, True, BLANCO)
                tn_s = fuente_grande.render(nombre_r, True, NEGRO)
                rx = ANCHO - tn.get_width() - 20
                pygame.draw.rect(pantalla, (32, 24, 40), (rx - 8, 16, tn.get_width() + 16, 32))
                pygame.draw.rect(pantalla, (240, 200, 60), (rx - 8, 16, tn.get_width() + 16, 32), 2)
                pantalla.blit(tn_s, (rx + 1, 21))
                pantalla.blit(tn, (rx, 20))
            except Exception:
                pass

        # --- "¡Salvaje!" o "¡Reta!" (abajo izquierda) ---
        if t_actual > 0.7:
            try:
                es_salvaje = not (getattr(b, "es_gimnasio", False) or
                                  getattr(b, "es_rival", False) or
                                  getattr(b, "es_supay", False) or
                                  getattr(b, "es_portero", False))
                tag = "¡Salvaje!" if es_salvaje else "¡Reto!"
                tt = fuente_grande.render(tag, True, (255, 240, 180))
                pygame.draw.rect(pantalla, (32, 24, 40), (12, ALTO - 48, tt.get_width() + 16, 32))
                pygame.draw.rect(pantalla, (240, 200, 60), (12, ALTO - 48, tt.get_width() + 16, 32), 2)
                pantalla.blit(tt, (20, ALTO - 44))
            except Exception:
                pass

        # --- Flash blanco final ---
        if t_actual > dur - 0.28:
            prog = (t_actual - (dur - 0.28)) / 0.28
            alpha = int(255 * min(1.0, prog))
            ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
            ov.fill((255, 255, 255, alpha))
            pantalla.blit(ov, (0, 0))

        # Texto "Presiona X para saltar"
        if t_actual < dur - 0.3:
            try:
                hint = fuente_peque.render("[X] Saltar", True, (200, 220, 255))
                pantalla.blit(hint, (ANCHO // 2 - hint.get_width() // 2, ALTO - 20))
            except Exception:
                pass

        # Fin de la animacion
        if t_actual >= dur:
            self._trans_timer = 0.0
            self.estado = "batalla"

    def _iniciar_anim_ataque(self, quien, tipo, duracion=1.1):
        """Inicia animacion de ataque. quien = 'jugador' | 'rival'."""
        self._anim_ataque_timer = 0.0001
        self._anim_ataque_quien = quien
        self._anim_ataque_tipo = tipo or "Normal"
        self._anim_ataque_duracion = duracion

    def _color_tipo(self, tipo):
        return {
            "Fuego": (255, 140, 40), "Agua": (80, 170, 240),
            "Planta": (80, 200, 90), "Electrico": (255, 230, 60),
            "Eléctrico": (255, 230, 60), "Hielo": (150, 230, 245),
            "Lucha": (220, 80, 60), "Siniestro": (120, 80, 150),
            "Fantasma": (160, 100, 200), "Veneno": (180, 90, 200),
            "Tierra": (200, 150, 90), "Roca": (170, 140, 100),
            "Acero": (180, 190, 210), "Psiquico": (240, 100, 200),
            "Psíquico": (240, 100, 200), "Bicho": (170, 200, 80),
            "Volador": (170, 200, 240), "Dragon": (100, 110, 240),
            "Dragón": (100, 110, 240), "Hada": (250, 180, 220),
            "Sonido": (150, 220, 220), "Normal": (220, 220, 220),
        }.get(tipo, (220, 220, 220))

    def _dibujar_anim_ataque(self, sr, sj):
        """A8-2: dibuja ataque con movimiento grande, proyectil y explosion.
        Devuelve (ox_rival, oy_rival, ox_jugador, oy_jugador) para aplicar al sprite."""
        if not getattr(self, "_anim_ataque_quien", None):
            return 0, 0, 0, 0
        t = self._anim_ataque_timer
        dur = getattr(self, "_anim_ataque_duracion", 1.1)
        quien = self._anim_ataque_quien
        col = self._color_tipo(self._anim_ataque_tipo)

        # Fases (0-1)
        f1_fin = 0.20       # lanzarse
        f2_fin = 0.55       # proyectil viaja
        f3_fin = 0.85       # explosion
        # (0.85 - dur) : volver

        ox_r = 0
        oy_r = 0
        ox_j = 0
        oy_j = 0

        # Movimiento del atacante
        if t < f1_fin:
            prog = t / f1_fin
            empuje = int(60 * (prog ** 0.5))
        elif t > f3_fin:
            prog = min(1.0, (t - f3_fin) / (dur - f3_fin))
            empuje = int(60 * (1.0 - prog))
        else:
            empuje = 60

        if quien == "jugador":
            ox_j = empuje
            oy_j = -int(empuje * 0.4)
        else:
            ox_r = -empuje
            oy_r = int(empuje * 0.4)

        # F10: Proyectil por tipo
        if f1_fin <= t <= f2_fin:
            prog = (t - f1_fin) / (f2_fin - f1_fin)
            if quien == "jugador":
                x0, y0 = 200, 230
                x1, y1 = 430, 130
            else:
                x0, y0 = 430, 130
                x1, y1 = 200, 230
            px = int(x0 + (x1 - x0) * prog)
            py = int(y0 + (y1 - y0) * prog - 20 * math.sin(prog * math.pi))
            # Estela comun a todos
            for i in range(5):
                tt = max(0.0, prog - i * 0.05)
                tx = int(x0 + (x1 - x0) * tt)
                ty = int(y0 + (y1 - y0) * tt - 20 * math.sin(tt * math.pi))
                try:
                    alpha_trail = 200 - i * 30
                    pygame.draw.circle(pantalla, col, (tx, ty), max(2, 6 - i))
                except Exception:
                    pass
            # Proyectil especifico por tipo
            try:
                self._dibujar_proyectil_tipo(self._anim_ataque_tipo, px, py, prog, 1.0)
            except Exception:
                pygame.draw.circle(pantalla, col, (px, py), 10)

        # Explosion (fase 3)
        if f2_fin <= t <= f3_fin:
            prog = (t - f2_fin) / (f3_fin - f2_fin)
            if quien == "jugador":
                hx, hy = 420 + 32, 100 + 32
            else:
                hx, hy = 170 + 32, 200 + 32
            # Multiples anillos
            for i in range(3):
                r = int(15 + 70 * prog + i * 8)
                pygame.draw.circle(pantalla, col, (hx, hy), r, max(1, 4 - i))
            # Chispas radiales
            for i in range(16):
                ang = i * 0.3927 + prog * 4
                rr = int(20 + 90 * prog)
                px = int(hx + math.cos(ang) * rr)
                py = int(hy + math.sin(ang) * rr)
                try:
                    pygame.draw.circle(pantalla, col, (px, py), 4)
                    pygame.draw.circle(pantalla, (255, 255, 255), (px, py), 2)
                except Exception:
                    pass
            # Flash blanco en el impacto
            if prog < 0.3:
                alpha = int(200 * (1 - prog / 0.3))
                ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
                ov.fill((255, 255, 255, alpha))
                pantalla.blit(ov, (0, 0))

        return ox_r, oy_r, ox_j, oy_j

    def _actualizar_anim_ataque(self, dt):
        if not getattr(self, "_anim_ataque_quien", None):
            return
        self._anim_ataque_timer += dt
        dur = getattr(self, "_anim_ataque_duracion", 1.1)
        if self._anim_ataque_timer >= dur:
            self._anim_ataque_timer = 0.0
            self._anim_ataque_quien = None

    def _dibujar_anim_ataque(self, dt, sr, sj):
        """Devuelve (offset_x_atacante, offset_y_atacante, proyectil_dibujado, fase)."""
        if self._anim_ataque_timer <= 0:
            return 0, 0, None, "idle"
        # Fases:
        # 0.00 - 0.12 : atacante se lanza hacia adelante
        # 0.12 - 0.32 : proyectil viaja
        # 0.32 - 0.50 : explosion en el defensor
        # 0.50 - 0.70 : atacante vuelve
        t = self._anim_ataque_timer
        quien = self._anim_ataque_quien
        tipo = self._anim_ataque_tipo
        col_tipo = {
            "Fuego": (255, 140, 40),
            "Agua": (80, 170, 240),
            "Planta": (80, 200, 90),
            "Electrico": (255, 230, 60),
            "Hielo": (150, 230, 245),
            "Lucha": (220, 80, 60),
            "Siniestro": (120, 80, 150),
            "Fantasma": (160, 100, 200),
            "Veneno": (180, 90, 200),
            "Tierra": (200, 150, 90),
            "Roca": (170, 140, 100),
            "Acero": (180, 190, 210),
            "Psiquico": (240, 100, 200),
            "Bicho": (170, 200, 80),
            "Volador": (170, 200, 240),
            "Dragon": (100, 110, 240),
            "Hada": (250, 180, 220),
            "Sonido": (150, 220, 220),
            "Normal": (200, 200, 200),
        }.get(tipo, (200, 200, 200))

        ox = 0
        oy = 0
        if t < 0.12:
            prog = t / 0.12
            ox = int(30 * math.sin(prog * math.pi / 2))
        elif 0.32 < t < 0.50:
            prog = (t - 0.32) / 0.18
            ox = int(30 * math.cos(prog * math.pi / 2))

        proyectil = None
        if 0.12 <= t <= 0.32:
            prog = (t - 0.12) / 0.20
            if quien == "jugador":
                x0, y0, x1, y1 = 170 + 32, 200 + 32, 420 + 32, 100 + 32
            else:
                x0, y0, x1, y1 = 420 + 32, 100 + 32, 170 + 32, 200 + 32
            px = int(x0 + (x1 - x0) * prog)
            py = int(y0 + (y1 - y0) * prog - 8 * math.sin(prog * math.pi))
            proyectil = ("bola", px, py, col_tipo)

        if t < 0.32 or 0.32 <= t <= 0.52:
            if 0.32 <= t <= 0.52:
                prog = (t - 0.32) / 0.20
                if quien == "jugador":
                    hx, hy = 420 + 32, 100 + 32
                else:
                    hx, hy = 170 + 32, 200 + 32
                for i in range(10):
                    ang = i * 0.628 + prog * 6
                    r = 8 + 30 * prog
                    px = int(hx + math.cos(ang) * r)
                    py = int(hy + math.sin(ang) * r)
                    pantalla.set_at((px, py), col_tipo)
                pygame.draw.circle(pantalla, col_tipo,
                                   (hx, hy), int(6 + 20 * prog), 2)

        return ox, oy, proyectil, "activa"

    def _iniciar_fade(self, callback):
        """Inicia fade out -> callback -> fade in."""
        self._fade_alpha = 0.0
        self._fade_estado = "out"
        self._fade_callback = callback

    def _actualizar_fade(self, dt):
        if self._fade_estado is None:
            return
        v = 255.0 / max(0.01, self._fade_duracion)
        if self._fade_estado == "out":
            self._fade_alpha += v * dt
            if self._fade_alpha >= 255:
                self._fade_alpha = 255
                self._fade_estado = "in"
                cb = getattr(self, "_fade_callback", None)
                if cb:
                    try:
                        cb()
                    except Exception:
                        pass
                self._fade_callback = None
        elif self._fade_estado == "in":
            self._fade_alpha -= v * dt
            if self._fade_alpha <= 0:
                self._fade_alpha = 0
                self._fade_estado = None

    def _dibujar_fade(self):
        if self._fade_alpha <= 0:
            return
        ov = pygame.Surface((ANCHO, ALTO))
        ov.fill((0, 0, 0))
        ov.set_alpha(int(max(0, min(255, self._fade_alpha))))
        pantalla.blit(ov, (0, 0))

    def _manejar_input_menu_pausa(self, key):
        opciones = ["MOCHILA", "EQUIPO", "POKEDEX", "LOGROS", "CHASQUI", "FESTIVAL",
                    "FRENTE DE LOS APUS", "ESTADISTICAS", "GUARDAR", "OPCIONES", "SALIR"]
        n = len(opciones)
        if key == pygame.K_UP:
            self.menu_pausa_idx = (self.menu_pausa_idx - 1) % n
            try:
                from sistemas.sonidos import Sonidos as SonAvz
                SonAvz.hover()
            except Exception:
                Sonidos.reproducir_select()
        elif key == pygame.K_DOWN:
            self.menu_pausa_idx = (self.menu_pausa_idx + 1) % n
            try:
                from sistemas.sonidos import Sonidos as SonAvz
                SonAvz.hover()
            except Exception:
                Sonidos.reproducir_select()
        elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
            Sonidos.reproducir_confirmar()
            op = opciones[self.menu_pausa_idx]
            if op == "MOCHILA":
                self.estado = "inventario"
                self.inv_idx = 0
            elif op == "EQUIPO":
                self.estado = "equipo_menu"
                self.menu_cambiar_idx = 0
            elif op == "POKEDEX":
                self.estado = "pokedex"
                self.pokedex_idx = 0
                self.pokedex_detalle = None
                self.pokedex_filtro = "todos"
                self.pokedex_orden = "id"
            elif op == "LOGROS":
                self.estado = "logros"
            elif op == "LOGROS":
                self.estado = "logros"
            elif op == "CHASQUI":
                self._iniciar_chasqui()
            elif op == "SAFARI":
                self._iniciar_safari()
            elif op == "SAFARI":
                self._iniciar_safari()
            elif op == "FESTIVAL":
                self.estado = "danza_elegir"
                self.danza_pokemon_idx = 0
            elif op == "FESTIVAL":
                self.estado = "danza_elegir"
                self.danza_pokemon_idx = 0
            elif op == "MI BASE":
                # Crear o abrir la base del mapa actual
                b, creada = self.bases.crear_base(self.mapa_actual.id, 5, 5)
                self.bases.base_actual = b
                self.estado = "base_menu"
                self.base_menu_idx = 0
            elif op == "FRENTE DE LOS APUS":
                self._iniciar_frente()
            elif op == "OMEGA-INCA":
                self._iniciar_omega_inca()
            elif op == "EPISODIO AMARU":
                self._mostrar_episodio_info()
            elif op == "ESTADISTICAS":
                self.estado = "estadisticas"
            elif op == "GUARDAR":
                try:
                    from sistemas.guardado import guardar_partida
                    ok = guardar_partida(self, 1)
                    if ok:
                        self._tiempo_juego_ultimo_guardado = self._tiempo_juego
                        self.mensajes = ["!Partida guardada en el slot 1!"]
                    else:
                        self.mensajes = ["!No se pudo guardar."]
                except Exception:
                    self.mensajes = ["!Error al guardar."]
                self.timer_mensajes = 2.0
                self.estado = "exploracion"
            elif op == "OPCIONES":
                try:
                    self.musica.alternar()
                    self.mensajes = ["Musica " + ("OFF" if self.musica.silenciada else "ON")]
                except Exception:
                    self.mensajes = ["Musica alternada"]
                self.timer_mensajes = 1.2
            elif op == "SALIR":
                self.estado = "menu_principal"
                self.menu_principal_idx = 0
        elif key in (pygame.K_f, pygame.K_ESCAPE):
            Sonidos.reproducir_cancelar() if hasattr(Sonidos, "reproducir_cancelar") else Sonidos.reproducir_select()
            self.estado = "exploracion"

    def _manejar_input_equipo(self, key):
        eq = self.equipo.pokemons
        if not eq:
            if key in (pygame.K_f, pygame.K_ESCAPE):
                self.estado = "exploracion"
            return
        if key == pygame.K_UP:
            self.equipo_idx = (self.equipo_idx - 1) % len(eq)
            Sonidos.reproducir_select()
        elif key == pygame.K_DOWN:
            self.equipo_idx = (self.equipo_idx + 1) % len(eq)
            Sonidos.reproducir_select()
        elif key in (pygame.K_RETURN, pygame.K_x, pygame.K_z):
            Sonidos.reproducir_confirmar()
            # Reordenar: intercambiar con el siguiente
            if len(eq) >= 2:
                i = self.equipo_idx
                j = (i + 1) % len(eq)
                eq[i], eq[j] = eq[j], eq[i]
                self.equipo_idx = j
        elif key == pygame.K_e:
            # C5: equipar objeto held (cicla entre bayas del inventario)
            poke = eq[self.equipo_idx] if eq else None
            if poke:
                try:
                    from data.bayas import BAYAS
                    # Ver que bayas tiene el jugador
                    disponibles = []
                    for nom in BAYAS.keys():
                        if self.inventario.tiene_objeto(nom):
                            disponibles.append(nom)
                    if not disponibles:
                        self.mensajes = ["No tienes bayas para equipar."]
                        self.timer_mensajes = 1.5
                    else:
                        # Ciclo: nada -> baya1 -> baya2 -> ... -> nada
                        actual = poke.objeto_equipado
                        if actual is None:
                            siguiente = disponibles[0]
                        elif actual in disponibles:
                            idx = disponibles.index(actual)
                            if idx + 1 < len(disponibles):
                                siguiente = disponibles[idx + 1]
                            else:
                                siguiente = None
                        else:
                            siguiente = disponibles[0]
                        poke.objeto_equipado = siguiente
                        if siguiente:
                            self.mensajes = [f"{poke.nombre} ahora lleva {siguiente}."]
                        else:
                            self.mensajes = [f"{poke.nombre} ya no lleva nada."]
                        self.timer_mensajes = 1.5
                except Exception as e:
                    print(f"Error equipando baya: {e}")
        elif key == pygame.K_r:
            # C5: quitar objeto held
            poke = eq[self.equipo_idx] if eq else None
            if poke and poke.objeto_equipado:
                self.mensajes = [f"{poke.nombre} dejo caer {poke.objeto_equipado}."]
                poke.objeto_equipado = None
                self.timer_mensajes = 1.5
        elif key in (pygame.K_f, pygame.K_ESCAPE):
            Sonidos.reproducir_select()
            self.estado = "exploracion"

    def _dibujar_equipo_menu(self):
        # Fondo tipo cuaderno/album
        for i in range(ALTO):
            r = int(30 + 20 * i / ALTO)
            g = int(20 + 15 * i / ALTO)
            b = int(40 + 25 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Panel lateral (lista de equipo)
        pygame.draw.rect(pantalla, (32, 24, 40), (0, 0, 170, ALTO))
        pygame.draw.rect(pantalla, (240, 200, 60), (166, 0, 4, ALTO))
        titulo = fuente_grande.render("EQUIPO", True, (255, 220, 100))
        pantalla.blit(titulo, (170 // 2 - titulo.get_width() // 2, 12))

        eq = self.equipo.pokemons
        if not eq:
            v = fuente_media.render("Sin Pokemon.", True, (200, 200, 210))
            pantalla.blit(v, (20, 60))
        else:
            for i, p in enumerate(eq):
                sel = (i == self.equipo_idx)
                y = 50 + i * 60
                fondo = (72, 50, 88) if sel else (40, 28, 48)
                pygame.draw.rect(pantalla, fondo, (8, y, 154, 56))
                pygame.draw.rect(pantalla, (240, 200, 60) if sel else (90, 70, 110),
                                 (8, y, 154, 56), 2 if sel else 1)
                sp = SPRITES.get(p.nombre)
                if sp:
                    pequeno = pygame.transform.scale(sp, (36, 36))
                    pantalla.blit(pequeno, (14, y + 10))
                nombre = p.nombre[:11]
                col_n = (255, 240, 150) if sel else (220, 220, 230)
                tn = fuente_peque.render(nombre, True, col_n)
                pantalla.blit(tn, (56, y + 6))
                tn2 = fuente_peque.render(f"Nv{p.nivel}", True, col_n)
                pantalla.blit(tn2, (56, y + 22))
                # mini barra PS
                r = p.ps / p.ps_max if p.ps_max else 0
                pygame.draw.rect(pantalla, (60, 40, 60), (56, y + 38, 90, 6))
                col = (56, 200, 80) if r > 0.5 else (240, 200, 60) if r > 0.2 else (220, 60, 60)
                pygame.draw.rect(pantalla, col, (56, y + 38, int(90 * r), 6))
                pygame.draw.rect(pantalla, (20, 15, 25), (56, y + 38, 90, 6), 1)

        # Panel de detalle (derecha)
        px = 180
        pw = ANCHO - px - 10
        pygame.draw.rect(pantalla, (28, 20, 38), (px, 10, pw, ALTO - 20))
        pygame.draw.rect(pantalla, (240, 200, 60), (px, 10, pw, ALTO - 20), 3)

        if eq:
            p = eq[self.equipo_idx]
            # Sprite grande
            sp_big = SPRITES.get(p.nombre)
            if sp_big:
                grande = pygame.transform.scale(sp_big, (128, 128))
                pantalla.blit(grande, (px + 20, 24))
            # Nombre y nivel
            nom = fuente_grande.render(p.nombre, True, (255, 240, 150))
            pantalla.blit(nom, (px + 160, 30))
            lv = fuente_media.render(f"Nv {p.nivel}", True, (220, 220, 230))
            pantalla.blit(lv, (px + 160, 60))
            # Tipos
            try:
                tipos = p.tipos or []
            except Exception:
                tipos = []
            colores_tipo = {
                "Planta": (110, 200, 100), "Fuego": (240, 120, 60),
                "Agua": (80, 150, 240), "Normal": (180, 180, 160),
                "Bicho": (170, 200, 80), "Tierra": (200, 160, 80),
                "Hada": (240, 170, 220), "Psiquico": (240, 100, 160),
                "Psíquico": (240, 100, 160), "Siniestro": (90, 70, 90),
                "Volador": (180, 200, 240), "Roca": (180, 150, 90),
                "Acero": (170, 180, 200), "Lucha": (200, 80, 60),
                "Veneno": (160, 90, 200), "Fantasma": (120, 100, 170),
                "Hielo": (140, 220, 230), "Dragon": (90, 90, 230),
                "Dragón": (90, 90, 230), "Electrico": (240, 210, 60),
                "Eléctrico": (240, 210, 60), "Sonido": (150, 220, 220),
            }
            tx = px + 160
            for tt in tipos:
                col = colores_tipo.get(tt, (200, 200, 200))
                pygame.draw.rect(pantalla, col, (tx, 90, 70, 20))
                pygame.draw.rect(pantalla, (20, 15, 25), (tx, 90, 70, 20), 1)
                et = fuente_peque.render(tt[:10], True, (30, 20, 30))
                pantalla.blit(et, (tx + 35 - et.get_width() // 2, 93))
                tx += 78

            # Barra de PS grande
            pygame.draw.rect(pantalla, (60, 40, 60), (px + 20, 165, 260, 12))
            r = p.ps / p.ps_max if p.ps_max else 0
            col = (56, 200, 80) if r > 0.5 else (240, 200, 60) if r > 0.2 else (220, 60, 60)
            pygame.draw.rect(pantalla, col, (px + 20, 165, int(260 * r), 12))
            pygame.draw.rect(pantalla, (20, 15, 25), (px + 20, 165, 260, 12), 2)
            ps_txt = fuente_peque.render(f"PS {p.ps}/{p.ps_max}", True, (255, 240, 200))
            pantalla.blit(ps_txt, (px + 20, 180))

            # Barra EXP
            pygame.draw.rect(pantalla, (25, 18, 35), (px + 20, 200, 260, 8))
            try:
                nec = p.exp_para_siguiente_nivel()
                rexp = min(1.0, p.exp / nec) if nec > 0 else 0
                pygame.draw.rect(pantalla, (100, 210, 255),
                                 (px + 20, 200, int(260 * rexp), 8))
            except Exception:
                pass
            pygame.draw.rect(pantalla, (20, 15, 25), (px + 20, 200, 260, 8), 1)
            exp_txt = fuente_peque.render(
                f"EXP {getattr(p,'exp',0)}/{p.exp_para_siguiente_nivel() if hasattr(p,'exp_para_siguiente_nivel') else '?'}",
                True, (100, 210, 255))
            pantalla.blit(exp_txt, (px + 20, 210))

            # Stats
            try:
                st_atq = p.stat_efectivo("atq")
                st_def = p.stat_efectivo("def")
                st_ae = p.stat_efectivo("atq_esp")
                st_de = p.stat_efectivo("def_esp")
                st_vel = p.stat_efectivo("vel")
            except Exception:
                st_atq = getattr(p, "atq", "?")
                st_def = getattr(p, "defensa", "?")
                st_ae = getattr(p, "atq_esp", "?")
                st_de = getattr(p, "def_esp", "?")
                st_vel = getattr(p, "vel", "?")
            stats = [("ATQ", st_atq), ("DEF", st_def),
                     ("ATQ.E", st_ae), ("DEF.E", st_de), ("VEL", st_vel)]
            y_st = 235
            for nom_st, val in stats:
                lbl = fuente_peque.render(nom_st, True, (200, 220, 240))
                pantalla.blit(lbl, (px + 20, y_st))
                pygame.draw.rect(pantalla, (40, 30, 50), (px + 80, y_st + 4, 100, 8))
                try:
                    v = int(val)
                except Exception:
                    v = 0
                ancho = min(100, int(v * 0.4))
                pygame.draw.rect(pantalla, (180, 130, 220), (px + 80, y_st + 4, ancho, 8))
                pygame.draw.rect(pantalla, (20, 15, 25), (px + 80, y_st + 4, 100, 8), 1)
                vt = fuente_peque.render(str(val), True, (240, 240, 240))
                pantalla.blit(vt, (px + 190, y_st))
                y_st += 16

            # C5: objeto equipado
            try:
                obj_eq = getattr(p, "objeto_equipado", None)
                tt_obj = fuente_media.render(
                    f"Lleva: {obj_eq if obj_eq else '(nada)'}",
                    True, (255, 200, 100) if obj_eq else (170, 170, 180))
                pantalla.blit(tt_obj, (px + 20, y_st + 4))
                y_st += 22
            except Exception:
                pass

            # Movimientos
            y_mov = y_st + 8
            tt_mov = fuente_media.render("Movimientos", True, (255, 220, 120))
            pantalla.blit(tt_mov, (px + 20, y_mov))
            y_mov += 22
            for i, m in enumerate(p.movimientos[:4]):
                mn = fuente_peque.render(
                    f"{i+1}. {m.nombre}  [{m.tipo}]  PP {m.pp}/{m.pp_max}",
                    True, (220, 220, 230))
                pantalla.blit(mn, (px + 26, y_mov))
                y_mov += 18

        # Pie
        tip = fuente_peque.render(
            "[↑/↓] Elegir  [X] Reordenar  [E] Equipar item  [R] Quitar  [F/ESC] Salir",
            True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 18))

    def _dibujar_estadisticas(self):
        # Fondo
        for i in range(ALTO):
            r = int(20 + 25 * i / ALTO)
            g = int(30 + 30 * i / ALTO)
            b = int(60 + 30 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Cabecera
        pygame.draw.rect(pantalla, (60, 40, 90), (0, 0, ANCHO, 44))
        pygame.draw.rect(pantalla, (240, 200, 60), (0, 42, ANCHO, 2))
        t = fuente_grande.render("ESTADISTICAS DE PARTIDA", True, BLANCO)
        pantalla.blit(t, (ANCHO // 2 - t.get_width() // 2, 12))

        # Panel
        pygame.draw.rect(pantalla, (28, 20, 38), (30, 60, ANCHO - 60, ALTO - 110))
        pygame.draw.rect(pantalla, (240, 200, 60), (30, 60, ANCHO - 60, ALTO - 110), 3)

        st = getattr(self, "_stats_partida", {})

        # Tiempo
        tiempo = getattr(self, "_tiempo_juego", 0)
        hh = int(tiempo) // 3600
        mm = (int(tiempo) % 3600) // 60
        ss = int(tiempo) % 60

        # Nombre del jugador
        nombre = getattr(self, "nombre_jugador", "Freekie")

        lineas = [
            ("Entrenador", nombre),
            ("Tiempo jugado", f"{hh:02d}:{mm:02d}:{ss:02d}"),
            ("", ""),
            ("Medallas obtenidas", f"{self.gimnasios.cantidad_medallas()}/8"),
            ("Pokemon vistos", str(self.pokedex.total_vistos())),
            ("Pokemon capturados", str(self.pokedex.total_capturados())),
            ("", ""),
            ("Batallas ganadas", str(st.get("batallas_ganadas", 0))),
            ("Batallas perdidas", str(st.get("batallas_perdidas", 0))),
            ("Entrenadores vencidos", str(st.get("entrenadores_derrotados",
                                                 len(self.gimnasios.lideres_derrotados)))),
            ("", ""),
            ("Pasos recorridos", f"{st.get('pasos', 0):,}"),
            ("Distancia estimada", f"{st.get('pasos', 0) * 0.5:.1f} m"),
            ("Curaciones", str(st.get("curaciones", 0))),
            ("", ""),
            ("Dinero actual", f"S/ {self.inventario.dinero}"),
            ("Dinero ganado", f"S/ {st.get('dinero_ganado', 0)}"),
        ]

        y = 80
        for etiq, val in lineas:
            if not etiq:
                y += 8
                continue
            t1 = fuente_media.render(etiq, True, (200, 220, 240))
            t2 = fuente_media.render(str(val), True, (255, 240, 150))
            pantalla.blit(t1, (50, y))
            pantalla.blit(t2, (ANCHO - 60 - t2.get_width(), y))
            y += 24

        # Pie
        tip = fuente_peque.render("[F/ESC] Volver al menu",
                                   True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO // 2 - tip.get_width() // 2, ALTO - 26))

    def _dibujar_menu_pausa(self):
        # Fondo semitransparente con tinte azulado
        ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
        for i in range(ALTO):
            a = int(140 + 60 * (i / ALTO))
            ov.fill((10, 8, 30, a), (0, i, ANCHO, 1))
        pantalla.blit(ov, (0, 0))

        # Panel principal
        px, py, pw, ph = 20, 30, ANCHO - 40, ALTO - 60
        UIKit.dibujar_panel(pantalla, px, py, pw, ph)

        # Titulo con sombra
        titulo = fuente_titulo.render("MENU", True, (200, 60, 60))
        ts = fuente_titulo.render("MENU", True, (60, 20, 20))
        tx = px + pw // 2 - titulo.get_width() // 2
        pantalla.blit(ts, (tx + 3, py + 8 + 3))
        pantalla.blit(titulo, (tx, py + 8))

        # Info jugador + medallas
        try:
            nombre = getattr(self, "nombre_jugador", "Freekie")
            medallas = self.gimnasios.cantidad_medallas()
            # Panel info
            UIKit.dibujar_panel_oscuro(pantalla, px + 15, py + 50, pw - 30, 50)
            t1 = fuente_media.render(f"Entrenador: {nombre}", True, UI.EMERALD_GOLD)
            t2 = fuente_peque.render(f"Medallas: {medallas}/8", True, (240, 240, 220))
            pantalla.blit(t1, (px + 30, py + 56))
            pantalla.blit(t2, (px + 30, py + 80))
            # Medallas
            for i in range(8):
                tiene = i < medallas
                UIKit.dibujar_medalla(pantalla, px + pw - 240 + i * 26, py + 60, 22, tiene)
        except Exception:
            pass

        # Opciones en 2 columnas
        opciones = ["MOCHILA", "EQUIPO", "POKEDEX", "LOGROS", "CHASQUI", "FESTIVAL",
                    "SAFARI", "MI BASE", "FRENTE DE LOS APUS", "OMEGA-INCA",
                    "EPISODIO AMARU", "ESTADISTICAS", "GUARDAR", "OPCIONES", "SALIR"]

        # Iconos para cada opcion
        iconos = {
            "MOCHILA": "🎒", "EQUIPO": "👥", "POKEDEX": "📖", "LOGROS": "🏆",
            "CHASQUI": "📞", "FESTIVAL": "🎭", "SAFARI": "🔭", "MI BASE": "🏠",
            "FRENTE DE LOS APUS": "⛰", "OMEGA-INCA": "🌀", "EPISODIO AMARU": "🐉",
            "ESTADISTICAS": "📊", "GUARDAR": "💾", "OPCIONES": "⚙", "SALIR": "🚪",
        }

        col_w = (pw - 60) // 2
        col1 = opciones[:8]
        col2 = opciones[8:]
        y0 = py + 115
        alto_op = 32
        sep = 5

        for i, op in enumerate(col1):
            sel = (i == self.menu_pausa_idx)
            bx = px + 20
            by = y0 + i * (alto_op + sep)
            fondo = (100, 80, 130) if sel else (60, 45, 80)
            pygame.draw.rect(pantalla, fondo, (bx, by, col_w, alto_op))
            if sel:
                pygame.draw.rect(pantalla, UI.EMERALD_GOLD, (bx, by, col_w, alto_op), 3)
                pygame.draw.rect(pantalla, UI.EMERALD_GOLD_LIGHT, (bx + 2, by + 2, col_w - 4, alto_op - 4), 1)
            else:
                pygame.draw.rect(pantalla, UI.EMERALD_BORDER_LIGHT, (bx, by, col_w, alto_op), 1)
            # Icono
            try:
                ico = fuente_media.render(iconos.get(op, ">"), True, UI.EMERALD_GOLD if sel else (180, 180, 200))
                pantalla.blit(ico, (bx + 8, by + 4))
            except Exception:
                pass
            txt = fuente_media.render(op, True, (255, 240, 140) if sel else (220, 220, 240))
            pantalla.blit(txt, (bx + 40, by + (alto_op - txt.get_height()) // 2))
            if sel:
                UIKit.dibujar_cursor(pantalla, bx - 14, by + 10, UI.EMERALD_GOLD)

        for i, op in enumerate(col2):
            idx_real = 8 + i
            sel = (idx_real == self.menu_pausa_idx)
            bx = px + 40 + col_w
            by = y0 + i * (alto_op + sep)
            fondo = (100, 80, 130) if sel else (60, 45, 80)
            pygame.draw.rect(pantalla, fondo, (bx, by, col_w, alto_op))
            if sel:
                pygame.draw.rect(pantalla, UI.EMERALD_GOLD, (bx, by, col_w, alto_op), 3)
                pygame.draw.rect(pantalla, UI.EMERALD_GOLD_LIGHT, (bx + 2, by + 2, col_w - 4, alto_op - 4), 1)
            else:
                pygame.draw.rect(pantalla, UI.EMERALD_BORDER_LIGHT, (bx, by, col_w, alto_op), 1)
            try:
                ico = fuente_media.render(iconos.get(op, ">"), True, UI.EMERALD_GOLD if sel else (180, 180, 200))
                pantalla.blit(ico, (bx + 8, by + 4))
            except Exception:
                pass
            if len(op) > 14:
                txt = fuente_peque.render(op, True, (255, 240, 140) if sel else (220, 220, 240))
            else:
                txt = fuente_media.render(op, True, (255, 240, 140) if sel else (220, 220, 240))
            pantalla.blit(txt, (bx + 40, by + (alto_op - txt.get_height()) // 2))
            if sel:
                UIKit.dibujar_cursor(pantalla, bx - 14, by + 10, UI.EMERALD_GOLD)

        # Pie con tiempo
        try:
            t = int(getattr(self, "_tiempo_juego", 0))
            hh = t // 3600
            mm = (t % 3600) // 60
            ss = t % 60
            info = fuente_peque.render(f"⏱ {hh:02d}:{mm:02d}:{ss:02d}", True, (200, 220, 255))
            pantalla.blit(info, (px + 20, py + ph - 30))
        except Exception:
            pass
        tip = fuente_peque.render("[Flechas] Navegar   [X] Elegir   [F/ESC] Cerrar",
                                   True, (240, 220, 180))
        pantalla.blit(tip, (px + pw - tip.get_width() - 20, py + ph - 30))
    def _dibujar_seguidor(self, cam_x, cam_y):
        """B4: dibuja el primer Pokemon del equipo detras del jugador."""
        if not self.equipo.pokemons:
            return
        if not getattr(self, "_seguidor_cola", None):
            return
        # Usar la 2da posicion de la cola (la primera es la actual)
        if len(self._seguidor_cola) < 2:
            return
        sx, sy, sdir = self._seguidor_cola[1]
        if abs(sx - self.mapa_actual.destino_x) + abs(sy - self.mapa_actual.destino_y) == 0:
            # Esta encima del jugador, no dibujar
            return
        poke = self.equipo.pokemons[0]
        sprite = SPRITES.get(poke.nombre)
        if sprite is None:
            return
        sp = pygame.transform.scale(sprite, (24, 24))
        px = sx * TILE_SIZE - cam_x + TILE_SIZE // 2 - sp.get_width() // 2
        py = sy * TILE_SIZE - cam_y + TILE_SIZE - sp.get_height()
        # Sombra
        pygame.draw.ellipse(pantalla, (0, 0, 0, 90), (px + 3, py + sp.get_height() - 3, 18, 4))
        # Sprite con bob si esta animado
        try:
            self._seguidor_anim += 1/60.0
            bob = int(math.sin(self._seguidor_anim * 8) * 1) if self.mapa_actual.moviendo else 0
        except Exception:
            bob = 0
        pantalla.blit(sp, (px, py + bob))

    def _dibujar_fondo_batalla(self, bioma="valle"):
        """F7: fondo unico de batalla segun bioma."""
        # Cielo con degradado por bioma
        cielos = {
            "costa":     ((135, 200, 240), (200, 230, 250)),
            "valle":     ((120, 180, 230), (180, 220, 240)),
            "sierra":    ((90, 130, 190),   (160, 190, 220)),
            "paramo":    ((180, 200, 230),  (230, 240, 250)),
            "altiplano": ((110, 160, 210),  (190, 210, 230)),
            "selva":     ((70, 130, 90),    (130, 180, 130)),
            "capital":   ((100, 110, 160),  (170, 180, 210)),
        }
        c1, c2 = cielos.get(bioma, cielos["valle"])
        for i in range(ALTO // 2):
            t = i / (ALTO // 2)
            r = int(c1[0] * (1-t) + c2[0] * t)
            g = int(c1[1] * (1-t) + c2[1] * t)
            b = int(c1[2] * (1-t) + c2[2] * t)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Elementos por bioma
        if bioma == "costa":
            # Sol + nubes
            pygame.draw.circle(pantalla, (255, 240, 140), (ANCHO - 80, 50), 30)
            pygame.draw.circle(pantalla, (255, 250, 200), (ANCHO - 80, 50), 22)
            for nx, ny in [(80, 40), (200, 60), (400, 30)]:
                pygame.draw.ellipse(pantalla, (255, 255, 255), (nx, ny, 50, 18))
                pygame.draw.ellipse(pantalla, (245, 245, 245), (nx + 15, ny - 6, 40, 20))
            # Mar
            for i in range(ALTO // 2, ALTO // 2 + 40):
                t = (i - ALTO // 2) / 40
                col = (int(60 + t*40), int(120 + t*50), int(180 + t*40))
                pygame.draw.line(pantalla, col, (0, i), (ANCHO, i))
            for i in range(10):
                wx = (i * 70 + 20) % ANCHO
                wy = ALTO // 2 + 15 + (i % 3) * 8
                pygame.draw.line(pantalla, (200, 230, 250), (wx, wy), (wx + 15, wy), 1)
        elif bioma in ("sierra", "paramo"):
            # Montañas con nieve
            for mx, my, mw, mh in [(40, 130, 180, 90), (250, 100, 220, 120),
                                    (450, 140, 200, 80)]:
                pygame.draw.polygon(pantalla, (100, 90, 110),
                    [(mx, my), (mx + mw//2, my - mh), (mx + mw, my)])
                # Nieve en la punta
                pygame.draw.polygon(pantalla, (245, 250, 255),
                    [(mx + mw//2 - 20, my - mh + 25),
                     (mx + mw//2, my - mh),
                     (mx + mw//2 + 20, my - mh + 25),
                     (mx + mw//2 + 12, my - mh + 22),
                     (mx + mw//2, my - mh + 28),
                     (mx + mw//2 - 12, my - mh + 22)])
            # Cielo estrellado si es noche
            try:
                if self.tiempo.es_noche():
                    rnd = random.Random(42)
                    for _ in range(60):
                        x = rnd.randint(0, ANCHO)
                        y = rnd.randint(0, ALTO // 2 - 20)
                        pygame.draw.rect(pantalla, (240, 240, 220), (x, y, 1, 1))
            except Exception:
                pass
        elif bioma == "selva":
            # Árboles grandes al fondo
            for i in range(8):
                tx = i * 90 + 20
                ty = 100
                pygame.draw.rect(pantalla, (60, 40, 20), (tx + 20, ty + 40, 12, 60))
                pygame.draw.ellipse(pantalla, (30, 90, 40), (tx, ty - 20, 80, 70))
                pygame.draw.ellipse(pantalla, (60, 140, 60), (tx + 10, ty - 30, 60, 60))
            # Ríos o agua
            for i in range(ALTO // 2 + 60, ALTO):
                t = (i - ALTO // 2 - 60) / (ALTO // 2 - 60)
                col = (int(60 + t*20), int(140 + t*20), 150)
                pygame.draw.line(pantalla, col, (0, i), (ANCHO, i))
        elif bioma == "capital":
            # Edificios modernos
            rnd = random.Random(7)
            for i in range(10):
                bx = i * 70
                bh = rnd.randint(60, 130)
                by = ALTO // 2 - bh + 60
                pygame.draw.rect(pantalla, (80, 80, 120), (bx, by, 60, bh))
                pygame.draw.rect(pantalla, (100, 100, 140), (bx + 4, by + 4, 52, bh - 8))
                # Ventanas
                for wy in range(by + 10, by + bh - 10, 14):
                    for wx in range(bx + 10, bx + 50, 12):
                        col_w = (255, 240, 140) if (wx + wy) % 3 == 0 else (40, 60, 90)
                        pygame.draw.rect(pantalla, col_w, (wx, wy, 6, 8))
        else:  # valle / default
            # Colinas verdes
            for i in range(3):
                cy = 200 + i * 30
                pygame.draw.ellipse(pantalla, (100 + i*20, 180 + i*10, 100 + i*20),
                                     (-50, cy, ANCHO + 100, 80))

        # Suelo base (según bioma)
        suelos = {
            "costa":     (230, 200, 160),
            "valle":     (140, 200, 110),
            "sierra":    (170, 150, 130),
            "paramo":    (220, 225, 235),
            "altiplano": (200, 190, 150),
            "selva":     (90, 140, 80),
            "capital":   (170, 170, 180),
        }
        suelo_col = suelos.get(bioma, suelos["valle"])
        pygame.draw.rect(pantalla, suelo_col, (0, ALTO // 2 + 90, ANCHO, ALTO // 2))
        # Sombra de la parte inferior
        for i in range(ALTO // 2 + 90, ALTO):
            t = (i - ALTO // 2 - 90) / (ALTO // 2)
            shade = tuple(max(0, int(c * (1 - t * 0.25))) for c in suelo_col)
            pygame.draw.line(pantalla, shade, (0, i), (ANCHO, i))

    def _dibujar_particulas_ambientales(self):
        """F6: particulas que caen segun bioma."""
        try:
            bioma = getattr(self.mapa_actual, "bioma", "valle")
        except Exception:
            return
        t = getattr(self, "anim_menu", 0.0)
        rnd = random.Random(int(t * 8))

        if bioma in ("selva", "valle"):
            # Hojas verdes cayendo
            for i in range(18):
                px_ = (rnd.randint(0, ANCHO) + int(t * 15 * (1 + i % 2))) % ANCHO
                py_ = (rnd.randint(0, ALTO) + int(t * 25)) % ALTO
                # Hoja
                col = (100 + (i % 3) * 20, 160 + (i % 4) * 15, 60)
                pygame.draw.ellipse(pantalla, col, (px_, py_, 4, 2))
        elif bioma in ("sierra", "paramo", "altiplano"):
            # Nieve cayendo
            for i in range(30):
                px_ = (rnd.randint(0, ANCHO) + int(t * 12 * (1 + i % 3))) % ANCHO
                py_ = (rnd.randint(0, ALTO) + int(t * 30)) % ALTO
                pygame.draw.circle(pantalla, (245, 250, 255), (px_, py_), 1)
                if i % 3 == 0:
                    pygame.draw.circle(pantalla, (220, 235, 250), (px_, py_), 2, 1)
        elif bioma == "costa":
            # Arena/polvo volando
            for i in range(15):
                px_ = (rnd.randint(0, ANCHO) + int(t * 20)) % ANCHO
                py_ = (rnd.randint(0, ALTO) + int(t * 8)) % ALTO
                pygame.draw.rect(pantalla, (230, 210, 170), (px_, py_, 2, 1))
            # Gaviotas lejanas (siluetas)
            for i in range(3):
                gx = (i * 250 + int(t * 10)) % (ANCHO + 40) - 20
                gy = 40 + i * 30 + int(math.sin(t + i) * 4)
                pygame.draw.line(pantalla, (60, 60, 70), (gx, gy), (gx + 5, gy - 3), 1)
                pygame.draw.line(pantalla, (60, 60, 70), (gx + 5, gy - 3), (gx + 10, gy), 1)
        elif bioma == "capital":
            # Hojas de periódico / viento
            for i in range(8):
                px_ = (rnd.randint(0, ANCHO) + int(t * 25)) % ANCHO
                py_ = (rnd.randint(0, ALTO) + int(t * 12)) % ALTO
                pygame.draw.rect(pantalla, (220, 220, 200), (px_, py_, 3, 2))
        else:
            # Hojas genéricas
            for i in range(10):
                px_ = (rnd.randint(0, ANCHO) + int(t * 15)) % ANCHO
                py_ = (rnd.randint(0, ALTO) + int(t * 20)) % ALTO
                pygame.draw.ellipse(pantalla, (150, 200, 120), (px_, py_, 3, 2))

    def _dibujar_amaru_detallado(self, cx, cy, t, escala=1.0):
        """F9: Amaru super detallado para la pantalla de titulo."""
        e = escala
        # Aura exterior pulsante
        pulso = 1.0 + 0.08 * math.sin(t * 2)
        for i in range(6):
            r = int((90 + i * 8) * e * pulso)
            alpha = max(0, 80 - i * 15)
            ov = pygame.Surface((r * 2, r * 2), pygame.SRCALPHA)
            pygame.draw.circle(ov, (255, 220, 100, alpha), (r, r), r, 3)
            pantalla.blit(ov, (cx - r, cy - r))

        # Cuerpo de la serpiente (curva sinusoidal)
        puntos = []
        for i in range(40):
            tt = i / 39
            x = cx - 180 * e + tt * 360 * e
            y = cy + math.sin(tt * 4 + t * 1.5) * 30 * e - tt * 20 * e
            puntos.append((x, y))

        # Sombra del cuerpo
        for i, (x, y) in enumerate(puntos):
            tt = i / len(puntos)
            grosor = int((3 + 6 * math.sin(tt * math.pi)) * e)
            pygame.draw.circle(pantalla, (20, 10, 30), (int(x) + 3, int(y) + 3), grosor)

        # Cuerpo con degradado (verde -> dorado)
        for i, (x, y) in enumerate(puntos):
            tt = i / len(puntos)
            r = int(60 + 100 * tt)
            g = int(120 + 100 * tt)
            b = int(60 + 40 * tt)
            grosor = int((3 + 6 * math.sin(tt * math.pi)) * e)
            pygame.draw.circle(pantalla, (r, g, b), (int(x), int(y)), grosor)

        # Escamas brillantes
        for i in range(0, len(puntos), 2):
            x, y = puntos[i]
            if i % 6 == 0:
                pygame.draw.circle(pantalla, (255, 240, 180), (int(x), int(y)), int(2 * e))

        # Cabeza grande
        hx, hy = puntos[-1]
        # Cuernos dorados
        pygame.draw.polygon(pantalla, (240, 200, 80), [
            (hx - 5*e, hy - 8*e), (hx - 15*e, hy - 35*e), (hx - 2*e, hy - 12*e)
        ])
        pygame.draw.polygon(pantalla, (240, 200, 80), [
            (hx + 5*e, hy - 8*e), (hx + 18*e, hy - 32*e), (hx + 4*e, hy - 12*e)
        ])
        pygame.draw.polygon(pantalla, (255, 230, 120), [
            (hx - 8*e, hy - 10*e), (hx - 13*e, hy - 30*e), (hx - 5*e, hy - 12*e)
        ])
        pygame.draw.polygon(pantalla, (255, 230, 120), [
            (hx + 8*e, hy - 10*e), (hx + 16*e, hy - 28*e), (hx + 5*e, hy - 12*e)
        ])
        # Cabeza
        pygame.draw.ellipse(pantalla, (60, 130, 80),
                            (hx - 18*e, hy - 12*e, 36*e, 26*e))
        pygame.draw.ellipse(pantalla, (100, 180, 110),
                            (hx - 14*e, hy - 10*e, 28*e, 20*e))
        # Hocico
        pygame.draw.ellipse(pantalla, (140, 210, 150),
                            (hx - 10*e, hy - 4*e, 20*e, 12*e))
        # Ojos brillantes
        pygame.draw.circle(pantalla, (255, 240, 60), (int(hx - 7*e), int(hy - 4*e)), int(3 * e))
        pygame.draw.circle(pantalla, (255, 240, 60), (int(hx + 7*e), int(hy - 4*e)), int(3 * e))
        pygame.draw.circle(pantalla, (255, 80, 80), (int(hx - 7*e), int(hy - 4*e)), int(2 * e))
        pygame.draw.circle(pantalla, (255, 80, 80), (int(hx + 7*e), int(hy - 4*e)), int(2 * e))
        pygame.draw.circle(pantalla, (255, 255, 255), (int(hx - 7*e), int(hy - 5*e)), 1)
        pygame.draw.circle(pantalla, (255, 255, 255), (int(hx + 7*e), int(hy - 5*e)), 1)
        # Fauces
        pygame.draw.line(pantalla, (30, 20, 30),
                         (hx - 4*e, hy + 4*e), (hx + 4*e, hy + 4*e), max(1, int(1 * e)))

        # Cola con punta de flecha
        tx, ty = puntos[0]
        pygame.draw.polygon(pantalla, (60, 130, 80), [
            (tx, ty),
            (tx - 20*e, ty - 15*e),
            (tx - 10*e, ty - 3*e),
            (tx - 25*e, ty + 5*e),
            (tx - 12*e, ty + 3*e),
            (tx - 15*e, ty + 20*e),
            (tx - 8*e, ty + 5*e),
        ])

        # Alas desplegadas
        ala_off = int(4 * math.sin(t * 3) * e)
        # Ala izquierda
        pygame.draw.polygon(pantalla, (40, 90, 60), [
            (cx - 30*e, cy - 20*e),
            (cx - 130*e, cy - 80*e + ala_off),
            (cx - 150*e, cy - 40*e + ala_off),
            (cx - 120*e, cy - 10*e),
            (cx - 80*e, cy - 30*e),
            (cx - 50*e, cy - 5*e),
        ])
        pygame.draw.polygon(pantalla, (60, 130, 80), [
            (cx - 30*e, cy - 20*e),
            (cx - 120*e, cy - 70*e + ala_off),
            (cx - 130*e, cy - 40*e + ala_off),
            (cx - 100*e, cy - 15*e),
            (cx - 60*e, cy - 25*e),
        ])
        # Detalles de alas
        for i in range(4):
            pygame.draw.line(pantalla, (30, 70, 50),
                             (int(cx - 40*e), int(cy - 20*e)),
                             (int(cx - 110*e + i*10*e), int(cy - 60*e + i*8*e + ala_off)), 1)
        # Ala derecha (espejo)
        pygame.draw.polygon(pantalla, (40, 90, 60), [
            (cx + 30*e, cy - 20*e),
            (cx + 130*e, cy - 80*e - ala_off),
            (cx + 150*e, cy - 40*e - ala_off),
            (cx + 120*e, cy - 10*e),
            (cx + 80*e, cy - 30*e),
            (cx + 50*e, cy - 5*e),
        ])
        pygame.draw.polygon(pantalla, (60, 130, 80), [
            (cx + 30*e, cy - 20*e),
            (cx + 120*e, cy - 70*e - ala_off),
            (cx + 130*e, cy - 40*e - ala_off),
            (cx + 100*e, cy - 15*e),
            (cx + 60*e, cy - 25*e),
        ])
        for i in range(4):
            pygame.draw.line(pantalla, (30, 70, 50),
                             (int(cx + 40*e), int(cy - 20*e)),
                             (int(cx + 110*e - i*10*e), int(cy - 60*e + i*8*e - ala_off)), 1)

        # Patas traseras
        pygame.draw.line(pantalla, (60, 130, 80),
                         (int(cx - 20*e), int(cy + 20*e)),
                         (int(cx - 30*e), int(cy + 45*e)), max(2, int(3 * e)))
        pygame.draw.line(pantalla, (60, 130, 80),
                         (int(cx + 20*e), int(cy + 20*e)),
                         (int(cx + 30*e), int(cy + 45*e)), max(2, int(3 * e)))

    def _dibujar_proyectil_tipo(self, tipo, x, y, prog, tam=1.0):
        """F10: dibuja un proyectil distinto segun el tipo del movimiento."""
        col_principal = {
            "Fuego":     (255, 140, 40),
            "Agua":      (80, 170, 240),
            "Planta":    (80, 200, 90),
            "Electrico": (255, 230, 60),
            "Eléctrico": (255, 230, 60),
            "Hielo":     (150, 230, 245),
            "Lucha":     (220, 80, 60),
            "Siniestro": (120, 80, 150),
            "Fantasma":  (160, 100, 200),
            "Veneno":    (180, 90, 200),
            "Tierra":    (200, 150, 90),
            "Roca":      (170, 140, 100),
            "Acero":     (180, 190, 210),
            "Psiquico":  (240, 100, 200),
            "Psíquico":  (240, 100, 200),
            "Bicho":     (170, 200, 80),
            "Volador":   (170, 200, 240),
            "Dragon":    (100, 110, 240),
            "Dragón":    (100, 110, 240),
            "Hada":      (250, 180, 220),
            "Sonido":    (150, 220, 220),
            "Normal":    (220, 220, 220),
        }.get(tipo, (220, 220, 220))
        col = col_principal

        if tipo in ("Fuego",):
            # Bola de fuego con lenguas
            for i in range(3):
                r = int((10 - i * 2) * tam)
                a = int(200 * (1 - prog * 0.3))
                pygame.draw.circle(pantalla, (255, 220 - i*40, 40), (int(x), int(y)), r + i * 3)
                pygame.draw.circle(pantalla, (255, 255, 150), (int(x), int(y)), max(1, r - 3))
            # Llamas alrededor
            for k in range(6):
                ang = k * 1.05 + prog * 8
                rx = x + math.cos(ang) * 14 * tam
                ry = y + math.sin(ang) * 14 * tam - 4
                pygame.draw.circle(pantalla, (255, 180, 60), (int(rx), int(ry)), int(3 * tam))

        elif tipo in ("Agua",):
            # Chorro de agua
            for k in range(4):
                offset = k * 6 * tam
                pygame.draw.ellipse(pantalla, (150, 200, 240),
                                    (int(x - 12 * tam + offset * 0.3), int(y - 6 * tam),
                                     int(10 * tam), int(12 * tam)))
                pygame.draw.ellipse(pantalla, col,
                                    (int(x - 10 * tam + offset * 0.3), int(y - 4 * tam),
                                     int(7 * tam), int(9 * tam)))
            # Gotas
            for k in range(3):
                pygame.draw.circle(pantalla, (220, 240, 255),
                                   (int(x + math.cos(prog * 6 + k * 2) * 12 * tam),
                                    int(y + math.sin(prog * 6 + k * 2) * 8 * tam)), int(2 * tam))

        elif tipo in ("Electrico", "Eléctrico"):
            # Rayo zigzag
            pts = []
            n = 8
            for i in range(n):
                tt = i / (n - 1)
                px = x - 40 * tam + tt * 80 * tam
                py = y + math.sin(prog * 20 + i * 1.7) * 8 * tam
                pts.append((int(px), int(py)))
            for i in range(len(pts) - 1):
                pygame.draw.line(pantalla, (255, 255, 200), pts[i], pts[i + 1], max(2, int(4 * tam)))
                pygame.draw.line(pantalla, col, pts[i], pts[i + 1], max(1, int(2 * tam)))
            # Chispas
            for k in range(5):
                ang = k * 1.25 + prog * 10
                r = 16 * tam
                px = x + math.cos(ang) * r
                py = y + math.sin(ang) * r
                pygame.draw.circle(pantalla, col, (int(px), int(py)), max(1, int(2 * tam)))

        elif tipo == "Planta":
            # Hojas girando
            for k in range(6):
                ang = k * 1.05 + prog * 6
                r = 10 * tam + math.sin(prog * 10 + k) * 4
                px = x + math.cos(ang) * r
                py = y + math.sin(ang) * r
                pygame.draw.ellipse(pantalla, col,
                                    (int(px - 4 * tam), int(py - 2 * tam),
                                     int(8 * tam), int(4 * tam)))
                pygame.draw.ellipse(pantalla, (60, 160, 70),
                                    (int(px - 3 * tam), int(py - 1 * tam),
                                     int(6 * tam), int(2 * tam)))

        elif tipo == "Hielo":
            # Copo de nieve
            for k in range(6):
                ang = k * 1.05
                px2 = x + math.cos(ang) * 14 * tam
                py2 = y + math.sin(ang) * 14 * tam
                pygame.draw.line(pantalla, col, (int(x), int(y)), (int(px2), int(py2)),
                                 max(1, int(2 * tam)))
            pygame.draw.circle(pantalla, col, (int(x), int(y)), max(1, int(6 * tam)))
            pygame.draw.circle(pantalla, (255, 255, 255), (int(x), int(y)), max(1, int(3 * tam)))

        elif tipo == "Psiquico" or tipo == "Psíquico":
            # Anillos mentales
            for i in range(3):
                r = int((10 + i * 6) * tam)
                pygame.draw.circle(pantalla, col, (int(x), int(y)), r, max(1, int(2 * tam)))
            pygame.draw.circle(pantalla, (255, 220, 255), (int(x), int(y)), max(1, int(5 * tam)))

        elif tipo == "Fantasma":
            # Silueta espectral
            pygame.draw.ellipse(pantalla, col,
                                (int(x - 10 * tam), int(y - 10 * tam),
                                 int(20 * tam), int(14 * tam)))
            pygame.draw.circle(pantalla, (240, 220, 255), (int(x - 3 * tam), int(y - 4 * tam)),
                               max(1, int(2 * tam)))
            pygame.draw.circle(pantalla, (240, 220, 255), (int(x + 3 * tam), int(y - 4 * tam)),
                               max(1, int(2 * tam)))
            # Cola
            pygame.draw.polygon(pantalla, col, [
                (int(x - 8 * tam), int(y + 3 * tam)),
                (int(x - 4 * tam), int(y + 14 * tam)),
                (int(x), int(y + 3 * tam)),
                (int(x + 4 * tam), int(y + 14 * tam)),
                (int(x + 8 * tam), int(y + 3 * tam)),
            ])

        elif tipo == "Veneno":
            # Burbujas acidas
            for k in range(5):
                ang = k * 1.25 + prog * 5
                r = 8 * tam + math.sin(prog * 12 + k) * 4
                px = x + math.cos(ang) * r
                py = y + math.sin(ang) * r
                pygame.draw.circle(pantalla, col, (int(px), int(py)), max(1, int(4 * tam)))
                pygame.draw.circle(pantalla, (240, 180, 255), (int(px), int(py)), max(1, int(2 * tam)))
            pygame.draw.circle(pantalla, (140, 60, 160), (int(x), int(y)), max(1, int(7 * tam)))

        elif tipo == "Tierra":
            # Rocas girando
            for k in range(4):
                ang = k * 1.57 + prog * 6
                px = x + math.cos(ang) * 12 * tam
                py = y + math.sin(ang) * 8 * tam
                pygame.draw.circle(pantalla, (140, 100, 60), (int(px), int(py)),
                                   max(1, int(4 * tam)))
                pygame.draw.circle(pantalla, col, (int(px - 1), int(py - 1)),
                                   max(1, int(3 * tam)))

        elif tipo == "Roca":
            # Roca grande
            pygame.draw.ellipse(pantalla, (100, 80, 60),
                                (int(x - 14 * tam), int(y - 12 * tam),
                                 int(28 * tam), int(24 * tam)))
            pygame.draw.ellipse(pantalla, col,
                                (int(x - 12 * tam), int(y - 10 * tam),
                                 int(24 * tam), int(20 * tam)))
            pygame.draw.ellipse(pantalla, (200, 180, 150),
                                (int(x - 8 * tam), int(y - 8 * tam),
                                 int(10 * tam), int(8 * tam)))

        elif tipo == "Acero":
            # Estrella metálica girando
            for k in range(4):
                ang = k * 1.57 + prog * 12
                px = x + math.cos(ang) * 14 * tam
                py = y + math.sin(ang) * 14 * tam
                pygame.draw.line(pantalla, col, (int(x), int(y)), (int(px), int(py)),
                                 max(2, int(3 * tam)))
            pygame.draw.circle(pantalla, (255, 255, 255), (int(x), int(y)), max(1, int(4 * tam)))

        elif tipo == "Lucha":
            # Puño con estela
            for k in range(3):
                r = int((10 + k * 3) * tam)
                pygame.draw.circle(pantalla, (255, 200, 150), (int(x), int(y)), r, 2)
            pygame.draw.circle(pantalla, (240, 90, 60), (int(x), int(y)), max(1, int(7 * tam)))
            pygame.draw.circle(pantalla, (255, 180, 100), (int(x - 2), int(y - 2)), max(1, int(4 * tam)))

        elif tipo == "Volador":
            # Pluma/ala
            pygame.draw.ellipse(pantalla, (240, 245, 255),
                                (int(x - 12 * tam), int(y - 6 * tam),
                                 int(24 * tam), int(12 * tam)))
            pygame.draw.ellipse(pantalla, col,
                                (int(x - 10 * tam), int(y - 4 * tam),
                                 int(20 * tam), int(8 * tam)))
            for k in range(3):
                pygame.draw.line(pantalla, (150, 180, 220),
                                 (int(x - 8 * tam + k * 6 * tam), int(y - 3 * tam)),
                                 (int(x - 4 * tam + k * 6 * tam), int(y + 3 * tam)), 1)

        elif tipo in ("Dragon", "Dragón"):
            # Bola de energía dragón
            pygame.draw.circle(pantalla, (60, 80, 200), (int(x), int(y)), max(1, int(14 * tam)))
            pygame.draw.circle(pantalla, col, (int(x), int(y)), max(1, int(11 * tam)))
            pygame.draw.circle(pantalla, (200, 220, 255), (int(x), int(y)), max(1, int(6 * tam)))
            for k in range(6):
                ang = k * 1.05 + prog * 8
                px = x + math.cos(ang) * 18 * tam
                py = y + math.sin(ang) * 18 * tam
                pygame.draw.circle(pantalla, (255, 240, 180), (int(px), int(py)), max(1, int(2 * tam)))

        elif tipo == "Hada":
            # Corazón brillante
            for k in range(8):
                ang = k * 0.785 + prog * 4
                r = 10 * tam + math.sin(prog * 10 + k) * 4
                px = x + math.cos(ang) * r
                py = y + math.sin(ang) * r
                pygame.draw.circle(pantalla, col, (int(px), int(py)), max(1, int(3 * tam)))
                pygame.draw.circle(pantalla, (255, 255, 255), (int(px), int(py)), 1)
            pygame.draw.circle(pantalla, (255, 220, 240), (int(x), int(y)), max(1, int(8 * tam)))

        elif tipo == "Bicho":
            # Enjambre de puntos verdes
            for k in range(8):
                ang = k * 0.785 + prog * 15
                r = 8 * tam + (k % 3) * 4
                px = x + math.cos(ang) * r
                py = y + math.sin(ang) * r
                pygame.draw.circle(pantalla, col, (int(px), int(py)), max(1, int(2 * tam)))
                pygame.draw.circle(pantalla, (60, 80, 30), (int(px), int(py)), 1)

        elif tipo == "Sonido":
            # Ondas de sonido
            for i in range(4):
                r = int((6 + i * 5) * tam + (prog * 10))
                pygame.draw.arc(pantalla, col,
                                (int(x - r), int(y - r), r * 2, r * 2),
                                -1.2 + prog * 3, 1.2 + prog * 3, max(1, int(2 * tam)))

        else:
            # Proyectil genérico
            pygame.draw.circle(pantalla, col, (int(x), int(y)), max(1, int(10 * tam)))
            pygame.draw.circle(pantalla, (255, 255, 255), (int(x), int(y)), max(1, int(4 * tam)))

    def _dibujar_condor_detallado(self, cx, cy, t, escala=1.0):
        """F9b: Condor andino majestuoso para la pantalla de titulo."""
        e = escala
        pulso = 1.0 + 0.06 * math.sin(t * 1.8)

        # Halo dorado suave
        for i in range(5):
            r = int((110 + i * 12) * e * pulso)
            alpha = max(0, 60 - i * 12)
            ov = pygame.Surface((r * 2, r * 2), pygame.SRCALPHA)
            pygame.draw.circle(ov, (255, 220, 120, alpha), (r, r), r, 3)
            pantalla.blit(ov, (cx - r, cy - r))

        # Nubes estilizadas al fondo
        for i, (nx, ny, nw, nh) in enumerate([(-100, 30, 200, 40), (100, 60, 180, 35), (280, 20, 220, 45)]):
            pygame.draw.ellipse(pantalla, (240, 245, 255, 100), (nx, ny, nw, nh))
            pygame.draw.ellipse(pantalla, (230, 240, 255, 80), (nx + 30, ny - 8, nw - 60, nh + 10))

        # Alas extendidas (gran envergadura)
        ala_y = cy - 20 * e + int(math.sin(t * 1.5) * 3 * e)
        ala_ancho = 220 * e
        ala_alto = 60 * e

        # Ala izquierda (con puntas de plumas)
        pygame.draw.polygon(pantalla, (30, 30, 40), [
            (cx - 20 * e, ala_y),
            (cx - ala_ancho, ala_y - ala_alto),
            (cx - ala_ancho + 40 * e, ala_y - ala_alto + 20 * e),
            (cx - ala_ancho + 80 * e, ala_y - ala_alto + 45 * e),
            (cx - ala_ancho + 120 * e, ala_y - ala_alto + 70 * e),
            (cx - 20 * e, ala_y + 15 * e),
        ])
        # Cuerpo principal del ala izq (mas claro)
        pygame.draw.polygon(pantalla, (55, 55, 70), [
            (cx - 20 * e, ala_y),
            (cx - ala_ancho + 20 * e, ala_y - ala_alto + 15 * e),
            (cx - ala_ancho + 60 * e, ala_y - ala_alto + 40 * e),
            (cx - ala_ancho + 100 * e, ala_y - ala_alto + 65 * e),
            (cx - 20 * e, ala_y + 8 * e),
        ])
        # Plumas individuales
        for i in range(6):
            px = cx - 40 * e - i * 30 * e
            py = ala_y - 8 * e + i * 8 * e
            pygame.draw.line(pantalla, (25, 25, 35),
                             (int(px), int(py)),
                             (int(px - 25 * e), int(py - 25 * e + i * 4 * e)), 2)

        # Ala derecha (espejo)
        pygame.draw.polygon(pantalla, (30, 30, 40), [
            (cx + 20 * e, ala_y),
            (cx + ala_ancho, ala_y - ala_alto),
            (cx + ala_ancho - 40 * e, ala_y - ala_alto + 20 * e),
            (cx + ala_ancho - 80 * e, ala_y - ala_alto + 45 * e),
            (cx + ala_ancho - 120 * e, ala_y - ala_alto + 70 * e),
            (cx + 20 * e, ala_y + 15 * e),
        ])
        pygame.draw.polygon(pantalla, (55, 55, 70), [
            (cx + 20 * e, ala_y),
            (cx + ala_ancho - 20 * e, ala_y - ala_alto + 15 * e),
            (cx + ala_ancho - 60 * e, ala_y - ala_alto + 40 * e),
            (cx + ala_ancho - 100 * e, ala_y - ala_alto + 65 * e),
            (cx + 20 * e, ala_y + 8 * e),
        ])
        for i in range(6):
            px = cx + 40 * e + i * 30 * e
            py = ala_y - 8 * e + i * 8 * e
            pygame.draw.line(pantalla, (25, 25, 35),
                             (int(px), int(py)),
                             (int(px + 25 * e), int(py - 25 * e + i * 4 * e)), 2)

        # Cuerpo central (negro profundo)
        pygame.draw.ellipse(pantalla, (20, 20, 30), 
                            (cx - 35 * e, cy - 30 * e, 70 * e, 90 * e))
        pygame.draw.ellipse(pantalla, (40, 40, 55),
                            (cx - 30 * e, cy - 25 * e, 60 * e, 80 * e))
        # Pecho con plumas
        for i in range(4):
            py = cy - 20 * e + i * 12 * e
            pygame.draw.line(pantalla, (60, 60, 75),
                             (int(cx - 15 * e), int(py)),
                             (int(cx + 15 * e), int(py)), 1)

        # Collar blanco caracteristico del condor
        pygame.draw.ellipse(pantalla, (245, 245, 250),
                            (cx - 35 * e, cy - 40 * e, 70 * e, 25 * e))
        pygame.draw.ellipse(pantalla, (220, 220, 230),
                            (cx - 32 * e, cy - 38 * e, 64 * e, 20 * e))

        # Cuello y cabeza (calva con pliegues)
        cabeza_x = cx
        cabeza_y = cy - 55 * e + int(math.sin(t * 2) * 2 * e)
        # Cuello
        pygame.draw.ellipse(pantalla, (40, 40, 55),
                            (cx - 12 * e, cy - 55 * e, 24 * e, 25 * e))
        # Cabeza calva con tono carmesi
        pygame.draw.ellipse(pantalla, (200, 100, 80),
                            (cabeza_x - 18 * e, cabeza_y - 15 * e, 36 * e, 22 * e))
        pygame.draw.ellipse(pantalla, (230, 130, 100),
                            (cabeza_x - 15 * e, cabeza_y - 12 * e, 30 * e, 18 * e))
        # Pliegues de la cabeza
        for i in range(3):
            pygame.draw.arc(pantalla, (180, 80, 60),
                            (cabeza_x - 14 * e, cabeza_y - 10 * e + i * 4 * e,
                             28 * e, 8 * e),
                            0, math.pi, 1)

        # Ojo
        pygame.draw.circle(pantalla, (240, 240, 240),
                           (int(cabeza_x - 5 * e), int(cabeza_y - 2 * e)), int(3 * e))
        pygame.draw.circle(pantalla, (20, 20, 30),
                           (int(cabeza_x - 5 * e), int(cabeza_y - 2 * e)), int(2 * e))
        pygame.draw.circle(pantalla, (255, 255, 255),
                           (int(cabeza_x - 6 * e), int(cabeza_y - 3 * e)), 1)

        # Pico ganchudo (caracteristico)
        pygame.draw.polygon(pantalla, (60, 60, 70), [
            (cabeza_x + 12 * e, cabeza_y - 3 * e),
            (cabeza_x + 24 * e, cabeza_y + 3 * e),
            (cabeza_x + 22 * e, cabeza_y + 8 * e),
            (cabeza_x + 12 * e, cabeza_y + 6 * e),
        ])
        pygame.draw.polygon(pantalla, (90, 90, 100), [
            (cabeza_x + 12 * e, cabeza_y - 2 * e),
            (cabeza_x + 22 * e, cabeza_y + 3 * e),
            (cabeza_x + 20 * e, cabeza_y + 5 * e),
            (cabeza_x + 13 * e, cabeza_y + 4 * e),
        ])
        # Gancho del pico
        pygame.draw.circle(pantalla, (40, 40, 50),
                           (int(cabeza_x + 22 * e), int(cabeza_y + 7 * e)), int(3 * e))

        # Patas (naranjas)
        pygame.draw.line(pantalla, (200, 130, 60),
                         (int(cx - 12 * e), int(cy + 55 * e)),
                         (int(cx - 18 * e), int(cy + 85 * e)), max(2, int(3 * e)))
        pygame.draw.line(pantalla, (200, 130, 60),
                         (int(cx + 12 * e), int(cy + 55 * e)),
                         (int(cx + 18 * e), int(cy + 85 * e)), max(2, int(3 * e)))
        # Garras
        for dx in (-18, -12, -6):
            pygame.draw.line(pantalla, (30, 20, 15),
                             (int(cx + dx * e), int(cy + 85 * e)),
                             (int(cx + dx * e - 4 * e), int(cy + 90 * e)), 2)
        for dx in (6, 12, 18):
            pygame.draw.line(pantalla, (30, 20, 15),
                             (int(cx + dx * e), int(cy + 85 * e)),
                             (int(cx + dx * e + 4 * e), int(cy + 90 * e)), 2)

    def _dibujar_anim_captura(self, x, y, t):
        """Animacion de captura estilo Emerald."""
        # La bola entra en arco
        if t < 0.4:
            prog = t / 0.4
            bx = int(x + 200 * (1 - prog) * math.cos(prog * math.pi / 2))
            by = int(y - 80 * math.sin(prog * math.pi))
            # Bola
            pygame.draw.circle(pantalla, (240, 60, 60), (bx, by), 14)
            pygame.draw.rect(pantalla, (250, 250, 250), (bx - 14, by, 28, 14))
            pygame.draw.line(pantalla, (40, 40, 40), (bx - 14, by), (bx + 14, by), 2)
            pygame.draw.circle(pantalla, (250, 250, 250), (bx, by), 5)
            pygame.draw.circle(pantalla, (40, 40, 40), (bx, by), 5, 2)
            return bx, by, False
        # La bola cae y se abre
        elif t < 0.7:
            prog = (t - 0.4) / 0.3
            # Flash blanco
            a = int(200 * (1 - prog))
            ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
            ov.fill((255, 255, 255, a))
            pantalla.blit(ov, (0, 0))
            return x, y, False
        # La bola se mueve capturando
        elif t < 1.8:
            prog = (t - 0.7) / 1.1
            # Bola que tiembla
            bx = x + int(math.sin(t * 30) * 3 * (1 - prog))
            pygame.draw.circle(pantalla, (240, 60, 60), (bx, y), 14)
            pygame.draw.rect(pantalla, (250, 250, 250), (bx - 14, y, 28, 14))
            pygame.draw.line(pantalla, (40, 40, 40), (bx - 14, y), (bx + 14, y), 2)
            pygame.draw.circle(pantalla, (250, 250, 250), (bx, y), 5)
            pygame.draw.circle(pantalla, (40, 40, 40), (bx, y), 5, 2)
            # Estrellitas
            for i in range(4):
                ang = i * 1.57 + t * 5
                sx = bx + math.cos(ang) * 20
                sy = y + math.sin(ang) * 20
                pygame.draw.circle(pantalla, (255, 240, 100), (int(sx), int(sy)), 2)
            return bx, y, False
        return x, y, True

    def _dibujar_mapa_regional(self):
        """Muestra el mapa regional estilo Emerald."""
        try:
            if not hasattr(self, "_ciudades_visitadas"):
                self._ciudades_visitadas = set()
            self._ciudades_visitadas.add(self.mapa_actual.id)
        except Exception:
            pass
        try:
            from sistemas.mapa_regional import dibujar_mapa
        except Exception as e:
            print(f"WARN mapa_regional: {e}")
            self.estado = "exploracion"
            return
        try:
            dibujar_mapa(pantalla, self, fuente_peque, fuente_media,
                         fuente_grande, fuente_titulo, self.anim_menu)
        except Exception as e:
            import traceback
            traceback.print_exc()
            self.mensajes = [f"Error mapa: {e}"]
            self.timer_mensajes = 2.0
            self.estado = "exploracion"

    def _menu_bg_blit(self, color=(0, 0, 0, 140), franjas=False):
        """Fondo semitransparente estilo Emerald."""
        ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
        ov.fill(color)
        pantalla.blit(ov, (0, 0))
        if franjas:
            for k in range(12):
                x = k * 60 - int((getattr(self, "anim_menu", 0.0) * 25) % 60)
                pygame.draw.polygon(ov, (255, 255, 255, 8),
                                    [(x, 0), (x + 20, 0), (x + 60, ALTO), (x + 40, ALTO)])
            pantalla.blit(ov, (0, 0))

    def _degradado_vertical(self, c1, c2, y0=0, y1=None):
        """Rellena la pantalla con un degradado vertical entre dos colores."""
        if y1 is None: y1 = ALTO
        span = max(1, y1 - y0)
        for i in range(y0, y1):
            t = (i - y0) / span
            r = int(c1[0] * (1 - t) + c2[0] * t)
            g = int(c1[1] * (1 - t) + c2[1] * t)
            b = int(c1[2] * (1 - t) + c2[2] * t)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

    def _vignette_batalla(self):
        """Vineta sutil estilo Emerald para dar foco al combate."""
        ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
        for i in range(50):
            a = int(3 + i * 1.5)
            pygame.draw.rect(ov, (0, 0, 0, a), (i, i, ANCHO - i*2, ALTO - i*2), 1)
        pantalla.blit(ov, (0, 0))

    def _dibujar_caja_movimientos(self, jugador):
        """Caja inferior estilo Emerald con los 4 movimientos."""
        bx, by, bw, bh = 10, ALTO - 92, ANCHO - 20, 84
        # Sombra
        pygame.draw.rect(pantalla, (0, 0, 0, 100), (bx + 2, by + 2, bw, bh))
        # Marco dorado doble
        pygame.draw.rect(pantalla, (100, 70, 30), (bx - 3, by - 3, bw + 6, bh + 6))
        pygame.draw.rect(pantalla, (240, 200, 60), (bx - 2, by - 2, bw + 4, bh + 4), 3)
        pygame.draw.rect(pantalla, (255, 240, 140), (bx, by, bw, bh), 1)
        pygame.draw.rect(pantalla, (28, 40, 70), (bx + 3, by + 3, bw - 6, bh - 6))
        pygame.draw.rect(pantalla, (70, 100, 160), (bx + 4, by + 4, bw - 8, bh - 8), 1)
        # 4 movimientos en 2x2
        cols = 2
        col_w = (bw - 20) // cols
        fila_h = (bh - 14) // 2
        for i, mov in enumerate(jugador.movimientos[:4]):
            fila = i // cols; col = i % cols
            mx = bx + 8 + col * (col_w + 4)
            my = by + 6 + fila * (fila_h + 2)
            sel = (i == self.menu_mov_idx)
            if sel:
                pygame.draw.rect(pantalla, (60, 90, 150), (mx - 2, my - 2, col_w + 4, fila_h + 4))
                pygame.draw.rect(pantalla, (255, 240, 100), (mx - 2, my - 2, col_w + 4, fila_h + 4), 2)
            else:
                pygame.draw.rect(pantalla, (35, 50, 90), (mx, my, col_w, fila_h))
            # Nombre
            nom = getattr(mov, "nombre", "?")
            tipo = getattr(mov, "tipo", "Normal")
            pp = getattr(mov, "pp", 0); ppm = getattr(mov, "pp_max", 20)
            col_nom = (255, 250, 200) if sel else (220, 220, 240)
            tn = fuente_peque.render(nom[:18], True, col_nom)
            pantalla.blit(tn, (mx + 6, my + 2))
            # Tipo coloreado
            col_tipo = {
                "Fuego": (240, 120, 60), "Agua": (80, 150, 240),
                "Planta": (110, 200, 100), "Electrico": (240, 210, 60),
                "Eléctrico": (240, 210, 60), "Hielo": (140, 220, 230),
                "Lucha": (200, 80, 60), "Siniestro": (90, 70, 90),
                "Fantasma": (120, 100, 170), "Veneno": (160, 90, 200),
                "Tierra": (200, 160, 80), "Roca": (180, 150, 90),
                "Acero": (170, 180, 200), "Psiquico": (240, 100, 160),
                "Psíquico": (240, 100, 160), "Bicho": (170, 200, 80),
                "Volador": (180, 200, 240), "Dragon": (90, 90, 230),
                "Dragón": (90, 90, 230), "Hada": (240, 170, 220),
                "Sonido": (150, 220, 220), "Normal": (180, 180, 160),
            }.get(tipo, (180, 180, 180))
            pygame.draw.rect(pantalla, col_tipo, (mx + col_w - 68, my + 2, 62, 14))
            pygame.draw.rect(pantalla, (0, 0, 0), (mx + col_w - 68, my + 2, 62, 14), 1)
            et = fuente_peque.render(tipo[:8], True, (30, 20, 30))
            pantalla.blit(et, (mx + col_w - 68 + 31 - et.get_width() // 2, my + 4))
            # PP
            pp_txt = fuente_peque.render(f"PP {pp}/{ppm}", True, (200, 220, 255))
            pantalla.blit(pp_txt, (mx + col_w - 68, my + fila_h - 14))

    def _dibujar_panel_batalla_emerald(self):
        """Paneles de HP arriba a la derecha (jugador) y arriba izquierda (rival)."""
        if not self.batalla_actual:
            return
        riv = self.batalla_actual.pokemon_salvaje
        jug = self.batalla_actual.pokemon_activo_jugador
        # --- Panel rival (arriba izquierda) ---
        px, py, pw, ph = 20, 20, 280, 68
        pygame.draw.rect(pantalla, (0, 0, 0, 100), (px + 2, py + 2, pw, ph))
        pygame.draw.rect(pantalla, (240, 220, 180), (px, py, pw, ph))
        pygame.draw.rect(pantalla, (100, 70, 30), (px, py, pw, ph), 2)
        pygame.draw.rect(pantalla, (255, 240, 200), (px + 2, py + 2, pw - 4, 2))
        # Nombre + nivel
        tn = fuente_media.render(riv.nombre, True, (40, 30, 20))
        lv = fuente_peque.render(f"Nv.{riv.nivel}", True, (80, 60, 30))
        pantalla.blit(tn, (px + 10, py + 6))
        pantalla.blit(lv, (px + pw - lv.get_width() - 10, py + 8))
        # Barra HP
        bx, by2 = px + 12, py + 32
        bw2, bh2 = pw - 24, 12
        pygame.draw.rect(pantalla, (60, 40, 30), (bx - 1, by2 - 1, bw2 + 2, bh2 + 2))
        pygame.draw.rect(pantalla, (30, 20, 15), (bx, by2, bw2, bh2))
        ratio = riv.ps / max(1, riv.ps_max)
        col = (90, 220, 100) if ratio > 0.5 else (240, 200, 60) if ratio > 0.2 else (220, 60, 60)
        fill = int(bw2 * ratio)
        if fill > 0:
            pygame.draw.rect(pantalla, col, (bx, by2, fill, bh2))
            pygame.draw.rect(pantalla, tuple(min(255, c + 60) for c in col), (bx, by2, fill, 3))
        pygame.draw.rect(pantalla, (0, 0, 0), (bx, by2, bw2, bh2), 1)
        # HP texto
        hp_txt = fuente_peque.render(f"{riv.ps}/{riv.ps_max}", True, (60, 40, 20))
        pantalla.blit(hp_txt, (bx + bw2 - hp_txt.get_width() - 2, py + 48))

        # --- Panel jugador (abajo derecha) ---
        px2, py2 = ANCHO - 300, 170
        pygame.draw.rect(pantalla, (0, 0, 0, 100), (px2 + 2, py2 + 2, pw, ph))
        pygame.draw.rect(pantalla, (240, 220, 180), (px2, py2, pw, ph))
        pygame.draw.rect(pantalla, (100, 70, 30), (px2, py2, pw, ph), 2)
        pygame.draw.rect(pantalla, (255, 240, 200), (px2 + 2, py2 + 2, pw - 4, 2))
        tn2 = fuente_media.render(jug.nombre, True, (40, 30, 20))
        lv2 = fuente_peque.render(f"Nv.{jug.nivel}", True, (80, 60, 30))
        pantalla.blit(tn2, (px2 + 10, py2 + 6))
        pantalla.blit(lv2, (px2 + pw - lv2.get_width() - 10, py2 + 8))
        bx2, by3 = px2 + 12, py2 + 32
        bw3, bh3 = pw - 24, 12
        pygame.draw.rect(pantalla, (60, 40, 30), (bx2 - 1, by3 - 1, bw3 + 2, bh3 + 2))
        pygame.draw.rect(pantalla, (30, 20, 15), (bx2, by3, bw3, bh3))
        ratio2 = jug.ps / max(1, jug.ps_max)
        col2 = (90, 220, 100) if ratio2 > 0.5 else (240, 200, 60) if ratio2 > 0.2 else (220, 60, 60)
        fill2 = int(bw3 * ratio2)
        if fill2 > 0:
            pygame.draw.rect(pantalla, col2, (bx2, by3, fill2, bh3))
            pygame.draw.rect(pantalla, tuple(min(255, c + 60) for c in col2), (bx2, by3, fill2, 3))
        pygame.draw.rect(pantalla, (0, 0, 0), (bx2, by3, bw3, bh3), 1)
        # HP numeros
        hp_txt2 = fuente_peque.render(f"{jug.ps}/{jug.ps_max}", True, (60, 40, 20))
        pantalla.blit(hp_txt2, (bx2 + bw3 - hp_txt2.get_width() - 2, py2 + 48))
        # Barra EXP
        try:
            nec = jug.exp_para_siguiente_nivel()
            rexp = min(1.0, getattr(jug, "exp", 0) / max(1, nec))
            ex = px2 + 12; ey = py2 + 56
            pygame.draw.rect(pantalla, (30, 40, 70), (ex, ey, bw3, 5))
            pygame.draw.rect(pantalla, (100, 210, 255), (ex, ey, int(bw3 * rexp), 5))
            pygame.draw.rect(pantalla, (0, 0, 0), (ex, ey, bw3, 5), 1)
        except Exception:
            pass

    _COL_TIPO_ANIM = {
        "Fuego": (255, 140, 40), "Agua": (80, 170, 240),
        "Planta": (80, 200, 90), "Electrico": (255, 230, 60),
        "Eléctrico": (255, 230, 60), "Hielo": (150, 230, 245),
        "Lucha": (220, 80, 60), "Siniestro": (120, 80, 150),
        "Fantasma": (160, 100, 200), "Veneno": (180, 90, 200),
        "Tierra": (200, 150, 90), "Roca": (170, 140, 100),
        "Acero": (180, 190, 210), "Psiquico": (240, 100, 200),
        "Psíquico": (240, 100, 200), "Bicho": (170, 200, 80),
        "Volador": (170, 200, 240), "Dragon": (100, 110, 240),
        "Dragón": (100, 110, 240), "Hada": (250, 180, 220),
        "Sonido": (150, 220, 220), "Normal": (220, 220, 220),
    }

    def _color_tipo_anim(self, tipo):
        return self._COL_TIPO_ANIM.get(tipo, (220, 220, 220))

    def _iniciar_hit_flash(self, lado, tipo, potencia_efecto=1.0):
        """Dispara un flash de impacto tipo-colored."""
        col = self._color_tipo_anim(tipo)
        if not hasattr(self, "_hit_flashes"):
            self._hit_flashes = []
        self._hit_flashes.append({
            "lado": lado, "col": col, "t": 0.35, "dur": 0.35,
            "pot": max(0.4, min(2.0, potencia_efecto)),
        })

    def _actualizar_hit_flashes(self, dt):
        if not hasattr(self, "_hit_flashes"):
            return
        vivos = []
        for h in self._hit_flashes:
            h["t"] -= dt
            if h["t"] > 0:
                vivos.append(h)
        self._hit_flashes = vivos

    def _dibujar_hit_flashes(self):
        if not hasattr(self, "_hit_flashes") or not self._hit_flashes:
            return
        import math as _m
        for h in self._hit_flashes:
            prog = 1.0 - (h["t"] / h["dur"])
            col = h["col"]
            pot = h["pot"]
            # Circulos concentricos expandiendose
            if h["lado"] == "rival":
                cx, cy = 420 + 32, 100 + 32
            else:
                cx, cy = 170 + 32, 200 + 32
            for i in range(4):
                r = int(20 + 60 * prog + i * 12 * pot)
                a = max(0, int(200 * (1 - prog) * pot - i * 30))
                ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
                pygame.draw.circle(ov, (*col, a), (cx, cy), r, 3)
                pantalla.blit(ov, (0, 0))
            # Estallido radial de chispas
            import random as _r
            rnd = _r.Random(int(prog * 1000) + hash(str(h["col"])))
            for i in range(int(10 * pot)):
                ang = rnd.uniform(0, 6.283)
                rr = 30 + 80 * prog + rnd.randint(0, 20)
                px_ = cx + _m.cos(ang) * rr
                py_ = cy + _m.sin(ang) * rr
                tam = max(1, int(4 * (1 - prog)))
                pygame.draw.circle(pantalla, col, (int(px_), int(py_)), tam)
                if tam >= 2:
                    pygame.draw.circle(pantalla, (255, 255, 255), (int(px_), int(py_)), 1)

    def _shake_inteligente(self, efectividad=1.0, potencia=40, critico=False):
        """Sacudida proporcional a potencia + efectividad. Critico = 2x."""
        base = 0.25
        escala = min(2.0, (potencia / 60.0)) * min(1.8, max(0.4, efectividad))
        if critico:
            escala *= 1.8
        self._screen_shake = max(self._screen_shake, base * escala)

    def _dibujar_crit_flash(self):
        """Flash rojo + texto de crítico."""
        t = getattr(self, "_crit_flash_timer", 0.0)
        if t <= 0:
            return
        self._crit_flash_timer = max(0.0, t - (1.0/60.0))
        prog = t / 0.6
        # Overlay rojo
        a = int(90 * prog)
        ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
        ov.fill((255, 30, 30, a))
        pantalla.blit(ov, (0, 0))
        # Texto "¡CRITICO!" pulsante
        if prog > 0.35:
            pulso = 1.0 + 0.2 * ((t * 12) % 1.0)
            try:
                fnt = pygame.font.SysFont("arial", int(38 * pulso), bold=True)
            except Exception:
                fnt = fuente_titulo
            txt = fnt.render("¡CRITICO!", True, (255, 240, 60))
            ts = fnt.render("¡CRITICO!", True, (120, 20, 20))
            tx = ANCHO // 2 - txt.get_width() // 2
            ty = 140
            pantalla.blit(ts, (tx + 3, ty + 3))
            pantalla.blit(txt, (tx, ty))

    def _mostrar_banner_ef(self, texto, color):
        self._banner_efectividad = (texto, color)
        self._banner_ef_t = 1.6

    def _dibujar_banner_ef(self):
        if self._banner_ef_t <= 0 or not self._banner_efectividad:
            return
        self._banner_ef_t -= 1.0/60.0
        prog = self._banner_ef_t / 1.6
        # Aparece -> sostiene -> desaparece
        if prog > 0.85:
            alpha = int(255 * (1.0 - prog) / 0.15)
            y_off = int(-30 * (prog - 0.85) / 0.15)
        elif prog > 0.15:
            alpha = 255; y_off = 0
        else:
            alpha = int(255 * prog / 0.15)
            y_off = int(30 * (1 - prog / 0.15))
        texto, col = self._banner_efectividad
        try:
            fnt = pygame.font.SysFont("arial", 32, bold=True)
        except Exception:
            fnt = fuente_titulo
        txt = fnt.render(texto, True, col)
        ts = fnt.render(texto, True, (20, 10, 10))
        ov = pygame.Surface(txt.get_size(), pygame.SRCALPHA)
        ov.blit(txt, (0, 0)); ov.set_alpha(alpha)
        ovs = pygame.Surface(txt.get_size(), pygame.SRCALPHA)
        ovs.blit(ts, (0, 0)); ovs.set_alpha(alpha)
        x = ANCHO // 2 - txt.get_width() // 2
        y = 200 + y_off
        pantalla.blit(ovs, (x + 3, y + 3))
        pantalla.blit(ov, (x, y))

    def _dibujar_evolucion_zoom(self, poke, nuevo):
        """Segunda capa de animacion de evolucion: zoom + luz + silueta."""
        t = getattr(self, "_evo_timer", 0.0)
        dur = 4.5
        # Fondo oscuro ya lo hace _dibujar_evolucion
        cx, cy = ANCHO // 2, ALTO // 2
        # Fase 1 (0-1.2): luz blanca intensa
        if t < 1.2:
            a = int(200 * (t / 1.2))
            ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
            ov.fill((255, 255, 255, a))
            pantalla.blit(ov, (0, 0))
        # Fase 2 (1.2-3.0): silueta alternando con sprite
        elif t < 3.0:
            prog = (t - 1.2) / 1.8
            if int(t * 10) % 2 == 0:
                sp = SPRITES.get(poke.nombre) if poke else None
                if sp:
                    tam = int(96 + 60 * prog)
                    big = pygame.transform.scale(sp, (tam, tam))
                    pantalla.blit(big, (cx - tam // 2, cy - tam // 2))
            else:
                sp_n = SPRITES.get(nuevo) if nuevo else None
                if sp_n:
                    try:
                        mask = pygame.mask.from_surface(sp_n)
                        sil = mask.to_surface(setcolor=(255, 255, 255, 255),
                                             unsetcolor=(0, 0, 0, 0))
                        tam = int(96 + 60 * prog)
                        big = pygame.transform.scale(sil, (tam, tam))
                        pantalla.blit(big, (cx - tam // 2, cy - tam // 2))
                    except Exception:
                        pass
            # Particulas orbitando
            import math as _m
            import random as _r
            for k in range(22):
                ang = k * 0.285 + t * 3.5
                rr = 80 + _m.sin(t * 3 + k) * 20
                px_ = cx + _m.cos(ang) * rr
                py_ = cy + _m.sin(ang) * rr
                col = [(255, 240, 100), (100, 220, 255), (255, 140, 220), (140, 255, 160)][k % 4]
                pygame.draw.circle(pantalla, col, (int(px_), int(py_)), 3)
        # Fase 3 (3.0-4.5): aparece nuevo con zoom-out
        else:
            prog = (t - 3.0) / 1.5
            sp_n = SPRITES.get(nuevo) if nuevo else None
            if sp_n:
                escala = 1.4 - 0.4 * prog
                tam = int(160 * escala)
                big = pygame.transform.scale(sp_n, (tam, tam))
                # Flash blanco al aparecer
                if prog < 0.15:
                    a = int(220 * (1 - prog / 0.15))
                    ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
                    ov.fill((255, 255, 255, a))
                    pantalla.blit(ov, (0, 0))
                bob = int(3 * _m.sin((t - 3.0) * 5))
                pantalla.blit(big, (cx - tam // 2, cy - tam // 2 + bob))
                # Aura dorada
                for i in range(3):
                    r = int(100 + i * 20 + prog * 40)
                    ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
                    pygame.draw.circle(ov, (255, 240, 120, 140 - i * 40), (cx, cy), r, 3)
                    pantalla.blit(ov, (0, 0))

    def _iniciar_mega_cine(self, nombre_mega):
        self._mega_cine_t = 2.5
        self._mega_cine_nombre = nombre_mega

    def _dibujar_mega_cine(self):
        t = getattr(self, "_mega_cine_t", 0.0)
        if t <= 0:
            return
        self._mega_cine_t = max(0.0, t - (1.0/60.0))
        prog = 1.0 - (self._mega_cine_t / 2.5)
        cx, cy = 170 + 32, 200 + 32  # sprite del jugador

        # Aura dorada creciente
        import math as _m
        for i in range(6):
            r = int(30 + i * 25 + prog * 60)
            a = max(0, int(180 - i * 25 - prog * 100))
            ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
            pygame.draw.circle(ov, (255, 220, 100, a), (cx, cy), r, 3)
            pantalla.blit(ov, (0, 0))

        # Rayos verticales descendentes
        import random as _r
        rnd = _r.Random(int(prog * 500))
        for i in range(6):
            x_r = cx + rnd.randint(-60, 60)
            y0_r = rnd.randint(0, 40)
            y1_r = cy - 20
            try:
                pygame.draw.line(pantalla, (255, 240, 180), (x_r, y0_r), (x_r, y1_r), 2)
                pygame.draw.line(pantalla, (255, 200, 80), (x_r, y0_r), (x_r, y1_r), 1)
            except Exception:
                pass

        # Nombre mega flotando
        if prog > 0.3 and self._mega_cine_nombre:
            txt = fuente_grande.render(self._mega_cine_nombre, True, (255, 240, 100))
            ts = fuente_grande.render(self._mega_cine_nombre, True, (100, 50, 10))
            tx = ANCHO // 2 - txt.get_width() // 2
            ty = 80
            pantalla.blit(ts, (tx + 3, ty + 3))
            pantalla.blit(txt, (tx, ty))

        # Flash final
        if prog > 0.85:
            a = int(220 * ((prog - 0.85) / 0.15))
            ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
            ov.fill((255, 250, 200, a))
            pantalla.blit(ov, (0, 0))

    def _iniciar_aprender_reveal(self, mov_nombre):
        self._aprender_reveal_t = 2.0
        self._aprender_reveal_mov = mov_nombre

    def _dibujar_aprender_reveal(self):
        t = getattr(self, "_aprender_reveal_t", 0.0)
        if t <= 0 or not self._aprender_reveal_mov:
            return
        self._aprender_reveal_t = max(0.0, t - (1.0/60.0))
        prog = 1.0 - (self._aprender_reveal_t / 2.0)
        # Caja central
        bw, bh = 420, 110
        bx = ANCHO // 2 - bw // 2
        by = ALTO // 2 - bh // 2
        # Escala de entrada
        escala = min(1.0, prog * 4)
        bw2 = int(bw * escala); bh2 = int(bh * escala)
        bx2 = ANCHO // 2 - bw2 // 2; by2 = ALTO // 2 - bh2 // 2
        pygame.draw.rect(pantalla, (20, 15, 40), (bx2, by2, bw2, bh2))
        pygame.draw.rect(pantalla, (255, 220, 60), (bx2, by2, bw2, bh2), 3)
        pygame.draw.rect(pantalla, (255, 240, 140), (bx2 + 3, by2 + 3, bw2 - 6, bh2 - 6), 1)
        if prog > 0.4:
            t1 = fuente_peque.render("¡NUEVO MOVIMIENTO APRENDIDO!", True, (255, 220, 60))
            t2 = fuente_grande.render(self._aprender_reveal_mov, True, (255, 255, 255))
            pantalla.blit(t1, (ANCHO // 2 - t1.get_width() // 2, by2 + 12))
            pantalla.blit(t2, (ANCHO // 2 - t2.get_width() // 2, by2 + 44))

    def _dibujar_batalla(self, dt=None):
        if not self.batalla_actual:
            return
        try:
            self._actualizar_ps_animados(getattr(self, "_last_dt", 1.0/60.0))
        except Exception:
            pass
        # F7: fondo por bioma
        _bioma_actual = "valle"
        try:
            _bioma_actual = getattr(self.mapa_actual, "bioma", "valle")
        except Exception:
            pass
        try:
            self._dibujar_fondo_batalla(_bioma_actual)
        except Exception:
            pantalla.fill((150, 200, 110))
            pygame.draw.rect(pantalla, MARRON_TIERRA, (0, ALTO-180, ANCHO, 180))
        rival = self.batalla_actual.pokemon_salvaje
        sr = SPRITES.get(rival.nombre)
        fr = getattr(self.batalla_actual, "_flash_rival", 0.0)
        if fr > 0:
            self.batalla_actual._flash_rival = max(0.0, fr - 1/60)
        # A8-2 HOTFIX: animacion de ataque completa
        try:
            self._actualizar_anim_ataque(getattr(self, "_last_dt", 1.0/60.0))
            ox_r, oy_r, ox_j, oy_j = self._dibujar_anim_ataque(sr, sj)
        except Exception:
            ox_r, oy_r, ox_j, oy_j = 0, 0, 0, 0

        # F5: sprites 96x96 con animacion idle (bob)
        _t_f5 = getattr(self, "anim_menu", 0.0)
        # Bob del rival (respira)
        bob_r = int(math.sin(_t_f5 * 2.0) * 3)
        # Bob del jugador
        bob_j = int(math.sin(_t_f5 * 2.0 + 0.5) * 3)

        if sr:
            try:
                spr_r_grande = pygame.transform.scale(sr, (96, 96))
            except Exception:
                spr_r_grande = sr
            self._dibujar_sprite_batalla(spr_r_grande, 380 + ox_r, 60 + oy_r + bob_r, fr)
            # Sombra
            pygame.draw.ellipse(pantalla, (0, 0, 0, 80),
                                (400 + ox_r, 160 + oy_r, 60, 12))
        else:
            pygame.draw.circle(pantalla, ROJO_INCA, (420 + ox_r, 100 + oy_r + bob_r), 45)

        jug = self.batalla_actual.pokemon_activo_jugador
        sj = SPRITES.get(jug.nombre)
        fj = getattr(self.batalla_actual, "_flash_jugador", 0.0)
        if fj > 0:
            self.batalla_actual._flash_jugador = max(0.0, fj - 1/60)
        if sj:
            try:
                spr_j_grande = pygame.transform.scale(sj, (96, 96))
            except Exception:
                spr_j_grande = sj
            # Sombra
            pygame.draw.ellipse(pantalla, (0, 0, 0, 80),
                                (140 + ox_j, 280 + oy_j, 60, 12))
            self._dibujar_sprite_batalla(spr_j_grande, 130 + ox_j, 190 + oy_j + bob_j, fj)
        else:
            pygame.draw.circle(pantalla, AZUL_ANDINO, (160 + ox_j, 230 + oy_j + bob_j), 50)
        self.efectos.dibujar(pantalla)

        # Panel rival estilo Emerald
        UIKit.dibujar_panel(pantalla, 20, 20, 280, 70)
        pygame.draw.rect(pantalla, (0, 0, 0), (20, 20, 280, 70), 1)
        # Nombre
        tn = fuente_media.render(rival.nombre, True, UI.EMERALD_TEXT)
        pantalla.blit(tn, (30, 26))
        lv = fuente_peque.render(f"Nv.{rival.nivel}", True, (100, 80, 60))
        pantalla.blit(lv, (280 - lv.get_width() - 12, 30))
        # Barra HP
        UIKit.dibujar_barra_hp(pantalla, 30, 55, 230, 12,
                                rival.ps / max(1, rival.ps_max))
        # Estados
        self._dibujar_iconos_estado(rival, 20, 20, 280, 70)

        # Panel jugador estilo Emerald
        UIKit.dibujar_panel(pantalla, 340, 170, 280, 80)
        pygame.draw.rect(pantalla, (0, 0, 0), (340, 170, 280, 80), 1)
        # Nombre
        tn = fuente_media.render(jug.nombre, True, UI.EMERALD_TEXT)
        pantalla.blit(tn, (350, 176))
        lv = fuente_peque.render(f"Nv.{jug.nivel}", True, (100, 80, 60))
        pantalla.blit(lv, (600 - lv.get_width() - 12, 180))
        # Barra HP
        UIKit.dibujar_barra_hp(pantalla, 350, 200, 230, 12,
                                jug.ps / max(1, jug.ps_max))
        # Texto HP
        try:
            hp_txt = fuente_peque.render(f"{jug.ps}/{jug.ps_max}", True, (80, 60, 40))
            pantalla.blit(hp_txt, (350, 216))
        except Exception:
            pass
        # Barra EXP
        try:
            nec = jug.exp_para_siguiente_nivel()
            UIKit.dibujar_barra_exp(pantalla, 350, 232, 230, 6,
                                     min(1, getattr(jug, 'exp', 0) / max(1, nec)))
            exp_txt = fuente_peque.render(f"EXP {getattr(jug,'exp',0)}/{nec}",
                                           True, (100, 180, 240))
            pantalla.blit(exp_txt, (350, 240))
        except Exception:
            pass
        self._dibujar_iconos_estado(jug, 340, 170, 280, 80)

        pygame.draw.rect(pantalla, CREMA, (10, ALTO-170, ANCHO-20, 160))
        pygame.draw.rect(pantalla, NEGRO, (10, ALTO-170, ANCHO-20, 160), 3)

        if self.batalla_actual.terminada:
            y = ALTO - 150
            for m in self.mensajes[-3:]:
                pantalla.blit(fuente_media.render(m, True, NEGRO), (20, y)); y += 25
            pantalla.blit(fuente_peque.render("[X] Continuar", True, GRIS_PIEDRA), (20, ALTO-30))
        elif self.batalla_msg_queue:
            # Mostrar el mensaje actual (uno a uno) mientras la cola no esté vacía
            y = ALTO - 150
            for m in self.mensajes[-2:]:
                pantalla.blit(fuente_media.render(m, True, NEGRO), (20, y)); y += 25
        elif self.batalla_actual.sub_estado == "menu_principal":
            for i, op in enumerate(["Luchar", "Cambiar", "Objetos", "Capturar", "Huir"]):
                col = AMARILLO_SOL if i == self.menu_batalla_idx else NEGRO
                col_i = i % 2; fil = i // 2
                pantalla.blit(fuente_media.render(op, True, col),
                              (40 + col_i*200, ALTO-150 + fil*35))
        elif self.batalla_actual.sub_estado == "menu_cambiar":
            for i, p in enumerate(self.equipo.pokemons):
                col = AMARILLO_SOL if i == self.menu_cambiar_idx else NEGRO
                vivo = "♥" if p.esta_vivo() else "✗"
                pantalla.blit(fuente_peque.render(
                    f"{vivo} {p.nombre} Nv{p.nivel}  PS:{p.ps}/{p.ps_max}",
                    True, col), (30, ALTO-150 + i*22))
        elif self.batalla_actual.sub_estado == "menu_objetos":
            pociones = [n for n in self.inventario.objetos
                        if self.inventario.objetos[n]["objeto"].tipo == "curacion"]
            if not pociones:
                pantalla.blit(fuente_peque.render("(Sin objetos de curación)", True, NEGRO),
                              (30, ALTO-150))
            for i, n in enumerate(pociones):
                col = AMARILLO_SOL if i == self.menu_objetos_idx else NEGRO
                cant = self.inventario.objetos[n]["cantidad"]
                pantalla.blit(fuente_peque.render(f"{n} x{cant}", True, col),
                              (30, ALTO-150 + i*22))
        elif self.batalla_actual.sub_estado == "menu_movimientos":
            for i, mov in enumerate(jug.movimientos):
                col = AMARILLO_SOL if i == self.menu_mov_idx else NEGRO
                nm = getattr(mov, 'nombre', f'Mov{i+1}')
                tp = getattr(mov, 'tipo', '?')
                pp = getattr(mov, 'pp', 0); ppmax = getattr(mov, 'pp_max', 20)
                pantalla.blit(fuente_peque.render(f"{nm} [{tp}] PP:{pp}/{ppmax}", True, col),
                              (30, ALTO-150 + i*25))

        # Efectos de ataque
        atk = getattr(self.batalla_actual, "_atacando", None)
        if atk:
            prog = (self.anim_menu * 3) % 1
            if atk == "rival":
                x = int(420 - 100 * prog)
                pygame.draw.rect(pantalla, (255, 200, 60), (x, 130, 20, 20))
            elif atk == "jugador":
                x = int(170 + 100 * prog)
                pygame.draw.rect(pantalla, (255, 200, 60), (x, 220, 20, 20))
        elif self.batalla_actual.sub_estado == "capturando":
            bx, by = 480, 130
            offset_y = max(0, int(60 * (1 - self.anim_menu % 1.2 / 1.2)))
            pygame.draw.circle(pantalla, (240, 60, 60), (bx, by - offset_y), 12)
            pygame.draw.rect(pantalla, (250, 250, 250),
                             (bx - 12, by - offset_y, 24, 12))
            pygame.draw.line(pantalla, (40, 40, 40),
                             (bx - 12, by - offset_y), (bx + 12, by - offset_y), 2)
            for i in range(3):
                r = 20 + i * 8 + int(10 * (self.anim_menu * 6 % 1))
                pygame.draw.circle(pantalla, (255, 255, 100), (bx, by), r, 2)

        # (A2) El flash y la sacudida se manejan en _dibujar_sprite_batalla

    def _dibujar_inventario(self):
        # Fondo azul oscuro estilo Emerald
        for i in range(ALTO):
            r = int(20 + 20 * i / ALTO)
            g = int(30 + 20 * i / ALTO)
            b = int(60 + 30 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Cabecera
        pygame.draw.rect(pantalla, (40, 60, 120), (0, 0, ANCHO, 46))
        pygame.draw.rect(pantalla, UI.EMERALD_GOLD, (0, 44, ANCHO, 3))
        t = fuente_grande.render("MOCHILA", True, BLANCO)
        pantalla.blit(t, (ANCHO // 2 - t.get_width() // 2, 10))

        # Soles
        s = fuente_media.render(f"S/ {self.inventario.dinero}", True, UI.EMERALD_GOLD)
        pygame.draw.rect(pantalla, (30, 40, 70), (ANCHO - s.get_width() - 30, 12, s.get_width() + 16, 26))
        pygame.draw.rect(pantalla, UI.EMERALD_GOLD, (ANCHO - s.get_width() - 30, 12, s.get_width() + 16, 26), 2)
        pantalla.blit(s, (ANCHO - s.get_width() - 22, 16))

        # Panel principal
        UIKit.dibujar_panel(pantalla, 20, 60, ANCHO - 40, ALTO - 100)

        lista = self.inventario.obtener_lista()
        if not lista:
            v = fuente_media.render("Tu mochila esta vacia", True, (120, 100, 80))
            pantalla.blit(v, (ANCHO//2 - v.get_width()//2, 200))
        else:
            y = 76
            for i, (obj, cant) in enumerate(lista[:12]):
                sel = (i == getattr(self, "inv_idx", 0))
                nom = getattr(obj, 'nombre', '?')
                tipo = getattr(obj, 'tipo', 'item')
                # Fondo de la fila
                fondo = (220, 240, 220) if sel else (240, 232, 210)
                pygame.draw.rect(pantalla, fondo, (30, y, ANCHO - 60, 28))
                if sel:
                    pygame.draw.rect(pantalla, UI.EMERALD_GOLD, (30, y, ANCHO - 60, 28), 3)
                else:
                    pygame.draw.rect(pantalla, (180, 160, 120), (30, y, ANCHO - 60, 28), 1)
                # Icono circular
                icono_col = {"curacion": (255, 100, 100),
                             "pokeball": (220, 60, 60),
                             "llave": (240, 200, 60),
                             "battle": (120, 200, 120),
                             "evolucion": (200, 100, 240)}.get(tipo, (100, 100, 100))
                pygame.draw.circle(pantalla, (40, 30, 40), (46, y + 14), 10)
                pygame.draw.circle(pantalla, icono_col, (46, y + 14), 8)
                pygame.draw.circle(pantalla, (255, 255, 255), (44, y + 12), 2)
                # Nombre
                tn = fuente_media.render(nom, True, UI.EMERALD_TEXT)
                pantalla.blit(tn, (66, y + 4))
                # Cantidad
                tc = fuente_media.render(f"x{cant}", True, (80, 60, 40))
                pantalla.blit(tc, (ANCHO - 110, y + 4))
                if sel:
                    UIKit.dibujar_cursor(pantalla, 16, y + 8, UI.EMERALD_GOLD)
                y += 32

        inst = fuente_peque.render("[^/v] Elegir   [X] Usar   [I/ESC] Volver",
                                   True, (240, 220, 180))
        pantalla.blit(inst, (ANCHO//2 - inst.get_width()//2, ALTO - 26))
    def _dibujar_evolucion(self):
        t = getattr(self, "_evo_timer", 0.0) + 1/60
        self._evo_timer = t
        poke = self.pokemon_evolucionar
        nuevo = self.evolucion_resultado

        # Fondo oscuro con destellos
        pantalla.fill((5, 3, 15))

        # Estrellas de fondo
        rnd = random.Random(7)
        for i in range(60):
            sx = rnd.randint(0, ANCHO)
            sy = rnd.randint(0, ALTO)
            br = int(150 + 100 * math.sin(t * 3 + i))
            pygame.draw.rect(pantalla, (br, br, 220), (sx, sy, 1, 1))

        duracion = 5.0
        cx = ANCHO // 2
        cy = ALTO // 2

        # Fase 1 (0-1.5s): Aura envolvente
        if t < 1.5:
            prog = t / 1.5
            # Circulos magicos expandiendose
            for i in range(5):
                r = int(40 + prog * 150 + i * 20)
                alpha = max(0, 220 - i * 40 - int(prog * 100))
                ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
                pygame.draw.circle(ov, (100, 200, 255, alpha), (cx, cy), r, 3)
                pantalla.blit(ov, (0, 0))
            # Sprite original brillando
            sp = SPRITES.get(poke.nombre) if poke else None
            if sp:
                big = pygame.transform.scale(sp, (128, 128))
                # Brillo pulsante
                br_alpha = int(150 * prog)
                ov2 = pygame.Surface((128, 128), pygame.SRCALPHA)
                ov2.fill((255, 255, 255, br_alpha))
                big2 = big.copy()
                big2.blit(ov2, (0, 0), special_flags=pygame.BLEND_RGBA_ADD)
                # Bob
                bob = int(math.sin(t * 15) * 3 * prog)
                pantalla.blit(big2, (cx - 64, cy - 64 + bob))

        # Fase 2 (1.5-3.5s): Silueta parpadeante + particulas
        elif t < 3.5:
            prog = (t - 1.5) / 2.0
            # Silueta alternando
            if int(t * 12) % 2 == 0:
                try:
                    from sistemas.batalla import aplicar_shiny
                    sp_nuevo = SPRITES.get(nuevo) if nuevo else None
                    if sp_nuevo:
                        # Silueta oscura
                        mask = pygame.mask.from_surface(sp_nuevo)
                        silhouette = mask.to_surface(setcolor=(255, 255, 255, 255),
                                                     unsetcolor=(0, 0, 0, 0))
                        big = pygame.transform.scale(silhouette, (128, 128))
                        # Brillo
                        ov = pygame.Surface((128, 128), pygame.SRCALPHA)
                        ov.fill((255, 255, 200, int(150 * math.sin(prog * 20))))
                        big.blit(ov, (0, 0), special_flags=pygame.BLEND_RGBA_ADD)
                        pantalla.blit(big, (cx - 64, cy - 64))
                except Exception:
                    pass

            # Particulas orbitando
            for i in range(20):
                ang = i * 0.314 + t * 4
                r = 80 + math.sin(t * 3 + i) * 20
                px = cx + math.cos(ang) * r
                py = cy + math.sin(ang) * r
                col = [(255, 240, 100), (100, 220, 255), (255, 140, 220), (140, 255, 160)][i % 4]
                tam = 3 + int(abs(math.sin(t * 4 + i)) * 3)
                pygame.draw.circle(pantalla, col, (int(px), int(py)), tam)
                pygame.draw.circle(pantalla, (255, 255, 255), (int(px), int(py)), max(1, tam - 2))

        # Fase 3 (3.5-5.0s): Revelacion con flash
        else:
            prog = (t - 3.5) / 1.5
            # Flash blanco inicial
            if prog < 0.15:
                a = int(255 * (1 - prog / 0.15))
                ov = pygame.Surface((ANCHO, ALTO))
                ov.fill((255, 255, 255))
                ov.set_alpha(a)
                pantalla.blit(ov, (0, 0))
            else:
                # Sprite nuevo revelado
                sp = SPRITES.get(nuevo) if nuevo else None
                if sp:
                    escala = 0.8 + 0.4 * min(1.0, (prog - 0.15) / 0.3)
                    tam = int(180 * escala)
                    big = pygame.transform.scale(sp, (tam, tam))
                    bob = int(math.sin((t - 3.5) * 4) * 3)
                    pantalla.blit(big, (cx - tam // 2, cy - tam // 2 + bob))

                    # Aura radiante
                    for i in range(3):
                        r = int(100 + i * 20 + prog * 30)
                        ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
                        pygame.draw.circle(ov, (255, 240, 100, 150 - i * 40), (cx, cy), r, 3)
                        pantalla.blit(ov, (0, 0))

        # Texto
        if t > 0.3:
            tt = fuente_grande.render("!Tu Pokemon esta evolucionando!", True, (255, 240, 180))
            # Sombra
            ts = fuente_grande.render("!Tu Pokemon esta evolucionando!", True, (60, 30, 20))
            tx = ANCHO//2 - tt.get_width()//2
            pantalla.blit(ts, (tx + 2, 22))
            pantalla.blit(tt, (tx, 20))

        if t > 3.8 and poke and nuevo:
            tt2 = fuente_grande.render(f"{poke.nombre}  ->  {nuevo}", True, (255, 220, 100))
            ts2 = fuente_grande.render(f"{poke.nombre}  ->  {nuevo}", True, (100, 40, 20))
            tx2 = ANCHO//2 - tt2.get_width()//2
            pantalla.blit(ts2, (tx2 + 3, ALTO - 100 + 3))
            pantalla.blit(tt2, (tx2, ALTO - 100))

            # Subtitulo
            t3 = fuente_media.render("!Felicidades!", True, (255, 250, 220))
            pantalla.blit(t3, (ANCHO//2 - t3.get_width()//2, ALTO - 60))

        tip = fuente_peque.render("[X] Continuar   [N] Cancelar",
                                  True, (240, 220, 180))
        pantalla.blit(tip, (ANCHO//2 - tip.get_width()//2, ALTO - 26))
    def _dibujar_evento_historia(self):
        self._dibujar_exploracion(1/60)      # mapa de fondo
        self._dibujar_dialogo()          # diálogo encima

    def _dibujar_dialogo(self):
        # Fondo con degradado púrpura
        ov = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
        for i in range(ALTO):
            if i < ALTO // 2:
                a = int(30 + 40 * (i / (ALTO // 2)))
                ov.fill((40, 25, 60, a), (0, i, ANCHO, 1))
            else:
                t = (i - ALTO // 2) / (ALTO // 2)
                a = int(70 + 100 * t)
                ov.fill((20, 12, 40, a), (0, i, ANCHO, 1))
        pantalla.blit(ov, (0, 0))

        # Textura sutil de rombos
        try:
            t_anim = self.anim_menu * 0.3
            for row in range(0, ALTO, 24):
                for col in range(0, ANCHO, 24):
                    a = 15 + int(8 * math.sin(t_anim + row * 0.1 + col * 0.1))
                    pygame.draw.polygon(pantalla, (120, 80, 60, a), [
                        (col + 12, row + 4), (col + 20, row + 12),
                        (col + 12, row + 20), (col + 4, row + 12),
                    ], 1)
        except Exception:
            pass

        bx, by, bw, bh = 14, 296, ANCHO - 28, 168

        # Panel con estilo Emerald
        UIKit.dibujar_panel(pantalla, bx, by, bw, bh)

        # Linea decorativa superior con escalones andinos
        for i in range(bw // 30):
            cx_ = bx + 15 + i * 30
            cy_ = by + 8
            pygame.draw.rect(pantalla, UI.EMERALD_RED, (cx_, cy_ + 3, 3, 3))
            pygame.draw.rect(pantalla, UI.EMERALD_RED, (cx_ + 3, cy_, 3, 6))
            pygame.draw.rect(pantalla, UI.EMERALD_RED, (cx_ + 6, cy_ + 3, 3, 3))

        # Retrato
        retrato_ancho = 0
        texto_completo = ""
        if self.dialogo_actual and self.dialogo_idx < len(self.dialogo_actual):
            texto_completo = self.dialogo_actual[self.dialogo_idx]
        if self.dialogo_hablante:
            try:
                from sistemas.retratos import Retratos
                hablando = (self.dialogo_char_idx < len(texto_completo))
                _expresion = "normal"
                _txt_low = texto_completo.lower()
                if any(w in _txt_low for w in ["jaja", "buena", "genial", "increible", "excelente"]):
                    _expresion = "feliz"
                elif any(w in _txt_low for w in ["maldit", "idiota", "calla", "basta"]):
                    _expresion = "enojado"
                elif any(w in _txt_low for w in ["lo siento", "perdi", "triste"]):
                    _expresion = "triste"
                elif any(w in _txt_low for w in ["imposible", "?!", "que!"]):
                    _expresion = "sorpresa"
                retrato = Retratos.obtener_animado(self.dialogo_hablante, 112,
                                                    self.anim_menu, hablando=hablando,
                                                    expresion=_expresion)
                rx, ry = bx + 12, by + 22
                # Marco doble
                pygame.draw.rect(pantalla, (60, 40, 30), (rx - 4, ry - 4, 120, 120))
                pygame.draw.rect(pantalla, UI.EMERALD_GOLD_DARK, (rx - 3, ry - 3, 118, 118), 2)
                pygame.draw.rect(pantalla, UI.EMERALD_GOLD, (rx - 2, ry - 2, 116, 116), 2)
                pygame.draw.rect(pantalla, (24, 18, 32), (rx, ry, 112, 112))
                pantalla.blit(retrato, (rx + 4, ry + 4))
                retrato_ancho = 132
            except Exception:
                retrato_ancho = 0

        # Texto con letra por letra
        if self.dialogo_actual and self.dialogo_idx < len(self.dialogo_actual):
            nombre_jug = getattr(self, "nombre_jugador", "Freekie")
            texto_completo = texto_completo.replace("[Nombre del Jugador]", nombre_jug)
            texto_completo = texto_completo.replace("[Nombre]", nombre_jug)
            texto = texto_completo[:self.dialogo_char_idx]

            x_texto = bx + 26 + retrato_ancho
            ancho_texto = bw - 46 - retrato_ancho
            y = by + 32
            for linea in self._wrap_texto(texto, fuente_media, ancho_texto):
                pantalla.blit(fuente_media.render(linea, True, (100, 80, 70)),
                              (x_texto + 1, y + 1))
                pantalla.blit(fuente_media.render(linea, True, UI.EMERALD_TEXT),
                              (x_texto, y))
                y += 26

            # Flecha continuar
            if self.dialogo_char_idx >= len(texto_completo):
                UIKit.dibujar_flecha_continuar(pantalla, bx + bw - 34, by + bh - 26, self.anim_menu)

            pag = fuente_peque.render(
                f"{self.dialogo_idx + 1}/{len(self.dialogo_actual)}",
                True, (140, 110, 70))
            pantalla.blit(pag, (bx + bw - pag.get_width() - 14, by + bh - 18))

        # Nombre en placa superior
        if self.dialogo_hablante:
            tt = fuente_media.render(self.dialogo_hablante, True, UI.EMERALD_GOLD_LIGHT)
            tw = tt.get_width() + 30
            lx, ly = bx + 8, by - 22
            pygame.draw.rect(pantalla, (0, 0, 0, 100), (lx + 2, ly + 2, tw, 26))
            pygame.draw.rect(pantalla, (60, 30, 20), (lx, ly, tw, 26))
            pygame.draw.rect(pantalla, UI.EMERALD_GOLD_DARK, (lx, ly, tw, 26), 2)
            pygame.draw.rect(pantalla, UI.EMERALD_GOLD, (lx + 2, ly + 2, tw - 4, 22), 2)
            # Decoraciones
            pygame.draw.rect(pantalla, UI.EMERALD_RED, (lx - 6, ly + 8, 4, 8))
            pygame.draw.rect(pantalla, UI.EMERALD_RED, (lx + tw + 2, ly + 8, 4, 8))
            pantalla.blit(tt, (lx + 15, ly + 4))
    def _dibujar_tienda(self):
        pantalla.fill(VERDE_SELVA)
        if not self.tienda_actual: return
        t = fuente_grande.render(f"TIENDA: {self.tienda_actual.nombre}", True, BLANCO)
        pantalla.blit(t, (ANCHO//2 - t.get_width()//2, 30))
        t = fuente_media.render(f"Soles: S/{self.inventario.dinero}", True, AMARILLO_SOL)
        pantalla.blit(t, (50, 80))
        pygame.draw.rect(pantalla, CREMA, (30, 110, ANCHO-60, 320))
        pygame.draw.rect(pantalla, NEGRO, (30, 110, ANCHO-60, 320), 3)
        y = 130
        for i, (nom, obj, precio) in enumerate(self.tienda_actual.obtener_lista_compra()[:9]):
            col = AMARILLO_SOL if i == self.tienda_idx else NEGRO
            pantalla.blit(fuente_media.render(f"{nom}", True, col), (50, y))
            pantalla.blit(fuente_media.render(f"S/{precio}", True, col), (ANCHO-150, y))
            y += 32
        pantalla.blit(fuente_peque.render("[↑/↓] [X] [ESC]", True, BLANCO), (50, 450))

    def _dibujar_liga(self):
        pantalla.fill((40, 30, 80))
        pygame.draw.rect(pantalla, DORADO_LIGA, (0, 0, 30, ALTO))
        pygame.draw.rect(pantalla, DORADO_LIGA, (ANCHO-30, 0, 30, ALTO))
        t = fuente_grande.render("LIGA POKÉMON", True, DORADO_LIGA)
        pantalla.blit(t, (ANCHO//2 - t.get_width()//2, 10))

    def _dibujar_pokedex(self):
        # Fondo con degradado rojo GBA
        for i in range(ALTO):
            r = max(0, min(255, int(40 + 30 * i / ALTO)))
            g = max(0, min(255, int(20 + 15 * i / ALTO)))
            b = max(0, min(255, int(30 + 20 * i / ALTO)))
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Marco superior
        pygame.draw.rect(pantalla, (200, 40, 60), (0, 0, ANCHO, 50))
        pygame.draw.rect(pantalla, (240, 80, 100), (0, 0, ANCHO, 4))
        pygame.draw.rect(pantalla, (140, 20, 40), (0, 46, ANCHO, 4))
        pygame.draw.circle(pantalla, (100, 180, 240), (30, 24), 12)
        pygame.draw.circle(pantalla, (60, 120, 200), (30, 24), 8)
        pygame.draw.circle(pantalla, (240, 240, 240), (26, 20), 3)
        pygame.draw.circle(pantalla, (255, 60, 60), (58, 24), 5)
        pygame.draw.circle(pantalla, (255, 220, 60), (74, 24), 5)
        pygame.draw.circle(pantalla, (100, 240, 100), (90, 24), 5)
        t = fuente_grande.render("POKEDEX REGIONAL", True, BLANCO)
        pantalla.blit(t, (ANCHO // 2 - t.get_width() // 2, 14))

        # Barra de progreso
        v = self.pokedex.total_vistos()
        c = self.pokedex.total_capturados()
        total = self.pokedex.total_registrados()
        try:
            barra_x = ANCHO // 2 - 100
            pygame.draw.rect(pantalla, (60, 20, 30), (barra_x, 54, 200, 12))
            relleno = int(200 * c / max(1, total))
            pygame.draw.rect(pantalla, (100, 220, 120), (barra_x, 54, relleno, 12))
            pygame.draw.rect(pantalla, (240, 200, 60), (barra_x, 54, 200, 12), 2)
            txt = fuente_peque.render(f"{c}/{total}", True, BLANCO)
            pantalla.blit(txt, (ANCHO // 2 - txt.get_width() // 2, 54))
        except Exception:
            pass

        # Info de filtro/orden
        try:
            filtro = self.pokedex_filtro.upper()
            orden = self.pokedex_orden.upper()
            info = fuente_peque.render(
                f"[TAB] Filtro: {filtro}    [O] Orden: {orden}    "
                f"Vistos: {v}    Capturados: {c}",
                True, (240, 220, 180))
            pantalla.blit(info, (ANCHO // 2 - info.get_width() // 2, 70))
        except Exception:
            pass

        # Marco principal
        pygame.draw.rect(pantalla, (60, 30, 40), (16, 88, ANCHO - 32, ALTO - 118))
        pygame.draw.rect(pantalla, (200, 60, 80), (16, 88, ANCHO - 32, ALTO - 118), 3)

        if self.pokedex_detalle:
            p = self.pokedex_detalle
            datos = p.get("datos", {})
            pygame.draw.rect(pantalla, (20, 40, 60), (30, 100, ANCHO - 60, ALTO - 140))
            pygame.draw.rect(pantalla, (100, 200, 240), (30, 100, ANCHO - 60, ALTO - 140), 2)

            sp = SPRITES.get(p["nombre"])
            if sp:
                sp_big = pygame.transform.scale(sp, (128, 128))
                pygame.draw.rect(pantalla, (10, 30, 50), (40, 110, 138, 138))
                pygame.draw.rect(pantalla, (100, 200, 240), (40, 110, 138, 138), 2)
                pantalla.blit(sp_big, (45, 115))

            nom = fuente_grande.render(f"#{p['id']:03d}  {p['nombre']}", True, BLANCO)
            pantalla.blit(nom, (195, 110))

            tipos = datos.get("tipos", p.get("tipos", ["?"]))
            colores = {"Planta": (110, 200, 100), "Fuego": (240, 120, 60),
                       "Agua": (80, 150, 240), "Normal": (180, 180, 160),
                       "Bicho": (170, 200, 80), "Tierra": (200, 160, 80),
                       "Hada": (240, 170, 220), "Psiquico": (240, 100, 160),
                       "Psíquico": (240, 100, 160), "Siniestro": (90, 70, 90),
                       "Volador": (180, 200, 240), "Roca": (180, 150, 90),
                       "Acero": (170, 180, 200), "Lucha": (200, 80, 60),
                       "Veneno": (160, 90, 200), "Fantasma": (120, 100, 170),
                       "Hielo": (140, 220, 230), "Dragon": (90, 90, 230),
                       "Dragón": (90, 90, 230), "Electrico": (240, 210, 60),
                       "Eléctrico": (240, 210, 60), "Sonido": (150, 220, 220)}
            tx = 195
            for tt in tipos:
                col = colores.get(tt, (200, 200, 200))
                pygame.draw.rect(pantalla, col, (tx, 140, 70, 22))
                pygame.draw.rect(pantalla, (20, 15, 25), (tx, 140, 70, 22), 1)
                et = fuente_peque.render(tt[:8], True, (30, 20, 30))
                pantalla.blit(et, (tx + 35 - et.get_width() // 2, 144))
                tx += 78

            alt = datos.get("altura", "?")
            pes = datos.get("peso", "?")
            cat = datos.get("categoria", "?")
            hab = datos.get("habilidad", "?")
            pantalla.blit(fuente_peque.render(
                f"Categoria: {cat}", True, (220, 220, 240)), (195, 172))
            pantalla.blit(fuente_peque.render(
                f"Altura: {alt} m   Peso: {pes} kg", True, (220, 220, 240)), (195, 188))
            pantalla.blit(fuente_peque.render(
                f"Habilidad: {hab}", True, (255, 220, 120)), (195, 204))

            sb = datos.get("stats_base", {})
            if sb:
                stats = [("PS", sb.get("ps", 0), 255), ("ATQ", sb.get("atq", 0), 200),
                         ("DEF", sb.get("def", 0), 200), ("ATQ.E", sb.get("atq_esp", 0), 200),
                         ("DEF.E", sb.get("def_esp", 0), 200), ("VEL", sb.get("vel", 0), 200)]
                y_st = 232
                for etiq, val, maxv in stats:
                    pantalla.blit(fuente_peque.render(etiq, True, (200, 220, 240)), (195, y_st))
                    pygame.draw.rect(pantalla, (60, 80, 100), (240, y_st + 4, 90, 6))
                    ancho = int(90 * min(1.0, val / maxv))
                    pygame.draw.rect(pantalla, (80, 200, 90), (240, y_st + 4, ancho, 6))
                    pantalla.blit(fuente_peque.render(str(val), True, BLANCO), (335, y_st))
                    y_st += 14

            desc = datos.get("descripcion", "Sin descripcion")
            y_d = 110
            pygame.draw.rect(pantalla, (15, 30, 45), (420, 105, ANCHO - 450, ALTO - 155))
            pygame.draw.rect(pantalla, (100, 200, 240), (420, 105, ANCHO - 450, ALTO - 155), 1)
            for ln in self._wrap_texto(desc, fuente_peque, ANCHO - 470):
                t2 = fuente_peque.render(ln, True, (220, 230, 240))
                pantalla.blit(t2, (430, y_d))
                y_d += 16
                if y_d > ALTO - 80:
                    break

            inst = fuente_peque.render("[ESC] Volver  [<] Anterior  [>] Siguiente",
                                       True, (240, 220, 180))
            pantalla.blit(inst, (ANCHO // 2 - inst.get_width() // 2, ALTO - 26))
        else:
            lista = self._lista_pokedex_filtrada()
            if not lista:
                msg = fuente_media.render("(Sin resultados para este filtro)",
                                          True, (200, 200, 210))
                pantalla.blit(msg, (ANCHO // 2 - msg.get_width() // 2, 200))
            else:
                self.pokedex_idx = max(0, min(self.pokedex_idx, len(lista) - 1))
                y = 100
                inicio = max(0, min(self.pokedex_idx - 6, len(lista) - 13))
                for i in range(13):
                    idx_real = inicio + i
                    if idx_real >= len(lista):
                        break
                    p = lista[idx_real]
                    sel = (idx_real == self.pokedex_idx)
                    if sel:
                        pygame.draw.rect(pantalla, (100, 200, 240),
                                         (24, y - 3, ANCHO - 48, 24))
                        pygame.draw.rect(pantalla, BLANCO,
                                         (24, y - 3, ANCHO - 48, 24), 1)
                    nom = p['nombre'] if p['estado'] != "—" else "???"
                    col = (20, 15, 25) if sel else BLANCO
                    t1 = fuente_peque.render(f"#{p['id']:03d}", True,
                                             (20, 15, 25) if sel else (150, 180, 200))
                    pantalla.blit(t1, (35, y))
                    t2 = fuente_peque.render(nom, True, col)
                    pantalla.blit(t2, (95, y))
                    if p['estado'] != "—":
                        for tt in (p.get("tipos") or [])[:2]:
                            col_t = {"Planta": (110, 200, 100), "Fuego": (240, 120, 60),
                                     "Agua": (80, 150, 240)}.get(tt, (180, 180, 180))
                            pygame.draw.circle(pantalla, col_t, (ANCHO - 220, y + 8), 4)
                            break
                    col_e = (100, 240, 100) if p['estado'] == "✓" else                             (240, 220, 60) if p['estado'] == "○" else (120, 120, 140)
                    t3 = fuente_peque.render(p['estado'], True, col_e)
                    pantalla.blit(t3, (ANCHO - 60, y))
                    y += 24
            inst = fuente_peque.render(
                "[↑/↓] Navegar   [TAB] Filtrar   [O] Orden   [X] Detalle   [D/ESC] Salir",
                True, (240, 220, 180))
            pantalla.blit(inst, (ANCHO // 2 - inst.get_width() // 2, ALTO - 26))
    def _dibujar_pc(self):
        # Fondo tipo pantalla de PC
        for i in range(ALTO):
            r = int(20 + 30 * i / ALTO)
            g = int(40 + 40 * i / ALTO)
            b = int(70 + 40 * i / ALTO)
            pygame.draw.line(pantalla, (r, g, b), (0, i), (ANCHO, i))

        # Marco cabecera
        pygame.draw.rect(pantalla, (60, 100, 180), (0, 0, ANCHO, 42))
        pygame.draw.rect(pantalla, (100, 180, 240), (0, 0, ANCHO, 4))
        pygame.draw.rect(pantalla, (30, 60, 120), (0, 38, ANCHO, 4))
        t = fuente_grande.render("PC - SISTEMA DE ALMACENAMIENTO", True, BLANCO)
        pantalla.blit(t, (ANCHO // 2 - t.get_width() // 2, 10))

        # Info de caja y modos
        try:
            total = self.pc.total_almacenados()
        except Exception:
            total = 0
        info = fuente_peque.render(
            f"Caja {self.pc_caja_actual + 1}/30   Pokemon almacenados: {total}   Modo: {self.pc_modo.upper()}",
            True, (220, 230, 250))
        pantalla.blit(info, (10, 46))

        # Panel izquierdo: Caja
        pygame.draw.rect(pantalla, (240, 240, 230), (10, 70, 340, ALTO - 110))
        pygame.draw.rect(pantalla, (60, 100, 180), (10, 70, 340, ALTO - 110), 3)
        titulo_caja = fuente_media.render(f"CAJA {self.pc_caja_actual + 1}", True, (30, 50, 90))
        pantalla.blit(titulo_caja, (20, 78))

        # Grid de 5x6 para los 30 slots de la caja
        caja = []
        try:
            caja = self.pc.obtener_lista_caja(self.pc_caja_actual) or []
        except Exception:
            caja = []

        for fil in range(6):
            for col in range(5):
                idx = fil * 5 + col
                x = 20 + col * 64
                y = 108 + fil * 52
                # Fondo del slot
                pygame.draw.rect(pantalla, (200, 200, 190), (x, y, 60, 48))
                pygame.draw.rect(pantalla, (120, 130, 140), (x, y, 60, 48), 1)
                if idx < len(caja):
                    p = caja[idx]
                    sel = (self.pc_modo == "retirar" and idx == self.pc_idx)
                    if sel:
                        pygame.draw.rect(pantalla, (100, 180, 240), (x - 2, y - 2, 64, 52), 3)
                    sp = SPRITES.get(getattr(p, "nombre", ""))
                    if sp:
                        mini = pygame.transform.scale(sp, (40, 40))
                        pantalla.blit(mini, (x + 10, y + 2))
                    try:
                        nv = fuente_peque.render(f"Nv{p.nivel}", True, (30, 30, 40))
                        pantalla.blit(nv, (x + 4, y + 32))
                    except Exception:
                        pass

        # Panel derecho: Equipo
        pygame.draw.rect(pantalla, (240, 240, 230), (360, 70, ANCHO - 370, ALTO - 110))
        pygame.draw.rect(pantalla, (200, 60, 80), (360, 70, ANCHO - 370, ALTO - 110), 3)
        titulo_eq = fuente_media.render("TU EQUIPO", True, (140, 30, 40))
        pantalla.blit(titulo_eq, (370, 78))

        for i, p in enumerate(self.equipo.pokemons[:6]):
            y = 108 + i * 48
            sel = (self.pc_modo == "guardar" and i == self.pc_idx)
            fondo = (250, 200, 150) if sel else (220, 220, 210)
            pygame.draw.rect(pantalla, fondo, (370, y, ANCHO - 390, 44))
            pygame.draw.rect(pantalla, (140, 100, 80), (370, y, ANCHO - 390, 44), 1)
            if sel:
                pygame.draw.rect(pantalla, (240, 140, 60), (370, y, ANCHO - 390, 44), 3)
            sp = SPRITES.get(getattr(p, "nombre", ""))
            if sp:
                mini = pygame.transform.scale(sp, (36, 36))
                pantalla.blit(mini, (374, y + 4))
            try:
                nom = fuente_peque.render(getattr(p, "nombre", "?"), True, (30, 30, 40))
                pantalla.blit(nom, (416, y + 4))
                lv = fuente_peque.render(f"Nv{p.nivel}  PS {p.ps}/{p.ps_max}", True, (60, 60, 70))
                pantalla.blit(lv, (416, y + 22))
            except Exception:
                pass

        # Ayuda segun modo
        ayuda = {
            "ver":     "[UP/DN] Cambiar caja   [X] Retirar   [G] Guardar   [ESC] Salir",
            "retirar": "[UP/DN] Elegir   [X] Sacar al equipo   [ESC] Volver",
            "guardar": "[UP/DN] Elegir   [X] Enviar a la caja   [ESC] Volver",
        }.get(self.pc_modo, "")
        t = fuente_peque.render(ayuda, True, (240, 230, 200))
        pantalla.blit(t, (ANCHO // 2 - t.get_width() // 2, ALTO - 22))
    def _dibujar_dialogo_gimnasio(self):
        # Dibujamos el mapa SIN efectos secundarios
        jpx, jpy = self.mapa_actual.tile_en_pixel()
        cam_x = int(jpx - ANCHO//2 + TILE_SIZE//2)
        cam_y = int(jpy - ALTO//2 + TILE_SIZE//2)
        cam_x = max(0, min(cam_x, len(self.mapa_actual.tiles[0]) * TILE_SIZE - ANCHO))
        cam_y = max(0, min(cam_y, len(self.mapa_actual.tiles) * TILE_SIZE - ALTO))
        self.mapa_actual.dibujar(pantalla, cam_x, cam_y)
        self.mapa_actual.dibujar_jugador(pantalla, cam_x, cam_y, SPRITES_JUGADOR)

        overlay = pygame.Surface((ANCHO, ALTO), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 160)); pantalla.blit(overlay, (0, 0))
        pygame.draw.rect(pantalla, (32, 24, 40), (30, 250, ANCHO - 60, 180))
        pygame.draw.rect(pantalla, DORADO_LIGA, (30, 250, ANCHO - 60, 180), 3)

        g = self.gimnasio_actual
        if not g:
            return
        nombre = getattr(g, "nombre", "Gimnasio")
        lider = getattr(g, "lider", None)
        lnom = getattr(lider, "nombre", "el líder")
        derrotado = getattr(lider, "derrotado", False)
        pantalla.blit(fuente_grande.render(nombre, True, DORADO_LIGA), (50, 262))
        if derrotado:
            txt = f"Ya derrotaste a {lnom}. ¡Sigue tu camino, campeón!"
        else:
            txt = f"{lnom} te espera en el gimnasio. ¿Aceptas el desafío?"
        y = 306
        for ln in self._wrap_texto(txt, fuente_media, ANCHO - 120):
            pantalla.blit(fuente_media.render(ln, True, BLANCO), (50, y)); y += 26
        t = "[X] Desafiar    [ESC] Salir" if not derrotado else "[X] / [ESC] Volver"
        pantalla.blit(fuente_peque.render(t, True, AMARILLO_SOL), (50, 400))

# =========================================================================
# PUNTO DE ENTRADA
# =========================================================================
if __name__ == "__main__":
    juego = Juego()
    juego.loop()
    pygame.quit()
    sys.exit()