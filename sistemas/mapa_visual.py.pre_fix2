 FLOR_ROJA, ARENA_CLARA, SIGN_INFO,
 # NUEVOS:
 AGUA_OCEANO,      # 27 - mar abierto, olas
 ARENA_PLAYA,      # 28 - playa
 ROCA_ESCALABLE,   # 29 - muro trepable con MO
 ROCA_ROMPIBLE,    # 30 - roca chica rompible con MO
 CUEVA_PISO,       # 31 - piso de cueva
 CUEVA_PARED,      # 32 - pared de cueva
 CUEVA_OSCURA,     # 33 - zona negra
 ANTORCHA,         # 34 - ilumina cueva
 CASCADA,          # 35 - cascada
 PUENTE,           # 36 - puente de madera
 ARBUSTO_CORTABLE, # 37 - se corta con MO
 MT_SUELO,         # 38 - MT recogible
 OBJ_BRILLANTE,    # 39 - item en el suelo
 TELEPORT,         # 40 - warp (entrada cueva)
 MONTAÑA,          # 41 - tile de montaña alta (fondo)
 LAGO,             # 42 - lago navegable
 ARENA_OSCURA,     # 43 - arena mojada
 PIEDRA_SAGRADA,   # 44 - decorativa
) = range(45)

