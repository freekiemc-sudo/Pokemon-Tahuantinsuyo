# sistemas/mapa_visual.py - VERSIÓN EXPANDIDA
"""
Mapas por tiles GRANDES (60x40) estilo Esmeralda con:
- Océano animado con olas y espuma
- Cuevas oscuras con antorchas
- Montañas escalables (MO Escalada)
- Agua navegable (MO Navegación)
- Arbustos cortables (MO Corte)
- Rocas rompibles (MO Golpe Roca)
- Plataformas y acantilados con saltos
- Letreros, MTs en el suelo, objetos brillantes
- Interiores conectados
"""
import math, random, pygame

TILE_SIZE = 16
MAP_WIDTH = 60
MAP_HEIGHT = 40

