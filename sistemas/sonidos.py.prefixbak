            "Fantasma":  Sonidos.ataque_fantasma,
            "Veneno":    Sonidos.ataque_veneno,
            "Tierra":    Sonidos.ataque_tierra,
            "Roca":      Sonidos.ataque_roca,
            "Acero":     Sonidos.ataque_acero,
            "Psiquico":  Sonidos.ataque_psiquico,
            "Psíquico":  Sonidos.ataque_psiquico,
            "Bicho":     Sonidos.ataque_bicho,
            "Volador":   Sonidos.ataque_volador,
            "Dragon":    Sonidos.ataque_dragon,
            "Dragón":    Sonidos.ataque_dragon,
            "Hada":      Sonidos.ataque_hada,
            "Sonido":    Sonidos.ataque_sonido,
            "Normal":    Sonidos.ataque_normal,
        }
        fn = tabla.get(tipo, Sonidos.ataque_normal)
        fn()

    @staticmethod
    def golpe():
