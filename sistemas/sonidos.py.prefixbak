    @staticmethod
    def victoria():
        if not Sonidos._habilitado:
            return
        try:
            ch = pygame.mixer.Channel(5)
            ch.stop()
            notas = [(523, 0.14), (523, 0.07), (523, 0.07), (523, 0.20),
                     (415, 0.20), (466, 0.20), (523, 0.40)]
            for f, d in notas:
                snd = Sonidos._tono(f, d, 0.20, "square")
                if snd:
                    ch.queue(snd)
        except Exception:
            pass

