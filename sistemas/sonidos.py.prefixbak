            except Exception:
                pass

    @staticmethod
    def evolucionar():
        if Sonidos._habilitado:
            try:
                import numpy as np
                sr = 22050
                dur = 2.0
                n = int(sr * dur)
                t = np.linspace(0, dur, n, False)
                # Barrido hacia arriba
                f = np.linspace(200, 1500, n)
                fase = 2 * np.pi * np.cumsum(f) / sr
                w = np.sin(fase) * 0.25
                env = np.sin(np.linspace(0, np.pi, n))
                w = (w * env * 32767).astype(np.int16)
                snd = pygame.sndarray.make_sound(np.column_stack((w, w)))
                ch = pygame.mixer.Channel(5)
                ch.stop()
                ch.play(snd)
            except Exception:
                pass

    @staticmethod
    def golpe_fuerte():
        if Sonidos._habilitado:
            try:
                import numpy as np
                sr = 22050
                n = int(sr * 0.15)
                t = np.linspace(0, 0.15, n, False)
                w = np.random.uniform(-1, 1, n) * np.exp(-12 * t)
                w += np.sin(2*np.pi*80*t) * np.exp(-8*t) * 0.5
                w = (w * 32767 * 0.4).astype(np.int16)
                snd = pygame.sndarray.make_sound(np.column_stack((w, w)))
                snd.play()
            except Exception:
                pass

    @staticmethod
    def critico():
        if Sonidos._habilitado:
            try:
                import numpy as np
                sr = 22050
                n = int(sr * 0.25)
                t = np.linspace(0, 0.25, n, False)
                w = np.random.uniform(-1, 1, n) * np.exp(-8 * t)
                w += np.sin(2*np.pi*150*t) * np.exp(-6*t)
                w += np.sin(2*np.pi*400*t) * np.exp(-10*t) * 0.5
                w = (w * 32767 * 0.45).astype(np.int16)
                snd = pygame.sndarray.make_sound(np.column_stack((w, w)))
                ch = pygame.mixer.Channel(5)
                ch.stop()
                ch.play(snd)
            except Exception:
                pass

