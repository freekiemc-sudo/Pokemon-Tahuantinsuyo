            "Tierra":    Sonidos.ataque_tierra,
            "Roca":      Sonidos.ataque_roca,
            "Acero":     Sonidos.ataque_acero,
            "Psiquico":  Sonidos.ataque_psiquico,
            "Psíquico":  Sonidos.ataque_psiquico,
            "Bicho":     Sonidos.ataque_bicho,
