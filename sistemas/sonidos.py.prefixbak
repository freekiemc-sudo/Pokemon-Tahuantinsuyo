"""
Sonido procedural avanzado - efectos contextuales
"""
import pygame, math

class Sonidos:
    _habilitado = True
    _cache = {}

    @staticmethod
    def init():
        try:
            if not pygame.mixer.get_init():
                Sonidos._habilitado = False; return
            import numpy  # noqa
        except Exception:
            Sonidos._habilitado = False

    @staticmethod
    def _tono(freq, dur=0.1, vol=0.3, forma="sin", freq_fin=None):
        key = (freq, dur, vol, forma, freq_fin)
        if key in Sonidos._cache: return Sonidos._cache[key]
        if not Sonidos._habilitado: return None
        try:
            import numpy as np
            sr = 22050
            n = int(sr * dur)
            t = np.linspace(0, dur, n, False)
            f = np.full_like(t, freq) if freq_fin is None else np.linspace(freq, freq_fin, n)
            fase = 2 * np.pi * np.cumsum(f) / sr
            if forma == "sin":    onda = np.sin(fase)
            elif forma == "square": onda = np.sign(np.sin(fase))
            elif forma == "tri":
                onda = 2 * np.abs(2 * ((fase / (2*np.pi)) % 1) - 1) - 1
            elif forma == "noise": onda = np.random.uniform(-1, 1, n)
            else: onda = np.sin(fase)
            env = np.ones_like(t)
            atk = min(int(sr * 0.005), n // 4)
            rel = min(int(sr * 0.02), n // 4)
            if atk > 0: env[:atk] = np.linspace(0, 1, atk)
            if rel > 0: env[-rel:] = np.linspace(1, 0, rel)
            onda = (onda * env * 32767 * vol).astype(np.int16)
            snd = pygame.sndarray.make_sound(np.column_stack((onda, onda)))
            Sonidos._cache[key] = snd
            return snd
        except Exception:
            return None

    @staticmethod
    def _play(snd):
        if snd: snd.play()

    # --- Básicos ---
    @staticmethod
    def select():
        if Sonidos._habilitado: Sonidos._play(Sonidos._tono(720, 0.04, 0.18, "square"))

    @staticmethod
    def confirmar():
        if Sonidos._habilitado: Sonidos._play(Sonidos._tono(880, 0.05, 0.20, "square"))

    @staticmethod
    def cancelar():
        if Sonidos._habilitado: Sonidos._play(Sonidos._tono(320, 0.08, 0.18, "square", 180))

    @staticmethod
    def bleep_texto():
        if Sonidos._habilitado:
            Sonidos._play(Sonidos._tono(900, 0.015, 0.08, "square"))

    @staticmethod
    def hover():
