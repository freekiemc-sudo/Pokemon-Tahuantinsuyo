    @staticmethod
    def ataque_normal():
        if Sonidos._habilitado: Sonidos._play(Sonidos._tono(250, 0.10, 0.22, "square"))    @staticmethod
    def ataque_por_tipo(tipo):
        tabla = {
            "Fuego":     Sonidos.ataque_fuego,
            "Agua":      Sonidos.ataque_agua,
            "Planta":    Sonidos.ataque_planta,
            "Electrico": Sonidos.ataque_electrico,
