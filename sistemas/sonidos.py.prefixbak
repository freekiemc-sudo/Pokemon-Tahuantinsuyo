        if Sonidos._habilitado:
            Sonidos._play(Sonidos._tono(400, 0.06, 0.16, "square", 260))

    @staticmethod
    def abrir_menu():
        if Sonidos._habilitado:
            try:
                ch = pygame.mixer.Channel(5)
                ch.stop()
                for f in (523, 659, 784):
                    s = Sonidos._tono(f, 0.04, 0.15, "square")
                    if s: ch.queue(s)
            except Exception:
                pass

