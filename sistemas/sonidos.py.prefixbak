        fn = tabla.get(tipo, Sonidos.ataque_normal)
        fn()

    @staticmethod
    def ataque_electrico():
        # Crackle agudo tipo rayo
        if not Sonidos._habilitado: return
        try:
            ch = pygame.mixer.Channel(4)
            ch.stop()
            s1 = Sonidos._tono(1400, 0.04, 0.22, "square")
            s2 = Sonidos._tono(900, 0.05, 0.20, "square", 1800)
            s3 = Sonidos._tono(2200, 0.06, 0.18, "square")
            for s in (s1, s2, s3):
                if s: ch.queue(s)
        except Exception:
            pass

